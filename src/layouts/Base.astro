---
import "../styles/global.css";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { absolute, site, withBase } from "@/config/site";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  /** og:image 대표이미지 (public 기준 경로) */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** JSON-LD (페이지에서 넘기면 head에 삽입) */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, noindex, type, publishedTime, image, imageAlt, imageWidth, imageHeight, jsonLd } =
  Astro.props;

/*
 * 검색엔진 소유 확인 메타 — 값은 저장소/빌드 환경변수로만 받는다(하드코딩 금지).
 *  · Google Search Console: 도메인 속성(TXT) 또는 URL 접두어 속성(HTML 태그)
 *  · 네이버 서치어드바이저: HTML 태그 방식
 * 예) PUBLIC_GOOGLE_SITE_VERIFICATION=xxxx PUBLIC_NAVER_SITE_VERIFICATION=yyyy npm run build
 */
const envOf = (key: string): string => {
  const viteEnv = import.meta.env as Record<string, string | undefined>;
  const nodeEnv = (typeof process !== "undefined" ? process.env : {}) as Record<string, string | undefined>;
  return (viteEnv[`PUBLIC_${key}`] ?? nodeEnv[key] ?? "").trim();
};
const googleVerification = envOf("GOOGLE_SITE_VERIFICATION");
const naverVerification = envOf("NAVER_SITE_VERIFICATION");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!--
      v6.1 여정 바 접힘 기억 — 첫 페인트 전에 감춰야 접어 둔 바가 깜빡이지 않는다.
      (Guide.astro가 접기·다시 켜기 때 같은 클래스를 붙이고 뗀다)
    -->
    <script is:inline>
      try {
        var bkStore = window.localStorage;
        if (bkStore.getItem("bk_read_guide_v1") === "off") document.documentElement.classList.add("bk-off-read");
        if (bkStore.getItem("bk_tool_guide_v1") === "off") document.documentElement.classList.add("bk-off-tool");
      } catch (e) {}
    </script>
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
    />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 본문·제목: Pretendard Variable (한글 가변 자형). 실패하면 시스템 글꼴로 읽힌다. -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <!-- 숫자·기준일: Instrument Serif -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={withBase("/favicon-16.svg")} type="image/svg+xml" sizes="16x16" />
    <link rel="icon" href={withBase("/favicon-16.png")} sizes="16x16" type="image/png" />
    <link rel="icon" href={withBase("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
    <link rel="alternate" hreflang="ko" href={absolute(path === "/" ? "/" : path.replace(/\/$/, "") + "/")} />
    <link rel="alternate" type="application/rss+xml" title={`${site.brand} 기록`} href={withBase("/rss.xml")} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}
    <noscript>
      <style>
        .reveal,
        .hero-title,
        .hero-soft,
        .hero-card {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
      >본문으로 건너뛰기</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      /*
       * 검색어를 주소(?q=…)·저장소로 넘기지 않는다.
       * `data-search-query`를 단 요소(첫 화면 검색 버튼, 글의 태그)를 누르면
       * 검색 오버레이를 열고 그 값을 메모리 이벤트로만 건넨다. 자바스크립트가 아직이면 링크대로 이동한다.
       */
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const el = target?.closest?.("[data-search-query]") as HTMLElement | null;
        if (!el) return;
        event.preventDefault();
        window.dispatchEvent(
          new CustomEvent("buffetkimz:open-search", { detail: el.getAttribute("data-search-query") ?? "" })
        );
      });
    </script>
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
