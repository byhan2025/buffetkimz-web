---
import Base from "@/layouts/Base.astro";
import AppArt from "@/components/AppArt.astro";
import ToolRunner from "@/components/tools/ToolRunner.tsx";
import AdSlot from "@/components/AdSlot.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site } from "@/config/site";
import { apps } from "@/data/apps";
import { hubTools } from "@/data/tools";
import { nextTool } from "@/data/journey";
import Guide from "@/components/guide/Guide.astro";
import { allPosts, postPath, formatDate } from "@/lib/posts";
import { AUTHOR_ID, ORG_ID, breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

/** 도구 허브 키 → 앱 slug. '다음 앱'은 메인 도구 → 리스크 도구 → 외부 앱 순으로 이어진다. */
export async function getStaticPaths() {
  const HUB_TO_SLUG: Record<string, string> = {
    pension: "pension-tax",
    "pension-draw": "pension-draw",
    "retirement-flow": "retirement-flow",
    "compound-return": "compound-return",
    coverage: "coverage-check",
    disclosure: "disclosure-check",
    silson: "silson-compare",
  };
  /* v7.1 — 도구 허브 순서 → 나머지 앱(내부 계산 도구 포함) 순. 예전에는 내부 앱을 빼서
     새로 추가한 4대 계좌 비교기의 소개 페이지가 만들어지지 않았다. */
  const hubOrder = hubTools.map((t) => HUB_TO_SLUG[t.key]).filter(Boolean);
  const ordered = [...hubOrder, ...apps.map((a) => a.slug)]
    .filter((slug, i, arr) => arr.indexOf(slug) === i)
    .map((slug) => apps.find((a) => a.slug === slug))
    .filter((a): a is (typeof apps)[number] => Boolean(a));

  /* v8.8.0 — 보관함(archived) 도구는 직접 주소로만 열린다.
     페이지는 그대로 만들되, '다음 앱' 순환과 사이트 내 링크에서는 빼서 노출을 늘리지 않는다. */
  const visible = ordered.filter((a) => !a.archived);
  const archived = ordered.filter((a) => a.archived);
  return [
    ...visible.map((app, i) => ({
      params: { slug: app.slug },
      props: { app, next: visible[(i + 1) % visible.length] },
    })),
    ...archived.map((app) => ({
      params: { slug: app.slug },
      props: { app, next: visible[0] },
    })),
  ];
}

const { app, next } = Astro.props;
/**
 * 도구 → 글 역방향 경로.
 * 1) 이 앱이 붙은 글을 먼저, 2) 모자라면 같은 태그(예: 실손·연금)를 가진 글로 채운다.
 * 도구를 먼저 써 본 사람이 그 계산의 배경을 읽으러 갈 수 있어야 한다.
 */
const all = await allPosts();
const appPosts = all.filter((p) => p.data.app === app.slug);
const appTags = new Set(app.tags);
const tagPosts = all.filter(
  (p) => p.data.app !== app.slug && p.data.tags.some((t) => appTags.has(t))
);
const posts = [...appPosts, ...tagPosts].slice(0, 3);

/** v6.1 도구 여정 — 이 도구 다음에 많이 이어 쓰는 도구 한 곳 (없으면 앱스토어 전체) */
const toolNext = nextTool(app.slug);
const toolJourney = {
  mode: "tool" as const,
  stage: "다음 도구",
  kicker: "이 다음으로 많이 쓰는 도구",
  title: toolNext.name,
  href: withBase(toolNext.href),
  why: toolNext.why,
  storageKey: "bk_tool_guide_v1",
  skipLabel: "건너뛰기",
};

const pagePath = `/apps/${app.slug}`;
const jsonLd = graph([
  {
    "@type": "SoftwareApplication",
    "@id": `${pageUrl(pagePath)}#app`,
    name: app.name,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    url: pageUrl(pagePath),
    description: app.summary,
    inLanguage: "ko-KR",
    isAccessibleForFree: true,
    ...(app.externalUrl ? { sameAs: app.externalUrl } : {}),
    offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
    author: { "@id": AUTHOR_ID },
    publisher: { "@id": ORG_ID },
    isPartOf: partOfWebsite,
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "앱스토어", path: "/apps" },
    { name: app.name, path: pagePath },
  ]),
]);
---

<Base
  title={`${app.name} — ${app.subtitle}`}
  description={app.summary}
  path={`/apps/${app.slug}`}
  noindex={Boolean(app.archived)}
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-8 md:py-12">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/apps")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">앱</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">{app.name}</span>
      </nav>

      <div class="mt-6 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
        <div>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[12px]">
            <span class="font-semibold text-clay">{app.kind}</span>
            <span class="text-ink-faint">{app.madeIn} · {app.status === "live" ? "운영 중" : "미리보기"}</span>
          </div>
          {
            app.externalUrl && (
              <p class="mt-2">
                <span class="chip !text-[11px]" data-external-badge="외부 웹앱 · 새 창 열기">
                  외부 웹앱 · 새 창 열기
                </span>
              </p>
            )
          }
          <h1 class="mt-2.5 text-[30px] font-bold leading-[1.28] tracking-[-0.045em] text-ink md:text-[40px]">
            {app.name}
          </h1>
          <p class="mt-1.5 text-[14.5px] text-ink-muted">{app.subtitle}</p>
          <p class="lede mt-4 max-w-[52ch]">{app.oneLine}</p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            {
              app.externalUrl ? (
                <a href={app.externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                  앱 열기
                </a>
              ) : (
                <a href={withBase(`/apps/${app.slug}/run`)} class="btn btn-primary">
                  지금 실행하기
                </a>
              )
            }
            {
              app.externalUrl ? (
                <span class="text-[12px] text-ink-faint">새 창에서 열립니다 · 설치 없이 실행</span>
              ) : (
                <span class="text-[12px] text-ink-faint">
                  {app.sendsDataOut
                    ? "가입 없이 실행 · 단축할 때만 주소 전송"
                    : "가입 없이 실행 · 입력값 서버 미전송"}
                </span>
              )
            }
          </div>

          {
            app.notice && (
              <p class="mt-4 max-w-[46ch] text-[12.5px] leading-[1.7] text-ink-faint" data-app-notice>
                {app.notice}
              </p>
            )
          }

          {
            app.scope === "practitioner" && (
              <p class="mt-2 max-w-[48ch] text-[12px] leading-[1.7] text-ink-faint" data-scope-note>
                실무자용 앱입니다 — 일반 독자용 앱스토어 목록에는 싣지 않고, 앱스토어 맨 아래
                ‘실무자용’ 칸과 이 소개에만 둡니다.
              </p>
            )
          }
        </div>

        <div class="min-h-[240px]">
          <AppArt art={app.art} />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-9 md:py-14">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16">
      <div class="min-w-0">
        <h2 class="text-[13px] font-semibold tracking-[0.01em] text-ink-faint">주요 기능</h2>
        <ul class="mt-3 divide-y divide-line-soft border-t border-line-soft">
          {
            app.features.slice(0, 2).map((f) => (
              <li class="grid gap-1 py-3.5 sm:grid-cols-[180px_1fr] sm:gap-6">
                <p class="text-[14px] font-semibold leading-snug text-ink">{f.title}</p>
                <p class="text-[13.5px] leading-[1.75] text-ink-muted">{f.body}</p>
              </li>
            ))
          }
        </ul>

        {
          app.internal && (
            <div class="mt-10">
              <h2 class="border-t border-line pt-5 text-[13px] font-semibold tracking-[0.01em] text-ink-faint">먼저 보기</h2>
              <p class="mt-2 max-w-[62ch] text-[13px] leading-relaxed text-ink-muted">
                같은 계산을 이 자리에서 바로 해 볼 수 있습니다. 첫 화면은 예시 입력값으로 시작하고,
                값을 바꾸면 결과가 즉시 달라집니다.
              </p>
              <div class="mt-4" data-nosnippet data-tool-input-area="true">
                <ToolRunner slug={app.slug} compact={true} client:visible />
              </div>
              <a href={withBase(`/apps/${app.slug}/run`)} class="mt-4 inline-flex min-h-[44px] items-center text-[13px] font-semibold text-brand-deep link">
                전체 화면으로 실행
              </a>
            </div>
          )
        }

        {
          app.basis && (
            <div class="mt-10">
              <h2 class="border-t border-line pt-5 text-[13px] font-semibold tracking-[0.01em] text-ink-faint">기준과 출처</h2>
              <ul class="mt-3 space-y-2.5">
                {app.basis.map((b) => (
                  <li class="flex gap-2.5 text-[13px] leading-[1.72] text-ink-soft">
                    <span class="mt-[8px] h-[3px] w-[3px] shrink-0 rounded-full bg-ink-faint" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
              <p class="mt-3 source-note">
                기준일 {site.baseDateLabel} 제도와 약관은 바뀌므로, 결정 전에 원문을 다시 확인하세요.
              </p>
            </div>
          )
        }

        <div class="mt-8 note-box">
          <p>
            <strong class="font-semibold text-ink">결과는 판정이 아닙니다.</strong>
            입력한 값과 공개된 기준을 나란히 놓고 확인할 항목을 정리하는 참고 도구입니다. 보험금 지급·가입
            가능 여부, 세액공제·연금 수령액 확정, 투자 수익을 판단하거나 보장하지 않습니다. 최종 확인은
            약관·증권과 관계 기관 안내에 따릅니다.
          </p>
        </div>

        <div data-ad-region="tools-bottom">
          <AdSlot id={`app-${app.slug}-bottom`} size="leaderboard" region="tools-bottom" />
        </div>
      </div>

      <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
        <div>
          <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">한눈에</h2>
          <dl class="mt-3 space-y-2.5 border-t border-line-soft pt-3 text-[12.5px]">
            <div class="flex justify-between gap-4">
              <dt class="text-ink-faint">분류</dt>
              <dd class="text-ink-soft">{app.kind}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-faint">만든 때</dt>
              <dd class="text-ink-soft">{app.madeIn}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-faint">실행</dt>
              <dd class="text-ink-soft">{app.externalUrl ? "외부 웹앱" : "사이트 안"}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-faint">상태</dt>
              <dd class="text-ink-soft">{app.status === "live" ? "운영 중" : "미리보기"}</dd>
            </div>
          </dl>
        </div>

        {
          posts.length > 0 && (
            <div class="border-t border-line pt-4">
              <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">이 도구의 배경이 된 기록</h2>
              <ul class="mt-2 space-y-2">
                {posts.map((p) => (
                  <li>
                    <a href={withBase(postPath(p))} class="inline-flex min-h-[24px] items-center text-[12.5px] leading-snug text-ink-muted hover:text-ink link">
                      {p.data.title}
                    </a>
                    <p class="mt-0.5 text-[12px] text-ink-faint">{formatDate(p.data.publishedAt)}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="wrap py-6">
      <HomePill position="bottom" />
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line-soft pt-4">
        <span class="text-[12px] text-ink-faint">다음 앱</span>
        <a href={withBase(`/apps/${next.slug}`)} class="text-[14px] font-semibold text-ink hover:text-brand-deep">
          {next.name}
        </a>
      </div>
    </div>
  </section>

  <!-- v6.1 도구 여정 바 — 다음에 많이 쓰는 도구로 이어 주고, '건너뛰기'로 접는다 -->
  <Guide mode="tool" journey={toolJourney} />
</Base>
