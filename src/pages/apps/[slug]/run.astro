---
import Base from "@/layouts/Base.astro";
import ToolRunner from "@/components/tools/ToolRunner.tsx";
import RunExit from "@/components/learn/RunExit.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site } from "@/config/site";
import { apps } from "@/data/apps";

export async function getStaticPaths() {
  return apps
    .filter((a) => a.internal)
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
---

<Base
  title={`${app.name} 실행`}
  description={
    app.sendsDataOut
      ? `${app.name} 실행 화면. 정리와 QR은 브라우저에서 하고, 단축할 때만 주소가 외부 서비스로 전송됩니다. 기준일 ${site.baseDateLabel}`
      : app.runMode === "form"
        ? `${app.name} 작성 화면. 이름·연락처·서명은 브라우저에서만 처리되고 서버로 전송되지 않습니다.`
        : `${app.name} 실행 화면. 입력값은 브라우저에서만 계산되고 서버로 전송되지 않습니다. 기준일 ${site.baseDateLabel}`
  }
  path={`/apps/${app.slug}/run`}
  noindex={true}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-6 md:py-9">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/apps")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">앱스토어</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(`/apps/${app.slug}`)} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">{app.name}</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">실행</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-[62ch]">
          <h1 class="text-[24px] font-bold tracking-[-0.035em] text-ink md:text-[30px]">{app.name}</h1>
          <p class="mt-2 text-[14px] leading-[1.7] text-ink-soft">{app.runNote ?? app.oneLine}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="chip">
            {app.runMode === "form"
              ? "서명까지 기기 안에서"
              : app.category === "utility"
                ? app.sendsDataOut
                  ? "정리·QR은 기기 안에서"
                  : app.runMode === "tool"
                    ? "기기 안에서 처리"
                    : app.runMode === "calc"
                      ? "계산은 기기 안에서"
                      : "파일은 기기 안에서"
                : "예시 입력값 기준"}
          </span>
          <span class="chip">
            {app.runMode === "form"
              ? "서버 미전송"
              : app.category === "utility"
                ? app.sendsDataOut
                  ? "단축만 외부 전송"
                  : "서버 미전송"
                : "브라우저에서 계산"}
          </span>
          {/* v9.5.0 — 본문 산식의 기준일과 층이 다르다. 페이지 기준선임을 단어로 밝힌다. */}
          <span class="chip mono">사이트 기준일 {site.baseDateLabel}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="scene-white">
    <!-- 모바일 하단 요약 바(약 76px + 안전영역)가 마지막 줄을 가리지 않도록 pb-28 이상을 둔다 -->
    <div class="wrap pb-28 pt-6 md:pb-10 md:pt-10">
      <div class="mx-auto max-w-[920px]" data-tool-input-area="true" data-nosnippet>
        <ToolRunner slug={app.slug} client:load />
      </div>

      {/*
        v9.1.0 P2 — 계산을 마친 뒤의 출구. 이 화면은 브레드크럼·소개 페이지 말고는 갈 곳이 없었다.
        트랙에 속한 도구는 '설명한 글 → 단계 안내·강의 → 다음 단계 도구', 트랙 밖 도구는 '다음 도구 → 도구 목록'.
        본문 흐름 안에 두어 모바일 하단 요약 바(.sticky-summary)와 겹치지 않는다.
        2026-11-27 — 동의서(runMode=form)는 '계산을 마쳤습니다' 출구가 맞지 않아 뺀다.
      */}
      {app.runMode !== "form" && (
        <div class="mx-auto max-w-[920px]">
          <RunExit slug={app.slug} name={app.name} />
        </div>
      )}

      <div class="mx-auto mt-6 grid max-w-[920px] gap-3 md:grid-cols-2">
        <div class="note-box">
          <p class="text-[12px] font-semibold text-ink">
            {app.runMode === "form" ? "동의서 기준·출처" : app.category === "utility" ? "동작 기준·출처" : "계산 기준·출처"}
          </p>
          <p class="mt-1.5">{app.sourceLine ?? `기준일 ${site.baseDateLabel}`}</p>
        </div>
        <div class="note-box">
          <p class="text-[12px] font-semibold text-ink">{app.category === "utility" ? "알아 둘 점" : "가정"}</p>
          <ul class="mt-1.5 space-y-1">
            {(app.assumptions ?? ["공개된 기준을 단순화해 계산합니다."]).map((a) => (
              <li>{a}</li>
            ))}
          </ul>
        </div>
      </div>

      <p class="tool-protect">
        {
          app.sendsDataOut
            ? "짧은 주소를 만들 때만 입력한 주소가 외부 단축 서비스(spoo.me)로 전송·저장됩니다. 고객 이름·연락처가 들어간 주소는 단축하지 마세요."
            : app.runMode === "form"
              ? "작성한 이름·연락처·서명은 서버로 전송되지 않고 브라우저 안에서만 처리됩니다. 확인증 파일은 내려받아 보관하고, 받은 진료자료는 확인 후 30일 안에 파기하세요."
              : app.category === "utility" && app.runMode === "calc"
              ? "입력한 값은 서버로 전송되지 않고 브라우저 안에서만 계산됩니다. 결과는 약관·증권·원문으로 한 번 더 확인해 주세요."
              : app.category === "utility"
                ? "올린 파일과 입력값은 서버로 전송되지 않고 브라우저 안에서만 처리됩니다. 결과 파일은 내려받아 보관해 주세요."
              : "이 결과는 참고용 모의계산입니다. 실제 조건은 약관·증권과 관계 기관의 최신 안내로 확인해 주세요."
        }
      </p>

      <p class="mx-auto mt-3 max-w-[920px] text-[12px] leading-relaxed text-ink-faint">
        설명과 계산 근거는
        <a href={withBase(`/apps/${app.slug}`)} class="mx-1 text-brand-deep link">{app.name} 소개 페이지</a>에 정리했습니다.
      </p>
    </div>
  </section>
</Base>
