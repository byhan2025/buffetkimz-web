---
/**
 * /academy/[slug] — 강의 상세 (v8.2.0).
 *
 * 강의 목록은 `data/academy.ts` 하나다(성인 7강 + 학교 트랙 5강).
 *   · 성인 실전 강의 → `components/academy/LessonView.astro`
 *   · 초등·청소년·첫 월급·가계 강의 → `components/academy/SchoolLessonView.astro`
 *     (본문 16px 이상·버튼 44px 이상·한 화면 한 질문 — 셋톡 교차검증 기준)
 * 주소는 강의 객체의 `slug`로만 만든다. v8.0의 `/academy/step2-pension-tax-limit/` 주소는 그대로 유지된다.
 */
import LessonView from "@/components/academy/LessonView.astro";
import SchoolLessonView from "@/components/academy/SchoolLessonView.astro";
import { ACADEMY_LESSONS } from "@/data/academy";

export function getStaticPaths() {
  return ACADEMY_LESSONS.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const isSchool = (lesson.track ?? "adult") !== "adult";
---

{isSchool ? <SchoolLessonView lesson={lesson} /> : <LessonView lesson={lesson} />}
