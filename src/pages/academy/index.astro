---
/**
 * /academy — 「버핏킴즈 금융생활학교」 통합 허브 (v8.2.0).
 *
 * ① 히어로 — 프로그램 한 줄 소개 + 숫자(6트랙 52주 · 성인 실전 6 STEP 41강 · 지금 열린 N강) + 첫 강의 버튼
 * ② 트랙 안내 — 초등 · 청소년 · 첫 월급 · 성인 실전 네 갈래를 먼저 보여 준다
 * ③ 지금 열린 강의 — 성인 5강 + 학교 트랙 3강을 카드로 펼친다(트랙 칩 포함)
 * ④ 52주 연재 로드맵 — 7트랙 52주를 탭으로 거르고, 지금 열린 주는 강의로 연결한다
 * ⑤ 성인 실전 6 STEP 로드맵 — 41강을 단계·질문·산출물로 편다
 * ⑥ 수강 경로 3가지 + 진단 3문항 — 성인 실전의 진입점
 * ⑦ 원칙·면책 — 특정 상품 비권유, 아동·청소년 개인정보 기준, 기준일
 *
 * 숫자(주차·강수·세트)는 `data/academy.ts`·`data/academy-school.ts`·`data/academy-lessons.ts`에서만 읽는다.
 * 52주와 41강은 합산하지 않는다 — 52주는 공개 연재, 41강은 성인 심화 후보다.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site } from "@/config/site";
import {
  ACADEMY,
  ACADEMY_SET,
  ACADEMY_STEPS,
  ACADEMY_PATHS,
  ACADEMY_DIAGNOSIS,
  OPEN_LESSONS,
  openLessonCount,
  TRACK_LABEL,
} from "@/data/academy";
import { SCHOOL_COUNTS, SCHOOL_TRACKS, SCHOOL_WEEKS, weeksOfTrack } from "@/data/academy-school";
import { breadcrumbList, graph, partOfWebsite } from "@/lib/schema";
import { availableCount } from "@/lib/card-assets";

const adultOpen = OPEN_LESSONS.filter((l) => (l.track ?? "adult") === "adult").length;
const schoolOpen = OPEN_LESSONS.length - adultOpen;

/** 트랙 안내 카드 — 첫 강의가 있으면 그 강의로 연결한다 */
const trackCards = [
  {
    id: "elementary",
    name: "초등 고학년",
    weeks: 8,
    line: "용돈·저축·물가",
    body: "7,000원을 세 칸으로 나누고, 목표까지 몇 주인지 계산합니다. 모든 금액은 가상입니다.",
    href: "/academy/school-elementary-allowance/",
    status: "1강 열림",
  },
  {
    id: "teen",
    name: "청소년",
    weeks: 8,
    line: "소액결제·BNPL·사기 방어",
    body: "월 5,000원을 1년으로 바꿔 보고, 송금 요청 앞에서 멈추는 순서를 익힙니다(112·1332).",
    href: "/academy/school-teen-payments/",
    status: "1강 열림",
  },
  {
    id: "firstpay",
    name: "첫 월급 · 사회초년생",
    weeks: 8,
    line: "명세서·비상금·첫해 운영표",
    body: "세전 300만 원에서 왜 33만 원이 빠지는지, 명세서 세 줄로 확인합니다.",
    href: "/academy/school-firstpay-stub/",
    status: `1강 열림`,
  },
  {
    id: "adult",
    name: "성인 실전",
    weeks: 41,
    line: "6 STEP · 41강 심화",
    body: "돈의 기초부터 1년 운영표까지. 지금 5강이 열려 있고, 12편을 우선 제작합니다.",
    href: "#roadmap",
    status: `${adultOpen}강 열림`,
  },
];

const jsonLd = graph([
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "금융생활학교", path: "/academy" },
  ]),
  {
    "@type": "Course",
    "@id": `${site.url}/academy/#course`,
    name: ACADEMY.name,
    description: ACADEMY.promise,
    inLanguage: "ko",
    isPartOf: partOfWebsite,
    provider: { "@id": `${site.url}/#organization` },
    hasCourseInstance: OPEN_LESSONS.map((l) => ({
      "@type": "CourseInstance",
      name: `${l.label} ${l.shortTitle}`,
      courseMode: "online",
      url: `${site.url}/academy/${l.slug}/`,
    })),
  },
]);
---

<Base
  title={`${ACADEMY.name} — 6트랙 52주 · 성인 실전 6 STEP 41강`}
  description={`${ACADEMY.name}는 초등 고학년·청소년·첫 월급·가계·자산형성·은퇴 6트랙 52주와 성인 실전 6 STEP 41강을 한곳에 모은 무료 금융교육입니다. 강의 1개는 5분 읽기, 카드뉴스 6장, 내 숫자 계산기, 1차 출처로 묶여 있습니다. 지금 ${openLessonCount}강이 열려 있습니다. 기준일 ${site.baseDateLabel}.`}
  path="/academy"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-6 md:py-10">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[16px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[28px]">홈</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">금융생활학교</span>
      </nav>

      <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end">
        <div class="max-w-[62ch]">
          <p class="eyebrow">{ACADEMY.tagline}</p>
          <h1 class="mt-2 text-[30px] font-bold leading-[1.22] tracking-[-0.042em] text-ink md:text-[44px]">
            {ACADEMY.name}
          </h1>
          <p class="mt-3 text-[15px] leading-[1.8] text-ink-soft">{ACADEMY.promise}</p>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            <li class="chip">{SCHOOL_COUNTS.tracks}트랙 · {SCHOOL_COUNTS.weeks}주</li>
            <li class="chip">성인 실전 {ACADEMY.counts.steps} STEP · {ACADEMY.counts.lessons}강</li>
            <li class="chip !border-brand/30 !bg-brand-soft !text-brand-deep">
              지금 열린 강의 {openLessonCount}개 (성인 {adultOpen} · 학교 {schoolOpen})
            </li>
            <li class="chip">카드뉴스 6장 단위</li>
            <li class="chip mono">기준일 {site.baseDateLabel}</li>
          </ul>

          <div class="mt-5 flex flex-wrap gap-2">
            <a href="#open" class="btn btn-primary min-h-[46px]">
              지금 열린 {openLessonCount}강 보기
              <span aria-hidden="true" class="ml-1.5">→</span>
            </a>
            <a href="#school-weeks" class="btn btn-secondary min-h-[46px]">52주 로드맵</a>
          </div>
        </div>

        <!-- 강의 1개의 표준 흐름 -->
        <div class="card p-5 md:p-6">
          <div class="flex items-baseline justify-between gap-3">
            <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">강의 1개 = 15분</p>
            <p class="mono text-[11.5px] text-ink-faint">읽기 5 + 실습 10</p>
          </div>
          <p class="mt-2 text-[15.5px] font-semibold leading-[1.6] tracking-[-0.02em] text-ink">
            카드로 먼저 보고, 읽고, 계산하고,<br />출처에서 확인합니다.
          </p>
          <ol class="academy-flow mt-4">
            {ACADEMY_SET.map((set) => (
              <li>
                <span class="academy-flow-no" aria-hidden="true">{set.no}</span>
                <span class="min-w-0">
                  <span class="block text-[13px] font-semibold text-ink">{set.title}</span>
                  <span class="mono block text-[11px] text-ink-faint">{set.minutes}</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="mt-4 border-t border-line-soft pt-3 text-[12px] leading-[1.65] text-ink-muted">
            초등·청소년 강의는 같은 흐름에 <strong class="font-semibold text-ink">한 화면 한 질문</strong> 3문항을
            더합니다. 본문 16px 이상, 버튼 44px 이상입니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ② 트랙 안내 -->
  <section class="scene-white border-b border-line" id="tracks">
    <div class="wrap py-10 md:py-12">
      <div class="sec-head">
        <div>
          <p class="eyebrow">트랙</p>
          <h2 class="sec-title">용돈부터 은퇴까지<br />네 갈래로 시작합니다</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            52주 연재는 6트랙 × 8편 + 특집 4편입니다. 성인 실전 41강은 그 위의 심화 과정이고,
            두 숫자는 합산하지 않습니다.
          </p>
        </div>
      </div>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          trackCards.map((t) => (
            <li class="card card-lift flex flex-col p-5">
              <div class="flex items-baseline justify-between gap-2">
                <p class="text-[11px] font-bold tracking-[0.14em] text-brand-deep">{t.name}</p>
                <span class="chip !min-h-[26px] !text-[12px]">{t.status}</span>
              </div>
              <p class="mono mt-2 text-[13.5px] font-semibold text-ink">{t.weeks}주 · {t.line}</p>
              <p class="mt-2 flex-1 text-[12.5px] leading-[1.7] text-ink-muted">{t.body}</p>
              <a href={withBase(t.href)} class="mt-3 inline-flex min-h-[44px] items-center text-[13px] font-bold text-brand-deep">
                열린 강의 보기 <span aria-hidden="true" class="ml-1">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ③ 지금 열린 강의 -->
  <section class="scene-sky-band border-b border-line" id="open">
    <div class="wrap py-10 md:py-14">
      <div class="sec-head">
        <div>
          <p class="eyebrow">지금 열린 강의</p>
          <h2 class="sec-title">성인 {adultOpen}강 · 학교 {schoolOpen}강<br />{openLessonCount}강이 열렸습니다</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            성인 실전 STEP 1·2의 다섯 강과, 초등·청소년·첫 월급의 첫 강입니다.<br />
            어떤 강의든 카드뉴스 6장 → 읽기 → 실습 → 운영표 1칸 순서로 끝납니다.
          </p>
        </div>
      </div>

      <ul class="academy-lessons mt-6">
        {
          OPEN_LESSONS.map((lesson) => {
            const track = lesson.track ?? "adult";
            return (
              <li class="academy-lesson" data-step={lesson.step} data-track={track}>
                <a href={withBase(`/academy/${lesson.slug}/`)} class="academy-lesson-link">
                  <span class="academy-lesson-head">
                    <span class="chip !min-h-[22px] !px-2 !text-[10.5px] !border-brand/30 !bg-brand-soft !text-brand-deep">
                      {TRACK_LABEL[track]} · {lesson.label}
                    </span>
                    <span class="academy-lesson-cards mono">
                      {availableCount(lesson.cardSet) > 0 ? `카드 ${availableCount(lesson.cardSet)}장` : "카드 준비 중"}
                    </span>
                  </span>
                  <span class="academy-lesson-title">{lesson.title}</span>
                  <span class="academy-lesson-hook">{lesson.hook}</span>
                  <span class="academy-lesson-nums">
                    {lesson.keyNumbers.map((k) => (
                      <span>
                        <span class="academy-lesson-num-label">{k.label}</span>
                        <span class="academy-lesson-num">{k.value}</span>
                      </span>
                    ))}
                  </span>
                  <span class="academy-lesson-go">
                    카드뉴스부터 보기 <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <p class="mt-4 text-[12.5px] leading-[1.7] text-ink-faint">
        초등·청소년 강의는 가상 금액만 쓰고, 입력값을 주소·저장소·서버에 남기지 않습니다. 세 트랙 3강은
        클라이언트 저장 없이 가상 금액으로만 연습합니다. 세 트랙 3강은 캡처에서 16px·44px 기준을 함께 확인했습니다.
      </p>
    </div>
  </section>

  <!-- ④ 52주 연재 로드맵 -->
  <section class="scene-cream border-b border-line" id="school-weeks">
    <div class="wrap py-10 md:py-14">
      <div class="sec-head">
        <div>
          <p class="eyebrow">52주 연재 로드맵</p>
          <h2 class="sec-title">6트랙 × 8편 + 특집 4편<br />{SCHOOL_COUNTS.weeks}주</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            초등 고학년 8 · 청소년 8 · 첫 월급 8 · 가계 8 · 자산형성 8 · 은퇴 8 · 특집 4입니다.<br />
            지금은 3트랙의 첫 강이 열려 있고, 나머지는 주 1편 순서로 준비합니다.
          </p>
        </div>
      </div>

      <div class="school-tabs-wrap mt-6">
        <div class="school-tabs" role="group" aria-label="52주 트랙 거르기">
          <button type="button" class="school-tab is-active" data-track-tab="all" aria-pressed="true">
            전체 <span class="mono">{SCHOOL_COUNTS.weeks}</span>
          </button>
          {
            SCHOOL_TRACKS.map((t) => (
              <button type="button" class="school-tab" data-track-tab={t.id} aria-pressed="false">
                {t.label} <span class="mono">{t.weeks}</span>
              </button>
            ))
          }
        </div>
        <p class="school-tabs-note" data-track-note aria-live="polite">
          전체 {SCHOOL_COUNTS.weeks}주를 보여 줍니다. 트랙을 고르면 그 트랙만 남습니다.
        </p>
      </div>

      <div class="school-blocks mt-5" data-school-blocks>
        {
          SCHOOL_TRACKS.map((t) => {
            const weeks = weeksOfTrack(t.id);
            return (
              <section class="school-block" data-track-block={t.id} aria-labelledby={`track-${t.id}`}>
                <div class="school-block-head">
                  <h3 id={`track-${t.id}`} class="text-[17px] font-bold tracking-[-0.02em] text-ink">
                    {t.label}
                  </h3>
                  <p class="text-[12.5px] text-ink-muted">{t.blurb}</p>
                  <span class="chip !min-h-[24px] !text-[11.5px]">{t.weeks}주</span>
                </div>
                <ol class="school-weeks">
                  {weeks.map((w) => (
                    <li class="school-week" data-week={w.id}>
                      <div class="school-week-top">
                        <span class="mono school-week-no">{w.week}주</span>
                        <span class="mono text-[10.5px] text-ink-faint">{w.id}</span>
                        {w.lessonSlug ? (
                          <span class="school-week-open">지금 열림</span>
                        ) : (
                          <span class="school-week-soon">연재 예정</span>
                        )}
                      </div>
                      <p class="school-week-title">{w.title}</p>
                      <p class="school-week-goal">{w.goal}</p>
                      <p class="school-week-take">
                        <span class="font-semibold text-ink-soft">가져갈 것</span> {w.takeaway}
                      </p>
                      {w.lessonSlug ? (
                        <a href={withBase(`/academy/${w.lessonSlug}/`)} class="school-week-link">
                          이 주의 강의 보기 <span aria-hidden="true">→</span>
                        </a>
                      ) : (
                        <p class="school-week-practice">실습 · {w.practice}</p>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            );
          })
        }
      </div>

      <div class="note-box mt-6">
        <p class="text-[12px] font-semibold text-ink">공개 리듬과 검수</p>
        <p class="mt-1.5 text-[12.5px] leading-[1.75] text-ink-muted">
          성인 파일럿으로 공통 형식을 확인한 뒤 첫 용돈 편부터 주 1편(월요일 오전) 공개를 제안합니다. 공개 전
          사실·효력일·조건·단위·계산·접근성·권리 검수를 거치고, 필수 결함이 하나라도 남으면 공개를 보류합니다.
          52주·41강·우선 12편은 서로 다른 목록이므로 하나의 숫자로 합산하지 않습니다. 측정은 실습 완료율·다음 편 이동률·같은 세션 전후 문제 차이로 하고, 초등·청소년에게 지속 식별자나 실제 재무 데이터는 만들지 않습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ⑤ 성인 실전 6 STEP 로드맵 -->
  <section class="scene-white border-b border-line" id="roadmap">
    <div class="wrap py-10 md:py-14">
      <div class="sec-head">
        <div>
          <p class="eyebrow">성인 실전 심화</p>
          <h2 class="sec-title">{ACADEMY.counts.steps} STEP · {ACADEMY.counts.lessons}강</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            개념(1) → 계좌(2) → 배분(3) → 수령(4) → 보장(5) → 운영(6) 순서입니다.<br />
            각 STEP은 질문 하나로 시작하고, 산출물 한 장으로 끝납니다.
          </p>
        </div>
      </div>

      <ol class="academy-steps mt-6">
        {
          ACADEMY_STEPS.map((step) => {
            const open = step.status === "open";
            const lessons = OPEN_LESSONS.filter((l) => (l.track ?? "adult") === "adult" && l.step === step.no);
            return (
              <li class="academy-step" data-open={open ? "true" : "false"} id={`step-${step.no}`}>
                <div class="academy-step-no" aria-hidden="true">
                  <span class="mono">STEP</span>
                  <strong>{step.no}</strong>
                </div>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <h3 class="text-[17px] font-bold tracking-[-0.03em] text-ink">{step.name}</h3>
                    <span class={open ? "academy-status is-open" : "academy-status"}>
                      {open ? `공개 ${step.opened}강` : "준비중"}
                    </span>
                  </div>
                  <p class="mt-1 text-[13.5px] leading-[1.65] text-ink-muted">{step.question}</p>
                  <dl class="academy-step-meta">
                    <div>
                      <dt>강의</dt>
                      <dd>{step.lessons}강</dd>
                    </div>
                    <div>
                      <dt>카드 세트</dt>
                      <dd>{step.cards}</dd>
                    </div>
                    <div>
                      <dt>학습 시간</dt>
                      <dd>{step.time}</dd>
                    </div>
                  </dl>
                  <p class="mt-2 text-[12px] leading-[1.6] text-ink-faint">
                    <span class="font-semibold text-ink-soft">수료 기준</span> {step.deliverable}
                  </p>
                  {open && (
                    <ul class="academy-step-lessons">
                      {lessons.map((lesson) => (
                        <li>
