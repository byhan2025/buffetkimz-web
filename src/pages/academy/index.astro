<script>
  /**
   * 52주 트랙 거르기 — 화면 안에서만 동작한다. 고른 트랙을 주소나 저장소에 남기지 않는다.
   * 자바스크립트가 없으면 7트랙이 모두 보인다.
   */
  const tabs = [...document.querySelectorAll<HTMLElement>("[data-track-tab]")];
  const blocks = [...document.querySelectorAll<HTMLElement>("[data-track-block]")];
  const note = document.querySelector<HTMLElement>("[data-track-note]");

  const pick = (id: string) => {
    tabs.forEach((t) => {
      const on = t.dataset.trackTab === id;
      t.classList.toggle("is-active", on);
      t.setAttribute("aria-pressed", on ? "true" : "false");
    });
    const shown = blocks.filter((b) => id === "all" || b.dataset.trackBlock === id);
    blocks.forEach((b) => {
      b.hidden = !shown.includes(b);
    });
    const weeks = shown.reduce((n, b) => n + b.querySelectorAll("[data-week]").length, 0);
    if (note) {
      note.textContent =
        id === "all"
          ? `전체 ${weeks}주를 보여 줍니다. 트랙을 고르면 그 트랙만 남습니다.`
          : `${shown[0]?.querySelector("h3")?.textContent?.trim() ?? ""} ${weeks}주만 보여 줍니다.`;
    }
  };

  tabs.forEach((t) => t.addEventListener("click", () => pick(t.dataset.trackTab ?? "all")));

  /**
   * 진단 3문항 — 체크 개수만 센다. 입력값을 어디에도 저장하지 않는다.
   * 0~1개 입문 / 2개 자산가·은퇴 / 3개 6단계 전체.
   */
  const diagnosis = document.querySelector<HTMLElement>("[data-diagnosis]");
  if (diagnosis) {
    const checks = [...diagnosis.querySelectorAll<HTMLInputElement>("[data-diagnosis-check]")];
    const countEl = diagnosis.querySelector<HTMLElement>("[data-diagnosis-count]");
    const answers = [...diagnosis.querySelectorAll<HTMLElement>("[data-diagnosis-answer]")];
    const render = () => {
      const n = checks.filter((c) => c.checked).length;
      if (countEl) countEl.textContent = `${n}개 체크`;
      const key = n === 0 ? "none" : n === 1 ? "starter" : n === 2 ? "builder" : "all";
      answers.forEach((a) => (a.hidden = a.dataset.diagnosisAnswer !== key));
    };
    checks.forEach((c) => c.addEventListener("change", render));
    render();
  }
</script>

