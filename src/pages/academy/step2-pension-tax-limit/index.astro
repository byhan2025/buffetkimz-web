---
/**
 * /academy/step2-pension-tax-limit — 「한스푼 아카데미」 파일럿 1강 (2-3강).
 *
 * ① 조건별 손익 반전 훅 — 같은 월 30만원이 전세 자금 여부로 갈리는 두 갈래
 * ② 5분 한스푼 읽기 — 원고는 data/academy.ts의 PILOT_READING(1,200~1,500자)
 * ③ 내 숫자 계산기 실습 — 시나리오 3개. 계산기 주소에는 아무 값도 붙이지 않는다
 * ④ 자료앨범 3D 카드 + 1차 출처 + 면책
 * ⑤ STEP 완료 체크 — 내 돈 운영표 1칸(로컬 상태, 저장 없음)
 *
 * 원칙: 특정 상품 비권유 · 모든 숫자는 tax-rules 상수에서 · 외부 채널·영상 이름 0.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import SheetSlot from "@/components/academy/SheetSlot.astro";
import { withBase, site } from "@/config/site";
import {
  ACADEMY,
  ACADEMY_STEPS,
  PILOT,
  PILOT_READING,
  READING_CHARS,
  stepByNo,
} from "@/data/academy";
import { breadcrumbList, graph, partOfWebsite } from "@/lib/schema";

const step = stepByNo(PILOT.step)!;
const path = `/academy/${PILOT.slug}`;
const N = PILOT.numbers;

/** 원고 분량이 규격(1,200~1,500자)을 벗어나면 빌드에서 바로 알린다. */
if (READING_CHARS < 1200 || READING_CHARS > 1500) {
  throw new Error(
    `2-3강 원고가 ${READING_CHARS}자입니다. 규격은 1,200~1,500자(공백 제외)입니다 — PILOT_READING을 고치세요.`,
  );
}

const sections = [
  { id: "read", no: "②", label: "5분 한스푼 읽기", note: `${READING_CHARS.toLocaleString("ko-KR")}자` },
  { id: "calc", no: "③", label: "계산기 실습", note: "10분" },
  { id: "cards", no: "④", label: "3D 카드 · 1차 출처", note: "5분" },
  { id: "sheet", no: "⑤", label: "내 돈 운영표 1칸", note: "STEP 완료" },
];

const jsonLd = graph([
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "아카데미", path: "/academy" },
    { name: `STEP ${step.no} ${step.name}`, path: "/academy" },
    { name: `${PILOT.label} ${PILOT.shortTitle}`, path },
  ]),
  {
    "@type": "LearningResource",
    "@id": `${site.url}${path}/#lesson`,
    name: PILOT.title,
    description: PILOT.hook,
    inLanguage: "ko",
    learningResourceType: "강의",
    educationalLevel: "입문",
    timeRequired: "PT15M",
    isPartOf: { "@id": `${site.url}/academy/#course` },
    provider: { "@id": `${site.url}/#organization` },
    dateModified: site.baseDate,
    teaches: [
      "연금저축·IRP 세액공제 한도 900만원",
      "총급여 구간별 공제율 16.5%·13.2%",
      "연금수령과 중도해지의 세율 차이",
    ],
  },
]);
---

<Base
  title={`${PILOT.label} ${PILOT.shortTitle} — 세액공제 148만 5,000원의 구조 | ${ACADEMY.name}`}
  description={`연금저축 600만원과 IRP 300만원, 합산 900만원의 세액공제가 어떻게 148만 5,000원이 되는지 5분 읽기로 정리합니다. 총급여 구간별 공제율, 연금수령과 중도해지의 차이, 내 숫자 계산기까지. 기준일 ${site.baseDateLabel}.`}
  path={path}
  type="article"
  publishedTime={site.baseDate}
  jsonLd={jsonLd}
>
  <!-- 히어로 + ① 조건별 손익 반전 훅 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-6 md:py-9">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/academy")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">
          아카데미
        </a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/academy/#roadmap")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">
          STEP {step.no} {step.name}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">{PILOT.label}</span>
      </nav>

      <div class="mt-4 max-w-[68ch]">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="chip !border-brand/30 !bg-brand-soft !text-brand-deep">STEP {step.no} · {PILOT.label}</span>
          <span class="chip">5분 읽기</span>
          <span class="chip">계산기 실습</span>
          <span class="chip">카드 6장</span>
          <span class="chip mono">기준일 {site.baseDateLabel}</span>
        </div>
        <h1 class="mt-3 text-[26px] font-bold leading-[1.3] tracking-[-0.042em] text-ink md:text-[36px]">
          {PILOT.title}
        </h1>
        <p class="mt-2 text-[14.5px] leading-[1.75] text-ink-soft">
          STEP {step.no} 「{step.name}」의 첫 강의입니다. 넣을 때·굴릴 때·꺼낼 때, 세 순간의 세금을 한 번에
          정리하고 내 숫자로 확인합니다.
        </p>
      </div>

      <!-- ① 훅 — 조건이 바뀌면 결론이 뒤집힌다 -->
      <div class="hook mt-5" data-hook>
        <p class="hook-lead">{PILOT.hook}</p>
        <div class="hook-grid">
          <div class="hook-side is-short">
            <p class="hook-tag">2년 안에 쓸 돈</p>
            <h2 class="hook-head">{PILOT.fork.short.head}</h2>
            <p class="hook-body">{PILOT.fork.short.body}</p>
            <p class="hook-verdict">{PILOT.fork.short.verdict}</p>
          </div>
          <div class="hook-side is-long">
            <p class="hook-tag">5년 넘게 묶어 둘 돈</p>
            <h2 class="hook-head">{PILOT.fork.long.head}</h2>
            <p class="hook-body">{PILOT.fork.long.body}</p>
            <p class="hook-verdict">{PILOT.fork.long.verdict}</p>
          </div>
        </div>
        <p class="hook-foot">
          월 30만원이면 1년에 360만원입니다. 연금저축 360만원 + IRP 300만원 = 660만원 →
          <strong class="font-semibold text-ink"> {N.monthly30Label}</strong>이 돌아옵니다. 같은 돈이라도 어느
          계좌에 두느냐가 결말을 바꿉니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 본문 -->
  <section class="scene-white">
    <div class="wrap py-9 md:py-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_286px] lg:gap-14">
        <div class="min-w-0">
          <!-- ② 5분 읽기 -->
          <div id="read" class="scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="flex flex-wrap items-end justify-between gap-2 border-b border-line pb-3">
              <div>
                <p class="eyebrow">② 5분 한스푼 읽기</p>
                <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                  한 편으로 끝내는 세액공제 구조
                </h2>
              </div>
              <p class="mono text-[11.5px] text-ink-faint">
                {READING_CHARS.toLocaleString("ko-KR")}자 (공백 제외) · 약 {PILOT.readingMinutes}분
              </p>
            </div>

            <p class="read-question mt-4">
              연금저축 {N.savingsLimit}, IRP {N.combinedLimit}. 두 숫자는 왜 따로 있을까요?
            </p>

            <div class="conclusion mt-4">
              <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">결론</p>
              <p class="mt-1.5 text-[15.5px] font-semibold leading-[1.7] tracking-[-0.012em] text-ink">
                두 계좌를 합쳐 {N.combinedLimit}까지 넣으면, 총급여 5,500만원 이하인 사람은 세금에서 최대{" "}
                {N.maxCreditLabel}이 줄어듭니다.
              </p>
              <p class="mt-2 border-t border-line/70 pt-2 text-[13px] leading-[1.7] text-ink-muted">
                <span class="font-semibold text-ink-soft">내 계약·재무와 대조</span> 내 총급여 구간과 올해
                연금계좌 납입액을 먼저 확인해 보세요.
              </p>
            </div>

            <div class="prose-article mt-6">
              {
                PILOT_READING.map((sec) => (
                  <>
                    <h2>{sec.h}</h2>
                    {sec.ps.map((p) => (
                      <p>{p}</p>
                    ))}
                  </>
                ))
              }
            </div>

            <p class="mt-6 rounded-xl border border-line bg-paper px-4 py-3 text-[12.5px] leading-[1.7] text-ink-muted">
              읽는 데 걸리는 시간은 5분입니다. 여기까지 읽었으면 아래 계산기에서 같은 숫자를 내 조건으로 한 번만
              바꿔 보세요. 세액공제는 읽는 것보다 직접 넣어 볼 때 남습니다.
            </p>
          </div>

          <!-- ③ 계산기 실습 -->
          <div id="calc" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="border-b border-line pb-3">
              <p class="eyebrow">③ 내 숫자 계산기 실습</p>
              <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                같은 900만원, 세 번 넣어 보기
              </h2>
              <p class="mt-2 text-[13px] leading-[1.7] text-ink-muted">
                아래 세 가지를 계산기에 그대로 넣어 보세요. 10분이면 공제액이 계단처럼 오르는 것을 눈으로 확인할
                수 있습니다.
              </p>
            </div>

            <ul class="mt-4 grid gap-3">
              {
                PILOT.scenarios.map((sc, i) => (
                  <li class="card card-lift p-4 md:p-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <p class="text-[11px] font-bold tracking-[0.14em] text-brand-deep">
                        시나리오 {String.fromCharCode(65 + i)} · {sc.label}
                      </p>
                      <p class="mono text-[12px] font-semibold text-ink-soft">{sc.result}</p>
                    </div>
                    <h3 class="mt-1.5 text-[15px] font-bold leading-snug tracking-[-0.025em] text-ink">
                      {sc.title}
                    </h3>
                    <ul class="scenario-settings mt-2">
                      {sc.settings.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                    <p class="mt-2 text-[12px] leading-[1.65] text-ink-faint">{sc.expect}</p>
                    <a
                      href={withBase("/apps/pension-tax/run")}
                      class="btn btn-secondary btn-sm mt-3 inline-flex min-h-[44px] items-center"
                    >
                      계산기에서 이 값으로 확인
                      <span aria-hidden="true" class="ml-1.5">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-3 grid gap-2 md:grid-cols-2">
              <div class="note-box">
                <p class="text-[12px] font-semibold text-ink">버튼이 값을 넘기지 않는 이유</p>
                <p class="mt-1">
                  이 페이지의 버튼은 계산기만 엽니다. 소득·납입액 같은 내 숫자는 주소(URL)에 붙이지 않습니다.
                  주소에 남은 숫자는 기록·공유·방문 로그에 그대로 따라다니기 때문입니다.
                </p>
              </div>
              <div class="note-box">
                <p class="text-[12px] font-semibold text-ink">함께 보면 좋은 도구</p>
                <p class="mt-1">
                  같은 돈을 일반계좌·ISA·연금저축·IRP에 넣었을 때 세후로 얼마가 남는지 비교하는 계산기입니다.
                </p>
                <p class="mt-2">
                  <a
                    href={withBase("/apps/account-tax-compare/run")}
                    class="link font-semibold text-ink-soft"
                  >
                    4대 계좌 세후 비교 열기
                  </a>
                </p>
              </div>
            </div>
          </div>

          <!-- ④ 3D 카드 + 1차 출처 -->
          <div id="cards" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="border-b border-line pb-3">
              <p class="eyebrow">④ 자료앨범 3D 카드 · 1차 출처</p>
              <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                손에 쥐는 6장과, 직접 열어볼 원문
              </h2>
            </div>

            <a
              href={withBase(PILOT.cardSet.href)}
              class="card card-lift card-set mt-4"
            >
              <span class="card-set-thumb" aria-hidden="true">
                <span class="mono">3D 카드</span>
                <strong>6</strong>
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-bold tracking-[0.14em] text-brand-deep">자료앨범 세트</span>
                <span class="mt-0.5 block text-[15.5px] font-bold tracking-[-0.025em] text-ink">
                  {PILOT.cardSet.title}
                </span>
                <span class="mt-0.5 block text-[12.5px] text-ink-muted">{PILOT.cardSet.meta}</span>
                <span class="mt-1 block text-[11.5px] text-ink-faint">
                  카드를 누르면 크게 보고, 장마다·세트 전체를 내려받을 수 있습니다.
                </span>
              </span>
              <span class="btn btn-secondary btn-sm card-set-btn">카드 6장 보기 →</span>
            </a>

            <div class="mt-5">
              <p class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">1차 출처 — 내가 직접 확인하는 원문</p>
              <ul class="source-list mt-2">
                {
                  PILOT.sources.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-row">
                        <span class="min-w-0">
                          <span class="block text-[13.5px] font-semibold leading-snug text-ink">{s.label}</span>
                          <span class="mt-0.5 block text-[12px] leading-[1.6] text-ink-muted">{s.what}</span>
                        </span>
                        <span class="source-host mono">{s.host} ↗</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-2 text-[11.5px] leading-[1.6] text-ink-faint">
                확인한 조문과 안내만 적었습니다. 링크는 기관 사이트에서 직접 열립니다. 기준일 {site.baseDateLabel}.
              </p>
            </div>

            <p class="disclaimer mt-4">
              <strong class="font-semibold text-ink">{PILOT.disclaimer}</strong> 이 글과 카드는 제도와 계산 구조를
              설명하는 학습 자료입니다. 가입·전환을 권하지 않으며, 보험은 재무설계의 도구로만 다룹니다.{" "}
              <a href={withBase("/principles")} class="link font-semibold text-ink-soft">편집 원칙 보기</a>
            </p>
          </div>

          <!-- ⑤ STEP 완료 체크 -->
          <div id="sheet" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <SheetSlot />
          </div>

          <!-- 다음 강 -->
          <div class="mt-10 rounded-2xl border border-line bg-paper-deep/55 p-5 md:p-6">
            <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">{PILOT.next.label}</p>
            <div class="mt-1 flex flex-wrap items-baseline gap-2">
              <p class="text-[17px] font-bold tracking-[-0.03em] text-ink">{PILOT.next.title}</p>
              <span class="chip !min-h-[24px] !text-[11px]">{PILOT.next.status}</span>
            </div>
            <p class="mt-1.5 text-[13px] leading-[1.7] text-ink-muted">{PILOT.next.body}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={withBase("/academy/#roadmap")} class="btn btn-secondary btn-sm min-h-[44px]">
                아카데미 로드맵으로
              </a>
              <a href={withBase("/apps/pension-tax/run")} class="btn btn-tertiary btn-sm min-h-[44px]">
                계산기 다시 열기
              </a>
            </div>
          </div>

          <p class="mt-8 border-t border-line pt-4 text-[12px] leading-[1.7] text-ink-faint">
            {ACADEMY.name} · STEP {step.no} 「{step.name}」 {PILOT.label} · 기준일 {site.baseDateLabel} · 숫자는
            제도 변경에 따라 달라질 수 있습니다.
          </p>
        </div>

        <!-- 사이드 -->
        <aside class="min-w-0 lg:sticky lg:top-[calc(var(--header-h)+16px)] lg:self-start">
          <div class="card p-4 md:p-5">
            <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">이 강의</p>
            <dl class="lecture-meta mt-2">
              <div>
                <dt>STEP</dt>
                <dd>{step.no} · {step.name}</dd>
              </div>
              <div>
                <dt>회차</dt>
                <dd>{PILOT.label}</dd>
              </div>
              <div>
                <dt>분량</dt>
                <dd>5분 읽기 · 10분 계산</dd>
              </div>
              <div>
                <dt>계산기</dt>
                <dd>연금저축·IRP 세액공제</dd>
              </div>
              <div>
                <dt>카드</dt>
                <dd>3D 6장 (B 세트)</dd>
              </div>
            </dl>
            <a
              href={withBase("/apps/pension-tax/run")}
              class="btn btn-primary btn-sm mt-3 inline-flex min-h-[44px] w-full items-center justify-center"
            >
              계산기 열기
            </a>
          </div>

          <nav class="card mt-3 p-4 md:p-5" aria-label="이 페이지 목차">
            <p class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">이 페이지</p>
            <ul class="toc-list mt-2">
              {
                sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>
                      <span class="mono text-[11px] text-ink-faint" aria-hidden="true">{s.no}</span>
                      <span class="flex-1 text-[13px] font-semibold text-ink-soft">{s.label}</span>
                      <span class="mono text-[11px] text-ink-faint">{s.note}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="card mt-3 p-4 md:p-5">
            <p class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">가정과 한계</p>
            <ul class="mt-2 space-y-1.5 text-[12px] leading-[1.65] text-ink-muted">
              <li>· 금액은 한도 기준의 예상 세액공제입니다. 실제 환급액은 그해 결정세액을 넘지 않습니다.</li>
              <li>· ISA 만기 이전 10%·최대 300만원 추가 한도는 이 글의 계산에 넣지 않았습니다.</li>
              <li>· 연금수령 요건(55세·5년 이상)을 채웠다고 보고 계산했습니다.</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .hook {
