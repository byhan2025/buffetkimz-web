---
/**
 * /academy/track/{id} — 트랙 첫 화면 (v9.1.0 P2 신설).
 *
 * 설계: reports/buffetkimz-web/learning-blueprint-v1-20261123.md §2-2·§7 P2
 *
 * 왜 필요한가
 *  · 단계 화면(`/academy/track/{id}/{no}`)만 있으면 들어오는 문이 브레드크럼뿐이다. 이 화면이 문이다 —
 *    아카데미 허브의 트랙 밴드와 글·강의의 하단 독이 모두 여기로 온다.
 *  · 여기서 3단계를 한눈에 세우고, 1단계로 들어가면 나머지는 단계 페이지의 진행선과 하단 독이 이어 준다.
 *  · 단계 목록은 `data/tracks.ts`의 순서를 그대로 쓰고, 각 단계의 글 수·도구 이름은 `lib/track-view.ts`가 해석한다.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site, absolute } from "@/config/site";
import { TRACKS, type Track } from "@/data/tracks";
import { ACADEMY } from "@/data/academy";
import { trackHref, trackView } from "@/lib/track-view";
import { breadcrumbList, graph } from "@/lib/schema";

export function getStaticPaths() {
  return TRACKS.filter((track) => track.status === "live").map((track) => ({
    params: { id: track.id },
    props: { track },
  }));
}

interface Props {
  track: Track;
}

const { track } = Astro.props;
const stages = await trackView(track);
const path = trackHref(track);
const first = stages[0];
const postCount = new Set(track.stages.flatMap((stage) => stage.posts)).size;
const toolCount = new Set(track.stages.map((stage) => stage.tool)).size;
const cardCount = new Set(track.stages.map((stage) => stage.card)).size;

const jsonLd = graph([
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "금융생활학교", path: "/academy" },
    { name: `${track.name} 트랙`, path },
  ]),
  {
    "@type": "Course",
    "@id": `${absolute(path)}#track`,
    name: `${track.name} 3단계 트랙`,
    description: track.promise,
    inLanguage: "ko",
    isPartOf: { "@id": `${site.url}/academy/#course` },
    provider: { "@id": `${site.url}/#organization` },
    hasCourseInstance: stages.map((stage) => ({
      "@type": "CourseInstance",
      name: `${stage.stage.no}단계 ${stage.stage.name}`,
      courseMode: "online",
      url: absolute(stage.href),
    })),
  },
]);
---

<Base
  title={`${track.name} 3단계 트랙 — ${ACADEMY.name}`}
  description={`${track.name}을 1→2→3단계로 완주하는 트랙입니다. ${track.promise}. 글 ${postCount}편과 계산기 ${toolCount}개, 카드 ${cardCount}세트로 이어집니다. 기준일 ${site.baseDateLabel}`}
  path={path}
  type="website"
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-6 md:py-10">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/academy")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">
          아카데미
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">{track.name} 트랙</span>
      </nav>

      <div class="mt-4 max-w-[66ch]">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="chip !border-brand/30 !bg-brand-soft !text-brand-deep">{track.name} · 3단계 트랙</span>
          <span class="chip">글 {postCount}편</span>
          <span class="chip">계산기 {toolCount}개</span>
          <span class="chip">카드 {cardCount}세트</span>
          <span class="chip mono">기준일 {site.baseDateLabel}</span>
        </div>
        <h1 class="mt-3 text-[28px] font-bold leading-[1.28] tracking-[-0.042em] text-ink md:text-[40px]">
          {track.name}, 세 단계로 완주합니다
        </h1>
        <p class="mt-2 text-[15px] leading-[1.8] text-ink-soft">
          진단 → 갈림길 → 방어. 각 단계는 <strong class="font-semibold text-ink">글 · 계산기 1개 · 카드 1세트 · 강의 1개</strong>로
          짜여 있습니다. 1단계를 끝내면 다음 단계로 넘어가는 질문이 남고, 그 질문이 다음 단계의 첫 화면입니다.
        </p>
        <p class="mt-3 rounded-xl border border-line bg-surface px-4 py-3 text-[13px] leading-[1.7] text-ink-muted">
          <span class="font-semibold text-ink">완주하면 남는 것</span> — {track.promise}
        </p>
        {first && (
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={withBase(first.href)} class="btn btn-primary min-h-[46px]">
              1단계 「{first.stage.name}」부터 시작
              <span aria-hidden="true" class="ml-1.5">→</span>
            </a>
            <a href={withBase("/academy#roadmap")} class="btn btn-secondary min-h-[46px]">다른 학습 경로 보기</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="scene-white">
    <div class="wrap py-9 md:py-14">
      <div class="sec-head">
        <div>
          <p class="eyebrow">3단계</p>
          <h2 class="sec-title">순서대로 한 단계씩</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            단계를 건너뛰어도 되지만, 1단계의 '내 숫자' 없이 2단계 비교를 열면 결과가 무엇을 뜻하는지 모르는 채
            끝납니다.
          </p>
        </div>
      </div>

      <ol class="track-stages mt-6">
        {
          stages.map((stage) => (
            <li class="track-stage" data-track-stage-card={stage.stage.no}>
              <div class="track-stage-head">
                <span class="track-stage-no mono">{stage.stage.no}</span>
                <div class="min-w-0">
                  <h3 class="track-stage-name">{stage.stage.name}</h3>
                  <p class="track-stage-q">{stage.stage.question}</p>
                </div>
              </div>

              <dl class="track-stage-meta">
                <div>
                  <dt>글</dt>
                  <dd>{stage.posts.length}편</dd>
                </div>
                <div>
                  <dt>계산기</dt>
                  <dd>{stage.tool?.name ?? "—"}</dd>
                </div>
                <div>
                  <dt>카드</dt>
                  <dd>{stage.card ? `${stage.card.title} ${stage.card.count}장` : "—"}</dd>
                </div>
                <div>
                  <dt>강의</dt>
                  <dd>{stage.lesson ? `${stage.lesson.label} ${stage.lesson.title}` : "—"}</dd>
                </div>
              </dl>

              <a class="track-stage-go" href={withBase(stage.href)}>
                {stage.stage.no}단계 열기 <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="note-box mt-6">
        <p class="text-[12px] font-semibold text-ink">이 트랙을 읽는 규칙</p>
        <p class="mt-1.5 text-[12.5px] leading-[1.75] text-ink-muted">
          모든 숫자에 조문·기관과 기준일을 붙였습니다. 계산기는 입력값을 서버로 보내지 않고 브라우저 안에서만
          계산합니다. 카드와 계산기 숫자가 다르면 카드를 다시 만드는 것이 원칙입니다. 특정 상품은 권하지 않습니다.
          {" "}
          <a href={withBase("/principles")} class="link font-semibold text-ink-soft">편집 원칙 보기</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .track-stages {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 900px) {
    .track-stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .track-stage {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background-color: #ffffff;
    box-shadow: 0 16px 32px -30px rgb(18 51 184 / 0.5);
  }

  .track-stage-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .track-stage-no {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 999px;
    background-color: var(--color-brand);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }

  .track-stage-name {
    font-size: 16.5px;
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--color-ink);
  }

  .track-stage-q {
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .track-stage-meta {
    display: grid;
    gap: 3px;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: var(--color-paper);
  }

  .track-stage-meta > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .track-stage-meta dt {
    flex: none;
    width: 40px;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-ink-faint);
  }

  .track-stage-meta dd {
    min-width: 0;
    margin: 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .track-stage-go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    margin-top: auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-brand-deep);
    text-decoration: none;
  }

  .track-stage-go:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
