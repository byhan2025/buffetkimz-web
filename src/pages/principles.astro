---
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site } from "@/config/site";
import { breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

const path = "/principles";

const principles = [
  {
    no: "01",
    title: "1차 출처를 먼저 보고, 가정은 따로 표시합니다",
    lead: "기사 요약이 아니라 원문을 봅니다.",
    body: [
      "금융위원회·금융감독원·국세청·한국은행·통계청·공단의 보도자료와 고시, 법령 원문을 먼저 확인합니다. 2차 보도는 수치가 원문과 맞는지 대조하는 데만 씁니다.",
      "원문에 없는 계산은 ‘가정’이라고 적고, 가정이 들어간 결과는 결과 옆에 함께 남깁니다. 확인한 사실과 내가 계산한 값을 한 문단에 섞지 않습니다.",
    ],
  },
  {
    no: "02",
    title: "글마다 기준일을 상단에 고정합니다",
    lead: "언제 확인한 기록인지가 본문보다 먼저 보여야 합니다.",
    body: [
      "모든 글의 제목 아래에 ‘기준일’과 ‘1차 출처’를 고정해 둡니다. 제도와 약관은 바뀌므로, 기준일이 없는 설명은 읽는 사람이 어느 시점의 사실인지 판단할 수 없습니다.",
      "기준일이 오래된 글은 목록과 본문에서 그 사실을 숨기지 않습니다. 새 사실이 확인되면 글을 고치고 기준일을 올립니다.",
    ],
  },
  {
    no: "03",
    title: "상품보다 구조를 먼저 설명합니다",
    lead: "1:1 상담문의는 내 숫자와 조건을 함께 놓고 확인하는 자리입니다.",
    body: [
      "세제·현금흐름·보장을 한자리에 놓고, 어느 한 축만 크게 보여 주는 설명은 하지 않습니다. 결론보다 그 결론이 서 있는 가정과 기준을 먼저 적습니다.",
      "도구는 입력값을 그 탭 안에서만 계산합니다. 결과는 판정이 아니라, 약관과 증권에서 더 확인할 항목입니다.",
    ],
  },
  {
    no: "04",
    title: "약관과 심사의 한계를 먼저 적습니다",
    lead: "지급 여부는 약관과 심사가 정합니다.",
    body: [
      "보험 글은 ‘가입하면 받는다’는 식으로 쓰지 않습니다. 지급 조건, 감액 기간, 면책 사항, 인수·심사회사의 판단이 남아 있다는 점을 본문에 적습니다.",
      "도구의 기준점은 공개 약관과 감독 자료를 참고한 내부 예시이며, 공식 기준이나 판정 결과가 아닙니다.",
    ],
  },
  {
    no: "05",
    title: "세제·현금흐름·보장을 함께 놓고 봅니다",
    lead: "한 축만 보면 답이 반대로 나옵니다.",
    body: [
      "절세만 보면 현금흐름이 막히고, 보장만 보면 납입이 버거워집니다. AFPK 재무설계의 관점에서 세제 혜택, 매달의 현금흐름, 보장의 빈 칸을 함께 놓고 설명합니다.",
      "계산 도구도 한 가지 숫자만 크게 보여 주지 않고, 전제와 결과를 나란히 두어 어느 가정에서 답이 달라지는지 보이게 합니다.",
    ],
  },
  {
    no: "06",
    title: "틀린 것은 고치고, 고친 기록을 남깁니다",
    lead: "정정은 조용히 하지 않습니다.",
    body: [
      "숫자나 문장이 틀렸다는 것이 확인되면 본문을 고치고, 글 아래에 무엇을 언제 고쳤는지 적습니다. 출처가 바뀌면 기준일과 출처 목록도 함께 갱신합니다.",
      "자동화로 만든 초안은 그대로 내보내지 않습니다. 숫자와 문장을 사람이 다시 읽고, 확인하지 못한 값은 ‘검증 불가’로 남깁니다.",
    ],
  },
];

const jsonLd = graph([
  {
    "@type": "WebPage",
    "@id": `${pageUrl(path)}#webpage`,
    name: "편집 원칙",
    description: "buffetkimz가 글을 쓰고 숫자를 확인하는 여섯 가지 기준.",
    url: pageUrl(path),
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "편집 원칙", path },
  ]),
]);
---

<Base
  title="편집 원칙 — 확인한 것과 계산한 것을 나눠 적는 기준"
  description="1차 출처 우선, 기준일 고정, 상품보다 구조, 약관·심사 한계 명시, 세제·현금흐름·보장의 균형, 정정과 업데이트. buffetkimz가 글과 도구를 만들 때 지키는 여섯 가지 기준입니다."
  path={path}
  jsonLd={jsonLd}
>
  <section class="scene-cream border-b border-line">
    <div class="wrap py-8 md:py-12">
      <HomePill />
      <p class="kicker">편집 원칙</p>
      <h1 class="h-display mt-3 max-w-[20ch] text-ink">
        확인한 것과<br />계산한 것을 나눠 적습니다.
      </h1>
      <p class="lede mt-5 max-w-[56ch]">
        이 사이트의 글과 도구는 여섯 가지 기준 위에서 만들어집니다. 기준은 선언이 아니라 결과물의 형태로
        드러납니다. 글마다 기준일과 1차 출처를 붙이고, 도구에는 전제와 한계를 함께 적습니다.
      </p>
      <p class="mono mt-5 text-[12.5px] text-ink-muted">
        기준일 <time datetime={site.baseDate}>{site.baseDateLabel}</time> · 적용 범위 글·도구·소식지 전체
      </p>
    </div>
  </section>

  <section class="scene-white">
    <div class="wrap py-10 md:py-14">
      <ol class="grid gap-x-10 gap-y-8 md:grid-cols-2" data-principles>
        {
          principles.map((p) => (
            <li class="border-t border-ink pt-4">
              <div class="flex items-baseline gap-3">
                <span class="mono text-[12px] font-semibold text-brand">{p.no}</span>
                <h2 class="text-[19px] font-bold leading-[1.4] tracking-[-0.03em] text-ink">{p.title}</h2>
              </div>
              <p class="mt-2 text-[13.5px] font-semibold leading-snug text-brand-deep">{p.lead}</p>
              {p.body.map((t) => (
                <p class="mt-2.5 text-[14px] leading-[1.8] text-ink-muted">{t}</p>
              ))}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="scene-cream border-t border-line">
    <div class="wrap py-8 md:py-10">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">이 원칙이 적용된 곳</h2>
          <p class="mt-2 max-w-[52ch] text-[13.5px] leading-[1.75] text-ink-muted">
            모든 글에 기준일·1차 출처·결론 앵커가 붙고, 도구에는 입력값과 전제가 함께 표시됩니다.
          </p>
        </div>
        <p class="flex flex-wrap items-center gap-x-4 text-[13.5px]">
          <a href={withBase("/posts")} class="link font-semibold text-brand-deep">자산리포트 전체</a>
          <a href={withBase("/apps")} class="link text-ink-muted">앱스토어</a>
          <a href={withBase("/about")} class="link text-ink-muted">소개</a>
        </p>
      </div>
      <HomePill position="bottom" />
    </div>
  </section>
</Base>
