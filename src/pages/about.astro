---
/**
 * 소개(/about) — v7.0 전면 재창조.
 *
 * 회의실 판정: 기존 소개는 "빵점 — 임팩트·흥미·재미 없음". 포맷을 먼저 연구하고 다시 지었다.
 * 참고한 포맷(2026-11-21 실물 확인)
 *  · Stripe — 'About us' 대신 신념을 첫 문장으로. 설명보다 주장, 장식보다 문장의 절제.
 *  · Linear — 사람과 숫자를 증거로. 큰 히어로 아래 명확한 증명 모듈.
 *  · Ramp·Mercury 등 금융 — 신뢰가 먼저 필요한 독자에게는 숫자 타일과 기준(principle)으로 증명.
 *  · 프라이빗 웰스·리서치 부티크 — 딥그린·네이비 바탕, 세리프 숫자, 금색 괘선의 조용한 격.
 * 공통 결론: ① 신념 한 문장 ② 증명 숫자 3~4개 ③ 구체적 서사 ④ 사람이 쓰는 기준
 *           ⑤ 다음 행동 하나. 그리고 '설명'이 아니라 '주장'으로 쓴다.
 *
 * 구성
 *  ① 히어로 — 딥그린 시네마틱 + 한글 캘리그라피 + 신념 한 문장 + 증명 숫자
 *  ② 3초 재무 진단 — 세 번 고르면 확인 순서를 돌려준다(FinanceCheck)
 *  ③ 3대 전문 영역 — 금융·투자 / 연금·노후 / 리스크·보장 인터랙티브 탭
 *  ④ 서사 3막 — 확인 → 기록 → 설계
 *  ⑤ 설계 철학 3장 — 숫자·시간·균형
 *  ⑥ 커뮤니티 · 1:1 문의 + 마무리 CTA
 *
 * v7.1 — '브랜드 쇼케이스(서표 하나, 손글씨 두 장)' 섹션은 걷어냈다. 히어로 쇼케이스와
 * 브랜드 필름이 이미 같은 이야기를 하고 있어, 같은 그림을 두 번 보여 주지 않는다.
 *
 * 지키는 것: 개인 신상·소속 비노출, 확인되지 않은 수치 금지(숫자는 데이터에서 센다),
 * 표(<table>) 미사용, 모바일 고정 바 없음, 방어적 부정 표현 없음.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import BrandLockup from "@/components/BrandLockup.astro";
import ChannelIcon from "@/components/about/ChannelIcon.astro";
import FinanceCheck from "@/components/about/FinanceCheck.tsx";
import { withBase, site, menuLabel } from "@/config/site";
import { channels, confirmedLinks } from "@/data/channels";
import { calendar } from "@/data/calendar";
import { storeCount } from "@/data/store";
import { allPosts, postPath } from "@/lib/posts";
import { AUTHOR_ID, graph, organizationNode, pageUrl, partOfWebsite, personNode, websiteNode } from "@/lib/schema";

const posts = await allPosts();
const postById = new Map(posts.map((p) => [p.id, p]));
/** 3초 진단의 추천 글 제목은 컬렉션에서 온다 — 화면에 손으로 적은 제목을 두지 않는다. */
const postTitles = Object.fromEntries(posts.map((p) => [postPath(p), p.data.title]));
const calendarCount = calendar.length;

const stats = [
  { href: "/posts", value: posts.length, unit: "편", label: menuLabel.posts },
  { href: "/apps", value: storeCount, unit: "종", label: menuLabel.apps },
  { href: "/calendar", value: calendarCount, unit: "건", label: menuLabel.calendar },
];

/** 3대 전문 영역 — 탭 하나가 '무엇을 보는가 + 확인 포인트 3 + 도구·글' 한 묶음. */
const areas = [
  {
    id: "finance",
    label: "금융 · 투자",
    headline: "돈이 도는 구조를 먼저 그립니다",
    body:
      "수익률은 결과이고, 구조가 원인입니다. 들어오는 돈과 나가는 돈, 계좌의 종류와 세금, 손실을 버티는 힘을 같은 자리에 놓고 봅니다.",
    points: [
      { title: "현금흐름", body: "고정비와 변동비를 나눠, 매달 남는 돈이 어디서 만들어지는지 확인합니다." },
      { title: "계좌 구조", body: "일반·ISA·연금계좌의 과세 방식이 같은 수익을 얼마나 다르게 남기는지 계산합니다." },
      { title: "버티는 힘", body: "기대 수익보다 먼저, 하락에서 팔지 않을 이유가 있는지를 봅니다." },
    ],
    tools: [
      { name: "투자 복리·세후 수익률 계산기", href: "/apps/compound-return/run" },
      { name: "한국형 타임머신", href: "/apps/trade-timemachine" },
    ],
    postId: "invest-dca-rule",
  },
  {
    id: "pension",
    label: "연금 · 노후",
    headline: "받는 날의 시간표를 정합니다",
    body:
      "노후의 두려움은 대개 목돈이 아니라 매달 나가는 돈에서 옵니다. 국민·퇴직·개인연금을 한 줄로 세우고, 언제부터 얼마를 받을지 계산합니다.",
    points: [
      { title: "3층 연금", body: "국민연금·퇴직연금·개인연금을 각각 계산해 합계와 비중을 확인합니다." },
      { title: "1,500만 원 경계", body: "사적연금이 연 1,500만 원을 넘을 때 과세가 어떻게 갈리는지 봅니다." },
      { title: "오늘 가치", body: "은퇴 시점의 명목 금액을 물가로 나눠, 실제 구매력으로 다시 봅니다." },
    ],
    tools: [
      { name: "은퇴 월 현금흐름 시뮬레이터", href: "/apps/retirement-flow/run" },
      { name: "연금 인출·세금 시뮬레이터", href: "/apps/pension-draw/run" },
    ],
    postId: "pension-tax-order",
  },
  {
    id: "risk",
    label: "리스크 · 보장",
    headline: "빈 칸을 메우는 순서를 정합니다",
    body:
      "보장은 상품이 아니라 구조입니다. 5대 담보의 빈 칸, 실손 세대별 자기부담, 고지의무를 순서대로 확인해 무엇부터 볼지 정합니다.",
    points: [
      { title: "5대 담보", body: "암·뇌·심장·수술비·간병비를 기준점과 나란히 놓고 빈 칸을 찾습니다." },
      { title: "실손 세대", body: "같은 병원비로 4세대와 5세대의 환급액이 어떻게 갈리는지 비교합니다." },
      { title: "고지의무", body: "3개월·2년·5년 질문을 미리 정리해, 청약서에 사실대로 적을 수 있게 합니다." },
    ],
    tools: [
      { name: "실손 세대별 비교기", href: "/apps/silson-compare/run" },
      { name: "보장 점검 시뮬레이터", href: "/apps/coverage-check/run" },
    ],
    postId: "insurance-coverage-conditions",
  },
];

const acts = [
  {
    title: "숫자를 원문에서 다시 읽었습니다",
    body:
      "금리가 내렸는데 왜 이자는 그대로인지, 실손을 갈아타야 하는지, 연금은 언제부터 받는지. 답은 제도가 바뀔 때마다 달라집니다. 그래서 보도 요약이 아니라 금융위·국세청·공단의 원문을 먼저 폅니다.",
    chip: "1차 출처 · 법령 · 고시",
  },
  {
    title: "확인한 것과 계산한 것을 나눠 적습니다",
    body:
      "원문에서 확인한 사실, 내가 계산한 값, 틀렸던 판단을 날짜와 함께 남깁니다. 글마다 기준일과 출처를 붙이는 이유는, 읽는 사람이 같은 자리에서 다시 확인할 수 있게 하기 위해서입니다.",
    chip: "기준일 · 가정 · 정정 기록",
  },
  {
    title: "되풀이되는 계산을 도구로 옮겼습니다",
    body:
      "표를 손으로 옮겨 적고 계산기를 두드리는 일은 기록으로 남길 가치가 없습니다. 같은 질문이 다시 오면, 앱스토어에서 그 계산을 바로 열 수 있게 만들었습니다.",
    chip: `앱 ${storeCount}종 · 금융 일정 ${calendarCount}건`,
  },
];

const philosophy = [
  {
    title: "숫자는 결론이 아니라 질문",
    body:
      "세액공제 148만 5,000원, 은퇴 후 월 269만 원(오늘 가치). 숫자는 그 자체로 답이 되지 않습니다. 그 숫자가 어떤 가정 위에 서 있는지 함께 읽어야 결정에 쓸 수 있습니다.",
  },
  {
    title: "시간을 자산으로 계산",
    body:
      "10년 뒤의 1억과 오늘의 1억은 같은 돈이 아닙니다. 물가와 수익률, 세금을 같은 시간축에 놓고 비교합니다.",
  },
  {
    title: "세제 · 현금흐름 · 보장의 균형",
    body:
      "절세만 보면 현금흐름이 막히고, 보장만 보면 납입이 버거워집니다. 재무설계의 관점으로 세 축을 함께 놓습니다.",
  },
];

/** 채널 카드 — 아이콘 키만 이름으로 잇는다. */
const iconOf: Record<string, string> = {
  스레드: "threads",
  인스타그램: "instagram",
  "네이버 블로그": "naver",
  유튜브: "youtube",
  X: "x",
  카페: "cafe",
  당근: "carrot",
  깃허브: "github",
};

const hubLinks = [
  { href: "/posts", label: `${menuLabel.posts} ${posts.length}편` },
  { href: "/apps", label: `${menuLabel.apps} ${storeCount}종` },
  { href: "/calendar", label: `${menuLabel.calendar} ${calendarCount}건` },
  { href: "/search", label: "본문까지 검색" },
  { href: "/rss.xml", label: "RSS 구독" },
];

const jsonLd = graph([
  {
    "@type": "AboutPage",
    "@id": `${pageUrl("/about")}#webpage`,
    url: pageUrl("/about"),
    name: "버핏킴즈 — 숫자로 설계하는 금융·연금 아카이브",
    description:
      "금융·투자·연금·재무의 숫자를 원문과 계산으로 확인하는 1인 금융·연금 아카이브. 3초 재무 진단, 세 가지 전문 영역, 서사 3막, 읽는 순서와 계산 도구를 한 페이지에 담았습니다.",
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
    about: { "@id": AUTHOR_ID },
    mainEntity: { "@id": AUTHOR_ID },
  },
  organizationNode(),
  websiteNode(),
  personNode(),
]);
---

<Base
  title="버핏킴즈 — 숫자 너머의 기준, 금융·연금 아카이브"
  description="금융·투자·연금·재무의 숫자를 원문과 계산으로 확인합니다. 시뮬레이터로 내 숫자를 검증하고, 필요한 기준을 글로 남깁니다. 3초 재무 진단으로 지금 확인할 순서부터."
  path="/about"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 — 신념 한 문장 + 한글 캘리그라피 + 증명 숫자 -->
  <section class="ab-hero" aria-labelledby="about-title">
    <div class="ab-hero-glow" aria-hidden="true"></div>
    <div class="wrap ab-hero-grid">
      <div class="ab-hero-copy">
        <HomePill />
        <p class="ab-kicker mono">ABOUT · buffetkimz</p>
        <h1 class="ab-title" id="about-title">
          돈의 구조를 읽고,<br /><span class="ab-title-em">숫자로 설계합니다.</span>
        </h1>
        <p class="ab-lede">
          숫자 너머의 기준을 찾는 1인 금융·연금 아카이브. 연금·투자·절세·보장의 핵심 기준을 데이터와
          시뮬레이터로 바로 검증합니다.
        </p>
        <p class="ab-lede-sub">
          모든 시뮬레이션은 브라우저 안에서 즉시 계산되고, 숫자가 결정에 닿는 지점에서는 1:1 문의로
          이어집니다.
        </p>

        <div class="ab-hero-actions">
          <a href="#diagnosis" class="ab-btn ab-btn--solid">3초 재무 진단</a>
          <a href={withBase("/apps")} class="ab-btn ab-btn--ghost">앱스토어 열기</a>
        </div>

        <dl class="ab-hero-stats" data-about-stats>
          {
            stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>
                  <a href={withBase(s.href)}>
                    <b data-count-to={String(s.value)}>{s.value}</b>
                    <span>{s.unit}</span>
                  </a>
                </dd>
              </div>
            ))
          }
          <div>
            <dt>기준일</dt>
            <dd class="ab-stat-date">
              <time datetime={site.baseDate}>{site.baseDateLabel}</time>
            </dd>
          </div>
        </dl>
      </div>

      <div class="ab-sign-panel" aria-label="버핏킴즈 한글 시그니처">
        <p class="ab-sign-top mono">
          <span>SINCE 2026.11</span>
          <span class="ab-sign-rule" aria-hidden="true"></span>
          <span>SEOUL</span>
        </p>
        <img
          class="ab-sign-ko"
          src={withBase("/brand/logo-ko-dark-tr-1920.webp")}
          srcset={`${withBase("/brand/logo-ko-dark-tr-480.webp")} 480w, ${withBase("/brand/logo-ko-dark-tr-960.webp")} 960w, ${withBase("/brand/logo-ko-dark-tr-1920.webp")} 1920w`}
          sizes="(max-width: 767px) 80vw, (max-width: 1023px) 46vw, 560px"
          width="3332"
          height="921"
          alt="버핏킴즈 — 공식 국문 로고"
          loading="eager"
          decoding="async"
        />
        <p class="ab-sign-cap">
          금융·투자·연금·재무 — 하나의 기준으로 읽는 이름
        </p>
        <div class="ab-sign-foot">
          <BrandLockup tone="dark" size="20px" />
          <span class="ab-sign-foot-note mono">RECORD · SIMULATE · ADVISE</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ② 3초 재무 진단 -->
  <section class="ab-check" id="diagnosis" aria-labelledby="ab-check-title">
    <div class="wrap ab-check-grid">
      <div class="ab-check-copy">
        <p class="ab-kicker ab-kicker--ink">3초 재무 진단</p>
        <h2 class="ab-h2" id="ab-check-title">
          무엇부터<br />확인해야 할까요?
        </h2>
        <p class="ab-check-body">
          고민 하나를 고르면 지금 내게 필요한 숫자와 그 숫자를 계산할 도구를 바로 보여 드립니다.
          무엇부터 확인하면 좋을지 <b>확인 순서</b>로 안내합니다.
        </p>
        <ul class="ab-check-points">
          <li>연금 · 투자 · 절세 · 보험 중 하나</li>
          <li>결과는 추천 앱 2종 + 읽을 글 1편</li>
          <li>고른 내용은 저장하지 않습니다</li>
        </ul>
      </div>
      <div class="ab-check-widget">
        <FinanceCheck client:visible postTitles={postTitles} />
      </div>
    </div>
  </section>

  <!-- ③ 3대 전문 영역 — 인터랙티브 탭 -->
  <section class="ab-areas" aria-labelledby="ab-areas-title">
    <div class="wrap">
      <div class="ab-areas-head">
        <div>
          <p class="ab-kicker ab-kicker--mint">전문 영역</p>
          <h2 class="ab-h2 ab-h2--light" id="ab-areas-title">세 개의 렌즈로<br />같은 숫자를 봅니다</h2>
        </div>
        <p class="ab-areas-desc">
          금융·투자, 연금·노후, 리스크·보장은 따로 떨어진 과목이 아닙니다. 한 영역의 결정이 다른 두
          영역의 숫자를 바꾸기 때문에, 세 렌즈를 같은 기준일 위에 놓습니다.
        </p>
      </div>

      <div class="ab-tabs" role="tablist" aria-label="전문 영역" data-ab-tabs>
        {
          areas.map((a, i) => (
            <button
              type="button"
              role="tab"
              id={`ab-tab-${a.id}`}
              class="ab-tab"
              data-ab-tab={a.id}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`ab-panel-${a.id}`}
              data-on={i === 0 ? "1" : "0"}
            >
              <span class="ab-tab-label">{a.label}</span>
            </button>
          ))
        }
      </div>

      {
        areas.map((a, i) => {
          const post = postById.get(a.postId);
          return (
            <div
              class="ab-panel"
              id={`ab-panel-${a.id}`}
              role="tabpanel"
              aria-labelledby={`ab-tab-${a.id}`}
              data-ab-panel={a.id}
              hidden={i !== 0}
            >
              <div class="ab-panel-main">
                <h3 class="ab-panel-title">{a.headline}</h3>
                <p class="ab-panel-body">{a.body}</p>
                <ol class="ab-panel-points">
                  {a.points.map((p) => (
                    <li>
                      <span class="ab-point-title">{p.title}</span>
                      <span class="ab-point-body">{p.body}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="ab-panel-side">
                <p class="ab-side-label mono">바로 계산</p>
                <ul class="ab-side-tools">
                  {a.tools.map((t) => (
                    <li>
                      <a href={withBase(t.href)} class="ab-side-tool">
                        {t.name}
