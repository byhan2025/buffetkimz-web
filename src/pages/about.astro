  <script>
    /* 숫자 카운트업 — 화면에 들어올 때 한 번. 모션 줄이기 설정이면 최종값 그대로 둔다. */
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const counters = Array.from(document.querySelectorAll<HTMLElement>("[data-count-to]"));
    const settle = (el: HTMLElement) => {
      const to = Number(el.dataset.countTo ?? "0");
      if (!Number.isFinite(to)) return;
      if (reduce || !("IntersectionObserver" in window)) {
        el.textContent = to.toLocaleString("ko-KR");
        return;
      }
      const start = performance.now();
      const dur = 900;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(to * eased).toLocaleString("ko-KR");
        if (p < 1) requestAnimationFrame(tick);
      };
      el.textContent = "0";
      requestAnimationFrame(tick);
    };
    if (reduce || !("IntersectionObserver" in window)) {
      counters.forEach(settle);
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            io.unobserve(el);
            settle(el);
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((el) => io.observe(el));
    }
  </script>
