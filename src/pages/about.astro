---
import Base from "@/layouts/Base.astro";
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { apps } from "@/data/apps";
import { channels, confirmedLinks } from "@/data/channels";
import { allPosts } from "@/lib/posts";

const posts = await allPosts();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  mainEntity: {
    "@type": "Person",
    name: site.author.name,
    description: site.author.bio,
    url: `${site.url}/about`,
  },
};
---

<Base
  title="소개 — 무엇을, 왜 기록하는가"
  description="buffetkimz는 금융과 돈에 관한 기록을 매일 쌓고, 되풀이되는 계산을 도구로 옮기는 개인 아카이브입니다. 쓰는 방식과 다루지 않는 것을 정리했습니다."
  path="/about"
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-10 md:py-14">
      <p class="kicker">소개</p>
      <h1 class="h-display mt-3 max-w-[22ch]">
        확인한 것을 적고,<br />되풀이되는 계산은 도구로.
      </h1>
      <p class="lede mt-5 max-w-[58ch]">
        buffetkimz는 금융과 돈에 관한 기록을 매일 쌓는 개인 아카이브입니다. 스레드, 인스타그램,
        블로그, 유튜브에 흩어질 이야기를 한곳에 모으고, 직접 만든 계산 도구를 함께 둡니다.
      </p>
    </div>
  </section>

  <section class="wrap py-10 md:py-14">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div class="space-y-9">
        <div>
          <h2 class="text-[13px] font-semibold tracking-[0.06em] text-ink-faint">왜 여기에 쓰는가</h2>
          <div class="mt-3 space-y-4 text-[15px] leading-[1.85] text-ink-soft">
            <p>
              보험과 금융을 현장에서 다루면 같은 질문을 반복해서 듣습니다. 금리가 내렸는데 왜 이자는
              그대로인지, 실손을 갈아타야 하는지, 연금은 얼마를 넣어야 하는지. 답은 매번 조금씩
              달라지고, 기억은 금방 흐려집니다.
            </p>
            <p>
              그래서 적기 시작했습니다. 현장에서 확인한 기준, 공개된 자료와 비교해 고친 숫자,
              틀렸던 판단까지. 기록이 쌓이면 같은 질문에 더 정확하게 답할 수 있습니다.
            </p>
            <p>
              도구는 그다음 단계입니다. 표를 손으로 옮겨 적고 계산기를 두드리는 일은 기록으로 남길
              가치가 없습니다. 그런 일은 브라우저에서 끝나게 하고, 사람은 설명과 판단에 시간을 씁니다.
            </p>
          </div>
        </div>

        <div>
          <h2 class="text-[13px] font-semibold tracking-[0.06em] text-ink-faint">쓰는 방식</h2>
          <ul class="mt-3 divide-y divide-line-soft border-t border-ink">
            {site.principles.map((p) => (
              <li class="grid gap-1 py-4 sm:grid-cols-[180px_1fr] sm:gap-6">
                <h3 class="text-[14px] font-semibold leading-snug text-ink">{p.title}</h3>
                <p class="text-[13.5px] leading-[1.75] text-ink-muted">{p.body}</p>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-[13px] font-semibold tracking-[0.06em] text-ink-faint">다루지 않는 것</h2>
          <ul class="mt-3 space-y-2.5">
            {[
              "특정 상품의 추천, 비교 우열, 가입 권유. 글과 도구 어디에도 상품명을 앞세우지 않습니다.",
              "소속 회사나 대리점의 이름. 이 사이트는 특정 회사의 모집 채널이 아닙니다.",
              "다른 사람의 개인정보. 사례는 식별할 수 없는 형태로만 씁니다.",
              "확인되지 않은 수치. 출처가 없거나 기준일이 불분명한 숫자는 쓰지 않습니다.",
            ].map((t) => (
              <li class="flex gap-2.5 text-[13.5px] leading-[1.75] text-ink-soft">
                <span class="mt-[9px] h-[3px] w-[3px] shrink-0 rounded-full bg-ink-faint" aria-hidden="true" />
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
        <div>
          <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">지금까지</h2>
          <dl class="mt-3 divide-y divide-line-soft border-t border-line-soft text-[12.5px]">
            <div class="flex justify-between py-2">
              <dt class="text-ink-faint">블로그</dt>
              <dd class="tabular-nums text-ink-soft">{posts.length}편</dd>
            </div>
            <div class="flex justify-between py-2">
              <dt class="text-ink-faint">카테고리</dt>
              <dd class="tabular-nums text-ink-soft">{categories.length}개</dd>
            </div>
            <div class="flex justify-between py-2">
              <dt class="text-ink-faint">도구</dt>
              <dd class="tabular-nums text-ink-soft">{apps.length}개</dd>
            </div>
            <div class="flex justify-between py-2">
              <dt class="text-ink-faint">기준일</dt>
              <dd class="text-ink-soft">{site.baseDateLabel}</dd>
            </div>
          </dl>
        </div>

        <div>
          <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">이 사이트</h2>
          <ul class="mt-2 space-y-1.5 text-[13px]">
            <li><a href={withBase("/posts")} class="text-ink-soft link">블로그 — 매일 쌓이는 기록</a></li>
            <li><a href={withBase("/apps")} class="text-ink-soft link">앱 — 직접 만든 도구</a></li>
            <li><a href={withBase("/calendar")} class="text-ink-soft link">제도달력 — 1~12월 일정</a></li>
            <li><a href={withBase("/search")} class="text-ink-soft link">검색 — 본문까지 찾기</a></li>
            <li><a href={withBase("/rss.xml")} class="text-ink-soft link">RSS 구독</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section id="channels" class="border-t border-ink">
    <div class="wrap py-10 md:py-14">
      <h2 class="h-section">채널</h2>
      <p class="mt-2 max-w-[52ch] text-[13.5px] leading-relaxed text-ink-muted">
        이 사이트가 본진입니다. 짧은 글은 다른 곳에, 긴 글과 기록은 여기에 남깁니다. 채널 주소는
        확정되는 대로 연결합니다.
      </p>
      <ul class="mt-6 border-t border-ink">
        {channels.map((c) => (
          <li class="grid grid-cols-[1fr_auto] items-baseline gap-3 border-b border-line py-3">
            <span class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-[14px] font-semibold text-ink">{c.name}</span>
              <span class="text-[12.5px] text-ink-muted">{c.note}</span>
            </span>
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-[12px] font-semibold text-brand-deep link">열기</a>
            ) : (
              <span class="text-[12px] text-ink-faint" aria-hidden="true">—</span><span class="sr-only">주소 준비 중</span>
            )}
          </li>
        ))}
        {confirmedLinks.map((l) => (
          <li class="grid grid-cols-[1fr_auto] items-baseline gap-3 border-b border-line py-3">
            <span class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-[14px] font-semibold text-ink">{l.name}</span>
              <span class="text-[12.5px] text-ink-muted">{l.note}</span>
            </span>
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-[12px] font-semibold text-brand-deep link">열기</a>
          </li>
        ))}
        {site.kakaoChannelUrl && (
          <li class="grid grid-cols-[1fr_auto] items-baseline gap-3 border-b border-line py-3">
            <span class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-[14px] font-semibold text-ink">카카오톡 채널</span>
              <span class="text-[12.5px] text-ink-muted">1:1 대화로 문의</span>
            </span>
            <a href={site.kakaoChannelUrl} target="_blank" rel="noopener noreferrer" class="text-[12px] font-semibold text-brand-deep link">열기</a>
          </li>
        )}
      </ul>
      <p class="mt-4 flex flex-wrap gap-4 text-[12px]">
        <a href={withBase("/privacy")} class="text-ink-muted link">개인정보처리방침</a>
        <a href={withBase("/terms")} class="text-ink-muted link">이용약관</a>
      </p>
    </div>
  </section>
</Base>
