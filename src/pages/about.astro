---
/**
 * 소개(/about) — v6.2 에디토리얼 전면 고도화 (회의실 4인방 합의 반영).
 *
 * ① 딥그린 히어로 — 한 줄 선언(가입을 권하지 않습니다) + 한글/영문 캘리그라피(390은 한 줄 가로)
 * ② 확인된 숫자 스트립 — 기록·도구·일정·가입 권유 0건 (목록에서 매번 다시 센다, 카운트업)
 * ③ 3단 서사 타임라인 — 확인 → 기록 → 도구
 * ④ 쓰는 방식 3장(출처 먼저·기준일 표시·가정 밝힘) + 다루지 않는 것 ✕ 칩
 * ⑤ 주제별 글 ↔ 도구 짝 3장 (실손·ISA·연금 글 → 해당 계산기)
 * ⑥ 채널·도구 허브 — 본진(HQ) 1장 + 채널 9칸(주소 미확정은 '주소 정리 중')
 * ⑦ 표식 → 편집 원칙 + '도구 써 보기 · 원칙 보기' CTA
 *
 * 지키는 것: 증빙 없는 자격 표현 금지(비영업 톤) · 개인 신상·소속 비노출 ·
 * 확인되지 않은 수치 금지(숫자는 데이터에서 센다) · 표(<table>) 미사용 · 모바일 고정 바 없음.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import BrandLockup from "@/components/BrandLockup.astro";
import ChannelIcon from "@/components/about/ChannelIcon.astro";
import { withBase, site } from "@/config/site";
import { channels, confirmedLinks } from "@/data/channels";
import { hubTools } from "@/data/tools";
import { calendar } from "@/data/calendar";
import { allPosts, categoryLabel, postPath } from "@/lib/posts";
import { AUTHOR_ID, graph, organizationNode, pageUrl, partOfWebsite, personNode, websiteNode } from "@/lib/schema";

const posts = await allPosts();
const postById = new Map(posts.map((p) => [p.id, p]));
const toolCount = hubTools.length;
const calendarCount = calendar.length;

/** 숫자 스트립 — 값은 전부 데이터에서 센다. */
const stats = [
  { href: "/posts", value: posts.length, unit: "편", label: "기록" },
  { href: "/apps", value: toolCount, unit: "종", label: "도구" },
  { href: "/calendar", value: calendarCount, unit: "건", label: "일정" },
  { href: "/principles", value: 0, unit: "건", label: "가입 권유" },
];

const narrative = [
  {
    no: "01",
    stage: "확인",
    title: "질문은 늘 같은 자리에서 시작됐습니다",
    body: "보험·세금·연금 문서를 읽고 설명을 맞추다 보면 같은 질문이 반복됩니다. 그때마다 기억과 요약에 기대지 않으려고 원문을 먼저 확인하는 습관이 생겼습니다.",
    chip: "1차 출처 · 금융위·국세청·공단",
  },
  {
    no: "02",
    stage: "기록",
    title: "확인한 것과 계산한 것을 나눠 적기 시작했습니다",
    body: "원문에서 확인한 기준, 직접 계산한 숫자, 틀렸던 판단까지 날짜와 함께 남깁니다. 글마다 기준일과 출처를 붙이는 이유입니다.",
    chip: "기준일 · 가정 표시",
  },
  {
    no: "03",
    stage: "도구",
    title: "되풀이되는 계산은 브라우저로 옮겼습니다",
    body: "표를 손으로 옮겨 적고 계산기를 두드리는 일은 기록으로 남길 가치가 없습니다. 입력값은 서버로 보내지 않고 그 탭 안에서만 계산합니다.",
    chip: `도구 ${toolCount}종 · 입력값 저장 0건`,
  },
];

/** 쓰는 방식 3장 */
const methods = [
  {
    no: "1단계",
    title: "출처 먼저",
    body: "금융위·금감원·국세청·공단의 원문을 먼저 봅니다. 보도 요약은 숫자를 대조하는 데만 씁니다.",
    example: "원문 링크를 글 끝에 남깁니다",
  },
  {
    no: "2단계",
    title: "기준일 표시",
    body: "모든 글과 도구에 확인한 날짜를 붙입니다. 제도는 바뀌므로, 기준일 없는 숫자는 싣지 않습니다.",
    example: "글 제목 아래 · 도구 결과 옆",
  },
  {
    no: "3단계",
    title: "가정 밝힘",
    body: "세금·수수료·물가 중 무엇을 넣고 넣지 못했는지 결과 옆에 적습니다. 전제가 달라지면 답도 달라집니다.",
    example: "결과보다 먼저 전제를 읽게 합니다",
  },
];

/** 다루지 않는 것 — 짧은 ✕ 칩 */
const notDoing = ["상품 가입 권유", "소속·회사 이름", "확인되지 않은 숫자", "다른 사람의 개인정보"];

/** 주제별 글 ↔ 도구 짝 (실제 글·도구만 연결) */
const pairSpec = [
  { postId: "insurance-silson-5th", toolKey: "silson" },
  { postId: "isa-pension-300", toolKey: "pension" },
  { postId: "pension-tax-order", toolKey: "pension-draw" },
];

const pairs = pairSpec
  .map(({ postId, toolKey }) => {
    const post = postById.get(postId);
    const tool = hubTools.find((t) => t.key === toolKey);
    if (!post || !tool) return null;
    return {
      post,
      tool,
      category: categoryLabel(post),
    };
  })
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

/** 채널 카드 — 아이콘 키만 이름으로 잇는다. */
const iconOf: Record<string, string> = {
  스레드: "threads",
  인스타그램: "instagram",
  "네이버 블로그": "naver",
  유튜브: "youtube",
  X: "x",
  카페: "cafe",
  당근: "carrot",
  깃허브: "github",
};

const hubLinks = [
  { href: "/posts", label: `블로그 ${posts.length}편` },
  { href: "/apps", label: `도구자료실 ${toolCount}종` },
  { href: "/calendar", label: `제도달력 ${calendarCount}건` },
  { href: "/search", label: "본문까지 검색" },
  { href: "/rss.xml", label: "RSS 구독" },
];

const jsonLd = graph([
  {
    "@type": "AboutPage",
    "@id": `${pageUrl("/about")}#webpage`,
    url: pageUrl("/about"),
    name: "소개 — 가입을 권하지 않습니다",
    description:
      "buffetkimz가 무엇을, 왜, 어떤 기준으로 기록하는지. 비영업 원칙과 쓰는 방식, 쌓인 기록과 도구, 글과 도구의 짝, 연결 채널을 한 페이지에 정리했습니다.",
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
    about: { "@id": AUTHOR_ID },
    mainEntity: { "@id": AUTHOR_ID },
  },
  organizationNode(),
  websiteNode(),
  personNode(),
]);
---

<Base
  title="소개 — 가입을 권하지 않습니다"
  description="가입을 권하지 않고, 내 숫자가 맞는지 먼저 확인합니다. 보험·세금·연금의 숫자를 근거와 함께 풀고, 스스로 확인할 기준과 직접 써볼 도구를 정리한 개인 아카이브입니다."
  path="/about"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 — 딥그린 에디토리얼 + 두 개의 손글씨 -->
  <section class="about-hero" aria-labelledby="about-title">
    <div class="wrap about-hero-grid">
      <div class="about-hero-copy">
        <HomePill />
        <p class="about-kicker">소개 · ABOUT</p>
        <ul class="about-chips" aria-label="이 사이트의 성격">
          <li class="about-chip about-chip--mint">비영업 기록</li>
          <li class="about-chip">입력값 저장 0건</li>
        </ul>
        <h1 class="about-hero-title" id="about-title">가입을 권하지 않습니다.</h1>
        <p class="about-hero-lede">
          <span class="block">내 숫자가 맞는지 먼저 확인합니다.</span>
          <span class="block">보험·세금·연금의 숫자를 근거와 함께 쉽게 풀어드립니다.</span>
        </p>
        <div class="about-hero-actions">
          <a href={withBase("/posts")} class="btn about-btn-solid">기록 보러 가기</a>
          <a href={withBase("/apps")} class="btn about-btn-ghost">도구 써 보기</a>
          <a href={withBase("/principles")} class="about-hero-link">편집 원칙</a>
        </div>
        <p class="about-hero-meta">
          기준일 <time datetime={site.baseDate}>{site.baseDateLabel}</time> · 모든 글과 도구에 1차 출처·기준일 표기
        </p>
      </div>

      <div class="about-sign-panel" aria-label="버핏킴즈 공식 시그니처">
        <p class="about-sign-label">
          <span>SINCE 2026.11</span>
          <span class="about-sign-rule" aria-hidden="true"></span>
          <span>버핏킴즈</span>
        </p>
        <div class="about-sign-arts">
          <div class="about-sign-ko">
            <img
              src={withBase("/brand/buffetkimz-calligraphy-ko-720.webp")}
              srcset={`${withBase("/brand/buffetkimz-calligraphy-ko-360.webp")} 360w, ${withBase("/brand/buffetkimz-calligraphy-ko-720.webp")} 720w`}
              sizes="(max-width: 767px) 52vw, (max-width: 1023px) 82vw, 430px"
              width="720"
              height="194"
              alt="한글 버핏킴즈 캘리그라피 — 흰 붓글씨와 푸른 빛줄기"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="about-sign-en">
            <img
              src={withBase("/brand/buffetkimz-calligraphy-en-1400.webp")}
              srcset={`${withBase("/brand/buffetkimz-calligraphy-en-700.webp")} 700w, ${withBase("/brand/buffetkimz-calligraphy-en-1400.webp")} 1400w`}
              sizes="(max-width: 767px) 34vw, (max-width: 1023px) 62vw, 300px"
              width="1400"
              height="467"
              alt="영문 BuffetKimz 캘리그라피 — 흰 붓글씨와 푸른 빛줄기"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <p class="about-sign-cap">한글 버핏킴즈 · 영문 BuffetKimz — 같은 이름, 두 개의 손</p>
        <div class="about-sign-foot">
          <BrandLockup tone="dark" size="18px" />
          <span class="about-sign-foot-note">기록 · 도구</span>
        </div>
      </div>
    </div>

    <!-- ② 확인된 숫자 스트립 — 첫 화면 안에서 바로 보이는 값 -->
    <div class="about-strip-wrap">
      <div class="wrap">
        <ul class="about-strip" data-about-stats aria-label="확인된 숫자">
          {
            stats.map((s, i) => (
              <li>
                <a href={withBase(s.href)} class="about-strip-item">
                  <span class="about-strip-label">{s.label}</span>
                  <span class="about-strip-value">
                    <b data-count-to={i === stats.length - 1 ? undefined : String(s.value)}>{s.value}</b>
                    <span>{s.unit}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="about-strip-note">
          홈과 같은 기준일 <time datetime={site.baseDate}>{site.baseDateLabel}</time> · 목록에서 자동으로 세는 값입니다.
          ‘가입 권유 0건’은 편집 원칙 03의 정책값입니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ③ 3단 서사 · 타임라인 -->
  <section class="about-story" aria-labelledby="about-story-title">
    <div class="wrap about-section-pad">
      <div class="about-story-grid">
        <div class="about-story-copy">
          <p class="about-kicker about-kicker--ink">왜 이 공간인가</p>
          <h2 class="about-h2" id="about-story-title">
            같은 질문이 돌아올 때마다,<br />답을 다시 확인하려고 만들었습니다.
          </h2>
          <div class="about-story-body">
            <p>
              금리가 내렸는데 왜 이자는 그대로인지, 실손을 갈아타야 하는지, 연금은 언제부터 얼마를
              받는지. 살다 보면 같은 질문이 몇 년을 두고 되돌아옵니다. 답은 제도와 기준이 바뀔 때마다
              달라지고, 그때 들은 설명은 기억에서 금방 흐려집니다.
            </p>
            <p>
              그래서 확인한 원문과 직접 계산한 숫자를 날짜와 함께 적습니다. 틀렸던 판단도 지우지 않고
              고친 기록을 남깁니다. 기록이 쌓이면 같은 질문에 더 정확하게 답할 수 있습니다.
            </p>
          </div>
          <p class="about-pull">숫자는 결론이 아니라 질문입니다.</p>
          <p class="about-story-apfk">
            세제 혜택, 매달의 현금흐름, 보장의 빈 칸을 <b>함께 놓고 보는 것</b>을 기준으로 삼습니다.
            한 축만 크게 보여 주는 설명은 하지 않습니다.
          </p>
          <a href={withBase("/principles")} class="about-inline-link">
            글과 도구를 만드는 기준 — 편집 원칙
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="about-timeline" data-about-timeline>
          {
            narrative.map((item) => (
              <li class="about-tl-item reveal">
                <span class="about-tl-no">{item.no}</span>
                <p class="about-tl-stage">{item.stage}</p>
                <h3 class="about-tl-title">{item.title}</h3>
                <p class="about-tl-body">{item.body}</p>
                <span class="about-tl-chip">{item.chip}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="about-tl-close">
        지금도 도구(03)에서 확인(01)으로 돌아가는 일이 매일 반복됩니다. 그 왕복이 이 사이트의 편집 방식입니다.
      </p>
    </div>
  </section>

  <!-- ④ 쓰는 방식 3장 + 다루지 않는 것 ✕ 칩 -->
  <section class="about-methods" aria-labelledby="about-methods-title">
    <div class="wrap about-section-pad">
      <div class="about-head">
        <div>
          <p class="about-kicker about-kicker--ink">쓰는 방식</p>
          <h2 class="about-h2" id="about-methods-title">출처를 먼저 보고,<br />기준일과 가정을 남깁니다</h2>
        </div>
        <p class="about-head-desc">
          글과 도구를 만들 때 매번 같은 세 단계를 거칩니다. 순서를 바꾸면 결론도 바뀌기 때문에,
          순서 자체를 기준으로 적어 둡니다.
        </p>
      </div>

      <ol class="about-method-grid" data-about-methods>
        {
          methods.map((m, i) => (
            <li class="about-method reveal">
              <span class="about-method-tag">{m.no}</span>
              <h3 class="about-method-title">{m.title}</h3>
              <p class="about-method-body">{m.body}</p>
              <span class="about-method-example">{m.example}</span>
            </li>
          ))
        }
      </ol>

      <div class="about-dont">
        <p class="about-dont-label">다루지 않는 것</p>
        <ul class="about-dont-chips">
          {
            notDoing.map((t) => (
              <li>
                <span class="about-dont-x" aria-hidden="true">
                  ✕
                </span>
                {t}
              </li>
            ))
          }
        </ul>
        <p class="about-dont-note">
          {site.contact.disclaimer} 도구는 입력값을 서버로 보내지 않고 브라우저 안에서만 계산합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ⑤ 글 ↔ 도구 짝 -->
  <section class="about-pairs" aria-labelledby="about-pairs-title">
    <div class="wrap about-section-pad">
      <div class="about-head">
        <div>
          <p class="about-kicker about-kicker--ink">읽고 · 계산하기</p>
          <h2 class="about-h2" id="about-pairs-title">글에서 확인한 기준을<br />도구로 바로 써 봅니다</h2>
        </div>
        <p class="about-head-desc">
          같은 기준일로 쓴 글과 도구를 짝지었습니다. 글에서 조건을 확인하고, 내 숫자를 넣어
          계산해 보세요. 입력값은 어디에도 저장되지 않습니다.
        </p>
      </div>

      <ul class="about-pair-grid" data-about-pairs>
        {
          pairs.map((p, i) => (
            <li class="about-pair">
              <div class="about-pair-head">
                <span class="about-pair-link-mark" aria-hidden="true">글 → 도구</span>
                <span class="about-pair-cat">{p.category}</span>
              </div>
              <h3 class="about-pair-post">
                <a href={withBase(postPath(p.post))}>
                  {p.post.data.title}
                  <span aria-hidden="true">→</span>
                </a>
              </h3>
              <p class="about-pair-question">“{p.post.data.question}”</p>
              <div class="about-pair-tool">
                <span class="about-pair-tool-label">이어서 계산</span>
                <span class="about-pair-tool-name">{p.tool.name}</span>
                <span class="about-pair-tool-what">{p.tool.short}</span>
                <div class="about-pair-actions">
                  {p.tool.runHref ? (
                    <a href={withBase(p.tool.runHref)} class="btn btn-secondary btn-xs">
                      도구 열기
                    </a>
                  ) : (
                    <a href={withBase(p.tool.href)} class="btn btn-secondary btn-xs">
                      도구 보기
                    </a>
                  )}
                  <a href={withBase(postPath(p.post))} class="about-pair-read">
                    글 읽기
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ⑥ 채널 · 도구 허브 -->
  <section class="about-hubs" id="channels" aria-labelledby="about-hubs-title">
    <div class="wrap about-section-pad">
      <div class="about-head">
        <div>
          <p class="about-kicker about-kicker--ink">채널 · 본진</p>
          <h2 class="about-h2" id="about-hubs-title">
            이 사이트가 본진이고,<br />채널은 각자의 결로
          </h2>
        </div>
        <p class="about-head-desc">
