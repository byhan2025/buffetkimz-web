---
import Base from "@/layouts/Base.astro";
import { withBase } from "@/config/site";
import { categories } from "@/data/categories";
import { apps } from "@/data/apps";
---

<Base
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지가 없습니다. 블로그와 앱, 제도달력에서 다시 찾아보세요."
  path="/404"
  noindex={true}
>
  <section class="wrap flex min-h-[62vh] flex-col justify-center py-20">
    <p class="kicker">404</p>
    <h1 class="h-display mt-3">이 칸은 비어 있습니다.</h1>
    <p class="mt-4 max-w-[46ch] text-[14.5px] leading-[1.8] text-ink-muted">
      주소가 바뀌었거나 아직 쓰지 않은 페이지입니다. 검색으로 찾거나, 아래에서 이어가세요.
    </p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a href={withBase("/")} class="btn btn-primary">홈으로</a>
      <a href={withBase("/posts")} class="btn btn-secondary">블로그</a>
      <a href={withBase("/search")} class="btn btn-secondary">검색</a>
    </div>

    <div class="mt-12 grid gap-8 border-t border-line pt-6 sm:grid-cols-2">
      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">카테고리</h2>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {categories.map((c) => (
            <li>
              <a href={withBase(`/posts/${c.slug}`)} class="inline-flex min-h-[34px] items-center text-[13px] text-ink-soft link">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">앱</h2>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {apps.map((a) => (
            <li>
              <a href={withBase(`/apps/${a.slug}`)} class="inline-flex min-h-[34px] items-center text-[13px] text-ink-soft link">
                {a.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
