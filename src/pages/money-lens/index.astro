---
/**
 * /money-lens — 「돈의 나이테」 (2026-11-26 대시보드형 전면 개편).
 *
 * 교과서형 1~4단계를 버리고 네 덩어리로 다시 짰다.
 *   ① 첫 화면 — 오늘 1억의 세 모습(원화·달러·금) + 원화 자산 위치 계기판(LensBoard)
 *   ② 바로 이어서 — 페이지 안 즉석 진단(LensDiagnose): 프리셋 한 번으로 환산·3층 비율·오늘 할 행동
 *   ③ 지금 시장은 어디에 있나(LensMarket, today.ts 연동)
 *   ④ 하단 컴팩트 — 착시 퀴즈 3문항 + 읽을거리 3편 + 6유형 표는 접어 둔다
 *
 * 값은 전부 `src/data/money-lens.ts`·`money-lens-tracks.ts`·`today.ts`에서 온다.
 * 화면에서 새 숫자를 만들지 않는다. 링크는 그릴 때 `withBase()`를 쓴다.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import LensBoard from "@/components/money-lens/LensBoard.tsx";
import LensDiagnose from "@/components/money-lens/LensDiagnose.tsx";
import LensMarket from "@/components/money-lens/LensMarket.astro";
import LensQuiz from "@/components/money-lens/LensQuiz.tsx";
import { withBase, site } from "@/config/site";
import { LENS_META, LENS_POSTS, LENS_VINTAGE } from "@/data/money-lens";
import { breadcrumbList, graph, partOfWebsite, pageUrl } from "@/lib/schema";

/** '2027-04-05' → '2027. 4. 5.' (사람이 읽는 날짜) */
const nextCheckLabel = (() => {
  const [y, m, d] = LENS_VINTAGE.nextCheckAt.split("-");
  return `${y}. ${Number(m)}. ${Number(d)}.`;
})();

/** 오늘 1억의 세 모습 — 데이터(META)에서만 계산한다. */
const NOW1EOK = (() => {
  const usd = 100000000 / LENS_META.fx.now;
  const grams = 100000000 / LENS_META.goldKrwPerG.now;
  return {
    usd: Math.round(usd).toLocaleString("ko-KR"),
    grams: grams.toFixed(1),
    don: Math.round(grams / 3.75),
  };
})();

/** 유형별 오늘 할 행동 6종 — 접어 두는 표. 링크는 지금 살아 있는 주소만 쓴다. */
const ACTIONS = [
  {
    kind: "버팀이 얇은 나무",
    when: "버팀 3개월 미만",
    action: "비상금 3개월치를 '지금 꺼낼 수 있는 통장'으로 모으면 얼마인지",
    tool: { label: "실업급여 확인", href: "/apps/unemployment-benefit/run" },
    post: { label: "비상금 3·6개월", href: "/posts/finance-emergency-fund-3-6" },
  },
  {
    kind: "자는 돈이 두꺼운 나무",
    when: "잠자는 돈 12개월치 이상",
    action: "잠자는 예금 1,000만 원의 12개월 세후 이자",
    tool: { label: "예금·적금", href: "/apps/compound-return/run" },
    post: { label: "예금자보호 1억", href: "/posts/deposit-protection-limit-100-million-check" },
  },
  {
    kind: "한 통화로 자란 나무",
    when: "진짜 돈 10% 미만 · 원화 80% 이상",
    action: "지난 10년 원화 자산의 달러 환산 수익률 확인",
    tool: { label: "계기판 10년", href: "/money-lens/" },
    post: { label: "환율과 장바구니", href: "/posts/economy-fx-grocery" },
  },
  {
    kind: "성장만 하는 나무",
    when: "일하는 돈 80% 이상 · 버팀 6개월 미만",
    action: "하락장 6개월을 현금으로 버티는 금액 계산",
    tool: { label: "대출 총이자", href: "/apps/loan-repay/run" },
    post: { label: "비상금 3·6개월", href: "/posts/finance-emergency-fund-3-6" },
  },
  {
    kind: "집 한 그루",
    when: "거주 주택 70% 이상",
    action: "집을 팔지 않고 쓸 수 있는 돈의 비중",
    tool: { label: "전세·월세", href: "/apps/rent-jeonse/run" },
    post: { label: "매수·전세 손익분기", href: "/posts/finance-buy-vs-jeonse-breakeven" },
  },
  {
    kind: "고른 나이테",
    when: "그 밖",
    action: "인출 순서(연금 → ISA → 일반계좌)에서 세금이 가장 적은 순서",
    tool: { label: "연금 인출", href: "/apps/pension-draw/run" },
    post: { label: "연금 4계좌", href: "/posts/pension-master-01-four-accounts" },
  },
] as const;

const jsonLd = graph([
  {
    "@type": "WebPage",
    "@id": `${pageUrl("/money-lens/")}#page`,
    name: "돈의 나이테 — 원화 자산이 지금 어디에 있나",
    description:
      "오늘 1억은 원화로 1억, 달러로 약 74,493달러, 금으로 566.6g입니다. 서울 아파트·예금·달러·금이 최근 10년 범위에서 지금 어디에 있는지 계기판으로 보고, 내 자산을 즉석에서 환산·진단합니다.",
    url: pageUrl("/money-lens/"),
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "돈의 나이테", path: "/money-lens/" },
  ]),
]);
---

<Base
  title="돈의 나이테 — 오늘 1억의 달러·금 위치를 한눈에"
  description="오늘 1억은 약 74,493달러, 금 566.6g. 서울 아파트·예금·달러·금이 최근 10년 범위에서 지금 어디에 있는지 계기판으로 확인하고, 내 자산을 즉석에서 환산·진단합니다."
  path="/money-lens/"
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-3 md:py-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <HomePill />
        <nav class="flex items-center gap-1.5 text-[11.5px] text-ink-faint" aria-label="위치">
          <a href={withBase("/")} class="inline-flex min-h-[24px] items-center hover:text-ink">홈</a>
          <span aria-hidden="true">/</span>
          <span class="text-ink-muted">돈의 나이테</span>
        </nav>
      </div>

      <div class="mt-1 max-w-[62ch]">
        <h1 class="text-[25px] font-bold tracking-[-0.04em] text-ink md:text-[36px]">돈의 나이테</h1>
        <p class="mt-1 text-[13.5px] leading-[1.6] text-ink-soft md:text-[14px]">
          같은 1억이 어디에 있느냐에 따라 10년 뒤 무게가 달라집니다. 원화로는 늘었는데 달러로는 줄어드는
          일이 실제로 일어납니다.
        </p>
      </div>

      {/* 오늘 1억의 세 모습 — 스크롤 없이 첫 화면에서 읽히는 요약 */}
      <div class="mt-2 max-w-[720px]" data-lens-anchor>
        <p class="text-[11.5px] font-semibold text-ink-faint">오늘 1억 원은</p>
        <ul class="mt-1 grid grid-cols-3 gap-1.5" aria-label="오늘 1억 원을 원화·달러·금으로 본 값">
          <li class="rounded-xl border border-line-soft bg-surface/80 px-2 py-1.5">
            <p class="text-[11px] text-ink-muted">원화로</p>
            <p class="mt-0.5 text-[16px] font-bold tabular-nums leading-tight tracking-[-0.02em] text-ink md:text-[20px]">
              1억<span class="ml-0.5 text-[11.5px] font-semibold text-ink-faint">원</span>
            </p>
          </li>
          <li class="rounded-xl border border-line-soft bg-surface/80 px-2 py-1.5">
            <p class="text-[11px] text-ink-muted">달러로</p>
            <p class="mt-0.5 text-[16px] font-bold tabular-nums leading-tight tracking-[-0.02em] text-ink md:text-[20px]">
              {NOW1EOK.usd}<span class="ml-0.5 text-[11.5px] font-semibold text-ink-faint">달러</span>
            </p>
          </li>
          <li class="rounded-xl border border-line-soft bg-surface/80 px-2 py-1.5">
            <p class="text-[11px] text-ink-muted">금으로</p>
            <p class="mt-0.5 text-[16px] font-bold tabular-nums leading-tight tracking-[-0.02em] text-ink md:text-[20px]">
              566.6<span class="ml-0.5 text-[11.5px] font-semibold text-ink-faint">g</span>
            </p>
          </li>
        </ul>
        <p class="mt-1 text-[11px] tabular-nums leading-snug text-ink-faint">
          금 {NOW1EOK.grams}g ≈ 약 {NOW1EOK.don}돈 · 1달러{" "}
          {LENS_META.fx.now.toLocaleString("ko-KR", { maximumFractionDigits: 2 })}원 · g당{" "}
          {Math.round(LENS_META.goldKrwPerG.now).toLocaleString("ko-KR")}원 (2026. 10. 월평균 환산)
        </p>
      </div>

      <p class="mt-1.5 text-[10.5px] leading-snug text-ink-faint">
        지표 확인 {LENS_META.asOfLabel} · 콘텐츠 기준일 {site.baseDateLabel} · 다음 갱신 {nextCheckLabel}
      </p>
    </div>
  </section>

  {/* ① 계기판 — 첫 화면 바로 아래에서 시작해 스크롤 한 번으로 끝난다 */}
  <section class="scene-white border-b border-line">
    <div class="wrap py-3 md:py-8">
      <LensBoard client:visible />
    </div>
  </section>

  {/* ② 페이지 안 즉석 진단 — 이동 없이 한 화면에서 */}
  <section class="scene-mist border-b border-line">
    <div class="wrap py-5 md:py-10">
      <div class="max-w-[68ch]">
        <h2 class="text-[21px] font-bold tracking-[-0.03em] text-ink md:text-[26px]">
          내 자산 즉석 환산 &amp; 균형 진단
        </h2>
        <p class="mt-1.5 text-[13.5px] leading-[1.7] text-ink-soft">
          예시를 누르거나 여섯 칸을 채우면 바로 나옵니다 — 순자산의 달러·금 환산, 진짜 돈·일하는 돈·잠자는
          돈의 비율, 그리고 유형에 맞는 오늘 할 행동 하나.
        </p>
      </div>

      <div class="mt-3">
        <LensDiagnose client:visible />
      </div>
    </div>
  </section>

  {/* ③ 지금 시장은 어디에 있나 */}
  <section class="scene-white border-b border-line">
    <div class="wrap py-4 md:py-10">
      <LensMarket />
    </div>
  </section>

  {/* ④ 하단 컴팩트 — 퀴즈 3문항 + 읽을거리 3편 */}
  <section class="scene-cream border-b border-line">
    <div class="wrap py-5 md:py-10">
      <div class="max-w-[68ch]">
        <h2 class="text-[21px] font-bold tracking-[-0.03em] text-ink md:text-[26px]">같은 숫자, 다른 답 — 3문항</h2>
        <p class="mt-1.5 text-[13.5px] leading-[1.7] text-ink-soft">
          고르면 계산 과정이 바로 펼쳐집니다. 점수는 매기지 않습니다.
        </p>
      </div>

      <div class="mt-3">
        <LensQuiz client:visible />
      </div>

      <p class="mt-2 text-[11px] leading-relaxed text-ink-faint" data-lens-disclaimer="quiz">
        퀴즈의 숫자는 이 화면의 공식 통계(2026. 10. 기준)로 계산했습니다. 실제 상품의 수익률·보장은 약관과
        계약 조건에 따르며, 이 결과는 이해를 돕기 위한 교육용입니다.
      </p>

      <div class="mt-5">
        <h3 class="text-[14.5px] font-bold tracking-[-0.02em] text-ink">더 읽기</h3>
        <ul class="mt-1.5 grid gap-1.5 md:grid-cols-3">
          {
            LENS_POSTS.map((p) => (
              <li>
                <a href={withBase(`/posts/${p.id}`)} class="card card-lift flex h-full items-baseline gap-2 px-3 py-2 md:flex-col md:items-start md:gap-0 md:py-3.5">
                  <span class="text-[12.5px] font-bold leading-snug text-ink md:text-[13px]">{p.title}</span>
                  <span class="text-[11px] leading-snug text-ink-faint md:mt-1 md:text-[11.5px] md:leading-relaxed md:text-ink-muted">{p.why}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* 접어 둔 6유형 표 — 필요할 때만 펼친다(모바일 세로 길이 절약) */}
  <section class="scene-white border-b border-line">
    <div class="wrap py-4 md:py-8">
      <details class="rounded-2xl border border-line bg-surface" data-lens-actions>
        <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between gap-2 px-4 text-[14px] font-bold text-ink">
          유형별 오늘 할 행동 6가지 (펼쳐 보기)
          <span class="text-[11.5px] font-normal text-ink-faint">동사 하나, 숫자 하나, 10분</span>
        </summary>
        <div class="overflow-x-auto px-3 pb-3">
          <table class="table-stack w-full border-collapse text-[12.5px]">
            <caption class="sr-only">진단 유형별 오늘 할 행동과 도구, 글</caption>
            <thead>
              <tr class="border-b border-line text-[11.5px] text-ink-faint">
                <th scope="col" class="px-2 py-2 text-left font-semibold">유형</th>
                <th scope="col" class="px-2 py-2 text-left font-semibold">오늘 할 행동 (10분)</th>
                <th scope="col" class="px-2 py-2 text-left font-semibold">도구</th>
                <th scope="col" class="px-2 py-2 text-left font-semibold">글</th>
              </tr>
            </thead>
            <tbody>
              {
                ACTIONS.map((a) => (
                  <tr class="border-b border-line-soft last:border-0">
                    <th scope="row" class="px-2 py-2 text-left align-top">
                      <span class="block font-semibold text-ink">{a.kind}</span>
                      <span class="mt-0.5 block text-[11px] font-normal text-ink-faint">{a.when}</span>
                    </th>
                    <td data-label="오늘 할 행동" class="px-2 py-2 align-top text-ink-soft">{a.action}</td>
                    <td data-label="도구" class="px-2 py-2 align-top">
                      <a href={withBase(a.tool.href)} class="link inline-flex min-h-[44px] items-center text-brand-deep">
                        {a.tool.label}
                      </a>
                    </td>
                    <td data-label="글" class="px-2 py-2 align-top">
                      <a href={withBase(a.post.href)} class="link inline-flex min-h-[44px] items-center text-ink-muted">
                        {a.post.label}
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="mt-2 px-1 text-[11px] leading-relaxed text-ink-faint" data-lens-disclaimer="actions">
            상품을 권하지 않습니다. 계산과 확인까지만 합니다.
          </p>
        </div>
      </details>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a href={withBase("/apps/money-ring/run")} class="btn btn-secondary btn-sm">심화 진단 열기</a>
        <a href={withBase("/academy/track/pension-tax/")} class="btn btn-secondary btn-sm">연금·세금 3단계 트랙</a>
        <a href={withBase("/apps")} class="link inline-flex min-h-[44px] items-center text-[12.5px] text-ink-muted">
          도구 전체 보기
        </a>
      </div>
    </div>
  </section>
</Base>
