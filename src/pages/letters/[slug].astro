---
/**
 * 소식지 한 호(/letters/2026-11-21) — 파이프라인이 만든 letters/*.md 본문을 그대로 보여 준다.
 * 복사용 채널 본문, 사이트 링크, 확인한 출처가 한 페이지에 남는다.
 */
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site, absolute } from "@/config/site";
import { formatDate, koreanDate, allPosts } from "@/lib/posts";
import { allLetters, letterPath, issueLabel } from "@/lib/letters";
import { AUTHOR_ID, ORG_ID, breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

export async function getStaticPaths() {
  const list = await allLetters();
  return list.map((letter, i) => ({
    params: { slug: letter.id },
    props: { letter, newer: list[i - 1], older: list[i + 1] },
  }));
}

const { letter, newer, older } = Astro.props;
const { Content } = await render(letter);
const posts = await allPosts();
const titleOf = new Map(posts.map((p) => [p.id, p.data.title]));
const path = letterPath(letter);
const published = letter.data.date.toISOString().slice(0, 10);

const jsonLd = graph([
  {
    "@type": "Article",
    "@id": `${pageUrl(path)}#article`,
    headline: `${issueLabel(letter.data.issue)} — ${koreanDate(letter.data.date)} 소식지`,
    description: `확인한 기록 ${letter.data.posts.length}편을 묶은 소식지 ${issueLabel(letter.data.issue)}입니다.`,
    datePublished: published,
    inLanguage: "ko-KR",
    author: { "@id": AUTHOR_ID },
    publisher: { "@id": ORG_ID },
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl(path) },
    isPartOf: partOfWebsite,
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "소식지", path: "/letters" },
    { name: issueLabel(letter.data.issue), path },
  ]),
]);
---

<Base
  title={`${issueLabel(letter.data.issue)} — ${koreanDate(letter.data.date)} 소식지`}
  description={`확인한 기록 ${letter.data.posts.length}편을 묶은 소식지 ${issueLabel(letter.data.issue)}입니다. 담긴 글과 1차 출처를 함께 확인할 수 있습니다.`}
  path={path}
  type="article"
  publishedTime={published}
  jsonLd={jsonLd}
>
  <article>
    <header class="border-b border-line">
      <div class="wrap py-8 md:py-12">
        <HomePill />
        <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
          <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">홈</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("/letters")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">소식지</a>
          <span aria-hidden="true">/</span>
          <span>{issueLabel(letter.data.issue)}</span>
        </nav>

        <div class="mt-6 max-w-[66ch]">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px]">
            <span class="font-semibold text-brand">소식지</span>
            <span class="mono text-ink-muted">{issueLabel(letter.data.issue)}</span>
            <time class="dateline" datetime={published}>{formatDate(letter.data.date)}</time>
            <span class="text-ink-faint">글 {letter.data.posts.length}편 · 출처 {letter.data.sources.length}곳</span>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap py-9 md:py-14">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_270px] lg:gap-16">
        <div class="min-w-0">
          <div class="prose-article prose-letter max-w-[66ch]">
            <Content />
          </div>

          <nav class="mt-10 grid gap-6 border-t border-ink pt-5 sm:grid-cols-2" aria-label="이전·다음 호">
            {
              older ? (
                <a href={withBase(letterPath(older))} class="group">
                  <span class="text-[12px] text-ink-faint">이전 호</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {issueLabel(older.data.issue)} — {formatDate(older.data.date)}
                  </p>
                </a>
              ) : (
                <span />
              )
            }
            {
              newer && (
                <a href={withBase(letterPath(newer))} class="group sm:text-right">
                  <span class="text-[12px] text-ink-faint">다음 호</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {issueLabel(newer.data.issue)} — {formatDate(newer.data.date)}
                  </p>
                </a>
              )
            }
          </nav>

          <HomePill position="bottom" />
        </div>

        <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
          <div>
            <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">이 호에 담긴 글</h2>
            <ul class="mt-2 space-y-2">
              {letter.data.posts.map((slug) => (
                <li class="text-[12.5px] leading-snug">
                  <a href={withBase(`/posts/${slug}`)} class="text-ink-muted hover:text-ink link">
                    {titleOf.get(slug) ?? slug}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {
            letter.data.sources.length > 0 && (
              <div class="border-t border-line pt-4">
                <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">확인한 출처</h2>
                <ul class="mt-3 space-y-2">
                  {letter.data.sources.map((s) => (
                    <li class="text-[12px] leading-[1.6] text-ink-muted">
                      {s.url ? (
                        <a href={s.url} target="_blank" rel="noopener noreferrer" class="link">{s.label}</a>
                      ) : (
                        s.label
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="border-t border-line pt-4">
            <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">지난 호</h2>
            <a href={withBase("/letters")} class="mt-2 inline-flex min-h-[44px] items-center text-[12.5px] font-semibold text-brand-deep md:min-h-[24px]">
              소식지 아카이브
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>
