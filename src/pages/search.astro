---
import Base from "@/layouts/Base.astro";
import SearchApp from "@/components/SearchApp.tsx";
import HomePill from "@/components/HomePill.astro";
import { site } from "@/config/site";
import { allPosts } from "@/lib/posts";
import { apps } from "@/data/apps";
import { storeCount } from "@/data/store";
import { calendar } from "@/data/calendar";

const posts = await allPosts();
---

<Base
  title="검색 — 자산리포트·앱·골든타임"
  description="자산리포트 본문, 제목, 태그와 앱 이름, 골든타임 일정을 한 번에 찾습니다. 서버 없이 브라우저에서 검색합니다."
  path="/search"
  noindex={true}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-9 md:py-12">
      <HomePill />
      <p class="kicker">검색</p>
      <h1 class="h-display mt-3 max-w-[18ch]">한 번에 찾기.</h1>
      <p class="lede mt-3 max-w-[54ch]">
        제목만이 아니라 본문, 태그, 앱 설명, 골든타임 일정까지 함께 찾습니다. 입력하는 즉시 결과가
        바뀝니다.
      </p>
      <div class="mt-7 max-w-[760px]">
        <SearchApp variant="page" client:load />
      </div>
    </div>
  </section>

  <section class="wrap py-8">
    <dl class="grid grid-cols-3 gap-4 border-t border-ink pt-4 text-[13px]">
      <div>
        <dt class="text-ink-faint">자산리포트</dt>
        <dd class="mt-1 text-[19px] font-bold tabular-nums text-ink">{posts.length}편</dd>
      </div>
      <div>
        <dt class="text-ink-faint">앱스토어</dt>
        <dd class="mt-1 text-[19px] font-bold tabular-nums text-ink">{storeCount}종</dd>
      </div>
      <div>
        <dt class="text-ink-faint">골든타임</dt>
        <dd class="mt-1 text-[19px] font-bold tabular-nums text-ink">{calendar.length}건</dd>
      </div>
    </dl>
    <p class="mt-0 text-[12px] text-ink-faint">
      앱스토어 {storeCount}종 = 계산·도구 {apps.length}종 + 금융 일정 달력 + 자료앨범. 기준일
      {site.baseDateLabel} 이 화면은 검색엔진 색인에서 제외됩니다.
    </p>
    <HomePill position="bottom" />
  </section>
</Base>
