---
import Base from "@/layouts/Base.astro";
import BrandFilm from "@/components/home/BrandFilm.tsx";
import StartHere from "@/components/home/StartHere.astro";
import TodayHub from "@/components/home/TodayHub.astro";
import AudiencePick from "@/components/home/AudiencePick.astro";
import UsageGuide from "@/components/home/UsageGuide.astro";
import DepthMark from "@/components/DepthMark.astro";
import TrustSplit from "@/components/home/TrustSplit.astro";
import ChannelBand from "@/components/home/ChannelBand.astro";
import PortalPicks from "@/components/home/PortalPicks.astro";
import ToolPreview from "@/components/ToolPreview.astro";
import Guide from "@/components/guide/Guide.astro";
import { withBase, site } from "@/config/site";
import { channels } from "@/data/channels";
import { mainTools } from "@/data/tools";
import { APP_CATEGORIES } from "@/data/apps";
import { categoryCount, storeCount, toolCount } from "@/data/store";
import { depthOfTool } from "@/data/depth";
import { calendar } from "@/data/calendar";
import { galleryCount, gallerySlideCount } from "@/data/gallery";
import { boardEntries } from "@/data/board";
import { allPosts } from "@/lib/posts";
import { graph, organizationNode, personNode, websiteNode } from "@/lib/schema";

/**
 * buffetkimz v8.7.0 — 브랜드 필름(1P) → 오늘 확인 허브 → 읽고 열어 보기 → 도구 → 기준 → 채널.
 *
 *   v8.7.0(2026-11-23) '덜어내기' 1단계 — 홈 9섹션 270링크를 5블록으로 줄였다(감사 보고 D1~D5).
 *     ① 필름 + 크레딧 **1줄**(기록·카드·도구·일정)
 *     ② 오늘 확인 허브(지표 4 · 3줄 · 기한 인용 · 카드)
 *     ③ 읽고 열어 보기(최신 글 3편 + 앱 추천 4종) — 소개(1,053자)·아카이브(36링크)·
 *        금융생활학교 밴드는 홈에서 내렸다. 소개는 /about, 전체 목록은 /posts·/academy가 맡는다.
 *     ④ 도구(대표 계산기 4개) — 지표 스트립·보험 칩 줄·달력 카드는 3중 노출이라 걷어냈다.
 *     ⑤ 기준(신뢰) → ⑥ 채널
 *
 * 배경 리듬: 나이트(1) → 화이트(②) → 크림(③) → 미스트(④) → 스카이밴드(⑤) → 화이트+딥그린(⑥)
 *
 * 원칙: 홈은 대표만 보여 주고, 전체 목록은 각 축 페이지가 한 번만 펼친다(감사 R1·R5).
 */
const posts = await allPosts();
const sourcedCalendar = calendar.filter((c) => Boolean(c.source));

/**
 * 도구 크레딧 숫자는 손으로 적지 않는다 — store.ts의 카테고리 합과 총합이 다르면 빌드를 세운다.
 */
const categorySum = APP_CATEGORIES.reduce((n, c) => n + categoryCount(c.id), 0);
if (categorySum !== storeCount) {
  throw new Error(`앱스토어 카테고리 합 ${categorySum} ≠ 전체 ${storeCount}. store.ts의 category를 확인하세요.`);
}
const channelCount = channels.length;

/**
 * 홈에 세우는 대표 도구 — 계산기가 있는 네 개(세액공제·인출·은퇴·복리).
 * 달력은 도구 카드가 아니라 섹션 머리의 한 줄 링크로 보낸다(카드 3중 노출 제거).
 */
const homeTools = mainTools.filter((t) => Boolean(t.runHref));

const shortToolLabel: Record<string, string> = {
  pension: "세액공제 계산 열기",
  "pension-draw": "인출 세금 계산 열기",
  "retirement-flow": "은퇴 계산 열기",
  "compound-return": "복리 계산 열기",
  "coverage": "보장 점검 열기",
  "disclosure": "고지 체크 열기",
  "silson": "실손 비교 열기",
};

const previewVariant: Record<string, "pension" | "pension-draw" | "retirement" | "compound" | "calendar"> = {
  pension: "pension",
  "pension-draw": "pension-draw",
  "retirement-flow": "retirement",
  "compound-return": "compound",
};

const jsonLd = graph([websiteNode(), organizationNode(), personNode()]);
---

<Base
  title="buffetkimz — 숫자 너머의 기준, 금융·투자·연금·노후·보험의 기록"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ① 첫 화면 — 3초 재무 진단 · 13월의 월급 지도 · 이달의 기한 · 계산기 4개 (v9.8.0) -->
  <StartHere />

  <!-- ② 오늘 확인 허브 — 지표 4 · 3줄 · 기한 인용 · 확인 카드 -->
  <TodayHub />

  <!-- ②-1 데일리 브리프 게시판 — 허브에 다 담지 못한 확인 메모로 가는 한 줄 (v9.2.0) -->
  <section class="scene-white border-b border-line" aria-label="데일리 브리프 게시판 안내">
    <div class="wrap pb-8 md:pb-10">
      <div class="board-entry">
        <p class="board-entry-text">
          <span class="board-entry-kicker">데일리 브리프</span>
          오늘 허브에 다 담지 못한 시황·제도·AI 메모를 하루 세 번(06:00 · 13:00 · 19:00) 확인해 쌓아 둡니다.
          지금 <b class="mono text-ink">{boardEntries.length}</b>건.
        </p>
        <a class="btn btn-secondary btn-sm board-entry-link" href={withBase("/board")}>
          데일리 브리프 게시판 보기
        </a>
      </div>
    </div>
  </section>

  <!-- ②-2 사용법 5탭 안내 — 왼쪽 설명, 오른쪽 화면 예시, 자동 순환 (깃밥 벤치마킹 2항) -->
  <UsageGuide />

  <!-- ⑥-1 상황별 맞춤 — 한 번 고르면 그 상황의 계산기·글이 바뀐다 (깃밥 벤치마킹 1항) -->
  <AudiencePick />

  <!-- ③ 읽고 열어 보기 — 자산리포트 최신 3편 + 앱스토어 추천 4종 -->
  <PortalPicks />

  <!-- ④ 미스트 — 대표 계산기 4개 (첫 화면의 빠른 계산기 4개와 다른 도구) -->
  <section class="scene-mist border-b border-line" data-area="4" id="tools">
    <div class="wrap py-10 md:py-14">
      <div class="sec-head" data-guide="tools">
        <div>
          <p class="eyebrow">도구</p>
          <h2 class="sec-title">가입 없이,<br />브라우저에서 바로</h2>
        </div>
        <div class="sec-head-side">
          <p class="sec-desc">
            입력한 값은 서버로 보내지 않고 그 탭 안에서만 계산합니다. 주소 단축기의 짧은 주소 생성만
            외부 단축 서비스로 전송됩니다.<br />
            모든 도구에 예시 입력값·계산 기준·출처·기준일을 함께 적었습니다.
          </p>
          <div class="sec-head-actions">
            <a href={withBase("/apps")} class="btn btn-secondary btn-sm">도구 {toolCount}종 전체</a>
            <a href={withBase("/calendar")} class="btn btn-tertiary btn-sm">금융 일정 {sourcedCalendar.length}건</a>
          </div>
        </div>
      </div>

      <ul class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-4" data-main-tools>
        {
          homeTools.map((t) => (
            <li class="card card-lift flex flex-col p-4 md:p-5">
              <div>
                <div class="flex items-center justify-between gap-2">
                  {depthOfTool(t.key) && <DepthMark depth={depthOfTool(t.key)!} />}
                  <span class="min-w-0 text-right text-[12px] leading-snug text-ink-faint">{t.meta}</span>
                </div>
                <h3 class="mt-1 text-[15px] font-bold leading-snug tracking-[-0.025em] text-ink">{t.name}</h3>
                <p class="clamp-2 mt-1.5 text-[12.5px] leading-[1.6] text-ink-muted">{t.short}</p>
              </div>

              <div class="mt-3">
                <ToolPreview variant={previewVariant[t.key] ?? "pension"} />
              </div>

              <div class="mt-auto pt-3">
                <a href={withBase(t.runHref ?? t.href)} class="btn btn-secondary btn-sm w-full">
                  {shortToolLabel[t.key] ?? "계산해 보기"}
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-ink-faint">
        <span>예시 입력값은 가상입니다</span>
        <span>결과는 판정이 아니라 확인할 항목</span>
        <span>연금 예상액은 공단 확정액 아님</span>
        <span>원금 손실 가능</span>
      </p>
    </div>
  </section>

  <!-- ⑤ 필름 — 소개 영역의 마지막. 첫 화면에서 내려 브랜드 이야기로 남긴다 (v9.8.0)
       · h1은 첫 화면(StartHere)이 갖는다. 여기 문장은 h2로 같은 모양을 유지한다.
       · 일간 머리글(기준일·확인 시각)은 첫 화면으로 옮겼다 — 같은 날짜를 두 번 쓰지 않는다. -->
  <section data-area="1" id="film" class="hero-film">
    <BrandFilm client:load appsHref={withBase("/apps")} aboutHref={withBase("/about")} />

    <!--
      크레딧 1줄 — 상영관에서 종이로 돌아오는 경계 (v8.7.0: 5줄 + 기준일 2줄 → 1줄)
      v9.5.0(2026-11-24 1단계) — 필름 아래 첫 문장이 '무엇을 하는 곳인지'를 말하게 했다.
        필름 12초는 그대로 두고, 필름 바로 아래(첫 화면 안)에 정의 한 줄 + 버튼 1개를 둔다.
        정의문은 전수 감사 §2-4의 B안 — 이 사이트가 미리 계산해 두는 곳이라는 약속만 말한다.
    -->
    <div class="film-credits" id="film-credits">
      <div class="hero-def" id="hero-def">
        {/*
          v9.6.0(2026-11-25) — 첫 화면의 h1.
            감사 P0-1: 화면에서 가장 큰 첫 화면 글자가 24px(필름 정적 록업)이고 섹션 h2가 34px이라
            위계가 뒤집혀 있었다. sr-only h1을 지우고, 이 정의문을 실제 h1(모바일 27px · 넓은 화면 40px)으로
            승격해 h2(24~34px) 위에 세운다. 카피는 확정된 B안 그대로다.
        */}
        <h2 class="hero-def-line">
          받을 때 알게 되는 연금,<br />5월에 알게 되는 세금 — <span class="hero-def-tail">미리 계산해 두는 곳</span>
        </h2>
        <a class="btn btn-primary hero-def-cta" href={withBase("/apps")}>계산기 열어 보기</a>
      </div>

      <p class="film-credit-line">
        <a href={withBase("/posts")}><b>{posts.length}</b>편 기록</a>
        <span aria-hidden="true">·</span>
        <a href={withBase("/gallery")}><b>{galleryCount}</b>세트 카드 {gallerySlideCount}장</a>
        <span aria-hidden="true">·</span>
        <a href={withBase("/apps")}><b>{toolCount}</b>종 도구</a>
        <span aria-hidden="true">·</span>
        <a href={withBase("/calendar")}><b>{sourcedCalendar.length}</b>건 일정</a>
      </p>
    </div>
  </section>


  <!-- ⑤ 신뢰 2단 스플릿 (이번 달 달력 카드는 v8.7.0에서 걷어냈다 — 허브·/calendar와 중복) -->
  <TrustSplit postsCount={posts.length} toolCount={toolCount} channelCount={channelCount} />

  <!-- ⑥ 확인된 링크 + 딥그린 상담문의 배너 -->
  <ChannelBand />

  <!-- 첫 방문 3스텝 스포트라이트 투어 + `? 가이드` (driver.js) -->
  <Guide mode="home" />
</Base>

<style>
  /*
   * 필름 아래 정의 한 줄 — 필름이 다 쓰지 않은 첫 화면의 마지막 띠.
   * 필름 높이에서 이 띠의 높이를 빼 두어(global.css `.film-stage`) 390에서도 스크롤 없이 문장과 버튼이 보인다.
   */
  .hero-film {
    /*
     * 이 값은 .hero-def 띠의 **실제 높이**여야 한다.
     * 필름 높이(calc(100svh - 헤더 - 이 값))가 이 값을 빼고 그리므로, 실제 높이보다 작으면
     * 히어로가 첫 화면을 넘고(감사 44c·44d), 크면 필름 아래에 흰 여백이 남는다.
     * 2026-11-25 실측(깃밥 벤치마킹 3항으로 일간 머리글을 더한 뒤):
     *   390 = 245px(머리글 38 + 정의 띠 167 + 크레딧 2줄 38 + 괘선) · 1440 = 209px(머리글 42 + 띠 128 + 크레딧 38 + 괘선).
     *   2px은 서브픽셀 반올림 여유 — 히어로가 첫 화면을 1px이라도 넘지 않게.
     *   이 띠의 문구·크기를 고치면 1440·390에서 `.film-credits` 높이를 다시 재서 이 값을 고친다.
     */
    --hero-def-h: 247px;
  }

  @media (min-width: 768px) {
    .hero-film {
      --hero-def-h: 211px;
    }
  }

  /*
   * 일간 머리글 — 신문 1면의 날짜 줄처럼. 왼쪽 날짜, 가운데 한 줄, 오른쪽 확인 시각.
   * 390에서는 가운데 줄을 접어 높이를 아끼고 날짜·확인 시각만 남긴다(첫 화면 안에 히어로가 끝나야 한다).
   */
  .daily-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    max-width: 1200px;
    margin-inline: auto;
    padding: 8px 16px;
    border-bottom: 1px solid var(--color-line);
  }

  .daily-date {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--color-ink);
  }

  .daily-date-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink-faint);
  }

  .daily-date time {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }

  .daily-weekday {
    font-size: 12.5px;
    color: var(--color-ink-muted);
  }

  .daily-line {
    flex: 1 1 auto;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--color-ink-faint);
    word-break: keep-all;
  }

  .daily-check {
    font-size: 12px;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .daily-head {
      padding: 12px 16px 8px;
    }
  }

  @media (max-width: 767px) {
    .daily-line {
      display: none;
    }
  }

  .hero-def {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    max-width: 1200px;
    margin-inline: auto;
    padding: 10px 16px 2px;
  }

  @media (min-width: 768px) {
    .hero-def {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 16px 6px;
    }
  }

  .hero-def-line {
    margin: 0;
    font-size: clamp(27px, 3.6vw, 40px);
    line-height: 1.3;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    /* 한 문장을 두 절로 끊어 읽힌다 — 절 경계는 <br>이 정하고, balance가 다시 흔들지 않게 한다 */
    text-wrap: initial;
  }

  .hero-def-tail {
    color: var(--color-brand-deep);
    /* 이 다섯 단어는 한 덩어리로 읽힌다 — 좁은 화면에서 "미리 / 계산해"로 끊기지 않게 */
    white-space: nowrap;
  }

  .hero-def-cta {
    flex: none;
    min-height: 44px;
    white-space: nowrap;
  }

  /* 허브 아래 한 줄 — 새 구역을 만들지 않고 '게시판으로 가는 문'만 놓는다 */
  .board-entry {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 18px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: linear-gradient(180deg, #fff 0%, var(--color-paper-deep) 100%);
    padding: 12px 14px;
  }

  @media (min-width: 768px) {
    .board-entry {
      padding: 12px 18px;
    }
  }

  .board-entry-text {
    flex: 1 1 320px;
    min-width: 0;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--color-ink-muted);
    overflow-wrap: anywhere;
  }

  .board-entry-kicker {
    display: inline-block;
    margin-right: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-brand-deep);
  }

  .board-entry-link {
    flex: none;
  }
</style>
