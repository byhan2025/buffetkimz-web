---
import Base from "@/layouts/Base.astro";
import HeroToolCard from "@/components/HeroToolCard.astro";
import CoverageGauge from "@/components/CoverageGauge.astro";
import PostCards from "@/components/PostCards.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { apps, appBySlug } from "@/data/apps";
import { calendar } from "@/data/calendar";
import { channels, confirmedLinks } from "@/data/channels";
import { hubTools } from "@/data/tools";
import { categoryName } from "@/data/categories";
import { allPosts, postPath, formatDate, koreanDate, shouldShowQuestion, sourceOrgLine } from "@/lib/posts";

const posts = await allPosts();
const thisMonth = site.today.getMonth() + 1;

const feature = posts[0];
const featureApp = feature.data.app ? appBySlug(feature.data.app) : undefined;

const cardItems = posts.slice(1, 4).map((p) => {
  const app = p.data.app ? appBySlug(p.data.app) : undefined;
  return {
    url: postPath(p),
    title: p.data.title,
    description: p.data.description,
    categoryName: categoryName(p.data.category),
    date: formatDate(p.data.publishedAt),
    readingMinutes: p.data.readingMinutes,
    question: p.data.question ?? app?.question,
    toolName: p.data.toolTitle ?? (app ? `${app.name.replace(" 시뮬레이터", "").replace(" 계산기", "")} 열기` : undefined),
    toolUrl:
      p.data.toolHref ?? (app?.internal ? `/apps/${app.slug}/run` : app ? `/apps/${app.slug}` : undefined),
    baseDate: site.baseDate,
    sourceCount: p.data.sources.length,
    sourceOrgLine: sourceOrgLine(p.data.sources),
  };
});

/* 피처 카드의 질문 — 제목과 겹치면 표시하지 않는다 */
const featureQuestion = feature.data.question ?? featureApp?.question;
const featureQuestionVisible = shouldShowQuestion(featureQuestion, feature.data.title);

const monthItems = calendar.filter((c) => c.month === thisMonth);
const spotlight = [
  ...monthItems.filter((c) => c.key),
  ...monthItems.filter((c) => !c.key),
].slice(0, 4);

/**
 * 실측 수치 — 글 컬렉션·도구 배열·제도 일정 데이터에서 빌드 시점에 그대로 센다.
 * 손으로 적은 숫자를 두지 않는다(콘텐츠가 늘면 같이 늘어야 한다).
 * 제도 일정은 공식 출처(source)가 적힌 항목만 센다.
 */
const sourcedCalendar = calendar.filter((c) => Boolean(c.source));
const toolCount = hubTools.length;
const searchItems = posts.length + apps.length + calendar.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.brand,
      description: site.description,
      inLanguage: "ko-KR",
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#author`,
      name: site.brand,
      description: site.author.bio,
      url: `${site.url}/about`,
    },
  ],
};
---

<Base
  title="buffetkimz — 금융의 기록과 직접 만든 도구"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 : 화이트·스카이블루 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap pt-8 md:pt-14">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/10 pb-3">
        <p class="text-[12.5px] font-semibold tracking-[-0.01em] text-ink-soft">
          금융 · 보험 · 연금 · 노후 · AI
        </p>
        <p class="mono text-[12px] text-ink-faint">
          <time datetime={site.baseDate}>{koreanDate(site.today)}</time> 기준
        </p>
      </div>

      <div class="grid items-center gap-10 pb-14 pt-8 md:pb-16 md:pt-10 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14 lg:pb-20">
        <div>
          <h1 class="h-display hero-title max-w-[15ch] text-ink">
            숫자를 확인하고,<br />기록으로 남깁니다.
          </h1>
          <p class="lede hero-soft mt-5 max-w-[44ch]">
            금리와 환율, 보험과 연금, 노후와 AI. 공개된 1차 자료로 확인한 기준과 출처를 붙여 매일
            한 편씩 남기고, 되풀이되는 계산은 브라우저에서 바로 쓰는 도구로 옮겼습니다.
          </p>

          <div class="hero-soft mt-7 flex flex-wrap items-center gap-2.5">
            <a href={withBase("/apps")} class="btn btn-solid">도구 다섯 가지</a>
            <a href={withBase("/posts")} class="btn btn-line">기록 {posts.length}편 읽기</a>
          </div>

          <div class="hero-soft mt-6 space-y-1 text-[12px] leading-relaxed text-ink-muted">
            <p>기록 <strong class="font-semibold text-ink">{posts.length}편</strong> · 도구 <strong class="font-semibold text-ink">{toolCount}종</strong> · 제도 일정 <strong class="font-semibold text-ink">{sourcedCalendar.length}건</strong></p>
            <p>모든 글에 기준일·1차 출처 · <span class="mono">기준일 <time datetime={site.baseDate}>{site.baseDate}</time></span></p>
          </div>
          <p class="hero-soft mt-4">
            <a
              href={withBase("/search")}
              class="inline-flex min-h-[44px] items-center gap-2 text-[13.5px] font-semibold text-ink-soft hover:text-brand-deep"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="11" cy="11" r="6.4"></circle>
                <path d="m16 16 4.2 4.2" stroke-linecap="round"></path>
              </svg>
              글·도구·제도 {searchItems}개 항목 검색
              <span class="kbd hidden sm:inline-flex" aria-hidden="true">⌘K</span>
            </a>
          </p>
        </div>

        <div class="mx-auto w-full max-w-[430px] lg:mr-0 lg:max-w-none">
          <HeroToolCard />
        </div>
      </div>
    </div>

    <!-- 히어로 경계에 겹치는 5대 탐색 카드 -->
    <div class="wrap relative z-10 -mb-14 md:-mb-16">
      <ul class="grid grid-cols-2 gap-2.5 md:grid-cols-5 md:gap-3">
        {
          hubTools.map((t, i) => (
            <li class={i === hubTools.length - 1 ? "col-span-2 md:col-span-1" : ""}>
              <a
                href={withBase(t.href)}
                class="card card-lift flex h-full min-h-[152px] flex-col p-4 md:min-h-[168px]"
              >
                <span class="text-[13.5px] font-bold leading-snug tracking-[-0.02em] text-ink">{t.name}</span>
                <span class="mt-1.5 text-[12px] leading-[1.6] text-ink-muted">{t.short}</span>
                <span class="mt-auto pt-3 text-[12px] font-semibold text-brand-deep">
                  {t.runHref ? "계산해 보기" : "달력 열기"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ② 크림 : 최근 기록 -->
  <section class="scene-cream pt-16 md:pt-20">
    <div class="wrap py-10 md:py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="kicker">기록</p>
          <h2 class="h-section mt-2">요즘 확인한 것</h2>
        </div>
        <a href={withBase("/posts")} class="inline-flex min-h-[44px] items-center text-[13.5px] font-semibold text-ink-soft link">기록 {posts.length}편 전체</a>
      </div>

      <!-- 피처 1 -->
      <a href={withBase(postPath(feature))} class="group mt-7 block">
        <div class="card card-lift grid gap-5 p-5 md:grid-cols-[1.35fr_0.65fr] md:items-center md:p-7">
          <div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="text-[12px] font-semibold text-brand">{categoryName(feature.data.category)}</span>
              <span class="mono text-[12px] text-ink-faint">{formatDate(feature.data.publishedAt)}</span>
              <span class="text-[12px] text-ink-faint">{feature.data.readingMinutes}분</span>
            </div>
            {featureQuestionVisible && (
              <p class="clamp-2 mt-3 text-[13.5px] font-semibold text-ink-muted">
                <span class="text-brand">Q.</span> {featureQuestion}
              </p>
            )}
            <h3 class="mt-1.5 max-w-[26ch] text-[clamp(20px,2.4vw,27px)] font-bold leading-[1.35] tracking-[-0.035em] text-ink group-hover:text-brand-deep">
              {feature.data.title}
            </h3>
            <p class="mt-3 max-w-[52ch] text-[14px] leading-[1.75] text-ink-muted">{feature.data.description}</p>
            <p class="mono mt-3 text-[12px] leading-relaxed text-ink-faint" data-card-meta>
              확인 기준일 {site.baseDate} · {sourceOrgLine(feature.data.sources)}
            </p>
          </div>

          <div class="flex flex-col gap-2 rounded-xl bg-paper-deep/70 p-4">
            <p class="text-[12px] font-semibold text-ink-faint">
              이 글에서 확인한 기준 · 1차 출처 {feature.data.sources.length}건
            </p>
            <ul class="space-y-1">
              {(feature.data.sources.length > 0
                ? feature.data.sources.slice(0, 2)
                : [{ label: `기준일 ${site.baseDateLabel}` }]
              ).map((src) => (
                <li class="flex gap-1.5 text-[12.5px] leading-[1.55] text-ink-soft">
                  <span class="mt-[7px] h-[3px] w-[3px] shrink-0 rounded-full bg-ink-faint" aria-hidden="true" />
                  <span class="clamp-2">{src.label}</span>
                </li>
              ))}
            </ul>            {featureApp && (
              <a
                href={withBase(featureApp.internal ? `/apps/${featureApp.slug}/run` : `/apps/${featureApp.slug}`)}
                class="btn btn-soft btn-sm mt-1 self-start"
              >
                {featureApp.name} 열기
              </a>
            )}
          </div>
        </div>
      </a>

      <!-- 3열 카드 -->
      <div class="mt-4">
        <PostCards items={cardItems} />
      </div>

      <div class="mt-8">
        <AdSlot id="home-feed-bottom" size="leaderboard" />
      </div>
    </div>
  </section>

  <!-- ③ 화이트 : 도구 허브 -->
  <section class="scene-white border-y border-line">
    <div class="wrap py-10 md:py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="max-w-[52ch]">
          <p class="kicker">도구</p>
          <h2 class="h-section mt-2">가입 없이, 브라우저에서 바로</h2>
          <p class="lede mt-3 text-[15.5px] md:text-[16.5px]">
            입력한 값은 서버로 보내지 않고 그 탭 안에서만 계산합니다. 모든 도구에 예시 입력값과 계산
            기준, 출처, 기준일을 함께 적었습니다.
          </p>
        </div>
        <a href={withBase("/apps")} class="inline-flex min-h-[44px] items-center text-[13.5px] font-semibold text-ink-soft link">도구 소개 전체</a>
      </div>

      <div class="mt-7">
        <CoverageGauge />
      </div>

      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          hubTools.map((t) => (
            <li class="card card-lift flex flex-col p-5">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="text-[16.5px] font-bold tracking-[-0.03em] text-ink">{t.name}</h3>
              </div>
              <p class="mt-2 text-[13.5px] leading-[1.7] text-ink-muted">{t.what}</p>
              <p class="mt-3 text-[12px] text-ink-faint">{t.meta}</p>
              <div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
                <a href={withBase(t.runHref ?? t.href)} class="btn btn-solid btn-sm">
                  {t.runHref ? "실행 화면" : "달력 열기"}
                </a>
                <a href={withBase(t.href)} class="inline-flex min-h-[44px] items-center text-[12.5px] font-semibold text-ink-muted hover:text-ink">
                  계산 근거·출처
                </a>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-ink-faint">
        <span>예시 입력값은 가상입니다</span>
        <span>결과는 판정이 아니라 확인할 항목</span>
        <span>약관·증권별 확인 필요</span>
      </p>
    </div>
  </section>

  <!-- ④ 네이비 : 제도 일정 + 채널 본진 -->
  <section class="scene-night">
    <div class="wrap py-10 md:py-14">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div>
          <p class="mono text-[12px] tracking-[0.08em] text-[#c3d6e6]">{thisMonth}월 · 제도 일정</p>
          <h2 class="h-section mt-2 text-white">{thisMonth}월에 확인할 것</h2>
          <p class="mt-3 max-w-[46ch] text-[14.5px] leading-[1.75] text-[#b9cddc]">
            날짜를 놓쳐서 생기는 손해가 있습니다. 매달 반복되는 기한과 절차를 한 장에 모았습니다.
          </p>

          <ul class="mt-6 divide-y divide-white/10 border-y border-white/15">
            {
              spotlight.map((item) => (
                <li class="grid gap-1 py-3.5 sm:grid-cols-[104px_1fr] sm:gap-5">
                  <p class="mono text-[12px] text-[#c3d6e6]">{item.when}</p>
                  <div>
                    <p class="text-[14.5px] font-semibold leading-snug text-white">{item.title}</p>
                    <p class="mt-1 text-[12.5px] leading-[1.7] text-[#b9cddc]">{item.action}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a href={withBase("/calendar")} class="btn btn-line !border-white/25 !bg-white/10 !text-white hover:!bg-white/15">
              1~12월 제도 일정 {calendar.length}건
            </a>
            <span class="text-[12px] text-[#c3d6e6]">기준일 {site.baseDate}</span>
          </div>
        </div>

        <div>
          <p class="mono text-[12px] tracking-[0.08em] text-[#c3d6e6]">채널</p>
          <h2 class="h-section mt-2 text-white">글은 여기에 모이고,<br />채널은 각자의 결로</h2>
          <p class="mt-3 max-w-[42ch] text-[14px] leading-[1.75] text-[#b9cddc]">
            이 사이트가 본진입니다. 채널마다 다루는 것이 다르고, 긴 글과 계산은 여기 남습니다.
          </p>

          <ul class="mt-5 grid gap-x-6 sm:grid-cols-2">
            {
              [...channels, ...confirmedLinks].map((c) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-white/10 py-2.5">
                  <span class="flex flex-wrap items-baseline gap-x-2">
                    <span class="text-[14px] font-semibold text-white">{c.name}</span>
                    <span class="text-[12px] text-[#c3d6e6]">{c.note}</span>
                  </span>
                  {c.url ? (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-[24px] items-center py-1 text-[12px] font-semibold text-[#cfe3f1] underline decoration-white/30 underline-offset-4 hover:text-white"
                    >
                      열기
                    </a>
                  ) : (
                    <span class="text-[12px] text-[#b7c9d9]" aria-hidden="true">—</span>
                  )}
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-[12px] text-[#b7c9d9]">
            확정되지 않은 주소는 적지 않습니다. 채널 주소가 정해지면 이 목록에 연결됩니다.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
