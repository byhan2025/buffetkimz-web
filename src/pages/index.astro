---
import Base from "@/layouts/Base.astro";
import HeroToolCard from "@/components/HeroToolCard.astro";
import CoverageStrip from "@/components/CoverageStrip.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { apps } from "@/data/apps";
import { calendar } from "@/data/calendar";
import { channels, confirmedLinks } from "@/data/channels";
import { hubTools } from "@/data/tools";
import { categoryName } from "@/data/categories";
import {
  allPosts,
  postPath,
  formatDateShort,
  koreanDate,
  shouldShowQuestion,
  sourceOrgLine,
} from "@/lib/posts";

/**
 * v3.2 홈 — 첫 화면에서 4대 축이 한눈에 읽히고, 아래는 압축한다.
 * ① 히어로(4대 축 인덱스 포함) ② 기록 4칸 ③ 도구 5칸 ④ 제도 일정 + 채널 2단 밴드
 */
const posts = await allPosts();
const thisMonth = site.today.getMonth() + 1;

/** 카드 버튼은 짧게 — 도구 정식 이름은 도구 섹션에 그대로 있다. */
const shortToolLabel: Record<string, string> = {
  "coverage-check": "보장 점검 열기",
  "disclosure-check": "고지 체크 열기",
  "silson-compare": "실손 비교 열기",
  "pension-tax": "세액공제 계산 열기",
};

const cardItems = posts.slice(0, 4).map((p) => {
  const app = p.data.app ? apps.find((a) => a.slug === p.data.app) : undefined;
  const toolUrl =
    p.data.toolHref ?? (app?.internal ? `/apps/${app.slug}/run` : app ? `/apps/${app.slug}` : undefined);
  const toolName = p.data.toolTitle ?? (app ? (shortToolLabel[app.slug] ?? `${app.name} 열기`) : undefined);
  return {
    url: postPath(p),
    title: p.data.title,
    question: shouldShowQuestion(p.data.question, p.data.title) ? p.data.question : undefined,
    categoryName: categoryName(p.data.category),
    date: formatDateShort(p.data.publishedAt),
    readingMinutes: p.data.readingMinutes,
    baseDate: site.baseDate,
    sourceOrgLine: sourceOrgLine(p.data.sources),
    sourceCount: p.data.sources.length,
    toolUrl,
    toolName,
  };
});

/**
 * 실측 수치 — 글 컬렉션·도구 배열·제도 일정 데이터에서 빌드 시점에 그대로 센다.
 * 손으로 적은 숫자를 두지 않는다. 제도 일정은 공식 출처(source)가 적힌 항목만 센다.
 */
const sourcedCalendar = calendar.filter((c) => Boolean(c.source));
const calcToolCount = hubTools.filter((t) => t.runHref).length;
const searchItems = posts.length + apps.length + calendar.length;

/** 4대 축 — 첫 화면 인덱스 */
const axes = [
  { href: "/posts", label: "블로그 기록", note: "기준일·출처를 붙인 글", count: `${posts.length}편` },
  { href: "/apps", label: "계산·점검 도구", note: "브라우저에서 바로", count: `${calcToolCount}종` },
  { href: "/calendar", label: "제도 일정 달력", note: "1~12월 기한과 절차", count: `${sourcedCalendar.length}건` },
  { href: "/#channels", label: "연결 채널", note: "채널마다 다른 결로", count: `${channels.length}곳` },
];

const monthItems = calendar.filter((c) => c.month === thisMonth);
const upcoming = [
  ...monthItems.filter((c) => c.key),
  ...monthItems.filter((c) => !c.key),
].slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.brand,
      description: site.description,
      inLanguage: "ko-KR",
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#author`,
      name: site.brand,
      description: site.author.bio,
      url: `${site.url}/about`,
    },
  ],
};
---

<Base
  title="buffetkimz — 금융의 기록과 직접 만든 도구"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 : 화이트·스카이블루 · 4대 축 인덱스 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap pt-5 md:pt-7">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/10 pb-2.5">
        <p class="text-[12.5px] font-semibold tracking-[-0.01em] text-ink-soft">
          금융 · 보험 · 연금 · 노후 · AI
        </p>
        <p class="mono text-[12px] text-ink-faint">
          <time datetime={site.baseDate}>{koreanDate(site.today)}</time> 기준
        </p>
      </div>

      <div class="grid items-center gap-6 pb-6 pt-6 md:pt-7 lg:grid-cols-[1.1fr_0.9fr] lg:gap-x-12">
        <div>
          <h1 class="hero-title max-w-[16ch] text-[clamp(32px,4.2vw,54px)] font-bold leading-[1.08] tracking-[-0.045em] text-ink">
            숫자를 확인하고,<br />기록으로 남깁니다.
          </h1>
          <p class="lede hero-soft mt-3 max-w-[46ch] text-[15px] leading-[1.7]">
            금리와 환율, 보험과 연금, 노후와 AI. 공개된 1차 자료로 확인한 기준과 출처를 붙여 남기고,
            되풀이되는 계산은 브라우저에서 바로 쓰는 도구로 옮겼습니다.
          </p>

          <div class="hero-soft mt-4 flex flex-wrap items-center gap-2">
            <a href={withBase("/apps")} class="btn btn-solid">도구 둘러보기</a>
            <a href={withBase("/posts")} class="btn btn-line">기록 {posts.length}편 읽기</a>
            <a
              href={withBase("/search")}
              class="inline-flex min-h-[44px] items-center gap-1.5 px-2 text-[13px] font-semibold text-ink-soft hover:text-brand-deep"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="11" cy="11" r="6.4"></circle>
                <path d="m16 16 4.2 4.2" stroke-linecap="round"></path>
              </svg>
              검색
            </a>
          </div>

          <p class="hero-soft mono mt-2.5 text-[12px] leading-relaxed text-ink-muted">
            기록 <strong class="font-semibold text-ink">{posts.length}편</strong> · 브라우저 도구 <strong class="font-semibold text-ink">{calcToolCount}종</strong> · 제도 일정 <strong class="font-semibold text-ink">{sourcedCalendar.length}건</strong>
            <span class="text-ink-faint"> · 모든 글에 기준일·1차 출처</span>
          </p>
        </div>

        <!-- 4대 축 인덱스 — 모바일에서는 문장 다음, 데스크톱에서는 히어로 아래 한 줄 -->
        <ul class="order-2 grid grid-cols-2 gap-2 lg:order-3 lg:col-span-2 lg:mt-2 lg:grid-cols-4">
          {
            axes.map((a) => (
              <li>
                <a href={withBase(a.href)} class="card card-lift flex items-center justify-between gap-2 px-3.5 py-2.5">
                  <span class="min-w-0">
                    <span class="block text-[13px] font-bold leading-snug tracking-[-0.02em] text-ink">{a.label}</span>
                    <span class="clamp-2 mt-0.5 block text-[12px] leading-snug text-ink-muted">{a.note}</span>
                  </span>
                  <span class="mono shrink-0 text-[12px] font-semibold text-brand-deep">{a.count} →</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="order-3 mx-auto w-full max-w-[430px] lg:order-2 lg:col-start-2 lg:row-start-1 lg:mr-0 lg:max-w-none">
          <HeroToolCard />
        </div>
      </div>
    </div>
  </section>

  <!-- ② 크림 : 최근 기록 4칸 -->
  <section class="scene-cream">
    <div class="wrap py-7 md:py-9">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="kicker">기록</p>
          <h2 class="h-sub mt-1">요즘 확인한 것</h2>
        </div>
        <a href={withBase("/posts")} class="inline-flex min-h-[44px] items-center text-[13px] font-semibold text-ink-soft link">
          기록 {posts.length}편 전체
        </a>
      </div>

      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-post-cards>
        {
          cardItems.map((item) => (
            <li class="card card-lift flex flex-col p-4">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-[12px] font-semibold tracking-[0.02em] text-brand">{item.categoryName}</span>
                <span class="mono text-[12px] text-ink-faint">{item.date}</span>
              </div>

              {item.question && (
                <p class="clamp-2 mt-2 text-[12.5px] font-semibold leading-snug text-ink-muted">
                  <span class="text-brand">Q.</span> {item.question}
                </p>
              )}

              <h3 class="clamp-2 mt-1 text-[15px] font-bold leading-[1.42] tracking-[-0.03em] text-ink">
                <a href={withBase(item.url)} class="hover:text-brand-deep">{item.title}</a>
              </h3>

              <p class="mono mt-2 text-[12px] leading-[1.5] text-ink-faint" data-card-meta>
                확인 기준일 {item.baseDate} · {item.sourceOrgLine || `출처 ${item.sourceCount}건`}
              </p>

              <div class="mt-auto flex items-center justify-between gap-2 pt-3">
                {item.toolUrl ? (
                  <a href={withBase(item.toolUrl)} class="btn btn-soft btn-sm !px-3 !text-[12.5px]">
                    {item.toolName}
                  </a>
                ) : (
                  <a href={withBase(item.url)} class="text-[12.5px] font-semibold text-brand-deep link">읽기</a>
                )}
                <span class="text-[12px] text-ink-faint">{item.readingMinutes}분</span>
              </div>
            </li>
          ))
        }
      </ul>

      <AdSlot id="home-feed-bottom" size="leaderboard" />
    </div>
  </section>

  <!-- ③ 화이트 : 도구 5칸 + 압축 게이지 -->
  <section class="scene-white border-y border-line">
    <div class="wrap py-7 md:py-9">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="kicker">도구</p>
          <h2 class="h-sub mt-1">가입 없이, 브라우저에서 바로</h2>
        </div>
        <a href={withBase("/apps")} class="inline-flex min-h-[44px] items-center text-[13px] font-semibold text-ink-soft link">
          도구 소개 전체
        </a>
      </div>
      <p class="mt-1.5 text-[13px] leading-[1.7] text-ink-muted">
        입력한 값은 서버로 보내지 않고 그 탭 안에서만 계산합니다. 모든 도구에 예시 입력값과 계산 기준, 출처, 기준일을 함께 적었습니다.
      </p>

      <div class="mt-4">
        <CoverageStrip />
      </div>

      <ul class="mt-3 grid grid-cols-2 gap-2.5 md:grid-cols-5">
        {
          hubTools.map((t) => (
            <li class="card card-lift flex flex-col p-3.5">
              <h3 class="text-[13px] font-bold leading-snug tracking-[-0.02em] text-ink">{t.name}</h3>
              <p class="clamp-2 mt-1 text-[12px] leading-[1.55] text-ink-muted">{t.short}</p>
              <a
                href={withBase(t.runHref ?? t.href)}
                class="mt-auto inline-flex min-h-[32px] items-end pt-2 text-[12px] font-semibold text-brand-deep link"
              >
                {t.runHref ? "계산해 보기" : "달력 열기"} →
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-ink-faint">
        <span>예시 입력값은 가상입니다</span>
        <span>결과는 판정이 아니라 확인할 항목</span>
        <span>약관·증권별 확인 필요</span>
      </p>
    </div>
  </section>

  <!-- ④ 네이비 2단 밴드 : 다가오는 제도 일정 3건 + 채널 허브 -->
  <section id="channels" class="scene-night">
    <div class="wrap py-7 md:py-9">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <p class="mono text-[12px] tracking-[0.08em] text-[#c3d6e6]">제도 일정 · {thisMonth}월</p>
            <a href={withBase("/calendar")} class="inline-flex min-h-[24px] items-center text-[12px] font-semibold text-[#cfe3f1] underline decoration-white/30 underline-offset-4 hover:text-white">
              1~12월 {calendar.length}건
            </a>
          </div>
          <h2 class="h-sub mt-1 text-white">다가오는 제도 일정</h2>
          <p class="mt-1.5 max-w-[46ch] text-[13px] leading-[1.7] text-[#b9cddc]">
            날짜를 놓쳐서 생기는 손해가 있습니다. 매달 반복되는 기한과 절차를 한 장에 모았습니다.
          </p>

          <ul class="mt-3 divide-y divide-white/10 border-y border-white/15">
            {
              upcoming.map((item) => (
                <li class="grid gap-0.5 py-2.5 sm:grid-cols-[96px_1fr] sm:gap-4">
                  <p class="mono text-[12px] text-[#c3d6e6]">{item.when}</p>
                  <div>
                    <p class="text-[13.5px] font-semibold leading-snug text-white">{item.title}</p>
                    <p class="clamp-2 mt-0.5 text-[12px] leading-[1.6] text-[#b9cddc]">{item.action}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-3 flex flex-wrap items-center gap-3">
            <a href={withBase("/calendar")} class="btn btn-line btn-sm !border-white/25 !bg-white/10 !text-white hover:!bg-white/15">
              제도 일정 달력 열기
            </a>
            <span class="text-[12px] text-[#c3d6e6]">기준일 {site.baseDate}</span>
          </div>
        </div>

        <div>
          <p class="mono text-[12px] tracking-[0.08em] text-[#c3d6e6]">채널 · {channels.length}곳</p>
          <h2 class="h-sub mt-1 text-white">글은 여기에 모이고,<br />채널은 각자의 결로</h2>

          <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
            {
              [...channels, ...confirmedLinks].map((c) => (
                <li class="flex items-baseline justify-between gap-2 border-b border-white/10 py-2">
                  <span class="flex min-w-0 flex-wrap items-baseline gap-x-1.5">
                    <span class="text-[13px] font-semibold text-white">{c.name}</span>
                    <span class="truncate text-[12px] text-[#c3d6e6]">{c.note}</span>
                  </span>
                  {c.url ? (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-[28px] min-w-[28px] shrink-0 items-center justify-end text-[12px] font-semibold text-[#cfe3f1] underline decoration-white/30 underline-offset-4 hover:text-white"
                    >
                      열기
                    </a>
                  ) : (
                    <span class="shrink-0 text-[12px] text-[#b7c9d9]" aria-hidden="true">—</span>
                  )}
                </li>
              ))
            }
          </ul>

          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
            <a
              href={site.kakaoChannelUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm !bg-white !text-ink hover:!bg-[#f2f7ff]"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M12 4c-4.4 0-8 2.6-8 5.8 0 2 1.3 3.8 3.4 4.9-.2.7-.7 2.3-.8 2.7 0 .3.2.4.4.3.4-.2 2.3-1.6 3-2.1.6.1 1.3.1 2 .1 4.4 0 8-2.6 8-5.9S16.4 4 12 4Z" />
              </svg>
              카카오톡 채널에서 대화
            </a>
            <p class="text-[12px] text-[#b7c9d9]">확정되지 않은 주소는 적지 않습니다. 채널 주소가 정해지면 이 목록에 연결됩니다.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
