---
import Base from "@/layouts/Base.astro";
import PostCards from "@/components/PostCards.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { appBySlug } from "@/data/apps";
import { postsByCategory, postPath, formatDate, sourceOrgLine } from "@/lib/posts";

export async function getStaticPaths() {
  const out = [];
  for (const category of categories) {
    const posts = await postsByCategory(category.slug);
    out.push({ params: { category: category.slug }, props: { category, posts } });
  }
  return out;
}

const { category, posts } = Astro.props;
const feature = posts[0];
const rest = posts.slice(1);

const toCard = (p: (typeof posts)[number]) => {
  const app = p.data.app ? appBySlug(p.data.app) : undefined;
  return {
    url: postPath(p),
    title: p.data.title,
    description: p.data.description,
    categoryName: category.name,
    date: formatDate(p.data.publishedAt),
    readingMinutes: p.data.readingMinutes,
    question: p.data.question ?? app?.question,
    toolName: p.data.toolTitle ?? (app ? `${app.name.replace(" 시뮬레이터", "").replace(" 계산기", "")} 열기` : undefined),
    toolUrl:
      p.data.toolHref ?? (app?.internal ? `/apps/${app.slug}/run` : app ? `/apps/${app.slug}` : undefined),
    baseDate: site.baseDate,
    sourceCount: p.data.sources.length,
    sourceOrgLine: sourceOrgLine(p.data.sources),
  };
};

const others = categories.filter((c) => c.slug !== category.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${category.name} 기록`,
  description: category.lead,
  url: `${site.url}/posts/${category.slug}`,
  inLanguage: "ko-KR",
};
---

<Base
  title={`${category.name} — 기록`}
  description={`${category.name}: ${category.lead}`}
  path={`/posts/${category.slug}`}
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-9 md:py-12">
      <nav class="flex items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[24px] items-center hover:text-ink">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/posts")} class="inline-flex min-h-[24px] items-center hover:text-ink">기록</a>
      </nav>

      <div class="mt-5 flex flex-wrap items-baseline gap-3">
        <h1 class="h-display text-ink">{category.name}</h1>
        <span class="text-[12.5px] text-ink-muted">글 {posts.length}편</span>
      </div>
      <p class="lede mt-3 max-w-[54ch]">{category.lead}</p>

      <ul class="mt-5 flex flex-wrap gap-2">
        {category.covers.map((c) => <li class="chip">{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="scene-white">
    <div class="wrap py-8 md:py-12">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-14">
        <div class="min-w-0">
          {
            feature ? (
              <>
                <a href={withBase(postPath(feature))} class="group block">
                  <div class="card card-lift p-5 md:p-7">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="mono text-[12px] text-ink-faint">{formatDate(feature.data.publishedAt)}</span>
                      <span class="text-[12px] text-ink-faint">{feature.data.readingMinutes}분</span>
                    </div>
                    <h2 class="mt-2.5 max-w-[26ch] text-[clamp(21px,2.6vw,28px)] font-bold leading-[1.34] tracking-[-0.036em] text-ink group-hover:text-brand-deep">
                      {feature.data.title}
                    </h2>
                    <p class="mt-3 max-w-[54ch] text-[14px] leading-[1.75] text-ink-muted">{feature.data.description}</p>
                  </div>
                </a>
                <div class="mt-4">
                  <PostCards items={rest.map(toCard)} columns={2} />
                </div>
              </>
            ) : (
              <p class="py-16 text-center text-[14px] text-ink-muted">아직 이 칸에는 글이 없습니다.</p>
            )
          }
          <div class="mt-8">
            <AdSlot id={`category-${category.slug}-bottom`} size="leaderboard" />
          </div>
        </div>

        <aside class="lg:border-l lg:border-line lg:pl-8">
          <h2 class="text-[12px] font-semibold tracking-[0.06em] text-ink-faint">다른 분야</h2>
          <ul class="mt-3 divide-y divide-line-soft border-t border-line-soft">
            {others.map((c) => (
              <li>
                <a href={withBase(`/posts/${c.slug}`)} class="flex min-h-[44px] items-center justify-between text-[13.5px] text-ink-soft hover:text-ink">
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
          <a href={withBase("/search")} class="mt-6 inline-flex min-h-[44px] items-center text-[13px] font-semibold text-brand-deep link">
            이 분야의 글 검색하기
          </a>
        </aside>
      </div>
    </div>
  </section>
</Base>
