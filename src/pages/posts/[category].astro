---
import Base from "@/layouts/Base.astro";
import PostCards from "@/components/PostCards.astro";
import HomePill from "@/components/HomePill.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { appBySlug } from "@/data/apps";
import { postsByCategory, postPath, formatDate, sourceOrgLine, toolOf } from "@/lib/posts";
import { thumbOf, thumbAltOf, topicThumbs } from "@/lib/thumbs";
import { breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

export async function getStaticPaths() {
  const out = [];
  for (const category of categories) {
    const posts = await postsByCategory(category.slug);
    out.push({ params: { category: category.slug }, props: { category, posts } });
  }
  return out;
}

const { category, posts } = Astro.props;
const feature = posts[0];
const rest = posts.slice(1);

const toCard = (p: (typeof posts)[number]) => {
  const app = p.data.app ? appBySlug(p.data.app) : undefined;
  const tool = toolOf(p);
  return {
    url: postPath(p),
    title: p.data.title,
    description: p.data.description,
    categoryName: category.name,
    tags: p.data.tags.slice(0, 2),
    dateISO: p.data.publishedAt.toISOString().slice(0, 10),
    date: formatDate(p.data.publishedAt),
    readingMinutes: p.data.readingMinutes,
    question: p.data.question ?? app?.question,
    series: p.data.series,
    toolName: tool.cta,
    toolUrl: tool.href,
    baseDate: formatDate(p.data.baseDate ?? p.data.publishedAt),
    sourceCount: p.data.sources.length,
    sourceOrgLine: sourceOrgLine(p.data.sources),
    thumb: thumbOf(p),
    thumbAlt: thumbAltOf(p),
  };
};

const others = categories.filter((c) => c.slug !== category.slug);

/**
 * v7.1 — 연금·퇴직 마스터 가이드 6편.
 * 분야 목록 위에 '읽는 순서'를 먼저 보여 준다. 편수·제목은 글 컬렉션에서 센다.
 */
const masterPosts = posts
  .filter((p) => p.data.series?.name === "연금·퇴직 마스터 가이드")
  .sort((a, b) => (a.data.series?.no ?? 0) - (b.data.series?.no ?? 0));
const masterMinutes = masterPosts.reduce((n, p) => n + p.data.readingMinutes, 0);

const jsonLd = graph([
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl(`/posts/${category.slug}`)}#webpage`,
    name: `${category.name} — 자산리포트`,
    description: category.lead,
    url: pageUrl(`/posts/${category.slug}`),
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.slice(0, 20).map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.data.title,
        url: pageUrl(postPath(p)),
      })),
    },
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "자산리포트", path: "/posts" },
    { name: category.name, path: `/posts/${category.slug}` },
  ]),
]);
---

<Base
  title={`${category.name} — 자산리포트`}
  description={`${category.name}: ${category.lead}`}
  path={`/posts/${category.slug}`}
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-9 md:py-12">
      <HomePill />
      <nav class="flex items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/posts")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">자산리포트</a>
      </nav>

      <div class="mt-5 grid gap-5 md:grid-cols-[minmax(0,1fr)_260px] md:items-end md:gap-8">
        <div>
          <div class="flex flex-wrap items-baseline gap-3">
            <h1 class="h-display text-ink">{category.name}</h1>
            <span class="text-[12.5px] text-ink-muted">글 {posts.length}편</span>
          </div>
          <p class="lede mt-3 max-w-[54ch]">{category.lead}</p>

          <ul class="mt-5 flex flex-wrap gap-2">
            {category.covers.map((c) => <li class="chip">{c}</li>)}
          </ul>
        </div>

        <!-- 분야 대표이미지 — 7대 주제별 그림(글에 썸네일이 없을 때 쓰는 같은 그림) -->
        <div class="post-thumb max-w-[360px] md:max-w-none" data-category-thumb={category.slug}>
          <img
            src={withBase(topicThumbs[category.slug] ?? "/thumbs/topic-philosophy.webp")}
            alt={`${category.name} 기록 대표 이미지`}
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="scene-white">
    <div class="wrap py-8 md:py-12">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-14">
        <div class="min-w-0">
          {
            masterPosts.length > 0 && (
              <section class="mb-8 rounded-2xl border border-line bg-paper-deep/60 p-5 md:p-6" data-master-series>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <div>
                    <p class="mono text-[11.5px] font-semibold tracking-[0.16em] text-brand">시리즈 07</p>
                    <h2 class="mt-1 text-[19px] font-bold tracking-[-0.03em] text-ink">연금·퇴직 마스터 가이드</h2>
                  </div>
                  <p class="text-[12px] text-ink-faint">
                    {masterPosts.length}편 · 약 {masterMinutes}분 · 적립 → 운용 → 인출
                  </p>
                </div>
                <p class="mt-2 max-w-[58ch] text-[13px] leading-[1.7] text-ink-muted">
                  연금계좌 네 개의 구조에서 시작해 세후 차이, 연말 공제, 자산 배치, 인출 순서, 은퇴 전 점검까지
                  순서대로 읽으면 한 바퀴가 끝납니다. 2026년 11월 세법 기준입니다.
                </p>
                <ol class="mt-4 grid gap-1.5 sm:grid-cols-2">
                  {masterPosts.map((p) => (
                    <li>
                      <a href={withBase(postPath(p))} class="flex min-h-[44px] items-start gap-2.5 rounded-lg bg-white px-3 py-2.5 hover:bg-white/70">
                        <span class="mono mt-0.5 shrink-0 text-[11.5px] font-semibold text-brand">
                          {String(p.data.series?.no ?? 0).padStart(2, "0")}
                        </span>
                        <span class="min-w-0">
                          <span class="block text-[13px] font-semibold leading-snug tracking-[-0.02em] text-ink">
                            {p.data.title}
                          </span>
                          <span class="mt-0.5 block text-[11.5px] text-ink-faint">{p.data.readingMinutes}분</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }
          {
            feature ? (
              <>
                <a href={withBase(postPath(feature))} class="group block">
                  <div class="card card-lift overflow-hidden p-5 md:p-7">
                    <div class="post-thumb post-thumb--wide mb-4">
                      <img
                        src={withBase(thumbOf(feature))}
                        alt={`${thumbAltOf(feature)} — ${feature.data.title}`}
                        width="1280"
                        height="800"
                        fetchpriority="high"
                      />
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="mono text-[12px] text-ink-faint">{formatDate(feature.data.publishedAt)}</span>
                      <span class="text-[12px] text-ink-faint">{feature.data.readingMinutes}분</span>
                    </div>
                    <h2 class="mt-2.5 max-w-[26ch] text-[clamp(21px,2.6vw,28px)] font-bold leading-[1.34] tracking-[-0.036em] text-ink group-hover:text-brand-deep">
                      {feature.data.title}
                    </h2>
                    <p class="mt-3 max-w-[54ch] text-[14px] leading-[1.75] text-ink-muted">{feature.data.description}</p>
                  </div>
                </a>
                <div class="mt-4">
                  <PostCards items={rest.map(toCard)} columns={2} />
                </div>
              </>
            ) : (
              <p class="py-16 text-center text-[14px] text-ink-muted">아직 이 칸에는 글이 없습니다.</p>
            )
          }
          <div class="mt-8">
            <AdSlot id={`category-${category.slug}-bottom`} size="leaderboard" region="article-bottom" />
          </div>

          <HomePill position="bottom" />
        </div>

        <aside class="lg:border-l lg:border-line lg:pl-8">
          <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">다른 분야</h2>
          <ul class="mt-3 divide-y divide-line-soft border-t border-line-soft">
            {others.map((c) => (
              <li>
                <a href={withBase(`/posts/${c.slug}`)} class="flex min-h-[44px] items-center justify-between text-[13.5px] text-ink-soft hover:text-ink">
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
          <a href={withBase("/search")} class="mt-6 inline-flex min-h-[44px] items-center text-[13px] font-semibold text-brand-deep link">
            이 분야의 글 검색하기
          </a>
        </aside>
      </div>
    </div>
  </section>
</Base>
