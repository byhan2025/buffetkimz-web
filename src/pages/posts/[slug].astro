---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { categoryBySlug } from "@/data/categories";
import { allPosts, postPath, formatDate, relatedApp } from "@/lib/posts";

export async function getStaticPaths() {
  const list = await allPosts();
  return list.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: list[i + 1], next: list[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const category = categoryBySlug(post.data.category)!;
const app = relatedApp(post);

const published = post.data.publishedAt.toISOString().slice(0, 10);
const path = postPath(post);
const sameCategory = (await allPosts())
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString().slice(0, 10),
  inLanguage: "ko-KR",
  author: { "@type": "Person", name: site.author.name, url: `${site.url}/about` },
  publisher: { "@type": "Organization", name: site.brand, url: site.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${site.url}${path}` },
  articleSection: category.name,
  keywords: post.data.tags.join(", "),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  type="article"
  publishedTime={published}
  jsonLd={jsonLd}
>
  <article>
    <header class="border-b border-line">
      <div class="wrap py-8 md:py-12">
        <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
          <a href={withBase("/")} class="inline-flex min-h-[24px] items-center hover:text-ink">홈</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("/posts")} class="inline-flex min-h-[24px] items-center hover:text-ink">블로그</a>
          <span aria-hidden="true">/</span>
          <a href={withBase(`/posts/${category.slug}`)} class="inline-flex min-h-[24px] items-center hover:text-ink">{category.name}</a>
        </nav>

        <div class="mt-6 max-w-[66ch]">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px]">
            <a href={withBase(`/posts/${category.slug}`)} class="font-semibold" style={`color:${category.tone}`}>
              {category.name}
            </a>
            <time class="dateline text-[12.5px]" datetime={published}>{formatDate(post.data.publishedAt)}</time>
            <span class="text-ink-faint">{post.data.readingMinutes}분 읽기</span>
          </div>

          <h1 class="mt-3 text-[28px] font-bold leading-[1.3] tracking-[-0.042em] text-ink md:text-[38px]">
            {post.data.title}
          </h1>
          <p class="lede mt-4">{post.data.description}</p>
        </div>
      </div>
    </header>

    <div class="wrap py-9 md:py-14">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_270px] lg:gap-16">
        <div class="min-w-0">
          <div class="prose-article max-w-[66ch]">
            <Content />
          </div>

          {
            post.data.tags.length > 0 && (
              <ul class="mt-10 flex flex-wrap gap-x-3 gap-y-1 border-t border-line pt-4">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={withBase(`/search?q=${encodeURIComponent(tag)}`)} class="text-[12.5px] text-ink-muted link">
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-6">
            <AdSlot id={`post-${post.id}-bottom`} size="leaderboard" />
          </div>

          <nav class="mt-10 grid gap-6 border-t border-ink pt-5 sm:grid-cols-2" aria-label="이전·다음 글">
            {
              prev ? (
                <a href={withBase(postPath(prev))} class="group">
                  <span class="text-[12px] text-ink-faint">이전 글</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {prev.data.title}
                  </p>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a href={withBase(postPath(next))} class="group sm:text-right">
                  <span class="text-[12px] text-ink-faint">다음 글</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {next.data.title}
                  </p>
                </a>
              )
            }
          </nav>
        </div>

        <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
          <div>
            <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">기준과 출처</h2>
            <p class="mt-2 text-[12.5px] leading-relaxed text-ink-muted">
              이 글은 <time datetime={site.baseDate}>{site.baseDateLabel}</time> 기준으로 확인했습니다. 제도와
              약관은 바뀔 수 있으니, 결정 전에 원문을 다시 확인하세요.
            </p>
            {
              post.data.sources.length > 0 && (
                <ul class="mt-3 space-y-2 border-t border-line-soft pt-3">
                  {post.data.sources.map((s) => (
                    <li class="text-[12px] leading-[1.6] text-ink-muted">
                      {s.url ? (
                        <a href={s.url} target="_blank" rel="noopener noreferrer" class="link">
                          {s.label}
                        </a>
                      ) : (
                        s.label
                      )}
                    </li>
                  ))}
                </ul>
              )
            }
          </div>

          {
            app && (
              <div class="border-t border-ink pt-4">
                <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">이어지는 도구</h2>
                <a href={withBase(`/apps/${app.slug}`)} class="group mt-2 block">
                  <p class="text-[15px] font-bold tracking-[-0.02em] text-ink group-hover:text-brand-deep">
                    {app.name}
                  </p>
                  <p class="mt-1.5 text-[12.5px] leading-relaxed text-ink-muted">{app.question}</p>
                  <p class="mt-2 text-[12px] font-semibold text-brand-deep">
                    {app.externalUrl ? "앱 열기" : "실행해 보기"}
                  </p>
                </a>
              </div>
            )
          }

          <div class="border-t border-line pt-4">
            <h2 class="text-[12px] font-semibold tracking-[0.08em] text-ink-faint">이 칸의 다른 글</h2>
            <ul class="mt-2 space-y-2">
              {
                sameCategory.map((p) => (
                    <li>
                      <a href={withBase(postPath(p))} class="text-[12.5px] leading-snug text-ink-muted hover:text-ink link">
                        {p.data.title}
                      </a>
                    </li>
                  ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>
