---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import AdSlot from "@/components/AdSlot.astro";
import HomePill from "@/components/HomePill.astro";
import { withBase, site, absolute } from "@/config/site";
import { categoryBySlug } from "@/data/categories";
import { allPosts, postPath, formatDate, koreanDate, relatedApp } from "@/lib/posts";
import { thumbOf, thumbAltOf, thumbSize } from "@/lib/thumbs";

export async function getStaticPaths() {
  const list = await allPosts();
  return list.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: list[i + 1], next: list[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const category = categoryBySlug(post.data.category)!;
const app = relatedApp(post);

const published = post.data.publishedAt.toISOString().slice(0, 10);
const basis = post.data.baseDate ?? post.data.publishedAt;
const basisIso = basis.toISOString().slice(0, 10);
const basisLabel = koreanDate(basis);
/** 기준일 표기 — 사이트 전체와 같은 `YYYY. MM. DD.` 한 형식 */
const basisDots = formatDate(basis);
/** 제목 아래 고정 자리 — 기준일 + 1차 출처(공식 기관 URL) 2줄 */
const primary = post.data.sources.find((s) => s.url) ?? post.data.sources[0];
const primaryLabel = primary ? primary.label.split(/[—–(]/)[0].trim() : "작성자 기록";
const primaryHost = primary?.url ? (() => {
  try {
    return new URL(primary.url!).host.replace(/^www\./, "");
  } catch {
    return null;
  }
})() : null;
const path = postPath(post);
const thumb = thumbOf(post);
const thumbAlt = thumbAltOf(post);
const thumbDim = thumbSize(thumb);
const sameCategory = (await allPosts())
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString().slice(0, 10),
  inLanguage: "ko-KR",
  author: { "@type": "Person", name: site.author.name, url: `${site.url}/about` },
  publisher: { "@type": "Organization", name: site.brand, url: site.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${site.url}${path}` },
  articleSection: category.name,
  keywords: post.data.tags.join(", "),
  image: absolute(thumb),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  type="article"
  publishedTime={published}
  jsonLd={jsonLd}
  image={thumb}
  imageAlt={`${thumbAlt} — ${post.data.title}`}
>
  <article>
    <header class="border-b border-line">
      <div class="wrap py-8 md:py-12">
        <HomePill />
        <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
          <a href={withBase("/")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">홈</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("/posts")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">블로그</a>
          <span aria-hidden="true">/</span>
          <a href={withBase(`/posts/${category.slug}`)} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">{category.name}</a>
        </nav>

        <div class="mt-6 max-w-[66ch]">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px]">
            <a href={withBase(`/posts/${category.slug}`)} class="inline-flex min-h-[44px] items-center font-semibold md:min-h-[24px]" style={`color:${category.tone}`}>
              {category.name}
            </a>
            <time class="dateline text-[12.5px]" datetime={published}>{formatDate(post.data.publishedAt)}</time>
            <span class="text-ink-faint">{post.data.readingMinutes}분 읽기</span>
          </div>

          <h1 class="mt-3 text-[28px] font-bold leading-[1.3] tracking-[-0.042em] text-ink md:text-[38px]">
            {post.data.title}
          </h1>

          <dl class="mt-4 space-y-1 border-l-2 border-brand/35 pl-3 text-[12.5px] leading-[1.65] text-ink-muted" data-post-basis>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <dt class="sr-only">기준일</dt>
              <dd class="mono">기준일 <time datetime={basisIso}>{basisDots}</time></dd>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <dt class="sr-only">1차 출처</dt>
              <dd>
                <span>1차 출처 {primaryLabel}</span>
                {primaryHost && (
                  <a href={primary.url} target="_blank" rel="noopener noreferrer" class="link mono">({primaryHost})</a>
                )}
                {post.data.sources.length > 1 && (
                  <span class="text-ink-faint">외 {post.data.sources.length - 1}건</span>
                )}
              </dd>
            </div>
          </dl>

          <p class="lede mt-4">{post.data.description}</p>
        </div>

        <figure class="mt-7 max-w-[66ch]">
          <div class="post-thumb post-thumb--wide">
            <img
              src={withBase(thumb)}
              alt={`${thumbAlt} — ${post.data.title}`}
              width={thumbDim.width}
              height={thumbDim.height}
              fetchpriority="high"
            />
          </div>
          <figcaption class="mt-2 flex flex-wrap items-center gap-x-2 text-[12px] text-ink-faint">
            <span>{category.name} 기록</span>
            <span aria-hidden="true">·</span>
            <span>{post.data.sources.length}곳에서 확인</span>
          </figcaption>
        </figure>
      </div>
    </header>

    <div class="wrap py-9 md:py-14">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_270px] lg:gap-16">
        <div class="min-w-0">
          <div class="prose-article max-w-[66ch]">
            <Content />
          </div>

          <p class="mt-8 max-w-[66ch] border-t border-line pt-4 text-[12.5px] leading-[1.7] text-ink-faint" data-post-disclaimer>
            이 글은 확인한 내용을 정리한 기록이며, 특정 상품의 가입이나 투자를 권하지 않습니다. 기준일 이후
            제도와 약관이 바뀔 수 있으니, 결정 전에 원문과 증권으로 다시 확인하세요.
          </p>

          {
            post.data.tags.length > 0 && (
              <ul class="mt-10 flex flex-wrap gap-x-3 gap-y-1 border-t border-line pt-4" data-post-tags>
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={withBase("/search")} data-search-query={tag} class="text-[12.5px] text-ink-muted link">
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-6">
            <AdSlot id={`post-${post.id}-bottom`} size="leaderboard" />
          </div>

          <nav class="mt-10 grid gap-6 border-t border-ink pt-5 sm:grid-cols-2" aria-label="이전·다음 글">
            {
              prev ? (
                <a href={withBase(postPath(prev))} class="group">
                  <span class="text-[12px] text-ink-faint">이전 글</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {prev.data.title}
                  </p>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a href={withBase(postPath(next))} class="group sm:text-right">
                  <span class="text-[12px] text-ink-faint">다음 글</span>
                  <p class="mt-1 text-[14px] font-semibold leading-snug text-ink group-hover:underline group-hover:underline-offset-4">
                    {next.data.title}
                  </p>
                </a>
              )
            }
          </nav>

          <HomePill position="bottom" />
        </div>

        <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
          <div>
            <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">기준과 출처</h2>
            <p class="mt-2 text-[12.5px] leading-relaxed text-ink-muted">
              이 글은 <time datetime={basisIso}>{basisLabel}</time> 기준으로 확인했습니다. 제도와
              약관은 바뀔 수 있으니, 결정 전에 원문을 다시 확인하세요.
            </p>
            {
              post.data.sources.length > 0 && (
                <ul class="mt-3 space-y-2 border-t border-line-soft pt-3">
                  {post.data.sources.map((s) => (
                    <li class="text-[12px] leading-[1.6] text-ink-muted">
                      {s.url ? (
                        <a href={s.url} target="_blank" rel="noopener noreferrer" class="link">
                          {s.label}
                        </a>
                      ) : (
                        s.label
                      )}
                    </li>
                  ))}
                </ul>
              )
            }
          </div>

          {
            app && (
              <div class="border-t border-ink pt-4">
                <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">이어지는 도구</h2>
                <a href={withBase(`/apps/${app.slug}`)} class="group mt-2 block">
                  <p class="text-[15px] font-bold tracking-[-0.02em] text-ink group-hover:text-brand-deep">
                    {app.name}
                  </p>
                  <p class="mt-1.5 text-[12.5px] leading-relaxed text-ink-muted">{app.question}</p>
                  <p class="mt-2 text-[12px] font-semibold text-brand-deep">
                    {app.externalUrl ? "앱 열기" : "실행해 보기"}
                  </p>
                </a>
              </div>
            )
          }

          <div class="border-t border-line pt-4">
            <h2 class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">이 칸의 다른 글</h2>
            <ul class="mt-2 space-y-2">
              {
                sameCategory.map((p) => (
                    <li>
                      <a href={withBase(postPath(p))} class="text-[12.5px] leading-snug text-ink-muted hover:text-ink link">
                        {p.data.title}
                      </a>
                    </li>
                  ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>
