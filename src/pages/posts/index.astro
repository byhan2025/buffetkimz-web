---
import Base from "@/layouts/Base.astro";
import PostCards from "@/components/PostCards.astro";
import HomePill from "@/components/HomePill.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site } from "@/config/site";
import { categories, categoryName } from "@/data/categories";
import { appBySlug } from "@/data/apps";
import { allPosts, postPath, formatDate, sourceOrgLine, toolOf } from "@/lib/posts";
import { thumbOf, thumbAltOf, thumbSize } from "@/lib/thumbs";
import { breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

const posts = await allPosts();
const feature = posts[0];
const rest = posts.slice(1);
/** 목록 머리의 기준일 — 가장 최근 글의 확인 기준일을 쓴다 */
const latestBasis = feature ? feature.data.baseDate ?? feature.data.publishedAt : site.today;
/** 기준일이 오래된 아카이브는 목록 머리에서 알린다 */
const basisAgeDays = Math.max(0, Math.floor((Date.now() - latestBasis.getTime()) / 86400000));

const card = (p: (typeof posts)[number]) => {
  const app = p.data.app ? appBySlug(p.data.app) : undefined;
  const tool = toolOf(p);
  return {
    url: postPath(p),
    title: p.data.title,
    description: p.data.description,
    categoryName: categoryName(p.data.category),
    tags: p.data.tags.slice(0, 2),
    dateISO: p.data.publishedAt.toISOString().slice(0, 10),
    date: formatDate(p.data.publishedAt),
    readingMinutes: p.data.readingMinutes,
    question: p.data.question ?? app?.question,
    series: p.data.series,
    toolName: tool.cta,
    toolUrl: tool.href,
    baseDate: formatDate(p.data.baseDate ?? p.data.publishedAt),
    sourceCount: p.data.sources.length,
    sourceOrgLine: sourceOrgLine(p.data.sources),
    thumb: thumbOf(p),
    thumbAlt: thumbAltOf(p),
  };
};

const counts = categories.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.category === c.slug).length,
}));

/** 많이 찾는 핵심 글 3편 — 대표(Featured)를 먼저, 모자라면 최신 글로 채운다. */
const featured = posts.filter((p) => p.data.featured);
const picks = [...featured, ...posts.filter((p) => !p.data.featured)].slice(0, 3);

const jsonLd = graph([
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl("/posts")}#webpage`,
    name: "buffetkimz 기록",
    description: "금융·투자·경제·보험·노후준비·연금·AI·철학을 매일 기록하는 자산리포트.",
    url: pageUrl("/posts"),
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.slice(0, 20).map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.data.title,
        url: pageUrl(postPath(p)),
      })),
    },
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "자산리포트", path: "/posts" },
  ]),
]);
---

<Base
  title="자산리포트 — 매일 쌓이는 금융·투자 기록"
  description="금리·환율·보험·연금·노후·AI. 확인한 것을 매일 한 편씩 남깁니다. 모든 글에 기준일과 1차 출처를 붙이고, 본문까지 검색할 수 있습니다."
  path="/posts"
  jsonLd={jsonLd}
>
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-8 md:py-12">
      <HomePill />
      <p class="kicker">자산리포트 · 투자백서</p>
      <h1 class="h-display mt-3 max-w-[17ch] text-ink">확인한 것을<br />매일 남깁니다.</h1>
      <p class="lede mt-5 max-w-[54ch]">
        금리와 환율, 보험과 연금, 노후와 AI. 그날 확인한 기준과 출처를 붙여 적습니다. 글마다 이어지는
        계산 도구를 함께 두었습니다.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px] text-ink-muted">
        <span>자산리포트 <strong class="font-semibold text-ink">{posts.length}편</strong></span>
        <span>{categories.length}개 분야</span>
        <span class="mono">기준일 <time datetime={latestBasis.toISOString().slice(0, 10)}>{formatDate(latestBasis)}</time></span>
        {basisAgeDays >= 2 && <span class="text-ink-faint">기준일이 {basisAgeDays}일 지났습니다</span>}
        <a href={withBase("/letters")} class="inline-flex min-h-[44px] items-center font-semibold text-brand-deep md:min-h-[24px]">
          소식지 제1호
        </a>
      </div>
    </div>
  </section>

  <!-- 최근 글 1건 -->
  <section class="scene-cream">
    <div class="wrap py-10 md:py-14">
      <a href={withBase(postPath(feature))} class="group block">
        <div class="card card-lift grid gap-5 p-5 md:grid-cols-[1.4fr_0.6fr] md:items-center md:gap-7 md:p-8">
          <div class="post-thumb post-thumb--wide md:col-span-2">
            <img
              src={withBase(thumbOf(feature))}
              alt={`${thumbAltOf(feature)} — ${feature.data.title}`}
              width={thumbSize(thumbOf(feature)).width}
              height={thumbSize(thumbOf(feature)).height}
              fetchpriority="high"
            />
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="text-[12px] font-semibold text-brand">{categoryName(feature.data.category)}</span>
              {feature.data.series && (
                <span class="series-chip" data-series={feature.data.series.name}>
                  {feature.data.series.name}
                  <span class="series-no">{String(feature.data.series.no).padStart(2, "0")}</span>
                </span>
              )}
              <span class="mono text-[12px] text-ink-faint">{formatDate(feature.data.publishedAt)}</span>
              <span class="text-[12px] text-ink-faint">{feature.data.readingMinutes}분</span>
            </div>
            <h2 class="mt-3 max-w-[28ch] text-[clamp(22px,2.8vw,32px)] font-bold leading-[1.32] tracking-[-0.038em] text-ink group-hover:text-brand-deep">
              {feature.data.title}
            </h2>
            <p class="mt-3 max-w-[54ch] text-[14.5px] leading-[1.75] text-ink-muted">{feature.data.description}</p>
            <p class="mono mt-3 text-[12px] leading-relaxed text-ink-faint" data-card-meta>
              확인 기준일 {formatDate(feature.data.baseDate ?? feature.data.publishedAt)} ·{" "}
              출처 {feature.data.sources.length}곳({sourceOrgLine(feature.data.sources)})
            </p>
          </div>
          <div class="rounded-xl bg-paper-deep/70 p-4">
            <p class="text-[12px] font-semibold text-ink-faint">기준일과 출처</p>
            <p class="mono mt-1.5 text-[13px] text-ink">{formatDate(feature.data.publishedAt)}</p>
            <p class="mt-2 text-[12.5px] leading-[1.65] text-ink-muted">
              {feature.data.sources.length > 0
                ? `1차 출처 ${feature.data.sources.length}건 · ${feature.data.sources.map((s) => s.label).slice(0, 2).join(" · ")}`
                : `기준일 ${formatDate(feature.data.baseDate ?? feature.data.publishedAt)}`}
            </p>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- 많이 찾는 핵심 글 3편 -->
  <section class="scene-white border-t border-line" aria-labelledby="picks-heading">
    <div class="wrap py-8 md:py-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="picks-heading" class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">많이 찾는 핵심 글</h2>
        <span class="text-[12px] text-ink-faint">처음 온다면 이 셋부터</span>
      </div>
      <ol class="mt-3 grid gap-2 sm:grid-cols-3">
        {
          picks.map((p, i) => (
            <li>
              <a
                href={withBase(postPath(p))}
                class="group flex h-full items-start gap-3 rounded-xl border border-line bg-white/70 px-4 py-3 transition-colors hover:border-brand/50"
              >
                <span class="mono mt-0.5 text-[11.5px] font-semibold text-brand">{String(i + 1).padStart(2, "0")}</span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-semibold leading-snug text-ink group-hover:text-brand-deep">
                    {p.data.title}
                  </span>
                  <span class="mono mt-1 block text-[11.5px] text-ink-faint">
                    {categoryName(p.data.category)}
                    {p.data.series && ` · ${p.data.series.name} ${String(p.data.series.no).padStart(2, "0")}`} ·{" "}
                    {formatDate(p.data.publishedAt)}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 광고·협찬 자리(목록 중간) — monetization.ts 가 OFF 면 아무것도 그리지 않는다 -->
  <div class="wrap py-6">
    <AdSlot id="posts-index-inline" size="native-list" region="article-mid" />
  </div>

  <section class="scene-white border-y border-line">
    <div class="wrap py-10 md:py-14">
      <!-- 분야 탭 (링크) -->
      <div class="relative">
        <div class="-mx-5 overflow-x-auto px-5 no-scrollbar md:mx-0 md:px-0">
          <div class="flex min-w-max items-center gap-1.5 pb-1" role="navigation" aria-label="분야">
            <span class="tab" data-active="true" aria-current="page">
              전체
              <span class="mono ml-1.5 text-[12px] text-ink-faint">{posts.length}</span>
            </span>
            {
              counts.map((c) => (
                <a href={withBase(`/posts/${c.slug}`)} class="tab">
                  {c.name}
                  <span class="mono ml-1.5 text-[12px] text-ink-faint">{c.count}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-6">
        <PostCards items={rest.map(card)} />
      </div>

      <div class="mt-10">
        <AdSlot id="posts-index-bottom" size="leaderboard" region="article-bottom" />
      </div>

      <HomePill position="bottom" />
    </div>
  </section>
</Base>
