---
/**
 * 자료앨범(/gallery) — v7.1.
 *
 * ── 권한 모델(정적 사이트) ────────────────────────────────────────────────
 * 이 사이트는 GitHub Pages에 올라가는 정적 빌드입니다. 그래서 **업로드 폼도, 업로드 API도 두지 않습니다.**
 * 방문자는 미리보기와 다운로드만 할 수 있고, 자료 등록은 관리자(김대표님·에이전트)가
 *   `public/gallery/`에 이미지를 넣고 `src/data/gallery.ts`에 카드를 추가 → 빌드·배포
 * 하는 방식으로만 이뤄집니다. 저장소에 쓸 수 있는 사람이 곧 등록 권한입니다.
 *
 * ── 방문자 기능 ──────────────────────────────────────────────────────────
 * 카테고리 탭 · 검색 · 태그 필터 · 카드 안 캐러셀(좌우/썸네일) · 라이트박스 크게 보기 ·
 * 현재 장 내려받기(download) · 세트 전체 순차 다운로드 · 전장 미리보기.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import AdSlot from "@/components/AdSlot.astro";
import { withBase, site, menuLabel } from "@/config/site";
import { GALLERY_CATEGORIES, categoryCount, galleryCount, galleryItems, gallerySlideCount } from "@/data/gallery";
import { breadcrumbList, graph, pageUrl, partOfWebsite } from "@/lib/schema";

const tabs = [
  { id: "all", label: "전체", count: galleryCount },
  ...GALLERY_CATEGORIES.map((c) => ({ id: c.id, label: c.label, count: categoryCount(c.id) })),
];

/** 태그 칩 — 자료에서 태그를 모아 빈도순으로 */
const tagCounts = new Map<string, number>();
for (const item of galleryItems) for (const t of item.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ko")).slice(0, 10);

const catLabel = (id: string) => GALLERY_CATEGORIES.find((c) => c.id === id)?.label ?? id;

/** 라이트박스·캐러셀이 읽는 자료 (경로는 withBase 적용) */
const payload = galleryItems.map((item) => ({
  id: item.id,
  title: item.title,
  category: catLabel(item.category),
  basis: item.basis,
  slides: item.slides.map((s) => ({
    src: withBase(s.src),
    alt: s.alt,
    caption: s.caption,
    name: s.src.split("/").pop() ?? "buffetkimz-card.png",
    width: s.width,
    height: s.height,
  })),
}));

const jsonLd = graph([
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl("/gallery")}#webpage`,
    name: "자료앨범 — 버핏킴즈",
    description:
      "금융·연금·재무 주제를 4:5 카드뉴스·캐러셀·인포그래픽·체크리스트로 정리한 자료 모음. 미리보기와 다운로드 전용.",
    url: pageUrl("/gallery"),
    inLanguage: "ko-KR",
    isPartOf: partOfWebsite,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: galleryItems.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.title,
        url: pageUrl("/gallery"),
      })),
    },
  },
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "자료앨범", path: "/gallery" },
  ]),
]);
---

<Base
  title={`자료앨범 — 카드뉴스·캐러셀·인포그래픽 내려받기`}
  description={`연금·금융 주제를 4:5 카드로 정리한 자료 ${galleryCount}세트 ${gallerySlideCount}장. 미리보기로 확인하고 원하는 장만, 또는 세트 전체를 내려받습니다. 관리자 등록 자료 전용.`}
  path="/gallery"
  jsonLd={jsonLd}
>
  <!-- ① 히어로 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-9 md:py-12">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">홈</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">자료앨범</span>
      </nav>

      <div class="mt-5 grid gap-6 md:grid-cols-[minmax(0,1fr)_300px] md:items-end md:gap-10">
        <div>
          <p class="mono text-[11.5px] font-semibold tracking-[0.18em] text-brand">GALLERY · 자료앨범</p>
          <h1 class="h-display mt-2 text-ink">보기 좋게 정리한<br />카드로, 그대로 내려받기</h1>
          <p class="lede mt-4 max-w-[56ch]">
            연금·금융 주제를 4:5 카드로 끊어 담았습니다. 카드 안에서 넘겨 보고, 한 장만 또는 세트 전체를
            내려받아 발표·상담 자료로 쓰실 수 있습니다.
          </p>

          <ul class="mt-5 flex flex-wrap gap-2" data-gallery-summary>
            <li class="chip">{galleryCount}세트 · {gallerySlideCount}장</li>
            <li class="chip">1080 × 1350 (4:5)</li>
            <li class="chip">PNG · 워터마크 없음</li>
            <li class="chip">기준일 {site.baseDateLabel}</li>
          </ul>
        </div>

        <!-- 대표 카드 미리보기 — 첫 세트의 첫 장 -->
        <a href={withBase(galleryItems[0].slides[0].src)} class="group block overflow-hidden rounded-2xl border border-line bg-white shadow-[0_24px_60px_-46px_rgba(15,53,80,0.7)]" data-gallery-hero>
          <img
            src={withBase(galleryItems[0].slides[0].src)}
            alt={galleryItems[0].slides[0].alt}
            width={galleryItems[0].slides[0].width}
            height={galleryItems[0].slides[0].height}
            class="w-full"
            fetchpriority="high"
          />
        </a>
      </div>

      <!-- 운영 방식 안내 — 업로드 없음, 관리자 등록 -->
      <div class="note-box mt-6 flex flex-col gap-1.5 md:flex-row md:items-start md:gap-6" data-gallery-policy>
        <p class="shrink-0 text-[12px] font-bold text-ink">자료 등록 방식</p>
        <p class="text-[12.5px] leading-[1.7] text-ink-muted">
          이 앨범은 관리자가 등록한 자료만 싣습니다. 페이지에는 업로드 입력창이나 업로드 API가 없고,
          새 자료는 <span class="mono text-ink-soft">public/gallery/</span>에 이미지를 넣고
          <span class="mono text-ink-soft">src/data/gallery.ts</span>에 카드를 추가한 뒤 빌드·배포하는 방식으로만
          올라갑니다. 방문자는 미리보기와 다운로드만 합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ② 필터 · 검색 -->
  <section class="scene-white border-b border-line">
    <div class="wrap py-5 md:py-6">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="자료 분류" data-gallery-tabs>
          {
            tabs.map((t) => (
              <button
                type="button"
                role="tab"
                aria-selected={t.id === "all" ? "true" : "false"}
                data-gallery-tab={t.id}
                data-count={t.count}
                class={`gallery-tab ${t.id === "all" ? "is-active" : ""}`}
              >
                {t.label}
                <span class="gallery-tab-count">{t.count}</span>
              </button>
            ))
          }
        </div>

        <div class="flex w-full items-center gap-2 md:w-[320px]">
          <label for="gallery-search" class="sr-only">자료 검색</label>
          <input
            id="gallery-search"
            type="search"
            placeholder="제목·태그로 찾기 (예: ISA)"
            class="h-[44px] w-full rounded-full border border-line bg-white px-4 text-[13px] text-ink placeholder:text-ink-faint focus:border-brand/50 focus:outline-none"
            data-gallery-search
          />
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-1.5" data-gallery-tags>
        <span class="text-[12px] font-semibold text-ink-faint">태그</span>
        {
          tags.map(([tag, n]) => (
            <button type="button" class="gallery-tag" data-gallery-tag={tag}>
              {tag}
              <span class="text-ink-faint">{n}</span>
            </button>
          ))
        }
      </div>

      <p class="mt-3 text-[12px] text-ink-faint" data-gallery-status>
        <span data-gallery-count>{galleryCount}</span>세트 · <span data-gallery-count-slides>{gallerySlideCount}</span>장 ·
        카드를 누르면 크게 보고 내려받을 수 있습니다.
      </p>
    </div>
  </section>

  <!-- ③ 자료 그리드 -->
  <section class="scene-cream">
    <div class="wrap py-8 md:py-12">
      <div class="grid gap-5 md:grid-cols-2" data-gallery-grid>
        {
          galleryItems.map((item, idx) => (
            <article
              class="gallery-card"
              data-gallery-item={item.id}
              data-category={item.category}
              data-tags={item.tags.join(" ")}
              data-title={`${item.title} ${item.tagline} ${item.tags.join(" ")}`}
              data-slides={item.slides.length}
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-[11.5px] font-bold tracking-[0.1em] text-brand">{catLabel(item.category)}</p>
                  <h2 class="mt-1 text-[17px] font-bold leading-snug tracking-[-0.03em] text-ink">
                    {item.title}
                  </h2>
                  <p class="mt-1 text-[12.5px] text-ink-muted">{item.tagline}</p>
                </div>
                <span class="chip shrink-0 !text-[11.5px]">{item.slides.length === 1 ? "1장" : `${item.slides.length}장 세트`}</span>
              </div>

              <!-- 카드 안 캐러셀 -->
              <div class="gallery-stage" data-gallery-stage-wrap>
                <button type="button" class="gallery-open" data-gallery-open aria-label={`${item.title} 크게 보기`}>
                  <img
                    src={withBase(item.slides[0].src)}
                    alt={item.slides[0].alt}
                    width={item.slides[0].width}
                    height={item.slides[0].height}
                    class="gallery-stage-img"
                    loading="eager"
                    decoding="async"
                    data-gallery-stage
                  />
                </button>
                {item.slides.length > 1 && (
                  <>
                    <button type="button" class="gallery-nav is-prev" data-gallery-prev aria-label="이전 장">
                      ‹
                    </button>
                    <button type="button" class="gallery-nav is-next" data-gallery-next aria-label="다음 장">
                      ›
                    </button>
                    <span class="gallery-counter" data-gallery-counter>
                      1 / {item.slides.length}
                    </span>
                  </>
                )}
              </div>

              {item.slides.length > 1 && (
                <ul class="gallery-thumbs" data-gallery-thumbs>
                  {item.slides.map((s, i) => (
                    <li>
                      <button
                        type="button"
                        class={`gallery-thumb ${i === 0 ? "is-active" : ""}`}
                        data-gallery-thumb={i}
                        aria-label={`${i + 1}장 — ${s.caption}`}
                      >
                        <img src={withBase(s.src)} alt="" width="108" height="135" loading="eager" decoding="async" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}

              <p class="mt-2 line-clamp-2 text-[12.5px] leading-[1.65] text-ink-muted" data-gallery-caption>
                {item.slides[0].caption}
              </p>

              <ul class="mt-2 flex flex-wrap gap-1">
                {item.tags.map((t) => (
                  <li class="gallery-tag-static">{t}</li>
                ))}
              </ul>

              <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-line-soft pt-3">
                <a
                  href={withBase(item.slides[0].src)}
                  download={item.slides[0].src.split("/").pop()}
                  class="btn btn-primary btn-xs"
                  data-gallery-download
                  data-gallery-download-current
                >
                  현재 장 내려받기
                </a>
                {item.slides.length > 1 && (
                  <>
                    <button type="button" class="btn btn-secondary btn-xs" data-gallery-set-download>
                      세트 전체 받기
                    </button>
                    <button type="button" class="btn btn-tertiary btn-xs" data-gallery-open-all>
                      전장 미리보기
                    </button>
                  </>
                )}
                <a href={withBase("/gallery")} class="ml-auto text-[11.5px] text-ink-faint" data-gallery-basis>
                  {item.basis}
                </a>
              </div>

              {item.related && (
                <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[12px]">
                  {item.related.map((r) => (
                    <a href={withBase(r.href)} class="font-semibold text-brand-deep link">{r.label}</a>
                  ))}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <p class="hidden py-16 text-center text-[14px] text-ink-muted" data-gallery-empty>
        조건에 맞는 자료가 없습니다. 검색어를 지우거나 다른 태그를 골라 보세요.
      </p>

      <div class="mt-8">
        <AdSlot id="gallery-bottom" size="leaderboard" region="article-bottom" />
      </div>

      <p class="mt-4 text-[12px] leading-[1.8] text-ink-faint">
        모든 카드는 1080×1350 PNG입니다. 세트 전체 받기는 브라우저가 연속 다운로드를 막으면 한 장씩
        내려받아 주세요. 자료의 숫자는 각 카드 하단의 기준일·출처를 함께 확인해 주세요.
      </p>
    </div>
  </section>

  <!-- 라이트박스 -->
  <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="자료 크게 보기">
    <div class="gallery-lb-head">
      <p class="text-[13px] font-bold text-white" data-lb-title></p>
      <div class="flex items-center gap-2">
        <span class="mono text-[12px] text-[#c9ddd4]" data-lb-count></span>
        <button type="button" class="gallery-lb-close" data-lb-close aria-label="닫기">×</button>
      </div>
    </div>
    <div class="gallery-lb-body">
      <button type="button" class="gallery-lb-nav is-prev" data-lb-prev aria-label="이전 장">‹</button>
      <img src="" alt="" data-lb-img />
      <button type="button" class="gallery-lb-nav is-next" data-lb-next aria-label="다음 장">›</button>
    </div>
    <div class="gallery-lb-foot">
      <p class="text-[12.5px] text-[#d7e7e1]" data-lb-caption></p>
      <div class="flex flex-wrap items-center gap-2">
        <a href="" download class="btn btn-primary btn-xs" data-lb-download>현재 장 내려받기</a>
        <div class="gallery-lb-thumbs" data-lb-thumbs></div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(payload)} />
  <script>
    type Slide = { src: string; alt: string; caption: string; name: string; width: number; height: number };
    type Item = { id: string; title: string; category: string; basis: string; slides: Slide[] };

    const data: Item[] = JSON.parse(document.getElementById("gallery-data")?.textContent || "[]");
    const byId = new Map(data.map((d) => [d.id, d]));

    const grid = document.querySelector<HTMLElement>("[data-gallery-grid]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-item]"));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-tab]"));
    const search = document.querySelector<HTMLInputElement>("[data-gallery-search]");
    const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gallery-tag]"));
    const empty = document.querySelector<HTMLElement>("[data-gallery-empty]");
    const countEl = document.querySelector<HTMLElement>("[data-gallery-count]");
    const slideCountEl = document.querySelector<HTMLElement>("[data-gallery-count-slides]");

    let activeCat = "all";
    let activeTag = "";

    /** 카드 하나의 상태 — 현재 장 index */
    const state = new Map<string, number>();
    cards.forEach((c) => state.set(c.dataset.galleryItem || "", 0));

    function renderCard(card: HTMLElement) {
      const id = card.dataset.galleryItem || "";
      const item = byId.get(id);
      if (!item) return;
      const i = state.get(id) ?? 0;
      const slide = item.slides[i];
      const stage = card.querySelector<HTMLImageElement>("[data-gallery-stage]");
      if (stage) {
        stage.src = slide.src;
        stage.alt = slide.alt;
      }
      const counter = card.querySelector<HTMLElement>("[data-gallery-counter]");
      if (counter) counter.textContent = `${i + 1} / ${item.slides.length}`;
      const cap = card.querySelector<HTMLElement>("[data-gallery-caption]");
      if (cap) cap.textContent = slide.caption;
      card.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach((b) => {
        b.classList.toggle("is-active", Number(b.dataset.galleryThumb) === i);
      });
      const dl = card.querySelector<HTMLAnchorElement>("[data-gallery-download-current]");
      if (dl) {
        dl.href = slide.src;
        dl.setAttribute("download", slide.name);
      }
    }

    function applyFilter() {
      const q = (search?.value || "").trim().toLowerCase();
      let shown = 0;
      let slides = 0;
      cards.forEach((card) => {
        const cat = card.dataset.category || "";
        const tags = (card.dataset.tags || "").toLowerCase();
        const title = (card.dataset.title || "").toLowerCase();
        const okCat = activeCat === "all" || cat === activeCat;
        const okTag = !activeTag || tags.includes(activeTag.toLowerCase());
        const okQ = !q || title.includes(q) || tags.includes(q);
        const visible = okCat && okTag && okQ;
        card.hidden = !visible;
        if (visible) {
          shown += 1;
          slides += Number(card.dataset.slides || 0);
        }
      });
      tabs.forEach((t) => {
        const on = (t.dataset.galleryTab || "all") === activeCat;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      tagButtons.forEach((t) => t.classList.toggle("is-active", (t.dataset.galleryTag || "") === activeTag));
      if (countEl) countEl.textContent = String(shown);
      if (slideCountEl) slideCountEl.textContent = String(slides);
      if (empty) empty.hidden = shown > 0;
      if (grid) grid.hidden = shown === 0;
    }

    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        activeCat = t.dataset.galleryTab || "all";
        applyFilter();
      })
    );
    search?.addEventListener("input", applyFilter);
    tagButtons.forEach((t) =>
      t.addEventListener("click", () => {
        const tag = t.dataset.galleryTag || "";
        activeTag = activeTag === tag ? "" : tag;
        applyFilter();
      })
    );

    // 카드 안 캐러셀
    cards.forEach((card) => {
      const id = card.dataset.galleryItem || "";
      const item = byId.get(id);
      if (!item) return;
      card.querySelector("[data-gallery-prev]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        const i = (state.get(id) ?? 0) - 1;
        state.set(id, (i + item.slides.length) % item.slides.length);
        renderCard(card);
      });
      card.querySelector("[data-gallery-next]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        const i = (state.get(id) ?? 0) + 1;
        state.set(id, i % item.slides.length);
        renderCard(card);
      });
      card.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach((b) => {
        b.addEventListener("click", () => {
          state.set(id, Number(b.dataset.galleryThumb) || 0);
          renderCard(card);
        });
      });
      card.querySelector("[data-gallery-open]")?.addEventListener("click", () => openLightbox(id, state.get(id) ?? 0));
      card.querySelector("[data-gallery-open-all]")?.addEventListener("click", () => openLightbox(id, 0));
    });

    // 라이트박스
    const lb = document.querySelector<HTMLDialogElement>("[data-gallery-lightbox]");
    const lbImg = document.querySelector<HTMLImageElement>("[data-lb-img]");
    const lbTitle = document.querySelector<HTMLElement>("[data-lb-title]");
    const lbCount = document.querySelector<HTMLElement>("[data-lb-count]");
    const lbCaption = document.querySelector<HTMLElement>("[data-lb-caption]");
    const lbDl = document.querySelector<HTMLAnchorElement>("[data-lb-download]");
    const lbThumbs = document.querySelector<HTMLElement>("[data-lb-thumbs]");
    let lbId = "";
    let lbIndex = 0;

    function renderLightbox() {
      const item = byId.get(lbId);
      if (!item || !lbImg) return;
      const slide = item.slides[lbIndex];
      lbImg.src = slide.src;
      lbImg.alt = slide.alt;
      if (lbTitle) lbTitle.textContent = item.title;
      if (lbCount) lbCount.textContent = `${lbIndex + 1} / ${item.slides.length}`;
      if (lbCaption) lbCaption.textContent = `${slide.caption} — ${item.basis}`;
      if (lbDl) {
        lbDl.href = slide.src;
        lbDl.setAttribute("download", slide.name);
      }
      if (lbThumbs) {
        lbThumbs.innerHTML = "";
        item.slides.forEach((s, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = `gallery-lb-thumb${i === lbIndex ? " is-active" : ""}`;
          b.setAttribute("aria-label", `${i + 1}장 ${s.caption}`);
          b.innerHTML = `<img src="${s.src}" alt="" width="40" height="50" loading="lazy" />`;
          b.addEventListener("click", () => {
            lbIndex = i;
            renderLightbox();
          });
          lbThumbs.appendChild(b);
        });
      }
      const prev = document.querySelector<HTMLButtonElement>("[data-lb-prev]");
      const next = document.querySelector<HTMLButtonElement>("[data-lb-next]");
      if (prev) prev.disabled = item.slides.length < 2;
      if (next) next.disabled = item.slides.length < 2;
    }

    function openLightbox(id: string, index = 0) {
      lbId = id;
      lbIndex = index;
      renderLightbox();
      if (lb && !lb.open) lb.showModal();
    }

    document.querySelector("[data-lb-close]")?.addEventListener("click", () => lb?.close());
    document.querySelector("[data-lb-prev]")?.addEventListener("click", () => {
      const item = byId.get(lbId);
      if (!item) return;
      lbIndex = (lbIndex - 1 + item.slides.length) % item.slides.length;
      renderLightbox();
    });
    document.querySelector("[data-lb-next]")?.addEventListener("click", () => {
      const item = byId.get(lbId);
      if (!item) return;
      lbIndex = (lbIndex + 1) % item.slides.length;
      renderLightbox();
    });
    lb?.addEventListener("click", (e) => {
      if (e.target === lb) lb.close();
    });
    document.addEventListener("keydown", (e) => {
      if (!lb?.open) return;
      if (e.key === "ArrowLeft") document.querySelector<HTMLButtonElement>("[data-lb-prev]")?.click();
      if (e.key === "ArrowRight") document.querySelector<HTMLButtonElement>("[data-lb-next]")?.click();
    });

    // 세트 전체 순차 다운로드
    function downloadOne(src: string, name: string) {
      const a = document.createElement("a");
      a.href = src;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }
    document.querySelectorAll<HTMLButtonElement>("[data-gallery-set-download]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const card = btn.closest<HTMLElement>("[data-gallery-item]");
        const item = byId.get(card?.dataset.galleryItem || "");
        if (!item) return;
        const total = item.slides.length;
        for (let i = 0; i < total; i += 1) {
          btn.textContent = `내려받는 중 ${i + 1}/${total}`;
          downloadOne(item.slides[i].src, item.slides[i].name);
          await new Promise((r) => setTimeout(r, 420));
        }
        btn.textContent = `세트 전체 받기 (${total}장)`;
        window.setTimeout(() => {
          btn.textContent = "세트 전체 받기";
        }, 1800);
      });
    });
  </script>
</Base>
