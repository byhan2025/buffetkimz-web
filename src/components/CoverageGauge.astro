---
/**
 * 5대 담보 5칸 게이지 — 기준점(예시 40대)과 예시 보유액을 같은 칸에 놓는다.
 * 칸 하나가 도구 실행 화면의 해당 항목으로 이어진다.
 * 라벨·문구는 실행 화면(CoverageCheck)과 같은 것을 쓴다(lib/coverage.ts).
 */
import { COVERAGE_EXAMPLE, COVERAGE_LABEL, COVERAGE_NOTE, COVERAGE_TONE, BAND_LABEL, coverageSummary, presentVerdicts } from "@/lib/coverage";
import { site, withBase } from "@/config/site";

const { rows, band } = coverageSummary(COVERAGE_EXAMPLE.band);
const pct = (r: number) => Math.max(2, Math.min(100, Math.round(r * 100)));
const man = (v: number) => v.toLocaleString("ko-KR");
/* 범례는 실제 행 라벨로 쓰인 상태만 — 지금은 2상태다. */
const verdicts = presentVerdicts(rows);
/* 막대는 도형(넓은 면), 라벨은 12px 글자 — 글자는 4.5:1을 넘는 어두운 톤을 따로 쓴다. */
const barTone = (verdict: string) => COVERAGE_TONE[verdict as keyof typeof COVERAGE_TONE].dot;
const textTone = (verdict: string) => COVERAGE_TONE[verdict as keyof typeof COVERAGE_TONE].text;
const unit = (key: string) => (key === "nursing" ? "만/일" : "만");
---

<div class="card overflow-hidden">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-line px-5 py-4 md:px-7">
    <div>
      <p class="text-[12px] font-semibold tracking-[0.02em] text-brand">5대 담보</p>
      <p class="mt-1 text-[15px] font-semibold text-ink">{BAND_LABEL[band]} 기준점과 예시 보유액</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-muted" data-coverage-legend>
      <span class="mono">예시 입력값 · 기준일 {site.baseDateLabel}</span>
      {
        verdicts.map((v) => (
          <span class="flex items-center gap-1" data-legend-state={v}><i class="h-2 w-2 rounded-full" style={`background:${COVERAGE_TONE[v].dot}`}></i>{COVERAGE_LABEL[v]}</span>
        ))
      }
    </div>
  </div>

  <!-- 결과 상태 바로 위에 두는 단순 비교 고지 -->
  <p class="border-b border-line-soft bg-paper-deep/50 px-5 py-2 text-[12px] leading-relaxed text-ink-muted md:px-7">
    {COVERAGE_NOTE}
  </p>

  <ul class="divide-y divide-line-soft">
    {
      rows.map((r) => (
        <li>
          <a
            href={withBase("/apps/coverage-check")}
            class="group grid grid-cols-[68px_1fr_auto] items-center gap-x-3 gap-y-1 px-5 py-3.5 transition-colors hover:bg-paper-deep/40 md:grid-cols-[96px_1fr_150px_150px] md:gap-x-5 md:px-7"
            aria-label={`${r.name} 기준 ${man(r.need)}${unit(r.key)}, 예시 ${man(r.have)}${unit(r.key)} — ${r.label} (보장 점검 도구에서 확인)`}
            data-row-state={r.verdict}
          >
            <span class="text-[14px] font-semibold text-ink md:text-[15px]">{r.name}</span>

            <span class="relative order-3 col-span-3 flex h-3 w-full items-center overflow-hidden rounded-full bg-[#eef2f5] md:order-none md:col-span-1">
              <span
                class="h-full rounded-full"
                style={`width:${pct(r.ratio)}%;background-color:${barTone(r.verdict)}`}
              />
            </span>

            <span class="mono order-2 justify-self-end text-[12.5px] text-ink-soft md:order-none md:justify-self-auto">
              {man(r.have)} / {man(r.need)}{unit(r.key)}
            </span>

            <span class="order-2 whitespace-nowrap justify-self-end text-[12px] font-semibold md:order-none" style={`color:${textTone(r.verdict)}`}>
              {r.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="border-t border-line bg-paper-deep/40 px-5 py-3 md:px-7">
    <p class="text-[12px] leading-relaxed text-ink-muted">
      가로 막대는 기준점을 100으로 놓았을 때의 예시 보유액입니다. 칸을 누르면 같은 기준점으로 내 숫자를
      넣어 보는 화면이 열립니다. 이 도해는 가입 판정이 아니라 확인할 항목을 보여 주는 예시입니다.
    </p>
  </div>
</div>
