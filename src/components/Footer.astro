---
/**
 * v3.2 슬림 푸터 — 세로 4단(브랜드·기록·도구·사이트) + 법적 고지 박스를
 * 1단 밴드(브랜드 + 주요 메뉴)와 두 줄짜리 색인·고지로 접었다.
 * 분류·도구 링크는 한 줄 색인으로 남겨 내부 이동은 그대로 유지한다.
 */
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { apps } from "@/data/apps";
import { calendar } from "@/data/calendar";

const year = site.today.getFullYear();
const internalApps = apps.filter((a) => a.internal);
const mainLinks = [
  { href: "/posts", label: "기록 전체" },
  { href: "/apps", label: "도구 전체" },
  { href: "/calendar", label: "제도 일정" },
  { href: "/search", label: "검색" },
  { href: "/about", label: "소개" },
];
const policyLinks = [
  { href: "/rss.xml", label: "RSS" },
  { href: "/privacy", label: "개인정보처리방침" },
  { href: "/terms", label: "이용약관" },
];
---

<footer class="border-t border-line bg-cream">
  <div class="wrap py-6 md:py-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-[46ch]">
        <a href={withBase("/")} class="serif text-[22px] leading-none text-ink">buffetkimz</a>
        <p class="mt-1.5 text-[12.5px] leading-[1.7] text-ink-muted">
          금융과 돈에 관한 기록, 그리고 직접 만든 도구. 확인한 기준과 출처를 붙여 남깁니다.
        </p>
      </div>

      <nav aria-label="주요 메뉴" class="flex flex-wrap items-center gap-x-4 text-[13px]">
        {
          mainLinks.map((l) => (
            <a href={withBase(l.href)} class="inline-flex min-h-[44px] items-center font-semibold text-ink-soft hover:text-brand-deep md:min-h-[32px]">
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-1 border-t border-line/70 pt-2 text-[12.5px] leading-[1.9] text-ink-muted md:mt-2">
      <span class="text-ink-faint">기록</span>
      {
        categories.map((c, i) => (
          <>
            {i > 0 && <span class="text-line" aria-hidden="true"> · </span>}
            <a href={withBase(`/posts/${c.slug}`)} class="inline-flex min-h-[24px] items-center hover:text-brand-deep">{c.name}</a>
          </>
        ))
      }
      <span class="mx-2 text-line" aria-hidden="true">|</span>
      <span class="text-ink-faint">도구</span>
      {
        internalApps.map((a, i) => (
          <>
            {i > 0 && <span class="text-line" aria-hidden="true"> · </span>}
            <a href={withBase(`/apps/${a.slug}`)} class="inline-flex min-h-[24px] items-center hover:text-brand-deep">{a.name}</a>
          </>
        ))
      }
      <span class="text-line" aria-hidden="true"> · </span>
      <a href={withBase("/calendar")} class="inline-flex min-h-[24px] items-center hover:text-brand-deep">제도 일정 {calendar.length}건</a>
    </p>

    <p class="mt-2 max-w-[96ch] text-[12px] leading-[1.8] text-ink-muted">
      buffetkimz는 금융·보험 정보를 정리해 남기는 개인 기록입니다. 모든 글과 도구는 정보 제공을 목적으로 하며,
      특정 상품의 추천·중개·가입 권유가 아닙니다. 보장 판정과 지급 여부는 약관과 보험회사의 심사에 따릅니다.
      도구에 입력한 값은 브라우저 안에서만 계산되며 서버로 전송·저장되지 않습니다.
    </p>

    <div class="mt-2 flex flex-col gap-1 border-t border-line/70 pt-2 text-[12px] text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.brand} · 계산 결과와 일정은 1차 자료 기준의 참고용 정보입니다.</p>
      <p class="flex flex-wrap items-center gap-x-3">
        {
          policyLinks.map((l) => (
            <a href={withBase(l.href)} class="inline-flex min-h-[24px] items-center hover:text-ink">{l.label}</a>
          ))
        }
        <span class="mono">기준일 <time datetime={site.baseDate}>{site.baseDate}</time></span>
      </p>
    </div>
  </div>
</footer>
