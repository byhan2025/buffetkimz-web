---
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { apps } from "@/data/apps";
import { calendar } from "@/data/calendar";

const year = site.today.getFullYear();
const tools = apps.filter((a) => a.internal);
---

<footer class="mt-0 bg-cream">
  <div class="wrap pb-10 pt-12 md:pt-14">
    <div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <a href={withBase("/")} class="serif text-[26px] leading-none text-ink">buffetkimz</a>
        <p class="mt-4 max-w-[34ch] text-[14px] leading-[1.75] text-ink-muted">
          금융과 돈에 관한 기록, 그리고 직접 만든 도구. 확인한 기준과 출처를 붙여 남깁니다.
        </p>
        <ul class="mt-5 space-y-1.5 text-[12.5px] text-ink-muted">
          {site.principles.map((p) => <li>{p.title}</li>)}
        </ul>

        <div class="mt-6">
          {
            site.kakaoChannelUrl ? (
              <a
                href={site.kakaoChannelUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center rounded-full border border-ink/15 bg-white px-4 text-[13px] font-semibold text-ink transition-colors hover:border-ink/40"
              >
                카카오톡 채널
              </a>
            ) : (
              <span class="inline-flex min-h-[44px] items-center rounded-full border border-dashed border-ink/20 px-4 text-[12.5px] text-ink-faint">
                카카오톡 채널 주소 준비 중
              </span>
            )
          }
        </div>
      </div>

      <nav aria-label="기록">
        <h2 class="text-[12px] font-semibold tracking-[0.04em] text-ink-faint">기록</h2>
        <ul class="mt-3.5 space-y-2">
          {
            categories.map((c) => (
              <li>
                <a href={withBase(`/posts/${c.slug}`)} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="도구">
        <h2 class="text-[12px] font-semibold tracking-[0.04em] text-ink-faint">도구</h2>
        <ul class="mt-3.5 space-y-2">
          {
            tools.map((a) => (
              <li>
                <a href={withBase(`/apps/${a.slug}`)} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">
                  {a.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href={withBase("/calendar")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">
              제도 일정 달력
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="사이트">
        <h2 class="text-[12px] font-semibold tracking-[0.04em] text-ink-faint">사이트</h2>
        <ul class="mt-3.5 space-y-2">
          <li><a href={withBase("/posts")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">기록 전체</a></li>
          <li><a href={withBase("/apps")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">도구 전체</a></li>
          <li><a href={withBase("/calendar")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">제도 일정 {calendar.length}건</a></li>
          <li><a href={withBase("/search")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">검색</a></li>
          <li><a href={withBase("/about")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">소개</a></li>
          <li><a href={withBase("/rss.xml")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">RSS</a></li>
          <li><a href={withBase("/privacy")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">개인정보처리방침</a></li>
          <li><a href={withBase("/terms")} class="flex min-h-[44px] items-center text-[13.5px] text-ink-soft hover:text-brand-deep md:min-h-[34px]">이용약관</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 rounded-2xl border border-ink/10 bg-white/60 p-5 md:p-6">
      <p class="max-w-[82ch] text-[12.5px] leading-[1.8] text-ink-muted">
        buffetkimz는 금융·보험 정보를 정리해 남기는 개인 기록입니다. 모든 글과 도구는 정보 제공을 목적으로 하며,
        특정 상품의 추천·중개·가입 권유가 아닙니다. 보장 판정과 지급 여부는 약관과 보험회사의 심사에 따릅니다.
        도구에 입력한 값은 브라우저 안에서만 계산되며 서버로 전송·저장되지 않습니다.
      </p>
      <p class="mt-3 max-w-[82ch] text-[12.5px] leading-[1.8] text-ink-faint">
        계산 결과와 일정은 공개된 1차 자료를 기준으로 정리한 참고용 정보입니다. 개별 계약은 약관과 증권,
        관계 기관의 최신 안내로 다시 확인해야 합니다.
      </p>
      <div class="mt-4 flex flex-col gap-2 border-t border-ink/10 pt-4 text-[12px] text-ink-faint sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {site.brand}</p>
        <p class="mono">
          콘텐츠 기준일 <time datetime={site.baseDate}>{site.baseDate}</time>
        </p>
      </div>
    </div>
  </div>
</footer>
