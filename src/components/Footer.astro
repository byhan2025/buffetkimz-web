---
/**
 * v3.2 슬림 푸터 — 세로 4단(브랜드·기록·도구·사이트) + 법적 고지 박스를
 * 1단 밴드(브랜드 + 주요 메뉴)와 두 줄짜리 색인·고지로 접었다.
 * 분류·도구 링크는 한 줄 색인으로 남겨 내부 이동은 그대로 유지한다.
 */
import { withBase, site } from "@/config/site";
import { categories } from "@/data/categories";
import { apps } from "@/data/apps";
import { calendar } from "@/data/calendar";
import BrandLockup from "@/components/BrandLockup.astro";

const year = site.today.getFullYear();
const internalApps = apps.filter((a) => a.internal);
const mainLinks = [
  { href: "/posts", label: "자산리포트 전체" },
  { href: "/apps", label: "앱스토어" },
  { href: "/calendar", label: "골든타임" },
  { href: "/gallery", label: "자료앨범" },
  { href: "/academy", label: "아카데미" },
  { href: "/about", label: "소개" },
];
const policyLinks = [
  { href: "/principles", label: "편집 원칙" },
  { href: "/rss.xml", label: "RSS" },
  { href: "/privacy", label: "개인정보처리방침" },
  { href: "/terms", label: "이용약관" },
];
---

<footer class="border-t border-line bg-cream">
  <div class="wrap py-6 md:py-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-[46ch]">
        <a href={withBase("/")} class="brand-lockup-link inline-flex" aria-label={`${site.brand} 홈`}>
          <BrandLockup class="brand-lockup--footer" />
        </a>
        <p class="mt-1.5 text-[12.5px] leading-[1.7] text-ink-muted">
          금융·투자·연금·재무를 하나의 기준으로 읽는 곳. 시장 지표와 오늘의 브리핑, 직접 계산하는
          앱스토어, 매일 쌓는 자산리포트를 한자리에 모았습니다.
        </p>
      </div>

      <nav aria-label="주요 메뉴" class="flex flex-wrap items-center gap-x-4 text-[13px]">
        {
          mainLinks.map((l) => (
            <a href={withBase(l.href)} class="inline-flex min-h-[44px] items-center font-semibold text-ink-soft hover:text-brand-deep md:min-h-[32px]">
              {l.label}
            </a>
          ))
        }
        <a
          href={site.contact.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center font-semibold text-brand-deep hover:text-brand"
        >
          {site.contact.label}
        </a>
        <a
          href={withBase("/principles")}
          class="inline-flex min-h-[44px] items-center font-semibold text-brand-deep hover:text-brand"
        >
          만든 기준
        </a>
      </nav>
    </div>

    <p class="mt-1 border-t border-line/70 pt-2 text-[12.5px] leading-[1.9] text-ink-muted md:mt-2">
      <span class="mr-1 font-semibold text-ink">자산리포트</span>
      {
        categories.map((c, i) => (
          <>
            {i > 0 && <span class="text-line" aria-hidden="true"> · </span>}
            <a href={withBase(`/posts/${c.slug}`)} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-brand-deep">{c.name}</a>
          </>
        ))
      }
      <span class="mx-2 text-line" aria-hidden="true">|</span>
      <span class="mr-1 font-semibold text-ink">앱스토어</span>
      {
        internalApps.map((a, i) => (
          <>
            {i > 0 && <span class="text-line" aria-hidden="true"> · </span>}
            <a href={withBase(`/apps/${a.slug}`)} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-brand-deep">{a.name}</a>
          </>
        ))
      }
      <span class="text-line" aria-hidden="true"> · </span>
      <a href={withBase("/calendar")} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-brand-deep">골든타임 {calendar.length}건</a>
    </p>

    <p class="mt-2 max-w-[96ch] text-[12px] leading-[1.8] text-ink-soft">
      buffetkimz는 금융·투자·연금·재무의 숫자를 원문과 계산으로 확인해 정리하는 금융 포털입니다.
      모든 글과 도구는 정보 제공을 목적으로 하며, 최종 판단과 결정은 읽는 분의 몫입니다. 1:1 상담문의는
      숫자와 조건을 함께 놓고 확인하는 자리입니다. 계산 결과는 약관·증권·원문으로 다시 확인하세요.
      도구에 입력한 값은 브라우저 안에서만 계산됩니다. 예외는 주소 단축기의 짧은 주소 생성 한 건으로,
      그때만 입력한 주소가 외부 단축 서비스로 전송됩니다.
    </p>

    <div class="mt-2 flex flex-col gap-1 border-t border-line/70 pt-2 text-[12px] text-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.brand} · 계산 결과와 일정은 1차 자료 기준의 참고용 정보입니다.</p>
      <p class="flex flex-wrap items-center gap-x-3">
        {
          policyLinks.map((l) => (
            <a href={withBase(l.href)} class="inline-flex min-h-[44px] md:min-h-[24px] items-center hover:text-ink">{l.label}</a>
          ))
        }
        <span class="mono">기준일 <time datetime={site.baseDate}>{site.baseDateLabel}</time></span>
      </p>
    </div>
  </div>
</footer>
