---
/**
 * 하위 페이지 '← 홈으로' 알약 버튼 (높이 44px 이상).
 *
 * - `position="top"`  : 페이지 머리(제목 위) — 모든 하위 페이지
 * - `position="bottom"` : 긴 글·목록의 끝 — 본문을 다 읽은 뒤 한 번 더
 *
 * 도구 실행 화면(/apps/…/run)은 하단 고정 요약 바(StickySummary)와 겹치므로 상단에만 둔다.
 */
import { withBase } from "@/config/site";

interface Props {
  position?: "top" | "bottom";
  label?: string;
}

const { position = "top", label = "홈으로" } = Astro.props;
---

<div class:list={["home-pill-row", position === "bottom" && "home-pill-row--bottom"]} data-home-pill={position}>
  <a href={withBase("/")} class="home-pill">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
    {label}
  </a>
</div>
