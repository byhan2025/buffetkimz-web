---
/**
 * TrackDock — 학습 트랙의 하단 순환 독 (v9.1.0 P2 신설).
 *
 * 설계: reports/buffetkimz-web/learning-blueprint-v1-20261123.md §3-1~§3-3·§5-4
 *
 * 왜 하단에 고정하는가
 *  · 글·강의를 다 읽은 사람은 화면 맨 끝에서 '다음이 무엇인지'를 찾는다. 그 자리에 진행선(1/3)과
 *    이전/현재/도구/다음 네 칸을 두면, 3단계를 1→2→3 클릭만으로 완주할 수 있다.
 *  · 순서의 주인은 `data/tracks.ts` 하나다 — 화면은 그 순서를 그릴 뿐, 다음 단계를 손으로 정하지 않는다.
 *
 * 지켜야 하는 것
 *  ① 모든 버튼·링크는 44px 이상(min-h-[44px]) — 한 손 엄지로 누르는 자리다.
 *  ② 기존 고정 요소(가이드 독·도구 요약 바)와 겹치지 않는다. 같은 자리를 쓰던 '읽기 여정 바'는
 *     이 독이 더 정확한 안내(트랙 순서·도구·다음 단계)를 하므로 독이 있는 화면에서 감춘다
 *     (global.css의 `body:has([data-track-dock])` 규칙).
 *  ③ 이 독은 도구 실행 화면(`/apps/{slug}/run`)에 붙이지 않는다 — 그 화면에는 모바일 하단 요약 바
 *     (`.sticky-summary`)가 있고, 그 자리는 `RunExit`가 본문 끝에서 맡는다.
 *  ④ 손실 질문(`nextQuestion`)은 **한 줄 티저**로만 둔다. 전문은 단계 페이지에 있고, 여기서 문장을
 *     자르면 '질문과 근거'가 떨어지므로 말줄임 대신 `title`에 전문을 함께 둔다.
 *
 * Props
 *  · track — 트랙 전체(순서·이름·약속)
 *  · stage — 지금 보고 있는 단계(이 글이·이 강의가 속한 단계)
 */
import { withBase } from "@/config/site";
import type { Track, TrackStage } from "@/data/tracks";
import { apps } from "@/data/apps";
import { trackHref } from "@/lib/track-view";

interface Props {
  track: Track;
  stage: TrackStage;
}

const { track, stage } = Astro.props;

const index = track.stages.findIndex((item) => item.no === stage.no);
const prev = index > 0 ? track.stages[index - 1] : undefined;
const next = index >= 0 && index < track.stages.length - 1 ? track.stages[index + 1] : undefined;
const tool = apps.find((item) => item.slug === stage.tool);
const progress = Math.round(((index + 1) / track.stages.length) * 100);
const here = `${stage.no}단계·${stage.name}`;
---

<nav
  class="track-dock"
  data-track-dock={track.id}
  data-track-stage={String(stage.no)}
  aria-label={`${track.name} 트랙 — ${track.stages.length}단계 중 ${stage.no}단계 ${stage.name}`}
>
  <div class="td-progress" aria-hidden="true">
    <span style={`width:${progress}%`}></span>
  </div>

  <div class="wrap td-row">
    {
      prev ? (
        <a
          class="td-btn td-prev"
          href={withBase(trackHref(track, prev))}
          aria-label={`이전 단계 — ${prev.no}단계 ${prev.name}`}
        >
          <span aria-hidden="true">←</span>
        </a>
      ) : (
        <span class="td-btn is-off" aria-hidden="true">
          ←
        </span>
      )
    }

    <a class="td-now" href={withBase(trackHref(track, stage))}>
      <span class="td-kicker">{track.name} · {stage.no}/{track.stages.length}</span>
      <span class="td-name">{here}</span>
    </a>

    {
      tool && (
        <a
          class="td-btn td-tool"
          href={withBase(`/apps/${tool.slug}/run`)}
          aria-label={`이 단계의 도구 — ${tool.name} 실행`}
        >
          도구
        </a>
      )
    }

    {
      next ? (
        <a
          class="td-btn td-next"
          href={withBase(trackHref(track, next))}
          aria-label={`다음 단계 — ${next.no}단계 ${next.name}`}
        >
          다음
        </a>
      ) : (
        <a
          class="td-btn td-next is-soon"
          href={withBase("/academy/#roadmap")}
          aria-label="다음 트랙은 준비 중입니다 — 아카데미 로드맵으로"
          title="보험·실손 트랙은 아직 열지 않았습니다"
        >
          다음 트랙
        </a>
      )
    }
  </div>

  <p class="td-q" title={stage.nextQuestion}>
    <span class="td-q-tag">다음 질문</span>
    <span class="td-q-text">{stage.nextQuestion}</span>
  </p>
</nav>

<style>
  .track-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    border-top: 1px solid var(--color-line);
    background-color: #ffffff;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -14px 30px -26px rgb(11 27 41 / 0.65);
  }

  /* 진행선 — 1/3 · 2/3 · 3/3을 2px로만 말한다 */
  .td-progress {
    height: 2px;
    background-color: var(--color-paper-deep);
  }

  .td-progress > span {
    display: block;
    height: 100%;
    background-color: var(--color-brand);
  }

  .td-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    min-width: 0;
  }

  /* 좌우 버튼 — 44px 정사각(터치 목표) */
  .td-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 44px;
    min-width: 44px;
    flex: none;
    padding: 0 10px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background-color: var(--color-surface);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
    text-decoration: none;
    white-space: nowrap;
  }

  .td-btn:hover {
    border-color: var(--color-brand);
  }

  /* 1단계에는 '이전'이 없다 — 자리를 비워 진행선이 흔들리지 않게 한다 */
  .td-btn.is-off {
    border-color: transparent;
    background-color: transparent;
    color: var(--color-ink-faint);
    opacity: 0.45;
  }

  .td-tool {
    color: var(--color-ink-soft);
  }

  .td-next {
    border-color: var(--color-brand);
    background-color: var(--color-brand);
    color: #ffffff;
  }

  .td-next:hover {
    border-color: var(--color-brand-deep);
    background-color: var(--color-brand-deep);
  }

  .td-next.is-soon {
    border-color: var(--color-line);
    background-color: var(--color-paper-deep);
    color: var(--color-ink-soft);
  }

  /* 가운데 — 지금 어느 단계인지 두 줄로 */
  .td-now {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    min-width: 0;
    min-height: 44px;
    padding: 2px;
    border-radius: 10px;
    text-decoration: none;
  }

  .td-now:hover .td-name {
    color: var(--color-brand-deep);
  }

  .td-kicker {
    overflow: hidden;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink-faint);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .td-name {
    overflow: hidden;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* 손실 질문 한 줄 — 전문은 단계 페이지에 있고, 여기서는 '무엇이 걸려 있는지'만 보인다 */
  .td-q {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    padding: 0 20px 10px;
    min-width: 0;
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .td-q-tag {
    flex: none;
    padding: 1px 6px;
    border-radius: 999px;
    background-color: var(--color-paper-deep);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .td-q-text {
    overflow: hidden;
    min-width: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (min-width: 768px) {
    .td-row {
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .td-q {
      padding: 0 40px 12px;
    }

    .td-name {
      font-size: 14px;
    }
  }

  /* 320px — '다음 트랙' 같은 긴 라벨이 두 줄이 되지 않게 줄인다 */
  @media (max-width: 359px) {
    .td-btn {
      padding: 0 8px;
      font-size: 12px;
    }
  }
</style>
