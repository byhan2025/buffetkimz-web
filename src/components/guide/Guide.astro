---
/**
 * v6.1 방문자 동선 가이드 — 화면 아래 도크 하나로 세 가지를 맡는다.
 *
 *  · `home`  : 첫 방문 스포트라이트 투어(driver.js) 3스텝 + `? 가이드`로 다시 보기
 *  · `post`  : 읽기 여정 바 — '다음 추천' 글/도구 → 이동, '필요 없어요'로 접기
 *  · `tool`  : 도구 여정 바 — '이 다음으로 많이 쓰는 도구' → 이동, '건너뛰기'로 접기
 *
 * 접힘은 브라우저(localStorage)에 기억한다(Base.astro head의 인라인 스크립트가 첫 페인트 전에 감춘다).
 * `? 가이드`는 접어 둔 바를 다시 켜고, 그 바가 무엇을 하는지 한 단계로 짚어 준다.
 */
import "@/styles/guide.css";
import "driver.js/dist/driver.css";

interface Journey {
  /** read | tool — 접힘 기억 키를 가른다 */
  mode: "read" | "tool";
  stage: string;
  kicker: string;
  title: string;
  href: string;
  /** 왜 이어지는지 한 줄 — `? 가이드` 팝오버에 쓴다 */
  why: string;
  storageKey: string;
  skipLabel: string;
}

interface Props {
  mode: "home" | "post" | "tool";
  journey?: Journey;
}

const { mode, journey } = Astro.props;
---

<div class="guide-dock" data-guide-dock data-guide-mode={mode}>
  {
    journey && (
      <div
        class="journey-bar"
        data-journey-bar
        data-store={journey.storageKey}
        data-why={journey.why}
        data-guide-mode={journey.mode}
      >
        <a
          class="journey-main"
          href={journey.href}
          aria-label={`${journey.kicker}: ${journey.title}`}
        >
          <span class="journey-kicker">
            <span class="journey-chip">{journey.stage}</span>
            <span>{journey.kicker}</span>
          </span>
          <span class="journey-line">
            <span class="journey-title">{journey.title}</span>
          </span>
        </a>
        <button
          type="button"
          class="journey-skip"
          data-journey-skip
          aria-label={`${journey.kicker} 안내 접기`}
        >
          {journey.skipLabel}
        </button>
      </div>
    )
  }

  <button type="button" class="guide-btn" data-guide-open aria-label="가이드 다시 보기" title="가이드">
    <span class="guide-btn-mark" aria-hidden="true">?</span>
    <span class="guide-btn-label">가이드</span>
  </button>
</div>

<script>
  import { driver, type Driver, type DriveStep } from "driver.js";

  type Mode = "home" | "post" | "tool";

  const dock = document.querySelector<HTMLElement>("[data-guide-dock]");

  if (dock) {
    const mode = (dock.dataset.guideMode as Mode | undefined) ?? "home";

    /*
     * v7.0 — 브랜드 필름 위에서는 가이드 버튼이 영상 컨트롤·CTA를 가리지 않게 위로 올린다.
     * 필름이 화면에 걸쳐 있는 동안만 dock에 표시를 주고, 지나가면 원래 자리로 돌린다.
     */
    const filmStage = document.querySelector<HTMLElement>("[data-film-stage]");
    if (filmStage && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            dock.dataset.overFilm = e.isIntersecting ? "1" : "0";
          });
        },
        { threshold: 0.12 }
      );
      io.observe(filmStage);
    }
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const KEY_TOUR = "bk_tour_done_v1";

    const read = (key: string): string | null => {
      try {
        return window.localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (key: string, value: string) => {
      try {
        if (key) window.localStorage.setItem(key, value);
      } catch {
        /* 저장이 막힌 브라우저(사생활 보호 모드) — 이번 화면에서만 동작한다 */
      }
    };

    const bar = dock.querySelector<HTMLElement>("[data-journey-bar]");
    const skipBtn = dock.querySelector<HTMLButtonElement>("[data-journey-skip]");
    const openBtn = dock.querySelector<HTMLButtonElement>("[data-guide-open]");

    /** 접어 둔 바를 다시 켠다 — 이 선택은 기억한다 */
    const showBar = () => {
      if (!bar) return;
      bar.hidden = false;
      document.documentElement.classList.remove("bk-off-read", "bk-off-tool");
      write(bar.dataset.store ?? "", "on");
    };

    skipBtn?.addEventListener("click", () => {
      if (!bar) return;
      const key = bar.dataset.store ?? "";
      write(key, "off");
      document.documentElement.classList.add(
        key === "bk_tool_guide_v1" ? "bk-off-tool" : "bk-off-read"
      );
      bar.hidden = true;
      // 접힌 버튼에 키보드 초점이 남지 않게 `? 가이드`로 옮긴다
      openBtn?.focus({ preventScroll: true });
    });

    /**
     * 투어 한 벌 — 매 단계에 `건너뛰기` 버튼을 붙인다.
     * 닫기(×)·배경 클릭·Esc도 같은 곳으로 끝나고, 끝나면 onExit가 한 번 불린다.
     */
    const createTour = (steps: DriveStep[], onExit?: () => void): Driver => {
      /* onPopoverRender가 만들어지는 도중에도 안전하게 닫을 수 있도록 참조를 미리 둔다. */
      let current: Driver | null = null;
      const tour: Driver = driver({
        steps,
        showProgress: true,
        progressText: "{{current}} / {{total}}",
        nextBtnText: "다음",
        prevBtnText: "이전",
        doneBtnText: "확인",
        closeBtnLabel: "닫기",
        allowClose: true,
        overlayColor: "#0b1b29",
        overlayOpacity: 0.66,
        stagePadding: 8,
        stageRadius: 14,
        popoverClass: "bk-tour",
        animate: !reduce,
        smoothScroll: !reduce,
        onPopoverRender: (popover) => {
          if (popover.footer.querySelector(".bk-tour-skip")) return;
          const skip = document.createElement("button");
          skip.type = "button";
          skip.className = "bk-tour-skip";
          skip.textContent = "건너뛰기";
          skip.addEventListener("click", () => current?.destroy());
          popover.footer.insertBefore(skip, popover.footerButtons);
        },
        onDestroyed: () => onExit?.(),
      });
      current = tour;
      return tour;
    };

    if (mode === "home") {
      /* ① 첫 방문 — 질문형 컨시어지 → 오늘 확인할 것 → 오늘의 기록 → 앱스토어 */
      const steps = ([
        {
          element: '[data-guide="concierge"]',
          popover: {
            title: "① 지금 확인할 것 (질문 안내)",
            description:
              "지금 내 상황에 맞는 주제를 두 번 고르면, 바로 써볼 계산기와 읽을 글, 다가오는 일정을 한 번에 짚어 드립니다.",
            side: "bottom",
            align: "start",
          },
        },
        {
          element: '[data-guide="hub"]',
          popover: {
            title: "② 오늘 확인 허브",
            description:
              "기준일과 지표, 오늘 확인할 세 가지를 모아 두었습니다. 매일 바뀌는 핵심만 빠르게 훑기 좋습니다.",
            side: "top",
            align: "start",
          },
        },
        {
          element: '[data-guide="latest"]',
          popover: {
            title: "③ 오늘의 기록",
            description:
              "새로 올라온 자산리포트와 앱스토어 추천입니다. 글에서 기준을 읽고, 도구에서 내 숫자로 확인합니다.",
            side: "top",
            align: "start",
          },
        },
        {
          element: '[data-guide="tools"]',
          popover: {
            title: "④ 앱스토어",
            description:
              "계산이 필요할 때는 앱스토어로. 입력한 값은 서버로 보내지 않고 브라우저 안에서만 계산합니다(단축 URL 생성만 외부 서비스 예외).",
            side: "top",
            align: "start",
          },
        },
      ] satisfies DriveStep[]).filter(
        (step) => typeof step.element === "string" && document.querySelector(step.element)
      );

      const tour = createTour(steps, () => write(KEY_TOUR, "done"));

      /* 첫 방문 자동 시작 — 질문형 컨시어지를 방해하지 않게 4.5초 대기 후, 아직 아무것도 누르지 않았을 때만 안내를 연다. */
      const AUTO_DELAY = 4_500;
      let cancelled = false;
      document.addEventListener(
        "pointerdown",
        (event) => {
          const target = event.target as HTMLElement | null;
          if (target?.closest?.("a, button, input, select, textarea, label")) cancelled = true;
        },
        { passive: true, capture: true }
      );

      window.setTimeout(() => {
        if (cancelled || document.visibilityState !== "visible") return;
        if (window.scrollY > 1600) return;
        if (read(KEY_TOUR) || tour.isActive()) return;
        if (steps.length === 0) return;
        tour.drive(0);
        // 느린 기기에서 필름·글꼴이 늦게 자리를 잡으면 한 번 더 기준을 잡는다
        window.setTimeout(() => {
          if (tour.isActive()) tour.refresh();
        }, 900);
      }, AUTO_DELAY);

      openBtn?.addEventListener("click", () => {
        cancelled = true;
        if (tour.isActive()) tour.destroy();
        window.setTimeout(() => tour.drive(0), 50);
      });
    } else if (bar) {
      /* ②③ 여정 바 — 트랙 독이 있으면 트랙 독 안내, 없으면 접힘 가능한 여정 바 안내 */
      const trackDock = document.querySelector<HTMLElement>("[data-track-dock]");
      const hint = createTour(
        trackDock
          ? [
              {
                element: "[data-track-dock]",
                popover: {
                  title: "학습 트랙 여정 안내",
                  description: `${
                    bar.dataset.why ?? ""
                  } 하단 바에서 이전·다음 단계와 이 단계의 계산기로 바로 이동할 수 있습니다.`,
                  side: "top",
                  align: "end",
                },
              },
            ]
          : [
              {
                element: "[data-journey-bar]",
                popover: {
                  title: mode === "tool" ? "도구 여정 안내" : "읽기 여정 안내",
                  description: `${
                    bar.dataset.why ?? ""
                  } 이 바가 다음에 볼 것을 계속 알려 줍니다. 필요 없으면 바의 버튼으로 접어 두세요 — 이 ? 버튼으로 언제든 다시 켤 수 있습니다.`,
                  side: "top",
                  align: "end",
                },
              },
            ],
        undefined
      );

      openBtn?.addEventListener("click", () => {
        // 접힌 바는 html 클래스로 감춰져 있어 bar.hidden이 false일 수 있다 — 항상 다시 켠다
        showBar();
        if (hint.isActive()) hint.destroy();
        window.setTimeout(() => hint.drive(0), 50);
      });
    }
  }
</script>
