---
/**
 * 질문 → 글 → 도구로 이어지는 3열 카드.
 * 카드마다 '무엇을 확인하는 글인지'를 질문 한 줄로 먼저 보여 주고,
 * 그 아래에 같은 주제의 도구 실행 버튼을 둔다.
 * 질문이 제목과 거의 같은 문장이면 질문 줄을 숨긴다(같은 말을 두 번 읽지 않게).
 */
import { shouldShowQuestion } from "@/lib/posts";
import { withBase } from "@/config/site";

export type PostCard = {
  url: string;
  title: string;
  description: string;
  categoryName: string;
  date: string;
  readingMinutes: number;
  question?: string;
  toolName?: string;
  toolUrl?: string;
  /** 그 글을 확인한 시점 — 카드마다 표시한다 */
  baseDate?: string;
  /** 1차 출처 기관 줄임 표기 (예: 한국은행·통계청) */
  sourceOrgLine?: string;
  /** 1차 출처 수 (기관명이 없을 때의 대체 표기) */
  sourceCount?: number;
};

interface Props {
  items: PostCard[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
const grid = columns === 2 ? "sm:grid-cols-2" : "sm:grid-cols-2 lg:grid-cols-3";
---

<ul class={`grid gap-4 ${grid}`} data-post-cards>
  {
    items.map((item) => {
      const question = shouldShowQuestion(item.question, item.title) ? item.question : undefined;
      return (
        <li class="card card-lift flex flex-col p-5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="text-[12px] font-semibold tracking-[0.02em] text-brand">{item.categoryName}</span>
            <span class="mono text-[12px] text-ink-faint">{item.date}</span>
          </div>

          {question && (
            <p class="clamp-2 mt-3 text-[12.5px] font-semibold leading-snug text-ink-muted">
              <span class="text-brand">Q.</span> {question}
            </p>
          )}

          <h3 class="mt-1.5 text-[17px] font-bold leading-[1.42] tracking-[-0.03em] text-ink">
            <a href={withBase(item.url)} class="block min-h-[24px] hover:text-brand-deep">
              {item.title}
            </a>
          </h3>

          <p class="clamp-2 mt-2 text-[13.5px] leading-[1.7] text-ink-muted">{item.description}</p>

          <p class="mono mt-3 text-[12px] leading-relaxed text-ink-faint" data-card-meta>
            확인 기준일 {item.baseDate} · {item.sourceOrgLine || `출처 ${item.sourceCount}건`}
          </p>

          <div class="mt-auto flex items-center justify-between gap-2 pt-4">
            {item.toolUrl ? (
              <a href={withBase(item.toolUrl)} class="btn btn-secondary btn-xs">
                {item.toolName ?? "도구로 확인"}
              </a>
            ) : (
              <a href={withBase(item.url)} class="btn btn-tertiary-quiet btn-xs">
                글 읽기
              </a>
            )}
            <span class="text-[12px] text-ink-faint">{item.readingMinutes}분</span>
          </div>
        </li>
      );
    })
  }
</ul>
