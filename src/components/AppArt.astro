---
/**
 * 앱 카드의 도해. 화면 캡처 대신 구조를 선과 숫자로만 그린다.
 */
import { RETIREMENT_EXAMPLE, COMPOUND_EXAMPLE, compoundProjection, retirementProjection } from "@/lib/finance";
import { UTILS_B_ART_ROWS } from "@/data/utils-b.ts";
import { UTILS_C_ART_ROWS } from "@/data/utils-c.ts";
import { UTILS_E_ART_ROWS } from "@/data/utils-e.ts";

interface Props {
  art:
    | "guide"
    | "coverage"
    | "disclosure"
    | "silson"
    | "pension"
    | "pension-draw"
    | "retirement"
    | "compound"
    | "accounts"
    | "timemachine"
    | "u-exif"
    | "u-url"
    | "u-pdf"
    | "u-compress"
    | "u-qr"
    | "u-resize"
    | "u-watermark"
    /* v7.3 유용한앱 2·3탄 16종 — 입력 → 처리 → 결과 3단 공통 도해 */
    | "text-counter"
    | "privacy-masker"
    | "json-csv-formatter"
    | "diff-checker"
    | "color-extractor"
    | "text-to-card"
    | "unit-date-calc"
    | "age"
    | "salary"
    | "loan"
    | "vat"
    | "rent"
    | "severance"
    | "dividend"
    | "hourly"
    /* v7.3 유용한앱 4탄 — 자기 도해 */
    | "u-upscale"
    | "u-shorten"
    | "u-pdf-split"
    | "u-clock"
    /* v7.4 유용한앱 5탄 12종 */
    | "svg-logo"
    | "brokerage-fee"
    | "acquisition-tax"
    | "subscription-score"
    | "moving-dday"
    | "health-premium"
    | "annual-leave"
    | "unemployment"
    | "freelancer-tax"
    | "overseas-tax"
    | "deposit-compare";
  compact?: boolean;
}
const { art, compact = false } = Astro.props;
const pad = compact ? "p-4" : "p-5 md:p-6";

const retire = retirementProjection(RETIREMENT_EXAMPLE);
const compound = compoundProjection(COMPOUND_EXAMPLE);
const retireRows = [
  { label: "국민연금", value: retire.nominal.nps },
  { label: "퇴직연금", value: retire.nominal.dc },
  { label: "개인연금", value: retire.nominal.personal },
];
const retireMax = Math.max(...retireRows.map((r) => r.value), 1);
const compoundRows = [
  { label: "납입 원금", value: compound.principal },
  { label: "세전", value: compound.gross },
  { label: "세후", value: compound.net },
];
const compoundMax = Math.max(...compoundRows.map((r) => r.value), 1);
const man = (v: number) => Math.round(v).toLocaleString("ko-KR");
/** 타임머신 도해 — 1만 번 재생에서 갈라진 경로의 끝 (예시 입력값 기준 그림) */
const tmEnds = [8, 14, 20, 26, 33, 39, 45, 52, 58, 64, 71, 77, 12, 30, 54, 68];
const tmOutcomes = [
  { label: "목표 도달", pct: 24 },
  { label: "손절", pct: 70 },
  { label: "미도달", pct: 6 },
];
/** QR 도해용 모듈 — 장식이지만 실제 QR처럼 보이도록 규칙적으로 채운다 */
const qrCells = Array.from({ length: 81 }, (_, i) => (i * 7 + Math.floor(i / 9) * 3) % 5 < 2);
/** v7.3 — 2·3탄 16종은 앱마다 다른 도해를 그리는 대신 '입력 → 처리 → 결과' 세 줄을 쓴다. */
const utilArtRows: Record<string, [string, string, string]> = { ...UTILS_B_ART_ROWS, ...UTILS_C_ART_ROWS, ...UTILS_E_ART_ROWS };
const utilSteps = utilArtRows[art];
---

<div class={`relative h-full w-full overflow-hidden border border-line bg-paper-deep ${pad}`} aria-hidden="true">
  <div class="absolute inset-0 opacity-[0.5]" style="background-image:linear-gradient(var(--color-line-soft) 1px, transparent 1px);background-size:100% 28px;"></div>

  {
    art === "guide" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">확인 순서</p>
        <ul class="mt-3 space-y-0">
          {["암", "뇌혈관", "심장", "수술비", "간병비"].map((label, i) => (
            <li class="flex items-center gap-3 border-b border-line-soft py-2 last:border-0">
              <span class="w-3 text-[12px] tabular-nums text-ink-faint">{i + 1}</span>
              <span class="text-[13px] font-semibold text-ink-soft">{label}</span>
              <span class="ml-auto flex items-end gap-[3px]">
                {Array.from({ length: 6 }, (_, k) => (
                  <span
                    class="w-[3px]"
                    style={`height:${6 + k * 2}px;background:${k <= 4 - i ? "var(--color-brand)" : "var(--color-line)"}`}
                  />
                ))}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[12px] text-ink-faint">기준일과 출처를 함께 남깁니다</p>
      </div>
    )
  }

  {
    art === "coverage" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">필요 / 보유</p>
          <p class="serif text-[13px] text-ink-faint">5,000</p>
        </div>
        <ul class="mt-4 space-y-3.5">
          {[
            { label: "암", need: 88, have: 62 },
            { label: "뇌혈관", need: 70, have: 40 },
            { label: "심장", need: 70, have: 70 },
            { label: "간병비", need: 60, have: 18 },
          ].map((row) => (
            <li>
              <div class="flex items-baseline justify-between text-[12px]">
                <span class="font-medium text-ink-soft">{row.label}</span>
                <span class="tabular-nums text-ink-faint">{row.have}%</span>
              </div>
              <div class="relative mt-1.5 h-[5px] w-full bg-line-soft">
                <div class="absolute inset-y-0 left-0 bg-brand/85" style={`width:${row.have}%`} />
                <div class="absolute inset-y-[-3px] w-[1px] bg-clay" style={`left:${row.need}%`} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    art === "disclosure" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">묻는 기간</p>
        <div class="mt-4 space-y-4">
          {[
            { label: "3개월", width: 26 },
            { label: "2년", width: 58 },
            { label: "5년", width: 92 },
          ].map((row, i) => (
            <div>
              <div class="flex items-baseline justify-between text-[12px]">
                <span class="font-medium text-ink-soft">{row.label}</span>
                <span class="text-[12px] text-ink-faint">{i === 2 ? "10대 질병" : "입원·수술"}</span>
              </div>
              <div class="mt-1.5 h-[7px] w-full bg-line-soft">
                <div class="h-full bg-brand/80" style={`width:${row.width}%`} />
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-[12px] leading-relaxed text-ink-faint">판정이 아니라 확인할 항목</p>
      </div>
    )
  }

  {
    art === "silson" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">자기부담률</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <p class="serif text-[26px] leading-none text-ink">30<span class="text-[13px]">%</span></p>
            <p class="mt-1 text-[12px] text-ink-muted">4세대 비급여</p>
            <div class="mt-2 h-[64px] w-full bg-line-soft"><div class="mt-auto h-[26%] w-full bg-brand/80"></div></div>
          </div>
          <div>
            <p class="serif text-[26px] leading-none text-clay">50<span class="text-[13px]">%</span></p>
            <p class="mt-1 text-[12px] text-ink-muted">5세대 비중증</p>
            <div class="mt-2 h-[64px] w-full bg-line-soft"><div class="mt-auto h-[52%] w-full bg-clay/70"></div></div>
          </div>
        </div>
        <p class="mt-3 text-[12px] text-ink-faint">보험료가 낮아진 만큼 자기부담이 오릅니다</p>
      </div>
    )
  }

  {
    art === "pension" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">올해의 한도</p>
        <div class="mt-4 flex items-end gap-4">
          <div class="flex-1">
            <p class="text-[12px] text-ink-muted">연금저축</p>
            <div class="mt-2 h-[70px] w-full bg-line-soft"><div class="mt-auto h-[66%] w-full bg-brand/80"></div></div>
            <p class="mt-1.5 serif text-[15px] tabular-nums text-ink">600</p>
          </div>
          <div class="flex-1">
            <p class="text-[12px] text-ink-muted">IRP 합산</p>
            <div class="mt-2 h-[70px] w-full bg-line-soft"><div class="mt-auto h-[100%] w-full bg-brand"></div></div>
            <p class="mt-1.5 serif text-[15px] tabular-nums text-ink">900</p>
          </div>
        </div>
        <p class="mt-3 text-[12px] text-ink-faint">단위 만원 · 12월 31일까지</p>
      </div>
    )
  }

  {
    art === "pension-draw" && (
      /* 기존 'pension' 아트의 두 막대 구조를 그대로 쓴다(새 창작물을 승인 없이 만들지 않는다).
         라벨·숫자만 인출 단계(설계서 §3.1 기본 조건)에 맞춘다. */
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">받을 때의 세금</p>
        <div class="mt-4 flex items-end gap-4">
          <div class="flex-1">
            <p class="text-[12px] text-ink-muted">종합과세</p>
            <div class="mt-2 h-[70px] w-full bg-line-soft"><div class="mt-auto h-[66%] w-full bg-brand/80"></div></div>
            <p class="mt-1.5 serif text-[15px] tabular-nums text-ink">122</p>
          </div>
          <div class="flex-1">
            <p class="text-[12px] text-ink-muted">16.5% 분리과세</p>
            <div class="mt-2 h-[70px] w-full bg-line-soft"><div class="mt-auto h-[100%] w-full bg-brand"></div></div>
            <p class="mt-1.5 serif text-[15px] tabular-nums text-ink">297</p>
          </div>
        </div>
        <p class="mt-3 text-[12px] text-ink-faint">단위 만원 · 연 1,500만원 기준</p>
      </div>
    )
  }

  {
    art === "retirement" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">은퇴 후 월 수령액</p>
        <ul class="mt-4 space-y-3">
          {retireRows.map((row) => (
            <li>
              <div class="flex items-baseline justify-between text-[12px]">
                <span class="font-medium text-ink-soft">{row.label}</span>
                <span class="tabular-nums text-ink-faint">{man(row.value)}만</span>
              </div>
              <div class="mt-1.5 h-[6px] w-full bg-line-soft">
                <div
                  class="h-full bg-brand/85"
                  style={`width:${Math.max(4, Math.round((row.value / retireMax) * 100))}%`}
                />
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex items-baseline justify-between border-t border-line pt-2">
          <span class="text-[12px] text-ink-faint">합계(명목)</span>
          <span class="text-[17px] font-bold tabular-nums text-ink">{man(retire.nominal.total)}만원</span>
        </div>
        <p class="mt-2 text-[12px] text-ink-faint">오늘 가치 {man(retire.real.total)}만 · 65세 은퇴 가정</p>
      </div>
    )
  }

  {
    art === "compound" && (
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">원금에서 세후까지</p>
        <ul class="mt-4 space-y-3.5">
          {compoundRows.map((row, i) => (
            <li>
              <div class="flex items-baseline justify-between text-[12px]">
                <span class="font-medium text-ink-soft">{row.label}</span>
                <span class="tabular-nums text-ink-faint">{man(row.value)}만</span>
              </div>
              <div class="mt-1.5 h-[8px] w-full bg-line-soft">
                <div
                  class={`h-full ${i === 2 ? "bg-brand" : "bg-brand/60"}`}
                  style={`width:${Math.max(4, Math.round((row.value / compoundMax) * 100))}%`}
                />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-[12px] leading-relaxed text-ink-faint">
          월 50만·20년·연 5.0% 가정 · 세금 {man(compound.tax)}만 제외
        </p>
      </div>
    )
  }

  {
    art === "accounts" && (
      /* v7.1 4대 계좌 비교 — 같은 5,000만원 수익에서 세후로 남는 몫을 네 칸으로. */
      <div class="relative">
        <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">같은 수익, 다른 세후</p>
        <div class="mt-4 flex items-end gap-2.5">
          {[
            { label: "일반", h: 72, v: "4,230" },
            { label: "ISA", h: 78, v: "4,525" },
            { label: "연금", h: 84, v: "4,725" },
            { label: "IRP", h: 84, v: "4,725" },
          ].map((c, i) => (
            <div class="flex-1">
              <div class="flex h-[88px] w-full items-end bg-line-soft">
                <div
                  class={`w-full ${i >= 2 ? "bg-brand" : "bg-brand/55"}`}
                  style={`height:${c.h}%`}
                />
              </div>
              <p class="mt-1.5 text-center text-[11.5px] font-semibold text-ink-soft">{c.label}</p>
              <p class="text-center text-[11px] tabular-nums text-ink-faint">{c.v}</p>
            </div>
          ))}
        </div>
        <p class="mt-3 text-[12px] text-ink-faint">단위 만원 · 5,000만원 수익 · 연금 수령 가정</p>
      </div>
    )
  }

  {
    art === "timemachine" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">1만 번 다시 걸은 경로</p>
          <p class="mono text-[12px] text-ink-faint">예시 입력</p>
        </div>

        <svg viewBox="0 0 240 82" class="mt-3 h-[82px] w-full" role="img" aria-label="진입 뒤 1만 번 재생에서 갈라진 경로의 끝 분포">
          <line x1="0" y1="12" x2="240" y2="12" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="3 3" />
          <line x1="0" y1="41" x2="240" y2="41" stroke="var(--color-brand)" stroke-width="1" />
          <line x1="0" y1="70" x2="240" y2="70" stroke="var(--color-clay)" stroke-width="1" stroke-dasharray="3 3" />
          {tmEnds.map((end) => (
            <path
              d={`M2 41 C 60 41, 90 ${41 + (end - 41) * 0.35}, 196 ${end} L 232 ${end}`}
              fill="none"
              stroke={end < 30 ? "var(--color-brand)" : "var(--color-ink-faint)"}
              stroke-width="1"
              opacity={end < 30 ? "0.55" : "0.3"}
            />
          ))}
        </svg>
        <p class="mt-1 text-[12px] text-ink-faint">점선 위 목표 · 실선 진입 · 점선 아래 손절</p>

        <ul class="mt-3 space-y-2">
          {tmOutcomes.map((row) => (
            <li class="flex items-center gap-3">
              <span class="w-[52px] shrink-0 text-[12px] font-medium text-ink-soft">{row.label}</span>
              <span class="h-[5px] flex-1 bg-line-soft">
                <span
                  class={`block h-full ${
                    row.label === "손절" ? "bg-clay/70" : row.label === "미도달" ? "bg-ink-faint/45" : "bg-brand/80"
                  }`}
                  style={`width:${row.pct}%`}
                />
              </span>
              <span class="w-[34px] shrink-0 text-right text-[12px] tabular-nums text-ink-faint">{row.pct}%</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-[12px] leading-relaxed text-ink-faint">지난 흔들림의 빈도 · 미래 예측 아님</p>
      </div>
    )
  }

  {
    art === "u-exif" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">촬영 정보 확인 → 제거</p>
          <p class="mono text-[12px] text-ink-faint">기기 안에서</p>
        </div>
        <div class="relative mt-3 h-[92px] overflow-hidden rounded-sm border border-line bg-[linear-gradient(135deg,#e7efe9,#f6f2e6)]">
          <span class="absolute left-[18%] top-[24%] h-8 w-8 bg-ink/25 blur-[3px]"></span>
          <span class="absolute right-[14%] top-[40%] h-5 w-12 bg-ink/20 blur-[3px]"></span>
          <span class="absolute bottom-1.5 left-1.5 rounded-sm bg-white/80 px-1.5 py-0.5 text-[10px] font-semibold text-ink-muted">가린 곳</span>
        </div>
        <ul class="mt-3 space-y-1.5">
          <li class="flex items-center justify-between border-b border-line-soft pb-1.5 text-[12px]">
            <span class="text-ink-soft">GPS</span>
            <span class="mono text-ink-faint line-through">37.5, 127.0</span>
            <span class="rounded-full bg-brand-soft px-1.5 py-0.5 text-[10px] font-semibold text-brand-deep">제거</span>
          </li>
          <li class="flex items-center justify-between border-b border-line-soft pb-1.5 text-[12px]">
            <span class="text-ink-soft">기종</span>
            <span class="mono text-ink-faint line-through">iPhone</span>
            <span class="rounded-full bg-brand-soft px-1.5 py-0.5 text-[10px] font-semibold text-brand-deep">제거</span>
          </li>
          <li class="flex items-center justify-between text-[12px]">
            <span class="text-ink-soft">픽셀</span>
            <span class="mono text-ink-faint">그대로</span>
            <span class="rounded-full bg-line-soft px-1.5 py-0.5 text-[10px] font-semibold text-ink-muted">유지</span>
          </li>
        </ul>
      </div>
    )
  }

  {
    art === "u-url" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">주소의 꼬리 자르기</p>
          <p class="mono text-[12px] text-ink-faint">복사 전 1초</p>
        </div>
        <p class="mono mt-3 break-all text-[11px] leading-[1.9] text-ink-muted">
          buffetkimz.com/apps/pension-tax
          <span class="bg-[#fbeee8] text-clay line-through">?utm_source=ig</span>
          <span class="bg-[#fbeee8] text-clay line-through">&amp;fbclid=IwAR2</span>
          <span class="bg-[#fbeee8] text-clay line-through">&amp;si=AbCd</span>
        </p>
        <div class="mt-2 border-t border-line pt-2">
          <p class="mono break-all text-[11.5px] font-semibold text-ink">buffetkimz.com/apps/pension-tax</p>
        </div>
        <ul class="mt-3 flex flex-wrap gap-1">
          {["utm_*"]
            .concat(["fbclid", "gclid", "srsltid", "igshid", "si"])
            .map((k) => (
              <li class="mono rounded-full bg-[#fbeee8] px-2 py-[2px] text-[10px] font-semibold text-clay">{k}</li>
            ))}
        </ul>
        <p class="mt-2 text-[12px] text-ink-faint">같은 페이지 · 다른 꼬리</p>
      </div>
    )
  }

  {
    art === "u-pdf" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">두 방향 변환</p>
          <p class="mono text-[12px] text-ink-faint">서버 미전송</p>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <span class="flex gap-1">
            {[0, 1, 2].map((i) => (
              <span class="block h-9 w-7 rounded-sm border border-line bg-[linear-gradient(160deg,#eef3ef,#f7f4ea)]" style={`transform:translateY(${i === 1 ? -3 : 0}px)`} />
            ))}
          </span>
          <span class="text-[13px] text-ink-faint">→</span>
          <span class="flex h-11 w-9 flex-col justify-between rounded-sm border border-line bg-white px-1 py-1.5">
            <span class="block h-[3px] w-full bg-line"></span>
            <span class="block h-[3px] w-3/4 bg-line"></span>
            <span class="block h-[3px] w-full bg-line"></span>
            <span class="mono mt-auto text-[8px] font-bold text-clay">PDF</span>
          </span>
        </div>
        <div class="mt-4 flex items-center gap-2 border-t border-line pt-3">
          <span class="flex h-11 w-9 flex-col justify-between rounded-sm border border-line bg-white px-1 py-1.5">
            <span class="block h-[3px] w-full bg-line"></span>
            <span class="block h-[3px] w-2/3 bg-line"></span>
            <span class="block h-[3px] w-full bg-line"></span>
            <span class="mono mt-auto text-[8px] font-bold text-clay">PDF</span>
          </span>
          <span class="text-[13px] text-ink-faint">→</span>
          <span class="flex gap-1">
            {[0, 1, 2].map((i) => (
              <span class="block h-9 w-7 rounded-sm border border-line bg-[linear-gradient(160deg,#eef3ef,#f7f4ea)]" style={`transform:translateY(${i === 1 ? -3 : 0}px)`} />
