    )
  }

  {
    art === "u-compress" && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
          <p class="text-[12px] font-semibold tracking-[0.01em] text-ink-faint">전 / 후 용량</p>
          <p class="mono text-[12px] text-clay">-87%</p>
        </div>
        {[
          { label: "원본", value: "2.4MB", pct: 100, tone: "bg-ink-faint/35" },
          { label: "JPG 72%", value: "310KB", pct: 13, tone: "bg-brand" },
        ].map((row) => (
          <div class="mt-3 flex items-center gap-2">
            <span class="w-[52px] shrink-0 text-[11.5px] text-ink-soft">{row.label}</span>
            <span class="h-2.5 flex-1 bg-line-soft">
              <span class={`block h-full ${row.tone}`} style={`width:${row.pct}%`} />
            </span>
            <span class="mono w-[48px] shrink-0 text-right text-[11px] text-ink-faint">{row.value}</span>
          </div>
        ))}
        <ul class="mt-4 space-y-1 border-t border-line pt-2.5 text-[11.5px] text-ink-faint">
          <li class="flex justify-between"><span>품질</span><span class="mono">10~95%</span></li>
          <li class="flex justify-between"><span>형식</span><span class="mono">JPG · WebP · PNG</span></li>
          <li class="flex justify-between"><span>여러 장</span><span class="mono">한 번에 12장</span></li>
        </ul>
      </div>
    )
  }

  {
    art === "u-qr" && (
      <div class="relative flex flex-col items-center">
        <p class="self-start text-[12px] font-semibold tracking-[0.01em] text-ink-faint">링크 하나 → QR</p>
        <svg viewBox="0 0 90 90" class="mt-2 h-[104px] w-[104px]" role="img" aria-label="QR 코드 모양 도해">
          <rect x="0" y="0" width="90" height="90" fill="#fff" stroke="var(--color-line)" />
          {qrCells.map((on, i) =>
            on ? (
              <rect x={(i % 9) * 9 + 9} y={Math.floor(i / 9) * 9 + 9} width="7" height="7" fill="var(--color-ink)" />
            ) : null
          )}
          <rect x="9" y="9" width="25" height="25" fill="none" stroke="var(--color-ink)" stroke-width="4" />
          <rect x="56" y="9" width="25" height="25" fill="none" stroke="var(--color-ink)" stroke-width="4" />
          <rect x="9" y="56" width="25" height="25" fill="none" stroke="var(--color-ink)" stroke-width="4" />
          <rect x="17" y="17" width="9" height="9" fill="var(--color-ink)" />
          <rect x="64" y="17" width="9" height="9" fill="var(--color-ink)" />
          <rect x="17" y="64" width="9" height="9" fill="var(--color-ink)" />
        </svg>
        <p class="mono mt-2 text-[11px] text-ink-faint">PNG · SVG · 외부 API 없음</p>
      </div>
    )
  }

