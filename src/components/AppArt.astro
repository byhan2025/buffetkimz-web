          <p class="mono text-[12px] text-ink-faint">투명도 55%</p>
        </div>
        <div class="relative mt-3 h-[112px] overflow-hidden rounded-sm border border-line bg-[linear-gradient(140deg,#e6efe9,#f7f3e7)]">
          <svg viewBox="0 0 200 112" class="h-full w-full" aria-hidden="true">
            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
              <text
                x={(i % 4) * 56 - 8}
                y={Math.floor(i / 4) * 62 + 34}
                transform="rotate(-28 100 56)"
                fill="#0b1b29"
                opacity="0.22"
                font-size="13"
                font-weight="700"
                font-family="Pretendard, system-ui, sans-serif"
              >
                buffetkimz
              </text>
            ))}
          </svg>
        </div>
        <ul class="mt-3 space-y-1 text-[11.5px] text-ink-faint">
          <li class="flex justify-between"><span>위치</span><span class="mono">중앙 · 모서리 · 타일</span></li>
          <li class="flex justify-between"><span>크기</span><span class="mono">가로의 2~20%</span></li>
          <li class="flex justify-between"><span>저장</span><span class="mono">원본 해상도</span></li>
        </ul>
      </div>
    )
  }

  {
    utilSteps && (
      <div class="relative">
        <div class="flex items-baseline justify-between">
