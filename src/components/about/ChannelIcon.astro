---
/**
 * 소개 페이지 채널 아이콘 — 브랜드 로고를 그대로 베끼지 않고,
 * 서비스별로 한눈에 구분되는 최소 선화(24px 격자)로 그린다.
 * 장식이므로 aria-hidden. 이름은 옆의 텍스트가 전달한다.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

