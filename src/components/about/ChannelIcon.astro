  {name === "carrot" && (
    <>
      <path d="M12.4 20.6c-3.2-1.6-5.5-4.8-5.5-8 0-2.9 1.8-4.8 4.2-4.8.7 0 1.3.2 1.3.2s.6-.2 1.3-.2c2.4 0 4.2 1.9 4.2 4.8 0 3.2-2.3 6.4-5.5 8Z" />
      <path d="M12.4 7.6V4.4M10 5.2 8.7 3.1M14.8 5.2l1.3-2.1" />
    </>
  )}
  {name === "github" && (
    <>
      <path d="M9 8.2 5.2 12 9 15.8M15 8.2 18.8 12 15 15.8" />
      <path d="M13.4 5.6 10.6 18.4" />
    </>
  )}
  {name === "kakao" && (
    <path d="M12 4.2c-4.3 0-7.8 2.6-7.8 5.7 0 2 1.3 3.7 3.3 4.8-.2.7-.6 2.2-.7 2.6 0 .3.2.4.4.3.4-.2 2.3-1.6 3-2.1.6.1 1.2.1 1.8.1 4.3 0 7.8-2.6 7.8-5.7S16.3 4.2 12 4.2Z" />
  )}
  {name === "bookmark" && (
    <>
