    <>
      <path d="M12 21c4.3 0 6.9-2.7 6.9-6.3 0-3.5-2.3-5.9-5.8-5.9-2.8 0-4.8 1.6-4.8 3.8 0 1.9 1.4 3.2 3.4 3.2 3.3 0 5.2-2.5 5.2-5.4 0-3.3-2.4-5.6-5.7-5.6C7 5 4.2 8.2 4.2 13.3 4.2 18.3 7.4 21 12 21Z" />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3.8" y="3.8" width="16.4" height="16.4" rx="5" />
      <circle cx="12" cy="12" r="3.6" />
      <circle cx="17" cy="7" r="0.9" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "naver" && (
    <>
      <rect x="3.8" y="3.8" width="16.4" height="16.4" rx="4.2" />
      <path d="M9.2 16.4V7.6l5.6 8.8V7.6" />
    </>
  )}
  {name === "youtube" && (
    <>
      <rect x="2.8" y="5.8" width="18.4" height="12.4" rx="3.6" />
      <path d="M10.6 9.4 15 12l-4.4 2.6Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "x" && <path d="M4.6 4.4 19.4 19.6M19.4 4.4 4.6 19.6" />}
  {name === "cafe" && (
    <>
      <path d="M4.6 8.4h10v4.8a5 5 0 0 1-10 0Z" />
      <path d="M14.6 9.6h1.9a2.4 2.4 0 0 1 0 4.8h-1.9" />
      <path d="M7.4 4.6c0 .8.9 1 .9 1.8M10.6 4.2c0 .9 1 1.1 1 2" />
      <path d="M4.4 20h11" />
    </>
