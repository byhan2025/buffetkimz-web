---
/**
 * v7.9.0 — 확정 공식 로고 록업 (2026-11-22 사용자 확정).
 *
 *  · light(기본) : 밝은 바탕 영문 `logo-en-light-tr` — 헤더·푸터·글 하단·검색
 *  · dark + en   : 어두운 바탕 영문 `logo-en-dark-tr`  — 다크 섹션·필름
 *  · dark + ko   : 어두운 바탕 국문 `logo-ko-dark-tr`  — 국문 강조 배너·필름 엔딩
 *
 *  파일은 8K 원본에서 배경색을 되돌려(unpremultiply) 만든 여백 크롭·투명 PNG라
 *  어떤 바탕 위에 놓아도 크림/흰 테두리나 잘림이 없다. 생성: scripts/make_brand_assets.py
 *
 *  높이는 `size`(예: "22px")로 넘기고, 생략하면 CSS의 `--lockup-h`(클래스별 기본값)를 따른다.
 *  폭은 원본 비율 그대로 — width/height 속성으로 자리를 미리 잡아 흔들림(CLS)을 막는다.
 */
import { withBase } from "@/config/site";

interface Props {
  /** 로고 높이 — 예: "22px". 생략하면 CSS `--lockup-h` */
  size?: string;
  /** light: 밝은 바탕 / dark: 어두운 바탕 */
  tone?: "light" | "dark";
  /** en: 영문 / ko: 국문(어두운 바탕 전용) */
  variant?: "en" | "ko";
  /** srcset 크기 힌트 — 큰 로고를 쓰는 자리에서 넘긴다 */
  sizes?: string;
  class?: string;
}

const { size, tone = "light", variant = "en", sizes, class: className } = Astro.props;

const ko = variant === "ko";
const file = ko ? "logo-ko-dark" : tone === "dark" ? "logo-en-dark" : "logo-en-light";
/** 크롭 PNG 실제 픽셀 크기 — 비율 계산과 width/height 속성에 쓴다 */
const [W, H] = ko ? [3332, 921] : tone === "dark" ? [3109, 803] : [3342, 883];

const srcset = [480, 960, 1920]
  .map((w) => `${withBase(`/brand/${file}-tr-${w}.webp`)} ${w}w`)
  .join(", ");

const alt = ko ? "버핏킴즈" : "buffetkimz";
---

<span
  class:list={["brand-lockup", className]}
  style={size ? `--lockup-h:${size}` : undefined}
>
  <img
    src={withBase(`/brand/${file}-tr-960.webp`)}
    srcset={srcset}
    sizes={sizes ?? "(max-width: 767px) 240px, 420px"}
    width={W}
    height={H}
    alt={alt}
    decoding="async"
  />
</span>
