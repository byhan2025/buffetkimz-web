---
/**
 * 브랜드 록업 — 시안 A '서표 · 인덱스 탭' (2026-11-21 확정).
 *
 *  - 심볼: 24 격자 인라인 SVG. 외부 참조 0건(파일 요청 없음), 낭독 제외(aria-hidden).
 *  - 워드마크: Instrument Serif — 사이트가 이미 쓰는 서체.
 *  - 비율: 심볼 = 워드마크 글자 크기 × 0.909 (28px : 30.8px, 시안 A 1:0.55 균형 비율).
 *  - 색: 먹(잉크 네이비)은 currentColor, 포인트 1색은 라이트 딥그린 / 다크 배경 민트(#7fe3c4).
 *
 * 글자 크기는 `size`(예: "30.8px")로 넘긴다. 생략하면 부모의 font-size(1em)를 따른다.
 */
interface Props {
  /** 워드마크 글자 크기 — 심볼·간격이 여기에 비례한다 */
  size?: string;
  /** dark: 잉크 네이비 바탕 위에서 종이색 + 민트 */
  tone?: "light" | "dark";
  class?: string;
  /** 화면에 워드마크를 함께 보일지 (심볼만 쓸 때 false) */
  wordmark?: boolean;
}

const { size, tone = "light", class: className, wordmark = true } = Astro.props;
---

<span
  class:list={["brand-lockup", tone === "dark" && "is-dark", className]}
  style={size ? `--lockup-size:${size}` : undefined}
>
  <svg class="brand-lockup__symbol" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="brand-lockup__ink" d="M3.9 2H13.9V22L8.9 16.2 3.9 22Z"></path>
    <rect class="brand-lockup__tab" x="13.9" y="5.8" width="6.4" height="2.8" rx="1.4"></rect>
  </svg>
  {wordmark && <span class="brand-lockup__word serif">buffetkimz</span>}
</span>
