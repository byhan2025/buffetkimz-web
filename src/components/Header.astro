---
/**
 * v7.2 헤더 — 데스크톱은 한 줄, 모바일(<768px)은 두 줄.
 *
 *  1행: buffetkimz 로고 + 검색 + 전체메뉴(≡)
 *  2행: 홈 · 자산리포트 · 앱스토어 · 골든타임 · 자료앨범 — 가로 스크롤 없는 1줄 고정 퀵 탭
 *  기준: 1024px부터 데스크톱 가로 메뉴, 그 아래(태블릿 포함)는 두 줄 퀵 탭 + ≡ 드로어.
 *
 * 하위 메뉴(드롭다운)는 두 곳에서 같은 목록(config/site.ts의 `children`)을 펼친다.
 *  · 데스크톱: 메뉴에 호버하거나 ▾ 버튼을 누르면 흰 메뉴판이 세로로 내려온다. 메뉴 글자를 누르면 그 페이지로 간다.
 *  · 모바일: 가로 탭을 한 번 누르면 그 자리에서 세로 메뉴판이 열리고, 다시 누르면(또는 바깥을 누르면) 닫힌다.
 *    '전체 보기'와 하위 항목으로 바로 이동한다. 메뉴판은 화면 좌우 여백 안에서만 열린다.
 *  · 메뉴판 구성: 위에는 지금 열린 분류(항목 수 칩 + 한 줄 설명), 구분선 아래는 '곧 열립니다 · 준비중'.
 *  · ≡ 전체메뉴 드로어는 지금까지의 구조·동작 그대로 둔다.
 *
 * 퀵 탭 그리드 비율은 config/site.ts의 `weight`(글자 수 비례)를 그대로 받아 쓴다.
 * 배경은 크림(paper) 98% + 약한 블러 — 스크롤해도 두 줄 바 뒤로 본문 글자가 비치지 않는다(v2.2).
 */
import { withBase, site, nav, quickTabs, quickTabColumns, stripBase, type NavChild } from "@/config/site";
import HeaderSearch from "@/components/HeaderSearch.tsx";
import BrandLockup from "@/components/BrandLockup.astro";
import { allPosts, categoryCounts } from "@/lib/posts";
import { calendar } from "@/data/calendar";
import { categoryCount as storeCategoryCount, storeCount } from "@/data/store";
import {
  categoryCount as galleryCategoryCount,
  galleryCount,
  gallerySlideCount,
} from "@/data/gallery";

const path = stripBase(Astro.url.pathname);
const isActive = (match: string) =>
  match === "/" ? path === "/" : path === match || path.startsWith(match + "/");

/** 메뉴판의 항목 수 칩 — 화면에서 숫자를 만들지 않고, 빌드 시 실제 데이터에서 센다. */
const [posts, postCounts] = await Promise.all([allPosts(), categoryCounts()]);

function chipFor(href?: string): string {
  if (!href) return "";
  if (href === "/posts") return `${posts.length}편`;
  if (href.startsWith("/posts/")) {
    const slug = href.split("/")[2] ?? "";
    const n = postCounts[slug];
    return n ? `${n}편` : "";
  }
  if (href === "/apps") return `${storeCount}종`;
  if (href.startsWith("/apps/#cat-")) return `${storeCategoryCount(href.split("#cat-")[1] ?? "")}종`;
  if (href === "/gallery") return `${galleryCount}세트 · ${gallerySlideCount}장`;
  if (href.startsWith("/gallery/?cat=")) return `${galleryCategoryCount(href.split("=")[1] ?? "")}세트`;
  if (href === "/calendar") return `${calendar.length}건`;
  return "";
}

/** 메뉴판 한 벌 — 열린 분류와 준비중 분류를 나눠 그린다(데스크톱·모바일 공통). */
const splitMenu = (children: NavChild[]) => ({
  live: children.filter((c) => !c.soon && c.href),
  soon: children.filter((c) => c.soon || !c.href),
});

/**
 * 하위 메뉴 머리의 개수 — '전체' 줄(부모와 같은 주소)은 분류가 아니므로 빼고 센다.
 * 자산리포트는 하위 메뉴가 곧 분류, 나머지는 항목이다.
 */
const menuCountText = (item: (typeof nav)[number], menu: { live: NavChild[] }) => {
  const n = menu.live.filter((c) => c.href !== item.href).length;
  return item.match === "/posts" ? `${n}개 분류` : `${n}개 항목`;
};
---

<header class="site-header sticky top-0 z-40 border-b border-line/80 bg-paper/[0.98] backdrop-blur-md">
  <!-- 1행 — 로고 · 주 메뉴(데스크톱) · 검색 · 전체메뉴 -->
  <div class="wrap site-header-row flex items-center gap-4">
    <a
      href={withBase("/")}
      class="brand-lockup-link flex min-h-[44px] shrink-0 items-center gap-2"
      aria-label={`${site.brand} 홈`}
      data-quick-active={isActive("/") ? "true" : "false"}
    >
      <BrandLockup class="brand-lockup--header" />
    </a>

    <nav class="site-nav mx-auto hidden items-center gap-1 lg:flex" aria-label="주 메뉴">
      {
        nav.map((item, i) => {
          const menu = item.children ? splitMenu(item.children) : null;
          return (
            <div
              class="nav-group"
              data-nav-group
              data-active={isActive(item.match) ? "true" : "false"}
              data-children={item.children ? "true" : "false"}
            >
              <a
                href={withBase(item.href)}
                class="nav-link"
                aria-current={isActive(item.match) ? "page" : undefined}
              >
                {item.label}
              </a>
              {menu && (
                <button
                  type="button"
                  class="nav-caret"
                  data-nav-toggle
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls={`nav-drop-${i}`}
                  aria-label={`${item.label} 하위 메뉴`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              )}
              {menu && (
                <div class="nav-drop" id={`nav-drop-${i}`} data-nav-drop hidden>
                  <div class="nav-drop-head-wrap">
                    <p class="nav-drop-head">
                      <span>{item.label}</span>
                      <span class="nav-drop-head-note">{menuCountText(item, menu)}</span>
                    </p>
                    <p class="nav-drop-desc">{item.desc}</p>
                  </div>
                  <ul class="nav-drop-list">
                    {menu.live.map((child) => (
                      <li>
                        <a
                          class="nav-drop-row"
                          href={child.external ? (child.href as string) : withBase(child.href as string)}
                          target={child.external ? "_blank" : undefined}
                          rel={child.external ? "noopener noreferrer" : undefined}
                        >
                          <span class="nav-drop-label">{child.label}</span>
                          {chipFor(child.href) && <span class="nav-drop-chip">{chipFor(child.href)}</span>}
                          {child.note && <span class="nav-drop-note">{child.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  {menu.soon.length > 0 && (
                    <div class="nav-drop-soon">
                      <p class="nav-drop-soon-head">
                        <span class="soon-dot" aria-hidden="true" />
                        곧 열립니다 · 준비중
                      </p>
                      <ul class="nav-drop-list">
                        {menu.soon.map((child) => (
                          <li>
                            <span class="nav-drop-row is-soon" aria-disabled="true">
                              <span class="nav-drop-label">{child.label}</span>
                              <span class="soon-pill">준비중</span>
                              {child.note && <span class="nav-drop-note">{child.note}</span>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <HeaderSearch client:idle />
      <button
        type="button"
        class="-mr-1 grid h-11 w-11 place-items-center text-ink lg:hidden"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M3.5 7h17M3.5 12h17M3.5 17h17" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- 2행 — 모바일 1줄 고정 퀵 탭 (가로 스크롤 없음). 하위 메뉴가 있는 탭은 ▾로 표시한다. -->
  <nav class="site-quick lg:hidden" aria-label="바로가기 메뉴">
    <ul class="site-quick-list" style={`--quick-cols:${quickTabColumns}`} data-quick-tabs>
      {
        quickTabs.map((tab, i) => (
          <li>
            <a
              href={withBase(tab.href)}
              class="site-quick-link"
              data-active={isActive(tab.match) ? "true" : "false"}
              data-quick-toggle={tab.children ? `quick-panel-${i}` : undefined}
              aria-expanded={tab.children ? "false" : undefined}
              aria-haspopup={tab.children ? "true" : undefined}
              aria-controls={tab.children ? `quick-panel-${i}` : undefined}
              aria-current={isActive(tab.match) ? "page" : undefined}
            >
              <span class="site-quick-text">{tab.label}</span>
              {tab.children && (
                <svg class="site-quick-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- 모바일 하위 메뉴판 — 헤더 바로 아래, 화면 좌우 여백 안에서만 열린다 -->
    <div class="quick-panels" data-quick-panels>
      {
        quickTabs.map((tab, i) => {
          const menu = tab.children ? splitMenu(tab.children) : null;
          return menu ? (
            <div class="quick-panel" id={`quick-panel-${i}`} data-quick-panel hidden>
              <div class="quick-panel-head-wrap">
                <p class="quick-panel-head">
                  <span>{tab.label}</span>
                  <a class="quick-panel-all" href={withBase(tab.href)}>
                    전체 보기 →
                  </a>
                </p>
                <p class="quick-panel-desc">{nav.find((n) => n.match === tab.match)?.desc}</p>
              </div>
              <ul class="quick-panel-list">
                {menu.live.map((child) => (
                  <li>
                    <a class="quick-panel-row" href={withBase(child.href as string)}>
                      <span class="quick-panel-label">{child.label}</span>
                      {chipFor(child.href) && <span class="quick-panel-chip">{chipFor(child.href)}</span>}
                      {child.note && <span class="quick-panel-note">{child.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {menu.soon.length > 0 && (
                <div class="quick-panel-soon">
                  <p class="quick-panel-soon-head">
                    <span class="soon-dot" aria-hidden="true" />
                    곧 열립니다 · 준비중
                  </p>
                  <ul class="quick-panel-list">
                    {menu.soon.map((child) => (
                      <li>
                        <span class="quick-panel-row is-soon" aria-disabled="true">
                          <span class="quick-panel-label">{child.label}</span>
                          <span class="soon-pill">준비중</span>
                          {child.note && <span class="quick-panel-note">{child.note}</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ) : null;
        })
      }
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden" data-menu-panel>
    <nav class="wrap flex flex-col py-2" aria-label="모바일 메뉴">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class="flex min-h-[52px] items-center justify-between border-b border-line-soft text-[16px] font-semibold text-ink"
            aria-current={isActive(item.match) ? "page" : undefined}
          >
            {item.label}
            {isActive(item.match) && <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true" />}
          </a>
        ))
      }
      <a href={withBase("/search")} class="flex min-h-[52px] items-center text-[16px] font-semibold text-ink-muted">검색</a>
    </nav>
  </div>
</header>

<script>
  /**
   * v7.4 — 모바일 드롭다운 메뉴판이 열린 동안 `? 가이드` 플로팅 버튼이 카드의 '준비중' 칩을
   * 가리지 않게 잠시 숨긴다. 열림/닫힘을 각 핸들러에서 직접 부르고, 혹시 빠진 경로가 있어도
   * 잡히도록 패널·드롭다운의 hidden/class 변화를 MutationObserver로 함께 살핀다.
   */
  const syncGuide = () => {
    const panels = [...document.querySelectorAll<HTMLElement>("[data-quick-panel], [data-nav-drop]")];
    const menu = document.querySelector<HTMLElement>("[data-menu-panel]");
    const open =
      panels.some((p) => !p.hidden) || (menu ? !menu.classList.contains("hidden") : false);
    document.documentElement.dataset.navOpen = open ? "true" : "false";
  };

  const observeGuide = () => {
    const targets = document.querySelectorAll<HTMLElement>(
      "[data-quick-panel], [data-nav-drop], [data-menu-panel]",
    );
    const mo = new MutationObserver(syncGuide);
    targets.forEach((t) => mo.observe(t, { attributes: true, attributeFilter: ["hidden", "class", "style"] }));
    syncGuide();
  };
  observeGuide();

  /**
   * v7.2 — 메뉴 하위 드롭다운.
   *  · 데스크톱: 호버(마우스가 있는 기기에서만) + ▾ 클릭. 패널이 화면 오른쪽 밖으로 나가면 안쪽으로 당긴다.
   *  · 모바일: 가로 탭 한 번 = 열기, 다시 탭·바깥 탭·Esc = 닫기. 이동은 '전체 보기'와 하위 항목으로 한다.
   */
  const closeDesk = () => {
    document.querySelectorAll<HTMLElement>("[data-nav-drop]").forEach((d) => {
      d.hidden = true;
      d.style.transform = "";
    });
    document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((g) => (g.dataset.open = "false"));
    document.querySelectorAll<HTMLElement>("[data-nav-toggle]").forEach((b) => b.setAttribute("aria-expanded", "false"));
  };

  const closeQuick = () => {
    document.querySelectorAll<HTMLElement>("[data-quick-panel]").forEach((p) => (p.hidden = true));
    document.querySelectorAll<HTMLElement>("[data-quick-toggle]").forEach((a) => a.setAttribute("aria-expanded", "false"));
  };

  const clamp = (drop: HTMLElement) => {
    drop.style.transform = "";
    const r = drop.getBoundingClientRect();
    const pad = 12;
    let shift = 0;
    if (r.right > window.innerWidth - pad) shift = window.innerWidth - pad - r.right;
    if (r.left + shift < pad) shift = pad - r.left;
    if (shift) drop.style.transform = `translateX(${Math.round(shift)}px)`;
  };

  document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
    const drop = group.querySelector<HTMLElement>("[data-nav-drop]");
    const toggle = group.querySelector<HTMLElement>("[data-nav-toggle]");
    if (!drop || !toggle) return;

    const open = () => {
      closeDesk();
      drop.hidden = false;
      group.dataset.open = "true";
      toggle.setAttribute("aria-expanded", "true");
      clamp(drop);
    };
    const close = () => {
      drop.hidden = true;
      group.dataset.open = "false";
      toggle.setAttribute("aria-expanded", "false");
      drop.style.transform = "";
    };

    toggle.addEventListener("click", (e) => {
      e.preventDefault();
      if (drop.hidden) open();
      else close();
    });

    const canHover = window.matchMedia("(hover: hover) and (min-width: 768px)");
    let timer = 0;
    group.addEventListener("mouseenter", () => {
      if (!canHover.matches) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(open, 60);
    });
    group.addEventListener("mouseleave", () => {
      if (!canHover.matches) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(close, 160);
    });
    group.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !group.contains(next)) close();
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-quick-toggle]").forEach((link) => {
    const panel = document.getElementById(link.dataset.quickToggle || "");
    if (!panel) return;

    link.addEventListener("click", (e) => {
      /* 첫 탭 = 열기, 열린 상태의 탭 = 닫기. 페이지 이동은 '전체 보기'·하위 항목이 맡는다. */
      e.preventDefault();
      const willOpen = panel.hidden;
      closeQuick();
      if (willOpen) {
        panel.hidden = false;
        link.setAttribute("aria-expanded", "true");
      }
    });
  });

  const closeAll = () => {
    closeDesk();
    closeQuick();
  };

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (target instanceof Element && target.closest("[data-nav-group]")) {
      // 메뉴 그룹 안쪽 클릭은 그 그룹의 로직이 처리한다
    } else {
      closeDesk();
    }
    const insidePanel = target instanceof Element && target.closest("[data-quick-panel]");
    const onToggle = target instanceof Element && target.closest("[data-quick-toggle]");
    if (!insidePanel && !onToggle) closeQuick();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  window.addEventListener("resize", () => {
    document.querySelectorAll<HTMLElement>("[data-nav-drop]").forEach((d) => {
      if (!d.hidden) clamp(d);
    });
  });

  /* ≡ 전체메뉴를 열면 위·아래 패널은 접는다(기존 드로어 동작은 그대로). */
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  if (toggle) {
    toggle.addEventListener("click", () => {
      closeAll();
      const nowHidden = panel?.classList.toggle("hidden");
      const open = nowHidden === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
    });
  }
</script>
