---
/**
 * 홈 신뢰 구역 — v7.0 리라이팅.
 *
 * 왼쪽: 이 사이트가 숫자를 다루는 세 가지 기준(1차 출처 · 기준일 · 가정과 한계).
 * 오른쪽: 확인한 출처 기관과 쌓인 양을 숫자로 보여 주는 데이터 카드.
 * 아래: 이번 달 금융 일정 3건을 얇게 깔아 유용성을 붙인다.
 *
 * v7.0에서 '서버 저장 0건'·'판정하지 않습니다' 같은 방어적 문구를 걷어내고,
 * 무엇을 어떻게 확인하는지로 바꿔 썼다. 숫자는 데이터에서 센다.
 */
import { withBase, site } from "@/config/site";
import { calendar } from "@/data/calendar";
import { storeCount } from "@/data/store";

interface Props {
  postsCount: number;
  toolCount: number;
  channelCount: number;
}

const { postsCount, toolCount, channelCount } = Astro.props;
const thisMonth = site.today.getMonth() + 1;
const sourcedCalendar = calendar.filter((c) => Boolean(c.source));
const monthItems = calendar.filter((c) => c.month === thisMonth);
const upcoming = [...monthItems.filter((c) => c.key), ...monthItems.filter((c) => !c.key)].slice(0, 3);

const sources = [
  { org: "금융위원회", what: "보험·금융 정책, 실손 세대" },
  { org: "금융감독원", what: "감독규정, 소비자 안내" },
  { org: "국세청", what: "연금계좌 세액공제, 과세 기준" },
  { org: "국민건강보험공단", what: "지역가입자 보험료, 피부양자" },
  { org: "한국은행", what: "기준금리, 물가·환율 통계" },
];

const standards = [
  {
    title: "1차 출처를 먼저 읽습니다",
    body: "금융위·금감원·국세청·한국은행·공단의 원문을 확인한 뒤 숫자를 씁니다.",
  },
  {
    title: "기준일을 함께 남깁니다",
    body: "제도는 바뀝니다. 모든 글과 도구에 확인한 날짜를 붙여, 어느 시점의 사실인지 밝힙니다.",
  },
  {
    title: "가정과 한계를 먼저 적습니다",
    body: "물가·수익률·세율 중 무엇을 넣고 넣지 못했는지 결과 옆에 적어, 숫자를 과신하지 않게 합니다.",
  },
];
---

<section class="scene-sky-band border-b border-line" data-area="5" id="trust">
  <div class="wrap py-10 md:py-14">
    <div class="sec-head">
      <div>
        <p class="eyebrow">기준</p>
        <h2 class="sec-title">숫자를 다루는<br />세 가지 기준</h2>
      </div>
      <div class="sec-head-side">
        <p class="sec-desc">
          계산의 근거가 되는 원칙과, 실제로 확인한 출처·기준일을 한 화면에 나란히 두었습니다.<br />
          확인 기준일 {site.baseDateLabel}
        </p>
      </div>
    </div>

    <div class="mt-5 grid gap-3 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- 페이지에서 유일한 단색 강조 카드 -->
      <div class="accent-card">
        <p class="mono text-[12px] text-[#c9d1e6]">금융·투자·재무를 다루는 방식</p>
        <h3 class="mt-1.5 text-[19px] font-bold leading-snug tracking-[-0.03em] text-white">
          1차 출처 · 기준일 ·<br />가정과 한계를 함께
        </h3>

        <ul class="mt-4 space-y-3">
          {
            standards.map((s) => (
              <li class="flex gap-3">
                <span class="accent-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path d="m5 12.5 4.2 4.2L19 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>
                  <span class="block text-[13.5px] font-semibold text-white">{s.title}</span>
                  <span class="mt-0.5 block text-[12px] leading-[1.65] text-[#dbe0ee]">{s.body}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="accent-line mt-4 flex flex-wrap items-center gap-2 pt-3">
          <a href={withBase("/about")} class="btn btn-sm btn-on-solid">소개 보기</a>
          <a href={withBase("/principles")} class="btn btn-sm btn-on-solid">편집 원칙</a>
        </div>
      </div>

      <!-- 데이터 카드 — 출처·기준일·쌓인 양 -->
      <div class="trust-data" data-trust-data>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="mono text-[12px] tracking-[0.01em] text-brand">확인한 출처 · 기준일</p>
          <p class="mono text-[12px] text-ink-faint">VERIFIED {site.baseDateLabel}</p>
        </div>

        <p class="mt-2 text-[19px] font-bold leading-snug tracking-[-0.03em] text-ink">
          법령과 감독 당국 원문을 먼저 보고,<br />요약은 원문과 대조합니다.
        </p>

        <ul class="mt-3 grid gap-x-4 gap-y-1.5 sm:grid-cols-2" data-source-list>
          {
            sources.map((s) => (
              <li class="flex items-baseline justify-between gap-2 border-b border-line-soft pb-1">
                <span class="text-[12.5px] font-semibold text-ink">{s.org}</span>
                <span class="text-right text-[12px] text-ink-muted">{s.what}</span>
              </li>
            ))
          }
        </ul>

        <dl class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4" data-trust-stats>
          <div class="trust-stat">
            <dt>자산리포트</dt>
            <dd>{postsCount}<span>편</span></dd>
          </div>
          <div class="trust-stat">
            <dt>앱</dt>
            <dd>{storeCount}<span>종</span></dd>
          </div>
          <div class="trust-stat">
            <dt>금융 일정</dt>
            <dd>{sourcedCalendar.length}<span>건</span></dd>
          </div>
          <div class="trust-stat">
            <dt>출처 기관</dt>
            <dd>{sources.length}<span>곳</span></dd>
          </div>
        </dl>

        <p class="mt-2.5 text-[12px] leading-[1.7] text-ink-muted">
          모든 글과 도구에 확인 기준일과 1차 출처를 붙입니다. 계산에 넣은 가정과 넣지 못한 것은 결과 옆에
          적고, SNS 채널에 올리는 글도 같은 기준으로 씁니다. 채널 {channelCount}곳의 주소는 확인되는 대로 엽니다.
        </p>
      </div>
    </div>

    <!-- 이번 달 금융 일정 3건 -->
    <div class="calendar-strip" data-calendar-strip>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <p class="text-[13px] font-bold tracking-[-0.02em] text-ink">
          이번 달 금융 일정
          <span class="ml-1.5 inline-block rounded-full bg-brand-soft px-2 py-0.5 align-[2px] text-[12px] font-semibold text-brand-deep">
            {thisMonth}월 · {monthItems.length}건
          </span>
        </p>
        <a href={withBase("/calendar")} class="btn btn-tertiary-quiet btn-xs !px-2">1~12월 {calendar.length}건 전체 →</a>
      </div>
      <ul class="mt-2 grid gap-2 sm:grid-cols-3">
        {
          upcoming.map((item) => (
            <li class="rounded-lg border border-line bg-white px-3 py-2">
              <p class="mono text-[12px] text-brand-deep">{item.when}</p>
              <p class="mt-0.5 text-[13px] font-semibold leading-snug text-ink">{item.title}</p>
              <p class="clamp-2 mt-0.5 text-[12px] leading-[1.55] text-ink-muted">{item.action}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
