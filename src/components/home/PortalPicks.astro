---
/**
 * 포털 픽 — 홈 ③ '최신'.
 *
 * 왼쪽: 자산리포트(/posts) 최신 3편 + **카드뉴스 최신 2세트**(v8.9.0, 감사 R1·S1).
 *      글과 카드는 다른 발행물이라 한 칸에서 나란히 보여 주고, 카드는 표지 썸네일로 구분한다.
 * 오른쪽: 앱스토어(/apps) 추천 4종 — 아이콘·이름·한 줄·바로 열기.
 *
 * 글은 컬렉션에서, 카드는 gallery.ts에서, 앱은 store.ts에서 읽는다. 손으로 적은 제목·숫자를 두지 않는다.
 */
import { withBase, menuLabel } from "@/config/site";
import { featuredStore } from "@/data/store";
import AppStoreIcon from "@/components/apps/AppStoreIcon.astro";
import { allPosts, categoryLabel, postPath, formatDate } from "@/lib/posts";
import { galleryItems } from "@/data/gallery";
import { cardThumb } from "@/lib/card-assets";

const posts = (await allPosts()).slice(0, 3);
/** 카드뉴스 최신 2세트 — 표지는 실제 파일이 있는 첫 장(빌드 시점 확인) */
const cardPick = galleryItems
  .map((item) => ({ item, cover: item.slides[0] }))
  .filter((x) => Boolean(x.cover))
  .slice(0, 2);
const picks = featuredStore.slice(0, 4);
---

<section class="scene-cream border-b border-line" data-area="picks" id="picks">
  <div class="wrap py-10 md:py-12">
    <div class="picks-head">
      <div>
        <p class="eyebrow">읽고 · 열어 보기</p>
        <h2 class="sec-title">오늘의 자산리포트와<br />앱스토어 추천</h2>
      </div>
      <p class="sec-desc">
        글에서 기준을 읽고, 도구에서 내 숫자로 확인합니다. <br />
        두 곳의 출처와 기준일은 같습니다.
      </p>
    </div>

    <div class="picks-grid">
      <!-- 자산리포트 -->
      <div class="picks-panel" data-guide="latest">
        <div class="picks-panel-head">
          <p class="picks-panel-label">
            {menuLabel.posts}
            <span class="picks-panel-sub">최신 3편 + 카드 2세트</span>
          </p>
          <a href={withBase("/posts")} class="picks-more">전체 보기 →</a>
        </div>
        <ul class="picks-posts">
          {
            posts.map((p) => (
              <li>
                <a href={withBase(postPath(p))} class="picks-post">
                  <span class="picks-post-cat">{categoryLabel(p)}</span>
                  <span class="picks-post-title">{p.data.title}</span>
                  <span class="picks-post-hook">{p.data.hook ?? p.data.question ?? p.data.description}</span>
                  <span class="picks-post-meta mono">
                    {formatDate(p.data.baseDate ?? p.data.publishedAt)} · {p.data.readingMinutes}분
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="picks-cards" data-guide="picks-cards">
          <div class="picks-cards-head">
            <p class="picks-panel-sub">카드뉴스 최신 2세트</p>
            <a href={withBase("/gallery")} class="picks-more">자료앨범 →</a>
          </div>
          <ul class="picks-cards-list">
            {cardPick.map(({ item, cover }) => (
              <li>
                <a href={withBase(`/gallery/${item.id}/`)} class="picks-card">
                  <img
                    src={withBase(cardThumb(cover.src))}
                    alt=""
                    width="48"
                    height="60"
                    loading="lazy"
                    decoding="async"
                    class="picks-card-cover"
                  />
                  <span class="picks-card-body">
                    <span class="picks-card-title">{item.title}</span>
                    <span class="picks-card-meta mono">
                      카드 {item.slides.length}장 · {item.category === "cardnews" ? "카드뉴스" : item.category === "infographic" ? "인포그래픽" : "체크리스트"}
                    </span>
                  </span>
                  <span class="picks-card-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- 앱스토어 -->
      <div class="picks-panel picks-panel--apps">
        <div class="picks-panel-head">
          <p class="picks-panel-label">
            {menuLabel.apps}
            <span class="picks-panel-sub">추천 4종</span>
          </p>
          <a href={withBase("/apps")} class="picks-more">앱스토어 →</a>
        </div>
        <ul class="picks-apps">
          {
            picks.map((app) => (
              <li>
                <a href={withBase(app.href)} class="picks-app">
                  <span class="picks-app-icon" aria-hidden="true">
                    <AppStoreIcon name={app.icon} size={18} />
                  </span>
                  <span class="picks-app-body">
                    <span class="picks-app-name">{app.name}</span>
                    <span class="picks-app-line">{app.tagline}</span>
                  </span>
                  <span class="picks-app-open" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={withBase("/apps")} class="btn btn-primary btn-sm picks-cta">앱스토어에서 골라 쓰기</a>
      </div>
    </div>

  </div>
</section>
