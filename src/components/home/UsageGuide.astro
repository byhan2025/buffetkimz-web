---
/**
 * 사용법 다단 안내 — 2026-11-25 깃밥 벤치마킹 2항.
 *
 * 새 방문자가 5초 안에 '이 사이트가 다섯 곳으로 되어 있다'를 이해하게 한다.
 *  · 왼쪽: 그 기능이 무엇을 하는 곳인지 두 문장과 바로가기
 *  · 오른쪽: 실제 화면 톤 그대로의 미니 모형(값은 데이터에서 가져온다 — 손으로 적지 않는다)
 *  · 아래: 5개 탭. 클릭·키보드로 바꾸고, 7초마다 스스로 넘어가며, 멈춤 버튼으로 자동 넘김을 끈다.
 *
 * 지키는 것
 *  · `prefers-reduced-motion`에서는 자동 넘김을 켜지 않는다(처음 탭에서 멈춘다).
 *  · 모형은 '화면 예시'임을 밝히고, 조작할 수 있는 척하지 않는다(버튼 모양은 그리되 링크가 아니다).
 *  · 숫자는 `today.ts`·`tax-rules`·`gallery`·`board`·`academy`에서 온다.
 */
import { withBase } from "@/config/site";
import { today as hub, hubStamp } from "@/data/today";
import { boardEntries } from "@/data/board";
import { galleryItems, galleryCount, gallerySlideCount } from "@/data/gallery";
import { toolCount } from "@/data/store";
import { ACADEMY, ACADEMY_STEPS } from "@/data/academy";
import { SCHOOL_COUNTS } from "@/data/academy-school";
import { cardThumb, existsInPublic } from "@/lib/card-assets";
import { PENSION_RULE } from "@/lib/finance";

/** 시장 모형 — 마켓 보드 앞줄과 같은 세 지표 */
const marketIds = ["kospi", "usdkrw", "ktb3y"];
const marketRows = marketIds
  .map((id) => hub.indicators.find((ind) => ind.id === id))
  .filter((ind): ind is NonNullable<typeof ind> => Boolean(ind))
  .map((ind) => ({ name: ind.name, value: ind.value, change: ind.change }));

/** 게시판 모형 — 가장 최근 확인 3건 */
const boardRows = boardEntries.slice(0, 3).map((entry) => ({
  slot: entry.slot,
  category: entry.category,
  title: entry.title,
}));

/** 자료앨범 모형 — 표지 파일이 실제로 있는 세트 셋 */
const galleryCovers: { item: (typeof galleryItems)[number]; cover: string }[] = galleryItems
  .map((item) => {
    const cover = item.slides.find((slide) => existsInPublic(slide.src));
    return cover ? { item, cover: cover.src } : null;
  })
  .filter((row): row is { item: (typeof galleryItems)[number]; cover: string } => Boolean(row))
  .slice(0, 3);

/** 아카데미 모형 — 앞 세 단계 */
const academyRows = ACADEMY_STEPS.slice(0, 3).map((step) => ({
  no: step.no,
  name: step.name,
  lessons: step.lessons,
  opened: step.opened,
}));

/** 세액공제 예시 — 도구 카드와 같은 값(한도 × 공제율) */
const pensionCredit = (PENSION_RULE.totalLimit * PENSION_RULE.rateLow).toFixed(1);

const tabs = [
  {
    id: "market",
    label: "오늘의 시장",
    meta: [`지표 ${hub.indicators.length}개`, `확인 ${hubStamp(hub.asOf)}`],
    title: "오늘의 시장과 확인할 것",
    desc: "코스피와 환율, 국고채 금리를 한 화면에 모으고 오늘 확인할 기한 세 건을 함께 둡니다. 지표마다 마지막 확인 시각과 출처를 붙입니다.",
    href: "#today",
    cta: "오늘 시장 보기",
  },
  {
    id: "tools",
    label: "계산기 도구",
    meta: [`도구 ${toolCount}종`, "브라우저 실행"],
    title: "가입 없이 브라우저에서 계산",
    desc: "세액공제와 은퇴 현금흐름, 복리, 연금 인출 세금을 내 숫자로 계산합니다. 입력한 값은 서버로 보내지 않고 그 화면 안에서만 씁니다.",
    href: withBase("/apps"),
    cta: "도구 전체 보기",
  },
  {
    id: "board",
    label: "데일리 브리프",
    meta: [`기록 ${boardEntries.length}건`, "하루 세 번"],
    title: "하루 세 번 쌓이는 확인 메모",
    desc: "오늘 허브에 다 담지 못한 시황과 제도, AI 메모를 06:00, 13:00, 19:00에 확인해 쌓습니다. 짧은 메모에도 출처와 확인 시각을 남깁니다.",
    href: withBase("/board"),
    cta: "게시판 열기",
  },
  {
    id: "gallery",
    label: "자료앨범",
    meta: [`카드 ${galleryCount}세트`, `${gallerySlideCount}장`],
    title: "카드뉴스와 체크리스트 내려받기",
    desc: "금융과 연금 주제를 4:5 카드로 정리했습니다. 카드 하단에 조문과 기준일을 적어 두어, 화면에 띄워 두거나 저장해 쓸 수 있습니다.",
    href: withBase("/gallery"),
    cta: "자료앨범 열기",
  },
  {
    id: "academy",
    label: "아카데미",
    meta: [`6트랙 ${SCHOOL_COUNTS.weeks}주`, `실전 ${ACADEMY.counts.lessons}강`],
    title: "순서대로 읽는 금융생활학교",
    desc: "돈의 기초부터 계좌 배치, 투자 구조, 은퇴 인출까지 6단계로 나눴습니다. 강의마다 읽기와 계산기, 카드, 출처가 한 세트입니다.",
    href: withBase("/academy"),
    cta: "아카데미 열기",
  },
] as const;
---

<section class="scene-mist border-b border-line" id="how" aria-labelledby="how-title" data-how>
  <div class="wrap py-10 md:py-14">
    <div class="how-head">
      <h2 id="how-title" class="sec-title">이렇게 활용하세요</h2>
      <p class="sec-desc">
        다섯 곳이 한 사이트 안에 있습니다. 탭을 눌러 무엇을 하는 곳인지 먼저 보세요.
      </p>
    </div>

    <div class="how-card">
      <div class="how-panels">
        {
          tabs.map((tab, i) => (
            <div
              class="how-panel"
              role="tabpanel"
              id={`how-panel-${tab.id}`}
              aria-labelledby={`how-tab-${tab.id}`}
              tabindex="0"
              hidden={i > 0}
              data-how-panel={tab.id}
            >
              <div class="how-text">
                <p class="how-meta">
                  {tab.meta.map((part, index) => (
                    <span>
                      {index > 0 && <i class="how-sep" aria-hidden="true" />}
                      {part}
                    </span>
                  ))}
                </p>
                <h3 class="how-title">{tab.title}</h3>
                <p class="how-desc">{tab.desc}</p>
                <a class="btn btn-secondary btn-sm how-cta" href={tab.href}>
                  {tab.cta}
                </a>
              </div>

              <div class="how-visual">
                <p class="how-visual-label">화면 예시</p>

                {tab.id === "market" && (
                  <div class="mock">
                    <div class="mock-head">
                      <span class="mock-title">오늘의 시장</span>
                      <span class="mock-sub mono">{hubStamp(hub.asOf)}</span>
                    </div>
                    <ul class="mock-list">
                      {marketRows.map((row) => (
                        <li class="mock-row">
                          <span class="mock-name">{row.name}</span>
                          <span class="mock-value mono">{row.value}</span>
                          <span class="mock-change mono">{row.change}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mock-foot">지표마다 마지막 확인 시각이 다릅니다</p>
                  </div>
                )}

                {tab.id === "tools" && (
                  <div class="mock">
                    <div class="mock-head">
                      <span class="mock-title">연금저축·IRP 세액공제 계산기</span>
                      <span class="mock-sub">조작 없음</span>
                    </div>
                    <div class="mock-field">
                      <span>총급여</span>
                      <b class="mono">5,500만 원</b>
                    </div>
                    <div class="mock-field">
                      <span>올해 납입</span>
                      <b class="mono">600만 원</b>
                    </div>
                    <span class="mock-track" aria-hidden="true">
                      <i style="width:67%" />
                    </span>
                    <p class="mock-result">
                      <span>예상 세액공제</span>
                      <b class="mono">{pensionCredit}만 원</b>
                    </p>
                    <p class="mock-foot">예시 입력값이며 결과는 판정이 아닙니다</p>
                  </div>
                )}

                {tab.id === "board" && (
                  <div class="mock">
                    <div class="mock-head">
                      <span class="mock-title">데일리 브리프</span>
                      <span class="mock-sub mono">06:00 / 13:00 / 19:00</span>
                    </div>
                    <ul class="mock-list">
                      {boardRows.map((row) => (
                        <li class="mock-note">
                          <span class="mock-note-head">
                            <span class="mock-chip">{row.category}</span>
                            <span class="mono mock-sub">{row.slot}</span>
                          </span>
                          <span class="mock-note-title">{row.title}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mock-foot">짧은 메모에도 출처와 확인 시각을 붙입니다</p>
                  </div>
                )}

                {tab.id === "gallery" && (
                  <div class="mock">
                    <div class="mock-head">
                      <span class="mock-title">자료앨범</span>
                      <span class="mock-sub mono">{galleryCount}세트</span>
                    </div>
                    <ul class="mock-covers">
                      {galleryCovers.map(({ item, cover }) => (
                        <li class="mock-cover">
                          <img
                            src={withBase(cardThumb(cover))}
                            alt=""
                            width="72"
                            height="90"
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="mock-cover-title">{item.title}</span>
                          <span class="mock-sub mono">카드 {item.slides.length}장</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mock-foot">4:5 카드로 내려받아 저장해 둘 수 있습니다</p>
                  </div>
                )}

                {tab.id === "academy" && (
                  <div class="mock">
                    <div class="mock-head">
                      <span class="mock-title">금융생활학교</span>
                      <span class="mock-sub mono">{SCHOOL_COUNTS.tracks}트랙</span>
                    </div>
                    <ul class="mock-list">
                      {academyRows.map((row) => (
                        <li class="mock-step">
                          <span class="mock-step-no mono">{String(row.no).padStart(2, "0")}</span>
                          <span class="mock-step-name">{row.name}</span>
                          <span class="mock-track mock-track--sm" aria-hidden="true">
                            <i style={`width:${Math.round((row.opened / row.lessons) * 100)}%`} />
                          </span>
                          <span class="mock-sub mono">{row.lessons}강</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mock-foot">강의마다 읽기, 계산기, 카드, 출처가 한 세트입니다</p>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="how-foot">
        <div class="how-tabs" role="tablist" aria-label="사이트 활용 안내" data-how-tabs>
          {
            tabs.map((tab, i) => (
              <button
                type="button"
                class="how-tab"
                role="tab"
                id={`how-tab-${tab.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`how-panel-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-how-tab={tab.id}
              >
                {tab.label}
              </button>
            ))
          }
        </div>

        <div class="how-controls">
          <p class="how-progress mono" aria-hidden="true" data-how-progress>1 / {tabs.length}</p>
          <button type="button" class="how-pause" aria-pressed="false" data-how-pause>
            자동 넘김 멈추기
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .how-head .sec-desc {
    max-width: 48ch;
  }

  .how-card {
    margin-top: 16px;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  @media (min-width: 768px) {
    .how-card {
      padding: 24px 24px 16px;
    }
  }

  .how-panel {
    display: grid;
    gap: 16px;
  }

  .how-panel[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .how-panel {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: center;
      gap: 32px;
    }
  }

  .how-panel:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }

  .how-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-ink-faint);
  }

  .how-meta > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .how-sep {
    display: inline-block;
    width: 1px;
    height: 10px;
    background-color: var(--color-line);
  }

  .how-title {
    margin-top: 8px;
    font-size: clamp(22px, 2.5vw, 30px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    word-break: keep-all;
  }

  .how-desc {
    margin-top: 12px;
    max-width: 44ch;
    font-size: 13.5px;
    line-height: 1.72;
    color: var(--color-ink-soft);
    word-break: keep-all;
  }

  .how-cta {
    margin-top: 16px;
  }

  .how-visual {
    min-width: 0;
  }

  .how-visual-label {
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--color-ink-faint);
    text-align: right;
  }

  .mock {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    min-height: 236px;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background-color: var(--color-paper);
  }

  .mock-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-line);
  }

  .mock-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .mock-sub {
    font-size: 12px;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .mock-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mock-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 8px;
    padding: 8px;
    border-radius: 9px;
    background-color: var(--color-surface);
  }

  .mock-name {
    font-size: 12.5px;
    color: var(--color-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mock-value {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .mock-change {
    font-size: 12px;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .mock-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--color-line);
    border-radius: 9px;
    background-color: var(--color-surface);
    font-size: 12.5px;
    color: var(--color-ink-muted);
  }

  .mock-field b {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .mock-track {
    display: block;
    height: 6px;
    border-radius: 3px;
    background-color: var(--color-line);
    overflow: hidden;
  }

  .mock-track i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background-color: var(--color-ink-soft);
  }

  .mock-track--sm {
    height: 4px;
    width: 28px;
  }

  .mock-result {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 12.5px;
    color: var(--color-ink-soft);
  }

  .mock-result b {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .mock-note {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    border-radius: 9px;
    background-color: var(--color-surface);
  }

  .mock-note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .mock-chip {
    padding: 2px 8px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 12px;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  .mock-note-title {
    font-size: 12.5px;
    font-weight: 650;
    line-height: 1.45;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    word-break: keep-all;
  }

  .mock-covers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .mock-cover {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .mock-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background-color: var(--color-paper-deep);
  }

  .mock-cover-title {
    font-size: 12px;
    font-weight: 650;
    line-height: 1.35;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    word-break: keep-all;
  }

  .mock-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 9px;
    background-color: var(--color-surface);
  }

  .mock-step-no {
    font-size: 12px;
    color: var(--color-ink-faint);
  }

  .mock-step-name {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mock-foot {
    padding-top: 8px;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink-faint);
  }

  .how-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
  }

  .how-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .how-tab {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: 12.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft),
      color 160ms var(--ease-out-soft);
  }

  .how-tab:hover {
    border-color: var(--color-ink-faint);
    color: var(--color-ink);
  }

  .how-tab[aria-selected="true"] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface);
  }

  .how-tab:active {
    background-color: var(--color-paper-deep);
    color: var(--color-ink);
  }

  .how-tab[aria-selected="true"]:active {
    background-color: var(--color-ink-soft);
    color: var(--color-surface);
  }

  .how-tab:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .how-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .how-progress {
    font-size: 12px;
    color: var(--color-ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .how-pause {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .how-pause:hover {
    border-color: var(--color-ink-faint);
    color: var(--color-ink);
  }

  .how-pause:active {
    background-color: var(--color-paper-deep);
  }

  .how-pause:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }
</style>

<script>
  /*
   * 다섯 탭 — 클릭·키보드(←/→/Home/End)로 바꾸고, 7초마다 스스로 넘어간다.
   * 자동 넘김은 마우스를 올리거나 포커스가 들어오면 잠시 멈추고, 멈춤 버튼으로 완전히 끈다.
   * prefers-reduced-motion이면 처음부터 자동 넘김을 켜지 않는다.
   */
  const root = document.querySelector<HTMLElement>("[data-how]");
  const tablist = root?.querySelector<HTMLElement>("[data-how-tabs]");

  if (root && tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>("[data-how-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-how-panel]")];
    const progress = root.querySelector<HTMLElement>("[data-how-progress]");
    const pauseBtn = root.querySelector<HTMLButtonElement>("[data-how-pause]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const INTERVAL = 7000;

    let index = 0;
    let userPaused = reduceMotion;
    let hovering = false;
    let timer = 0;

    const show = (next: number, focusTab = false) => {
      index = (next + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focusTab) tabs[index].focus();
      if (progress) progress.textContent = `${index + 1} / ${tabs.length}`;
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (userPaused || hovering || document.hidden) return;
      timer = window.setInterval(() => show(index + 1), INTERVAL);
    };

    const syncPause = () => {
      if (!pauseBtn) return;
      pauseBtn.setAttribute("aria-pressed", userPaused ? "true" : "false");
      pauseBtn.textContent = userPaused ? "자동 넘김 다시 시작" : "자동 넘김 멈추기";
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        show(i);
        start();
      });
    });

    tablist.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === "ArrowRight" || key === "ArrowLeft" || key === "Home" || key === "End") {
        event.preventDefault();
        const next =
          key === "Home" ? 0 : key === "End" ? tabs.length - 1 : index + (key === "ArrowRight" ? 1 : -1);
        show(next, true);
        start();
      }
    });

    pauseBtn?.addEventListener("click", () => {
      userPaused = !userPaused;
      syncPause();
      if (userPaused) stop();
      else start();
    });

    root.addEventListener("mouseenter", () => {
      hovering = true;
      stop();
    });
    root.addEventListener("mouseleave", () => {
      hovering = false;
      start();
    });
    root.addEventListener("focusin", () => {
      hovering = true;
      stop();
    });
    root.addEventListener("focusout", (event) => {
      if (root.contains((event as FocusEvent).relatedTarget as Node | null)) return;
      hovering = false;
      start();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    syncPause();
    start();
  }
</script>
