---
/**
 * 홈 6영역 — SNS 채널 연결 밴드 + 마무리 1:1 상담문의 배너(Handlus 스타일).
 * v7.1 — 내부 기획 용어(사이트를 '거점'이라 부르던 표현)를 걷어내고 방문자에게 읽히는 말로 바꿨다.
 *
 * 상담문의는 3순위(Tertiary) 위계다. 배너 문구는 '무엇을 함께 보는지'로 적는다.
 * v5.8에서 편집 원칙 배너로 바뀌었고, v5.8.2(2026-11-21)에서 사용자 선택으로 1:1 상담문의를 되살리며
 * 편집 원칙 링크를 배너 안 보조 링크로 남겼다. 배너는 딥그린 한 면 — 페이지의 마지막 색 장면이다.
 */
import { withBase, site } from "@/config/site";
import { channels, confirmedLinks } from "@/data/channels";
---

<section class="scene-white border-b border-line" data-area="6" id="channels">
  <div class="wrap py-10 md:py-14">
    <div class="sec-head">
      <div>
        <p class="eyebrow">소식 · SNS {channels.length}곳</p>
        <h2 class="sec-title">짧은 소식은 각 채널에서,<br />기록은 이곳에</h2>
      </div>
      <div class="sec-head-side">
        <p class="sec-desc">
          긴 글과 기록은 이곳에 남깁니다. 짧은 소식은 각 채널에서 만나요.<br />
          확정된 주소부터 순차적으로 연결합니다.
        </p>
      </div>
    </div>

    <ul class="mt-5 grid gap-2 sm:grid-cols-2" data-channel-list>
      {
        channels.map((c) => (
          <li data-channel class="flex items-center justify-between gap-3 rounded-xl border border-line bg-white px-3.5 py-2">
            <span class="min-w-0">
              <span class="block text-[13.5px] font-semibold text-ink">{c.name}</span>
              <span class="block truncate text-[12px] text-ink-muted">{c.note}</span>
            </span>
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="btn btn-tertiary btn-xs shrink-0">
                열기
              </a>
            ) : (
              <span class="shrink-0 text-[12px] text-ink-faint">주소 정리 중</span>
            )}
          </li>
        ))
      }
      <!-- 7개 채널 + 코드 보관소 = 8칸. 마지막 칸을 비워 두지 않는다. -->
      <li data-code-store class="flex items-center justify-between gap-3 rounded-xl border border-dashed border-[#cbd9e4] bg-paper px-3.5 py-2">
        <span class="min-w-0">
          <span class="block text-[13.5px] font-semibold text-ink">코드 보관소</span>
          <span class="block truncate text-[12px] text-ink-muted">앱의 코드와 배포 기록</span>
        </span>
        <a
          href={confirmedLinks[0].url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-tertiary btn-xs shrink-0"
        >
          {confirmedLinks[0].name} 열기
        </a>
      </li>
    </ul>

    <!-- 마무리 배너 — 1:1 상담문의(주) + 편집 원칙(보조), 딥그린 한 면 -->
    <div class="cta-band mt-5" data-contact-banner>
      <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
        <div>
          <p class="mono text-[12px] tracking-[0.01em] text-[#c9e6dd]">{site.contact.label}</p>
          <h3 class="mt-2 max-w-[28ch] text-[19px] font-bold leading-[1.4] tracking-[-0.03em] text-white md:text-[24px]">
            내 숫자를 어디서부터 손봐야 할지, 함께 짚어 드립니다.
          </h3>
          <p class="mt-2 max-w-[52ch] text-[12.5px] leading-[1.7] text-[#cfe4dc]">
            연금·세액공제·현금흐름·보장을 한자리에 놓고, 지금 확인해야 할 순서를 정리해 드립니다.
          </p>
        </div>
        <div class="w-full md:w-auto">
          <a
            href={site.contact.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn cta-outline w-full md:w-auto"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 4c-4.4 0-8 2.6-8 5.8 0 2 1.3 3.8 3.4 4.9-.2.7-.7 2.3-.8 2.7 0 .3.2.4.4.3.4-.2 2.3-1.6 3-2.1.6.1 1.3.1 2 .1 4.4 0 8-2.6 8-5.9S16.4 4 12 4Z" />
            </svg>
            {site.contact.label}
          </a>
          <a
            href={withBase("/principles")}
            class="mt-1 inline-flex min-h-[44px] w-full items-center justify-center gap-1.5 text-[12.5px] font-semibold text-[#cfe4dc] underline decoration-[#cfe4dc]/40 underline-offset-4 hover:text-white hover:decoration-white md:justify-end"
          >
            글과 도구를 만드는 기준 — 편집 원칙
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <p class="mt-2 text-[12px] text-ink-faint">
      <a href={withBase("/privacy")} class="link">개인정보처리방침</a> · 문의 채널은 카카오톡 1:1 대화로 열립니다.
      기준일 {site.baseDateLabel}
    </p>
  </div>
</section>
