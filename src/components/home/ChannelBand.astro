---
/**
 * 홈 6영역 — SNS 채널 연결 밴드 + 마무리 1:1 상담문의 배너(Handlus 스타일).
 * v7.1 — 내부 기획 용어(사이트를 '거점'이라 부르던 표현)를 걷어내고 방문자에게 읽히는 말로 바꿨다.
 *
 * 상담문의는 3순위(Tertiary) 위계다. 배너 문구는 '무엇을 함께 보는지'로 적는다.
 * v5.8에서 편집 원칙 배너로 바뀌었고, v5.8.2(2026-11-21)에서 사용자 선택으로 1:1 상담문의를 되살리며
 * 편집 원칙 링크를 배너 안 보조 링크로 남겼다. 배너는 딥그린 한 면 — 페이지의 마지막 색 장면이다.
 */
import { withBase, site } from "@/config/site";
import { confirmedLinks } from "@/data/channels";
---

<section class="scene-white border-b border-line" data-area="6" id="channels">
  <div class="wrap py-10 md:py-14">
    <div class="sec-head">
      <div>
        <p class="eyebrow">소식 · SNS · 확인된 링크 {confirmedLinks.length}곳</p>
        <h2 class="sec-title">짧은 소식은 각 채널에서,<br />기록은 이곳에</h2>
      </div>
      <div class="sec-head-side">
        <p class="sec-desc">
          긴 글과 기록은 이곳에 남깁니다. 짧은 소식은 SNS에서 만나요.<br />
          주소가 확인된 채널만 링크로 열어 둡니다(아래 {confirmedLinks.length}곳).
        </p>
      </div>
    </div>

    <!-- v8.7.0 — 주소가 없는 SNS 이름을 늘어놓지 않는다(감사 보고 'SNS 이름 나열 숨김').
         확인된 링크만 카드로 두고, 나머지는 링크가 생길 때 이 자리에 붙인다. -->
    <ul class="mt-5 grid gap-2 sm:grid-cols-2" data-channel-list>
      {
        confirmedLinks.map((l) => (
          <li class="flex items-center justify-between gap-3 rounded-xl border border-line bg-white px-3.5 py-2">
            <span class="min-w-0">
              <span class="block text-[13.5px] font-semibold text-ink">{l.name}</span>
              <span class="block truncate text-[12px] text-ink-muted">{l.note}</span>
            </span>
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn btn-tertiary btn-xs shrink-0">
              열기
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-2 text-[12px] leading-[1.7] text-ink-faint">
      SNS 채널 주소는 확인되는 대로 이 자리에 링크로 엽니다. 주소를 확인하지 못한 채널은 이름만 걸어 두지 않습니다.
    </p>

    <!-- 마무리 배너 — 1:1 상담문의(주) + 편집 원칙(보조), 딥그린 한 면 -->
    <div class="cta-band mt-5" data-contact-banner>
      <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
        <div>
          <p class="mono text-[12px] tracking-[0.01em] text-[#c9d1e6]">{site.contact.label}</p>
          <h3 class="mt-2 max-w-[28ch] text-[19px] font-bold leading-[1.4] tracking-[-0.03em] text-white md:text-[24px]">
            내 숫자를 어디서부터 손봐야 할지, 함께 짚어 드립니다.
          </h3>
          <p class="mt-2 max-w-[52ch] text-[12.5px] leading-[1.7] text-[#cfd5e4]">
            연금·세액공제·현금흐름·보장을 한자리에 놓고, 지금 확인해야 할 순서를 정리해 드립니다.
          </p>
        </div>
        <div class="w-full md:w-auto">
          <a
            href={site.contact.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn cta-outline w-full md:w-auto"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 4c-4.4 0-8 2.6-8 5.8 0 2 1.3 3.8 3.4 4.9-.2.7-.7 2.3-.8 2.7 0 .3.2.4.4.3.4-.2 2.3-1.6 3-2.1.6.1 1.3.1 2 .1 4.4 0 8-2.6 8-5.9S16.4 4 12 4Z" />
            </svg>
            {site.contact.label}
          </a>
          <a
            href={withBase("/principles")}
            class="mt-1 inline-flex min-h-[44px] w-full items-center justify-center gap-1.5 text-[12.5px] font-semibold text-[#cfd5e4] underline decoration-[#cfd5e4]/40 underline-offset-4 hover:text-white hover:decoration-white md:justify-end"
          >
            글과 도구를 만드는 기준 — 편집 원칙
          </a>
        </div>
      </div>
    </div>

    <p class="mt-2 text-[12px] text-ink-faint">
      <a href={withBase("/privacy")} class="link">개인정보처리방침</a> · 문의 채널은 카카오톡 1:1 대화로 열립니다.
    </p>
  </div>
</section>
