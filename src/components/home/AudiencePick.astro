---
/**
 * 상황별 맞춤 큐레이션 — 2026-11-25 깃밥 벤치마킹 1항 (홈 첫 화면 아래).
 *
 * 방문자가 자기 상황(사회초년생 · 직장인·가장 · 은퇴준비)을 한 번 누르면
 * 그 상황의 계산기와 글이 바로 바뀐다. 무거운 팝업을 띄우지 않고, 필름 아래 흐름 안에 놓는다.
 *
 * 동작 방식
 *  · 라디오 3개 + CSS `:checked`로 패널을 바꾼다 — 자바스크립트가 없어도 선택이 된다.
 *  · 자바스크립트는 고른 값을 `localStorage`(bk-audience)에 남기고, 다시 열면 그 값을 되살린다.
 *  · 패널 셋을 모두 서버에서 그린다(숨은 패널도 링크는 살아 있음). 없는 글·도구를 가리키면 여기서 빌드가 선다.
 */
import { withBase } from "@/config/site";
import { AUDIENCES, DEFAULT_AUDIENCE } from "@/data/audience";
import { hubTools } from "@/data/tools";
import { depthOfPost, depthOfTool } from "@/data/depth";
import { allPosts, postPath, categoryLabel } from "@/lib/posts";
import DepthMark from "@/components/DepthMark.astro";

const posts = await allPosts();
const postById = new Map(posts.map((p) => [p.id, p]));
const toolByKey = new Map(hubTools.map((t) => [t.key, t]));

/** 추천 목록이 실제 발행물·도구를 가리키는지 빌드에서 확인한다 */
for (const audience of AUDIENCES) {
  for (const key of audience.tools) {
    if (!toolByKey.has(key)) {
      throw new Error(`상황별 추천(${audience.id})이 없는 도구 "${key}"를 가리킵니다. src/data/audience.ts를 확인하세요.`);
    }
  }
  for (const slug of audience.posts) {
    if (!postById.has(slug)) {
      throw new Error(`상황별 추천(${audience.id})이 발행되지 않은 글 "${slug}"을 가리킵니다. src/data/audience.ts를 확인하세요.`);
    }
  }
}

const panels = AUDIENCES.map((audience) => ({
  audience,
  tools: audience.tools.map((key) => toolByKey.get(key)!),
  posts: audience.posts.map((slug) => postById.get(slug)!),
}));
---

<section class="scene-cream border-b border-line" id="start" aria-labelledby="start-title" data-audience-pick>
  <div class="wrap py-9 md:py-12">
    <div class="aud-head">
      <h2 id="start-title" class="sec-title">내 상황에 맞는 계산과 기록</h2>
      <p class="sec-desc">
        셋 중 하나를 고르면 이 자리의 추천이 바로 바뀝니다. 고른 값은 이 브라우저에만 남습니다.
      </p>
    </div>

    <fieldset class="aud">
      <legend class="sr-only">내 상황</legend>
      {
        AUDIENCES.map((audience) => (
          <input
            class="aud-radio"
            type="radio"
            name="audience"
            id={`aud-${audience.id}`}
            value={audience.id}
            checked={audience.id === DEFAULT_AUDIENCE}
            data-aud-radio
          />
        ))
      }

      <div class="aud-bar">
        {
          AUDIENCES.map((audience) => (
            <label class="aud-option" for={`aud-${audience.id}`}>
              {audience.label}
            </label>
          ))
        }
      </div>

      <div class="aud-panels">
        {
          panels.map(({ audience, tools, posts: picked }) => (
            <div class="aud-panel" data-aud={audience.id}>
              <p class="aud-summary">{audience.summary}</p>

              <div class="aud-cols">
                <div class="aud-col">
                  <p class="aud-col-head">먼저 계산</p>
                  <ul class="aud-list">
                    {tools.map((tool) => (
                      <li>
                        <a class="aud-tool" href={withBase(tool.runHref ?? tool.href)}>
                          <span class="aud-item-body">
                            <span class="aud-item-name">{tool.name}</span>
                            <span class="aud-item-note">{tool.short}</span>
                          </span>
                          {depthOfTool(tool.key) && <DepthMark depth={depthOfTool(tool.key)!} />}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="aud-col">
                  <p class="aud-col-head">먼저 읽기</p>
                  <ul class="aud-list">
                    {picked.map((post) => (
                      <li>
                        <a class="aud-post" href={withBase(postPath(post))}>
                          <span class="aud-item-body">
                            <span class="aud-item-cat">{categoryLabel(post)}</span>
                            <span class="aud-item-name">{post.data.title}</span>
                          </span>
                          <span class="aud-post-foot">
                            <span class="aud-min mono">{post.data.readingMinutes}분</span>
                            <DepthMark depth={depthOfPost({ id: post.id, readingMinutes: post.data.readingMinutes })} />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </fieldset>
  </div>
</section>

<style>
  .aud-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .aud-head .sec-desc {
    max-width: 46ch;
  }

  .aud {
    position: relative;
    min-inline-size: 0;
    margin: 16px 0 0;
    padding: 0;
    border: 0;
  }

  /* 라디오는 화면에서 감추되 포커스는 받는다 — 키보드 화살표로 상황을 바꾼다 */
  .aud-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .aud-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .aud-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft),
      color 160ms var(--ease-out-soft);
  }

  .aud-option:active {
    border-color: var(--color-ink);
  }

  .aud-option:hover {
    border-color: var(--color-ink-faint);
    color: var(--color-ink);
  }

  #aud-starter:checked ~ .aud-bar [for="aud-starter"],
  #aud-worker:checked ~ .aud-bar [for="aud-worker"],
  #aud-retiree:checked ~ .aud-bar [for="aud-retiree"] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface);
  }

  #aud-starter:focus-visible ~ .aud-bar [for="aud-starter"],
  #aud-worker:focus-visible ~ .aud-bar [for="aud-worker"],
  #aud-retiree:focus-visible ~ .aud-bar [for="aud-retiree"] {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .aud-panels {
    margin-top: 12px;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  .aud-panel {
    display: none;
  }

  #aud-starter:checked ~ .aud-panels [data-aud="starter"],
  #aud-worker:checked ~ .aud-panels [data-aud="worker"],
  #aud-retiree:checked ~ .aud-panels [data-aud="retiree"] {
    display: block;
  }

  .aud-summary {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-ink-soft);
    word-break: keep-all;
  }

  .aud-cols {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .aud-panels {
      padding: 20px;
    }

    .aud-cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
      margin-top: 16px;
    }
  }

  .aud-col-head {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-ink);
  }

  .aud-list {
    display: flex;
    flex-direction: column;
  }

  .aud-list > li + li {
    border-top: 1px solid var(--color-line-soft);
  }

  .aud-tool,
  .aud-post {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
    padding: 8px 2px;
  }

  .aud-item-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .aud-item-name {
    font-size: 13px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    word-break: keep-all;
  }

  .aud-tool:active .aud-item-name,
  .aud-post:active .aud-item-name,
  .aud-tool:hover .aud-item-name,
  .aud-post:hover .aud-item-name {
    color: var(--color-brand-deep);
  }

  .aud-item-note {
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  .aud-item-cat {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink-faint);
  }

  .aud-post-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex: none;
  }

  .aud-min {
    font-size: 12px;
    color: var(--color-ink-faint);
  }
</style>

<script>
  /*
   * 고른 상황을 이 브라우저에 남긴다(쿠키·서버 전송 없음).
   * 저장된 값이 있으면 다시 열었을 때 그 상황으로 시작한다.
   */
  const KEY = "bk-audience";
  const root = document.querySelector<HTMLElement>("[data-audience-pick]");

  if (root) {
    const radios = [...root.querySelectorAll<HTMLInputElement>("[data-aud-radio]")];

    try {
      const saved = window.localStorage.getItem(KEY);
      const match = radios.find((radio) => radio.value === saved);
      if (match) match.checked = true;
    } catch {
      /* 저장소를 막은 브라우저에서는 기본값으로 둔다 */
    }

    for (const radio of radios) {
      radio.addEventListener("change", () => {
        if (!radio.checked) return;
        try {
          window.localStorage.setItem(KEY, radio.value);
        } catch {
          /* 저장하지 못해도 이번 화면의 선택은 그대로 동작한다 */
        }
      });
    }
  }
</script>
