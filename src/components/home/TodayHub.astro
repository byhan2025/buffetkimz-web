---
/**
 * 홈 최상단 '오늘 확인 허브' — v5.9.
 *
 * 브랜드 필름(1P) 아래, 순수 소개(2P) 위. 필름을 가리지 않고 '오늘 무엇을 확인할지'만 남긴다.
 *
 * 순서 (390px 포함 동일)
 *   ① 기준 시각 한 줄 → ② 지표 스트립 → ③ 오늘의 핵심 3줄 → ④ 세로 '오늘 확인할 것' 최대 3건
 *   → ⑤ 대표 도구 바로가기 1개
 *
 * 이 블록 안에는 상담·가입 CTA를 두지 않는다. 링크는 카드마다 도구 1 + 출처 1까지.
 */
import { withBase, site } from "@/config/site";
import { today as hub, hubBasisLine } from "@/data/today";
import { asOfLabel, clockLabel, freshnessOf } from "@/lib/fresh";
import { ddayOf, isUpcoming } from "@/lib/dday";

/** 배지는 빌드 시각으로 정한다 — 배포 뒤 시간이 지나면 '확인 지연'으로 바뀐다. */
const buildNow = new Date();
const fresh = freshnessOf({ asOf: hub.asOf, nextCheckAt: hub.nextCheckAt }, buildNow);

/** AI 요약은 라벨 · 기준 시각 · 원문 링크가 모두 있을 때만 그린다. */
const ai = hub.ai && hub.ai.label && hub.ai.asOfLabel && hub.ai.sourceUrl ? hub.ai : null;

const items = hub.items.slice(0, 3).map((item) => ({
  ...item,
  fresh: freshnessOf(item, buildNow),
  dday: item.dueDate ? ddayOf(item.dueDate, site.today) : undefined,
}));

const dirClass = (d: "up" | "down" | "flat") =>
  d === "down" ? "ind-change is-down" : d === "up" ? "ind-change is-up" : "ind-change";

const ddayClass: Record<string, string> = {
  later: "dday dday--later",
  soon: "dday dday--soon",
  near: "dday dday--near",
  today: "dday dday--near",
  past: "dday dday--later",
};
---

<section
  class="scene-white border-b border-line"
  data-area="hub"
  data-hub
  data-fresh={fresh.state}
  aria-labelledby="hub-title"
  id="today"
>
  <div class="wrap py-9 md:py-12">
    <div class="hub-head">
      <div>
        <p class="eyebrow">오늘 확인 허브</p>
        <h2 id="hub-title" class="sec-title">오늘 확인할 것</h2>
      </div>
      <div class="hub-head-side">
        <p class="hub-basis mono" data-hub-basis>{hubBasisLine(hub)}</p>
        {fresh.state === "ok" ? (
          <p class="hub-next mono">다음 확인 {clockLabel(hub.nextCheckAt)}</p>
        ) : (
          <p class={`hub-fresh hub-fresh--${fresh.state}`} role="status" data-fresh-badge={fresh.state}>
            <span class="hub-fresh-label">{fresh.label}</span>
            <span class="hub-fresh-detail">{fresh.detail}</span>
          </p>
        )}
      </div>
    </div>

    {/* ② 지표 스트립 — 지표마다 기준 시각·출처가 다르다 */}
    <div class="mt-4" data-indicator-strip>
      <ul class="ind-strip no-scrollbar" aria-label="오늘의 지표">
        {
          hub.indicators.map((ind) => (
            <li>
              <a
                class="ind-chip"
                href={ind.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-indicator={ind.id}
                title={`${ind.name} ${ind.value} ${ind.change} · ${ind.asOfLabel} · ${ind.source}${ind.basis ? ` (${ind.basis})` : ""}`}
              >
                <span class="ind-name">{ind.name}</span>
                <span class="ind-row">
                  <span class="ind-value">{ind.value}</span>
                  <span class={dirClass(ind.direction)}>{ind.change}</span>
                </span>
                <span class="ind-meta mono">
                  {ind.asOfLabel}
                  <span class="ind-source">{ind.source}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-1.5 text-[11.5px] leading-[1.6] text-ink-faint">{hub.stripNote}</p>
    </div>

    <div class="hub-mid mt-4">
      {/* ③ 오늘의 핵심 3줄 */}
      <div class="hub-brief" data-hub-brief>
      <p class="hub-label">30초 요약</p>
      <ol class="hub-brief-list">
        {
          hub.highlights.map((h, i) => (
            <li>
              <span class="hub-brief-no mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="hub-brief-text">{h.text}</span>
              <span class="hub-brief-meta mono">{h.meta}</span>
            </li>
          ))
        }
      </ol>
    </div>

      {/* AI 요약 — 3종 세트(라벨·기준 시각·원문 링크)가 모두 있을 때만 */}
      {
        ai && (
          <div class="hub-ai" data-hub-ai>
          <div class="hub-ai-head">
            <span class="hub-ai-label">{ai.label}</span>
            <span class="mono text-[11.5px] text-ink-faint">{ai.asOfLabel}</span>
            <a
              class="hub-ai-source link mono text-[11.5px]"
              href={ai.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              원문 보기
            </a>
          </div>
          <ul class="hub-ai-lines">
            {ai.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
            <p class="hub-ai-note">
              {ai.note} <span class="text-ink-faint">원문: {ai.sourceLabel}</span>
            </p>
          </div>
        )
      }
    </div>

    {/* ④ 오늘 확인할 것 — 세로 최대 3건 */}
    <ol class="hub-items mt-4" data-hub-items>
      {
        items.map((item) => (
          <li class="hub-item" data-hub-item={item.id} data-fresh={item.fresh.state}>
            <div class="hub-item-head">
              <span class="hub-kind">{item.kind}</span>
              {item.dday && isUpcoming(item.dueDate as string, site.today) && (
                <>
                  <span class={ddayClass[item.dday.tone]} aria-label={item.dday.aria}>
                    {item.dday.label}
                  </span>
                  <span class="mono text-[11px] text-ink-faint">{item.dday.dateLabel}</span>
                </>
              )}
              <span class="hub-item-asof mono">기준 {asOfLabel(item.asOf, false)}</span>
            </div>
            <h3 class="hub-item-title">{item.title}</h3>
            <p class="hub-item-why">{item.why}</p>
            <ul class="hub-item-points">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="hub-item-foot">
              {item.toolHref && (
                <a class="btn btn-secondary btn-xs" href={withBase(item.toolHref)} data-hub-tool-link>
                  {item.toolLabel}
                </a>
              )}
              <a
                class="hub-item-source"
                href={item.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-hub-source
              >
                근거: {item.sourceLabel}
              </a>
            </div>
            {item.basis && <p class="hub-item-basis">{item.basis}</p>}
            {item.fresh.state !== "ok" && (
              <p class={`hub-fresh hub-fresh--${item.fresh.state}`} role="status">
                <span class="hub-fresh-label">{item.fresh.label}</span>
                <span class="hub-fresh-detail">{item.fresh.detail}</span>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    {/* ⑤ 대표 도구 — 이 블록에서 도구로 가는 큰 버튼 하나 */}
    <div class="hub-tool mt-3" data-hub-tool>
      <div class="hub-tool-body">
        <p class="hub-label">대표 도구</p>
        <p class="hub-tool-name">{hub.tool.label}</p>
        <p class="hub-tool-note">{hub.tool.note}</p>
      </div>
      <a class="btn btn-primary hub-tool-cta" href={withBase(hub.tool.href)}>
        {hub.tool.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <p class="hub-notice">{hub.notice}</p>
  </div>
</section>
