---
/**
 * 홈 '금융 포털' 허브 — v7.0.
 *
 * 브랜드 필름(1P) 아래, 소개(2P) 위. 브리프의 종합 금융포털 4대 모듈을 이 한 구역에 담는다.
 *   ① 마켓 보드 — 핵심 6지표 + 그 밖의 지표(변동 흐름 스파크라인)
 *   ② 이번 주 돈의 일정 D-Day 3건
 *   ③ 지금 바로 쓰는 시뮬레이터 TOP 3
 *   ④ 분야별 30초 브리핑 탭 피드(투자·연금 / 절세·세법 / 보험·리스크)
 * 그 아래에 '오늘 확인할 것' 3건과 대표 도구 하나를 둔다.
 *
 * 지키는 것
 *  · 값·기한·출처는 전부 `data/today.ts`·`pulse.ts`·`store.ts`에서 온다(화면에서 숫자를 만들지 않는다).
 *  · 지표마다 기준 시각이 다르고, 등락률의 분모는 전일 종가·직전 고시다.
 *  · 신선도는 빌드 시각과 브라우저 시각 양쪽에서 같은 규칙(lib/fresh.ts)으로 다시 계산한다.
 *  · 자동 갱신이 아직 붙지 않았으므로('수동 확인') 하루 3회 갱신을 약속하지 않는다.
 */
import { withBase, site } from "@/config/site";
import { today as hub, hubBasisLine, hubNotice } from "@/data/today";
import { asOfLabel, clockLabel, freshnessOf } from "@/lib/fresh";
import { ddayOf, isUpcoming } from "@/lib/dday";
import { galleryCount, gallerySlideCount } from "@/data/gallery";
import { calendar } from "@/data/calendar";
import MarketBoard from "@/components/home/MarketBoard.astro";
import SimTop3 from "@/components/home/SimTop3.astro";
import BriefTabs from "@/components/home/BriefTabs.astro";

/** 배지는 빌드 시각으로 정한다 — 배포 뒤 시간이 지나면 '확인 지연'으로 바뀐다. */
const buildNow = new Date();
const fresh = freshnessOf(
  {
    asOf: hub.asOf,
    nextCheckAt: hub.nextCheckAt,
    staleAfterDays: hub.staleAfterDays,
    status: hub.status ?? "ok",
    lastGoodAsOf: hub.lastGoodAsOf,
    scheduleConnected: hub.scheduleConnected,
  },
  buildNow
);

/** AI 요약은 라벨 · 기준 시각 · 원문 링크가 모두 있을 때만 그린다. */
const ai = hub.ai && hub.ai.label && hub.ai.asOfLabel && hub.ai.sourceUrl ? hub.ai : null;

const items = hub.items.slice(0, 3).map((item) => ({
  ...item,
  fresh: freshnessOf(
    { ...item, staleAfterDays: hub.staleAfterDays, scheduleConnected: hub.scheduleConnected },
    buildNow
  ),
  dday: item.dueDate ? ddayOf(item.dueDate, site.today) : undefined,
}));

/**
 * v8.7.0 — 허브와 금융 달력의 같은 사건을 두 번 쓰지 않는다(감사 D11·G4).
 *   허브 항목의 기한(dueDate)과 `calendar.ts` 항목의 기한이 같으면 허브는 달력 제목을 한 줄로 인용하고,
 *   카드 본문은 달력에 없는 항목에만 쓴다. 문장을 새로 쓰지 않으므로 숫자가 서로 다른 말을 할 수 없다.
 */
const calendarByDue = new Map<string, (typeof calendar)[number]>();
for (const entry of calendar) {
  if (!entry.dueDate) continue;
  const picked = calendarByDue.get(entry.dueDate);
  // 같은 기한이 둘이면 달력에서 `key`로 표시한 대표 사건을 인용한다(12/31: 연금 마감 > 보장성 한도).
  if (!picked || (!picked.key && entry.key)) calendarByDue.set(entry.dueDate, entry);
}
const citedItems = items
  .map((item) => ({ item, entry: item.dueDate ? calendarByDue.get(item.dueDate) : undefined }))
  .filter((row) => Boolean(row.entry));
const calendarCards = items.filter((item) => !(item.dueDate && calendarByDue.has(item.dueDate)));

const ddayClass: Record<string, string> = {
  later: "dday dday--later",
  soon: "dday dday--soon",
  near: "dday dday--near",
  today: "dday dday--near",
  past: "dday dday--later",
};
---

<section
  class="scene-white border-b border-line"
  data-area="hub"
  data-hub
  data-fresh={fresh.state}
  data-as-of={hub.asOf}
  data-next-check-at={hub.nextCheckAt}
  data-stale-days={String(hub.staleAfterDays)}
  data-status={hub.status ?? "ok"}
  data-last-good-as-of={hub.lastGoodAsOf ?? ""}
  data-schedule-connected={String(hub.scheduleConnected)}
  aria-labelledby="hub-title"
  id="today"
>
  <div class="wrap py-9 md:py-12">
    <div class="hub-head" data-guide="hub">
      <div>
        <p class="eyebrow">금융 포털 · 오늘</p>
        <h2 id="hub-title" class="sec-title">오늘의 시장과<br />확인할 것</h2>
      </div>
      <div class="hub-head-side">
        {/* v7.2 — 홈에서 자료앨범으로 바로 가는 문. 첫 스크롤에서 눈에 먼저 들어오게 맨 위에 둔다. */}
        <a class="hub-gallery" href={withBase("/gallery")} data-hub-gallery>
          <span class="hub-gallery-body">
            <span class="hub-gallery-kicker">자료앨범</span>
            <span class="hub-gallery-note">카드뉴스·체크리스트 {galleryCount}세트 {gallerySlideCount}장 — 바로 내려받기</span>
          </span>
          <span class="hub-gallery-go" aria-hidden="true">→</span>
        </a>
        {/* v7.2 — 홈 상단에서 대메뉴 네 곳(자산리포트·앱스토어·골든타임·자료앨범)으로 바로 가는 줄 */}
        <ul class="hub-quicknav" aria-label="주요 메뉴 바로가기">
          <li><a href={withBase("/posts")}>자산리포트</a></li>
          <li><a href={withBase("/apps")}>앱스토어</a></li>
          <li><a href={withBase("/calendar")}>골든타임</a></li>
        </ul>
        <p class="hub-basis mono" data-hub-basis>{hubBasisLine(hub)}</p>
        {hub.updatedAtLabel && (
          <p class="hub-updated mono" data-hub-updated>
            업데이트 {hub.updatedAtLabel}
          </p>
        )}
        {hub.scheduleConnected ? (
          <p class="hub-next mono" data-hub-next hidden={fresh.state !== "ok"}>
            다음 확인 {clockLabel(hub.nextCheckAt)}
          </p>
        ) : (
          <p class="hub-next mono" data-hub-schedule-note>
            정기 자동 갱신 연결 준비 중
          </p>
        )}
        <p
          class={`hub-fresh hub-fresh--${fresh.state}`}
          role="status"
          data-fresh-badge={fresh.state}
          hidden={fresh.state === "ok"}
        >
          <span class="hub-fresh-label">{fresh.label}</span>
          <span class="hub-fresh-detail">{fresh.detail}</span>
        </p>
      </div>
    </div>

    {/* 모바일 모듈 격자 — 네 모듈로 바로 건너뛰는 2×2 타일(넓은 화면에서는 숨김) */}
    <ul class="hub-modgrid" aria-label="오늘의 포털 모듈">
      <li>
        <a href="#mod-market" data-mod="market">
          <span class="hub-modgrid-name">시장 지표</span>
          <span class="hub-modgrid-note">코스피 · 환율 · 금리</span>
        </a>
      </li>
      <li>
        <a href={withBase("/calendar")} data-mod="money">
          <span class="hub-modgrid-name">돈의 일정</span>
          <span class="hub-modgrid-note">
            {items.filter((i) => i.dday).map((i) => (i.dday as NonNullable<typeof i.dday>).label).join(" · ") || "기한 3건"}
          </span>
        </a>
      </li>
      <li>
        <a href="#mod-sim" data-mod="sim">
          <span class="hub-modgrid-name">시뮬레이터</span>
          <span class="hub-modgrid-note">세액 · 은퇴 · 계획</span>
        </a>
      </li>
      <li>
        <a href="#mod-brief" data-mod="brief">
          <span class="hub-modgrid-name">브리핑</span>
          <span class="hub-modgrid-note">투자 · 절세 · 보험</span>
        </a>
      </li>
    </ul>

    {/* ① 마켓 보드 — 핵심 6지표 + 변동 흐름 */}
    <div class="mt-4" data-indicator-strip>
      <MarketBoard />
    </div>

    {/* ②③④ — 모듈+사이드(8:4). 모바일은 모듈 격자 */}
    <div class="hub-layout mt-4">
      <div class="hub-main">
        <div class="hub-brief" data-hub-brief>
        <div class="hub-brief-head">
          <p class="hub-label">30초 요약</p>
          <button type="button" class="hub-copy" data-hub-copy aria-label="오늘 확인 3줄을 복사">
            3줄 복사
          </button>
        </div>
        <ol class="hub-brief-list">
          {
            hub.highlights.map((h, i) => (
              <li data-brief-line={i + 1} data-brief-text={h.text} data-brief-meta={h.meta}>
                <span class="hub-brief-no mono" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="hub-brief-text">{h.text}</span>
                <span class="hub-brief-meta mono">
                  {h.meta}
                  {h.sourceUrl && (
                    <a
                      class="hub-brief-src"
                      href={h.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${h.text} — 1차 출처 열기`}
                    >
                      원문
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ol>
        {
          ai && (
            <div class="hub-ai" data-hub-ai>
              <div class="hub-ai-head">
                <span class="hub-ai-label">{ai.label}</span>
                <span class="mono text-[11.5px] text-ink-faint">{ai.asOfLabel}</span>
                <a
                  class="hub-ai-source link mono text-[11.5px]"
                  href={ai.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  원문 보기
                </a>
              </div>
              <ul class="hub-ai-lines">
                {ai.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <p class="hub-ai-note">
                {ai.note} <span class="text-ink-faint">원문: {ai.sourceLabel}</span>
              </p>
            </div>
          )
        }
        </div>

        {/* ④ 분야별 30초 브리핑 탭 */}
        <div class="mt-3">
          <BriefTabs />
        </div>
      </div>

      <aside class="hub-side">
        {/* v8.7.0 — '다가오는 돈의 일정' 카드 3장은 아래 '오늘 확인할 것'의 달력 인용 1줄과 같은 사건이라 내렸다. */}
        <SimTop3 />
      </aside>
    </div>

    {/* 오늘 확인할 것 — 기한은 달력에서 한 줄로 인용하고, 카드는 달력에 없는 항목만 남긴다(v8.7.0) */}
    <div class="hub-items-head">
      <h3 class="hub-items-title">오늘 확인할 것</h3>
      <p class="mono hub-items-note">기한·금액·출처를 함께 남깁니다</p>
    </div>

    {
      citedItems.length > 0 && (
        <ul class="hub-cites mt-3" data-hub-calendar-cites aria-label="기한이 있는 일정 — 골든타임에서 인용">
          {citedItems.map(({ item, entry }) => {
            const dday = item.dday;
            return (
              <li data-hub-calendar-cite={item.id}>
                <a href={withBase(`/calendar#m${entry!.month}`)} class="hub-cite-link">
                  {dday && isUpcoming(item.dueDate as string, site.today) && (
                    <span class={ddayClass[dday.tone]} aria-label={dday.aria}>
                      {dday.label}
                    </span>
                  )}
                  <span class="hub-cite-title">{entry!.title}</span>
                  <span class="mono hub-cite-when">{entry!.when}</span>
                  <span class="hub-cite-go" aria-hidden="true">
                    골든타임 →
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    {
      calendarCards.length > 0 && (
        <ol class="hub-items mt-3" data-hub-items>
          {calendarCards.map((item) => (
          <li
            class="hub-item"
            data-hub-item={item.id}
            data-fresh={item.fresh.state}
            data-as-of={item.asOf}
            data-next-check-at={item.nextCheckAt}
            data-stale-days={String(hub.staleAfterDays)}
            data-status={item.status}
            data-last-good-as-of={item.lastGoodAsOf ?? ""}
          >
            <div class="hub-item-head">
              <span class="hub-kind">{item.kind}</span>
              {item.dday && isUpcoming(item.dueDate as string, site.today) && (
                <>
                  <span class={ddayClass[item.dday.tone]} aria-label={item.dday.aria}>
                    {item.dday.label}
                  </span>
                  <span class="mono text-[11px] text-ink-faint">{item.dday.dateLabel}</span>
                </>
              )}
              <span class="hub-item-asof mono">확인 {asOfLabel(item.asOf, false)}</span>
            </div>
            <h3 class="hub-item-title">{item.title}</h3>
            <p class="hub-item-why">{item.why}</p>
            <ul class="hub-item-points">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="hub-item-foot">
              {item.toolHref && (
                <a class="btn btn-secondary btn-xs" href={withBase(item.toolHref)} data-hub-tool-link>
                  {item.toolLabel}
                </a>
              )}
              <a
                class="hub-item-source"
                href={item.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-hub-source
                title={`${item.publishedAt ? `발행 ${item.publishedAt} · ` : ""}수집 ${asOfLabel(item.fetchedAt)}`}
              >
                근거: {item.sourceLabel}
              </a>
            </div>
            {item.basis && <p class="hub-item-basis">{item.basis}</p>}
            <p
              class={`hub-fresh hub-fresh--${item.fresh.state}`}
              role="status"
              data-fresh-badge={item.fresh.state}
              hidden={item.fresh.state === "ok"}
            >
              <span class="hub-fresh-label">{item.fresh.label}</span>
              <span class="hub-fresh-detail">{item.fresh.detail}</span>
            </p>
          </li>
          ))}
        </ol>
      )
    }

    {/* 대표 도구 — 이 구역에서 도구로 가는 큰 버튼 하나 */}
    <div class="hub-tool mt-3" data-hub-tool>
      <div class="hub-tool-body">
        <p class="hub-label">대표 도구</p>
        <p class="hub-tool-name">{hub.tool.label}</p>
        <p class="hub-tool-note">{hub.tool.note}</p>
      </div>
      <a class="btn btn-primary hub-tool-cta" href={withBase(hub.tool.href)}>
        {hub.tool.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <p class="hub-notice" data-hub-notice>{hubNotice(hub)}</p>
  </div>
</section>

{/* v5.9.1 — 페이지 로드 시 + 1분마다 신선도 재계산 (규칙은 fresh.ts 하나) */}
<script>
  import { refreshHub } from "../../lib/hub-fresh-dom";

  const section = document.querySelector<HTMLElement>("[data-hub]");
  if (section) {
    const tick = () => refreshHub(section, new Date());
    tick();
    window.setInterval(tick, 60_000);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) tick();
    });

    /*
     * '30초 요약' 3줄 복사 — 줄 문구는 서버가 그린 li의 data-*에서 그대로 읽는다.
     * 클립보드가 막힌 브라우저에서는 임시 textarea + execCommand로 한 번 더 시도한다.
     */
    const copyBtn = section.querySelector<HTMLButtonElement>("[data-hub-copy]");
    const briefLines = [...section.querySelectorAll<HTMLElement>("[data-brief-line]")];
    const briefText = () =>
      briefLines
        .map((li) => `${li.dataset.briefLine}. ${li.dataset.briefText} — ${li.dataset.briefMeta}`)
        .join("\n");

    const legacyCopy = (text: string) => {
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    };

    if (copyBtn && briefLines.length) {
      const reset = () => window.setTimeout(() => (copyBtn.textContent = "3줄 복사"), 2200);
      copyBtn.addEventListener("click", async () => {
        const text = briefText();
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          ok = legacyCopy(text);
        }
        copyBtn.textContent = ok ? "복사했습니다" : "3줄을 길게 눌러 복사";
        reset();
      });
    }
  }
</script>
