---
/**
 * 이번 주 돈의 일정 — v7.0 홈 금융포털 2번째 모듈.
 *
 * `today.ts`의 확인 항목 중 기한(`dueDate`)이 가까운 순서로 세 건만 큰 D-Day 카드로 세운다.
 * D-Day 계산은 사이트의 다른 곳과 같은 `lib/dday.ts`를 쓴다(숫자가 화면마다 달라지지 않게).
 */
import { withBase, site } from "@/config/site";
import { today as hub } from "@/data/today";
import { ddayOf, isUpcoming } from "@/lib/dday";
import { asOfLabel } from "@/lib/fresh";

const dated = hub.items
  .filter((i) => i.dueDate)
  .map((i) => ({ item: i, dday: ddayOf(i.dueDate as string, site.today) }))
  .filter((x) => isUpcoming(x.item.dueDate as string, site.today))
  .sort((a, b) => (a.item.dueDate as string).localeCompare(b.item.dueDate as string))
  .slice(0, 3);

/** 칩의 기준 시각도 데이터에서 만든다 — 화면에 손으로 적은 시각을 두지 않는다. */
const stamp = asOfLabel(dated[0]?.item.asOf ?? hub.asOf, false);
const withinWeek = dated.filter(({ dday }) => dday.days <= 7).length;
---

<div class="wmoney" data-week-money id="mod-money">
  <div class="wmoney-head">
    <p class="wmoney-label">다가오는 돈의 일정</p>
    <a class="wmoney-all" href={withBase("/calendar")}>골든타임 전체 →</a>
  </div>
  <p class="mod-chip mono">
    기준 {stamp} · 다가오는 {dated.length}건{withinWeek > 0 && ` (7일 이내 ${withinWeek}건)`}
  </p>

  <ol class="wmoney-list">
    {
      dated.map(({ item, dday }) => (
        <li class="wmoney-item" data-due={item.dueDate}>
          <span class={`wmoney-dday tone-${dday.tone}`} aria-label={dday.aria}>
            <b>{dday.label}</b>
            <span class="mono">{dday.dateLabel}</span>
          </span>
          <span class="wmoney-body">
            <span class="wmoney-title">{item.title}</span>
            <span class="wmoney-why">{item.why}</span>
            <span class="wmoney-actions">
              {item.toolHref && (
                <a class="wmoney-tool" href={withBase(item.toolHref)}>
                  {item.toolLabel}
                  <span aria-hidden="true">→</span>
                </a>
              )}
              <a class="wmoney-src" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
                {item.sourceLabel}
              </a>
            </span>
          </span>
        </li>
      ))
    }
  </ol>

  <p class="wmoney-note">
    기한이 지나면 그해 혜택이 사라지는 항목만 모았습니다. 7일을 넘는 기한도 함께 두며, 일정은
    {site.baseDateLabel} 기준 확인값입니다.
  </p>
</div>
