---
/**
 * 홈 3영역 — 아카이브.
 *
 * 웅이아부지식 '주제·시리즈·처음 읽을 글'을 한 장에 모은다.
 *  ① 최근 기록 한 줄(신선도) ② 다루는 7대 주제 ③ 시리즈 6묶음 ④ 처음 읽을 글·자주 찾는 계산
 * 편수·제목은 전부 글 컬렉션에서 빌드 시점에 센다.
 */
import { withBase, site } from "@/config/site";
import { allPosts, postPath, formatDateShort } from "@/lib/posts";
import { categoryName } from "@/data/categories";
import { thumbOf, thumbAltOf } from "@/lib/thumbs";
import { libraryTopics, librarySeries, firstReads, frequentCalculations } from "@/data/library";
import { hubTools } from "@/data/tools";

const posts = await allPosts();
const byId = new Map(posts.map((p) => [p.id, p]));

const topics = libraryTopics.map((t) => {
  const list = posts.filter((p) => p.data.category === t.slug);
  return { ...t, count: list.length, latest: list[0] };
});

const series = librarySeries
  .map((s) => {
    const items = s.postIds.map((id) => byId.get(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
    return {
      ...s,
      items,
      minutes: items.reduce((sum, p) => sum + p.data.readingMinutes, 0),
    };
  })
  .filter((s) => s.items.length > 0);

const first = firstReads
  .map((f) => ({ ...f, post: byId.get(f.id) }))
  .filter((f): f is typeof f & { post: NonNullable<typeof f.post> } => Boolean(f.post));

const calcs = frequentCalculations
  .map((f) => ({ ...f, tool: hubTools.find((t) => t.key === f.key) }))
  .filter((f): f is typeof f & { tool: NonNullable<typeof f.tool> } => Boolean(f.tool));

const recent = posts.slice(0, 3);
const totalMinutes = posts.reduce((sum, p) => sum + p.data.readingMinutes, 0);
---

<section class="scene-cream border-b border-line" data-area="3" id="archive">
  <div class="wrap py-10 md:py-14">
    <div class="sec-head">
      <div>
        <p class="eyebrow">기록 · ARCHIVE</p>
        <h2 class="sec-title">쌓인 글을,<br />주제와 시리즈로</h2>
      </div>
      <div class="sec-head-side">
        <p class="sec-desc">
          {posts.length}편의 기록을 7개 주제와 {series.length}개 시리즈로 묶었습니다.<br />
          처음 온 사람은 '처음 읽을 글'에서, 급한 사람은 '자주 찾는 계산'에서 시작하면 됩니다.
        </p>
      </div>
    </div>

    <!-- 최근 기록 — 썸네일 카드 3장 (글만 있어 딱딱해 보이지 않게) -->
    <div class="recent-head" data-recent-strip>
      <span class="mono shrink-0 text-[12px] font-semibold text-ink-soft">최근 기록</span>
      <span class="mono hidden shrink-0 text-[12px] text-ink-faint sm:inline">
        {posts.length}편 · 약 {totalMinutes}분
      </span>
      <a href={withBase("/posts")} class="btn btn-secondary btn-xs ml-auto shrink-0">
        기록 {posts.length}편 전체
      </a>
    </div>
    <ul class="recent-cards" data-recent-cards>
      {
        recent.map((p) => (
          <li>
            <a href={withBase(postPath(p))} class="recent-card group">
              <span class="post-thumb recent-card-thumb">
                <img
                  src={withBase(thumbOf(p))}
                  alt={thumbAltOf(p)}
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="recent-card-body">
                <span class="recent-card-meta">
                  <span class="mono text-[12px] text-ink-faint">{formatDateShort(p.data.publishedAt)}</span>
                  <span class="text-[12px] font-semibold text-brand">{categoryName(p.data.category)}</span>
                </span>
                <span class="recent-card-title clamp-2">{p.data.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- 7대 주제 -->
    <div class="mt-8 flex items-baseline justify-between gap-3">
      <h3 class="text-[15px] font-bold tracking-[-0.025em] text-ink">다루는 7대 주제</h3>
      <span class="mono text-[12px] text-ink-faint">7 TOPICS · {posts.length} NOTES</span>
    </div>
    <ul class="mt-2.5 grid grid-cols-2 gap-2 lg:grid-cols-4" data-topic-grid>
      {
        topics.map((t) => (
          <li>
            <a href={`${withBase("/posts")}/${t.slug}`} class={`topic-card ${t.sub ? "is-sub" : ""}`}>
              <span class="flex items-center justify-between gap-2">
                <span class="mono text-[12px] font-semibold tracking-[0.08em] text-brand">{t.tag}</span>
                <span class="mono text-[12px] text-ink-faint">{t.count}편</span>
              </span>
              <span class="mt-2 flex items-baseline gap-2">
                <span class="text-[19px] font-bold leading-none tracking-[-0.035em] text-ink">{t.name}</span>
                {t.sub && <span class="topic-sub">서브</span>}
              </span>
              <span class="mt-1.5 block text-[12.5px] leading-[1.6] text-ink-muted">{t.line}</span>
              {t.latest && (
                <span class="mt-2 block border-t border-line-soft pt-2">
                  <span class="clamp-1 block text-[12px] text-ink-faint">최근 · {t.latest.data.title}</span>
                </span>
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a href={withBase("/posts")} class="topic-card is-all">
          <span class="flex items-center justify-between gap-2">
            <span class="mono text-[12px] font-semibold tracking-[0.08em] text-brand-deep">ALL</span>
            <span class="mono text-[12px] text-brand-deep">{posts.length}편</span>
          </span>
          <span class="mt-2 block text-[19px] font-bold leading-none tracking-[-0.035em] text-ink">전체 기록</span>
          <span class="mt-1.5 block text-[12.5px] leading-[1.6] text-ink-soft">
            날짜순 목록과 분야 탭으로 한 번에 훑습니다.
          </span>
          <span class="mt-2 inline-flex items-center gap-1 text-[12px] font-semibold text-brand-deep">
            전체 보기 <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>

    <!-- 시리즈 + 처음 읽을 글·자주 찾는 계산 -->
    <div class="mt-8 grid gap-4 lg:grid-cols-[1.12fr_0.88fr] lg:gap-6">
      <div>
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="text-[15px] font-bold tracking-[-0.025em] text-ink">시리즈로 읽기</h3>
          <span class="mono text-[12px] text-ink-faint">{series.length}개 묶음</span>
        </div>
        <ul class="mt-2.5 grid gap-2 sm:grid-cols-2" data-series-grid>
          {
            series.map((s) => (
              <li class="series-card">
                <div class="flex items-center justify-between gap-2">
                  <span class="mono text-[12px] font-semibold tracking-[0.08em] text-brand">SERIES {s.no}</span>
                  <span class="mono text-[12px] text-ink-faint">{s.items.length}편 · {s.minutes}분</span>
                </div>
                <h4 class="mt-1.5 text-[14.5px] font-bold leading-snug tracking-[-0.025em] text-ink">{s.title}</h4>
                <p class="mt-1 text-[12px] leading-[1.6] text-ink-muted">{s.line}</p>
                <ol class="mt-2 space-y-1">
                  {s.items.map((p, i) => (
                    <li>
                      <a href={withBase(postPath(p))} class="series-link">
                        <span class="mono shrink-0 text-[12px] text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
                        <span class="clamp-1 text-[12.5px] leading-snug text-ink-soft">{p.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-[15px] font-bold tracking-[-0.025em] text-ink">처음 읽을 글</h3>
            <span class="mono text-[12px] text-ink-faint">START HERE</span>
          </div>
          <ol class="mt-2.5 space-y-1.5" data-first-reads>
            {
              first.map((f, i) => (
                <li>
                  <a href={withBase(postPath(f.post))} class="curation-row">
                    <span class="post-thumb curation-thumb">
                      <img
                        src={withBase(thumbOf(f.post))}
                        alt=""
                        width="1280"
                        height="800"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="mono mt-0.5 shrink-0 text-[12px] font-semibold text-brand">{String(i + 1).padStart(2, "0")}</span>
                    <span class="min-w-0">
                      <span class="block text-[13.5px] font-bold leading-snug tracking-[-0.02em] text-ink">
                        {f.post.data.title}
                      </span>
                      <span class="mt-0.5 block text-[12px] leading-[1.6] text-ink-muted">{f.reason}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-[15px] font-bold tracking-[-0.025em] text-ink">자주 찾는 계산</h3>
            <span class="mono text-[12px] text-ink-faint">QUICK TOOLS</span>
          </div>
          <ul class="mt-2.5 space-y-1.5" data-quick-calcs>
            {
              calcs.map((c) => (
                <li>
                  <a href={withBase(c.tool.runHref ?? c.tool.href)} class="curation-row">
                    <span class="min-w-0 flex-1">
                      <span class="block text-[13.5px] font-bold leading-snug tracking-[-0.02em] text-ink">{c.tool.name}</span>
                      <span class="mt-0.5 block text-[12px] leading-[1.6] text-ink-muted">{c.reason}</span>
                    </span>
                    <span class="shrink-0 text-[12px] font-semibold text-brand-deep">열기 →</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-2 text-[12px] leading-[1.6] text-ink-faint">
            모두 가입 없이, 입력값은 브라우저 안에서만 계산합니다. 기준일 {site.baseDate}.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
