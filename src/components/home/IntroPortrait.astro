---
/**
 * v5.1 — 2페이지 '버핏킴즈 순수 소개'.
 *
 * 웅이아부지(woong2v)의 About(정체성) → Beliefs(철학) → Manifesto(약속) 흐름을
 * 버핏킴즈의 목소리로 다시 썼다. 이 화면에는 도구·계산기·시뮬레이터 이야기를 한 줄도 넣지 않는다.
 * (도구는 아래 4번째 섹션부터. 여기는 사람과 태도만.)
 *
 * 개인 신상(가족·직장·소속)은 쓰지 않는다. 확인한 방식과 다루는 범위만 적는다.
 */
import { site } from "@/config/site";

const identities = [
  {
    title: "숫자를 먼저 확인하는 기록가",
    body:
      "기억은 금방 흐려지고, 감은 자주 틀립니다. 그래서 확인한 숫자와 그 기준일을 먼저 적습니다. 기록이 쌓이면 같은 질문에 더 정확하게 답할 수 있습니다.",
  },
  {
    title: "금융과 삶의 균형을 보는 설계자",
    body:
      "숫자가 좋아도 삶이 무너지면 실패한 설계입니다. 오늘의 현금흐름과 20년 뒤의 시간표를 같은 자리에 놓고 봅니다.",
  },
  {
    title: "유행보다 원문을 믿는 탐구자",
    body:
      "요약과 전언은 빠르지만 자주 어긋납니다. 금융위·금감원·국세청·공단의 원문을 먼저 읽고, 보도자료의 표현은 원문과 대조합니다.",
  },
  {
    title: "채널의 길이에 맞게 나누는 기록",
    body:
      "같은 내용을 채널의 길이에 맞게 나눠 매일 남깁니다. 짧은 질문은 짧게, 긴 계산은 길게. 누군가의 질문이 곧 다음 글의 제목이 됩니다.",
  },
];

const beliefs = [
  {
    field: "금융",
    key: "구조",
    line: "돈이 어디서 들어와 어디로 나가는지, 그 구조를 먼저 그립니다.",
  },
  {
    field: "투자",
    key: "버티는 힘",
    line: "수익률보다 오래 견디는 힘을 봅니다. 흔들릴 때 팔지 않을 이유가 있는가.",
  },
  {
    field: "연금",
    key: "시간표",
    line: "얼마를 모으느냐보다, 언제부터 얼마를 받는지의 시간표를 정합니다.",
  },
  {
    field: "노후",
    key: "고정비",
    line: "노후의 두려움은 대개 매달 나가는 고정비에서 옵니다. 그 한 줄부터 봅니다.",
  },
  {
    field: "보험",
    key: "리스크 관리",
    line: "없애는 것이 아니라, 지급 조건과 고지 의무를 한 걸음 뒤에서 확인하는 일입니다.",
  },
];

const principles = [
  {
    title: "공식 원문 확인",
    body: "법령·감독 당국·공단의 원문을 먼저 보고, 요약은 원문과 대조한 뒤 씁니다.",
  },
  {
    title: "기준일 명시",
    body: "모든 글과 숫자에 확인한 날짜를 붙입니다. 기준일 없는 숫자는 싣지 않습니다.",
  },
  {
    title: "가정과 한계 공개",
    body: "무엇을 넣고 무엇을 넣지 못했는지(세금·수수료·물가)를 결과 옆에 함께 적습니다.",
  },
  {
    title: "영업·과장 배제",
    body: "가입 권유, 수익률 약속, '무조건' 같은 단정 표현을 쓰지 않습니다.",
  },
];
---

<section class="scene-white border-b border-line" data-area="2" id="about">
  <div class="wrap py-12 md:py-16">
    <!-- About — 어떤 사람인가 -->
    <div class="grid gap-9 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+24px)] lg:self-start">
        <p class="eyebrow">버핏킴즈는</p>
        <h2 class="mt-3 max-w-[16ch] text-[clamp(30px,4.2vw,50px)] font-bold leading-[1.14] tracking-[-0.045em] text-ink">
          숫자를 먼저 확인하고,<br />그 숫자가 삶에서<br />무엇을 뜻하는지 봅니다.
        </h2>
        <p class="mt-5 max-w-[42ch] text-[15px] leading-[1.82] text-ink-muted">
          숫자를 먼저 확인하는 기록입니다. 같은 질문을 자주 마주치고, 답은 매번 조금씩 달라집니다.
          그 차이를 기억에 두지 않고 글로 남기기 시작했습니다. 잘못 짚은 판단도 함께 남깁니다.
        </p>
        <dl class="mt-7 grid gap-2 border-t border-ink/12 pt-4 text-[12.5px] sm:grid-cols-2">
          <div class="flex items-baseline gap-2">
            <dt class="text-ink-faint">쓰는 사람</dt>
            <dd class="font-semibold text-ink">buffetkimz · 버핏킴즈</dd>
          </div>
          <div class="flex items-baseline gap-2">
            <dt class="text-ink-faint">기준일</dt>
            <dd class="mono text-ink-soft">{site.baseDate}</dd>
          </div>
        </dl>
      </div>

      <ul class="space-y-0 divide-y divide-line-soft border-y border-line-soft" data-intro-identities>
        {
          identities.map((item) => (
            <li class="py-5">
              <span class="block min-w-0">
                <span class="block text-[16px] font-bold leading-snug tracking-[-0.025em] text-ink sm:text-[17px]">
                  {item.title}
                </span>
                <span class="mt-1.5 block text-[13.5px] leading-[1.78] text-ink-muted">{item.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Beliefs — 다섯 분야를 대하는 태도 -->
    <div class="mt-12 md:mt-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink/15 pb-3">
        <p class="text-[13px] font-bold tracking-[-0.02em] text-ink">다섯 분야를 대하는 태도</p>
        <span class="mono text-[12px] text-ink-faint">금융 · 투자 · 연금 · 노후 · 보험</span>
      </div>
      <ul class="grid gap-px border-b border-line-soft bg-line-soft sm:grid-cols-2 lg:grid-cols-5" data-intro-beliefs>
        {
          beliefs.map((b) => (
            <li class="flex flex-col bg-white px-4 py-5">
              <span class="text-[13px] font-bold text-ink">{b.field}</span>
              <span class="mt-2 text-[12px] font-semibold text-brand">{b.key}</span>
              <p class="mt-2 text-[12.5px] leading-[1.72] text-ink-muted">{b.line}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Manifesto — 왜 이 공간을 만들었는가 + 편집 원칙 -->
    <div class="mt-12 grid gap-9 md:mt-16 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14">
      <div data-intro-why>
        <p class="eyebrow">왜 이 공간을 만들었는가</p>
        <h3 class="mt-3 text-[clamp(22px,2.7vw,32px)] font-bold leading-[1.24] tracking-[-0.038em] text-ink">
          확인하지 않은 말은<br />오래 쓰기 어렵습니다.
        </h3>
        <div class="mt-4 space-y-3.5 text-[14px] leading-[1.85] text-ink-muted">
          <p>
            금리가 내렸는데 왜 이자는 그대로인지, 실손을 갈아타야 하는지, 연금은 언제부터 얼마를 받는지.
            자주 마주치는 질문입니다. 답은 제도가 바뀔 때마다 달라지고, 어제의 설명이 오늘은
            틀린 말이 되기도 합니다.
          </p>
          <p>
            그래서 이곳은 결론을 먼저 말하지 않습니다. 근거가 되는 원문이 무엇인지, 그 기준일이 언제인지,
            어떤 가정 위에서 계산했는지를 먼저 적습니다. 읽는 사람이 같은 자리에서 다시 확인할 수 있게
            하는 것이 이 공간의 목적입니다.
          </p>
          <p>
            <strong class="font-semibold text-ink">특정 상품의 추천도, 가입 권유도 하지 않습니다.</strong>{" "}
            판정 대신 확인할 항목을, 약속 대신 가정과 한계를 남깁니다. 숫자는 결론이 아니라 질문입니다.
          </p>
        </div>
        <p class="mt-5 flex items-baseline gap-3 border-t border-line-soft pt-4">
          <span class="text-[12px] text-ink-faint">기록하는 사람</span>
          <span class="serif text-[24px] leading-none text-ink">buffetkimz</span>
          <span class="mono ml-auto text-[12px] text-ink-faint">{site.baseDate}</span>
        </p>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-3 border-b border-ink/15 pb-3">
          <p class="text-[13px] font-bold tracking-[-0.02em] text-ink">편집 원칙 네 가지</p>
        </div>
        <ul class="mt-1 divide-y divide-line-soft" data-intro-principles>
          {
            principles.map((p) => (
              <li class="py-3.5">
                <span class="block min-w-0">
                  <span class="block text-[14.5px] font-bold leading-snug tracking-[-0.025em] text-ink">{p.title}</span>
                  <span class="mt-1 block text-[12.5px] leading-[1.7] text-ink-muted">{p.body}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-[12px] leading-[1.7] text-ink-faint">
          이 사이트는 특정 회사의 모집 채널이 아니며, 1:1 상담문의는 가입 권유·중개가 아닌 일반 안내 창구입니다.
        </p>
      </div>
    </div>
  </div>
</section>
