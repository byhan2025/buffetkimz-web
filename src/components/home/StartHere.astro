---
/**
 * 홈 첫 화면 — 질문형 컨시어지 (v9.9.0, 2026-11-28).
 *
 * 무엇이 바뀌었나
 *  · 흰 배경의 나열형 첫 화면을 **딥 네이비 그라데이션 히어로**로 바꿨다. 첫인상의 무게와 대비를
 *    세우고, 아래 '오늘 확인 허브'(흰 종이)가 시작되는 경계를 분명히 하려는 것이다.
 *  · '3초 재무 진단'(연금·투자·절세·보험 한 단계)을 **2단계 질문형 컨시어지**로 바꿨다.
 *    ① 어떤 돈 고민인가(보험·실손 / 연금·세금 / 월급·지출 / 대출·청약) →
 *    ② 그 갈래에서 지금 내 상황에 가까운 것 → 결과 카드(계산기 1 + 글 1 + 다가오는 일정 1).
 *  · 결과 카드는 '추천·처방'이 아니라 **'지금 확인할 것'**이다. 금소법·비영업 원칙에 맞춰
 *    무엇을 먼저 확인하면 되는지만 놓는다.
 *
 * 지키는 것
 *  · h1은 홈 전체에서 이 구역 하나. 문구는 기존 확정 카피를 그대로 쓴다(새 브랜드 카피를 짓지 않는다).
 *  · 2단계는 라디오 + CSS `:checked` — 자바스크립트가 없어도 선택이 되고, 스크립트를 싣지 않는다.
 *  · 패널 열여섯 개를 모두 서버에서 그린다. 처음 상태의 추천 1세트와 갈래 이동 링크 4개가
 *    **초기 HTML에 `<a>`로 그대로** 있어, JS를 실행하지 않는 크롤러·심사자도 바로 읽는다.
 *  · 없는 계산기·글을 가리키면 빌드가 선다(data/concierge.ts를 고친다). 그래서 빈 카드가 나오지 않고,
 *    '잘 모르겠어요' 선택지는 언제나 대표 계산기·분야 목록으로 가는 기본 경로를 갖는다.
 *  · 모바일(390)에서는 이 구역이 화면을 100% 채우지 않는다 — 아래 허브 상단이 살짝 걸치게 높이를 줄인다.
 *  · 브랜드 필름 입구는 **클릭했을 때만** `#film`으로 이동한다(첫 화면에서 자동재생하지 않는다).
 */
import { withBase, site } from "@/config/site";
import { today as hub } from "@/data/today";
import { appBySlug } from "@/data/apps";
import { BRANCHES, DEFAULT_BRANCH, DEFAULT_CHOICE, resolveDue } from "@/data/concierge";
import { allPosts, postPath } from "@/lib/posts";

const all = await allPosts();
const postById = new Map(all.map((p) => [p.id, p]));
const categoryCount = (slug: string) => all.filter((p) => p.data.category === slug).length;

/**
 * 카드 아래 '출처' 한 줄.
 *  · 앱 sourceLine 끝의 '· 기준일 2026. 11. 21.'은 카드의 사이트 기준일과 겹치므로 걷어낸다.
 *  · 여러 출처를 다 적으면 좁은 화면에서 문장이 잘린다 — 첫 출처 + '외 N건'으로 줄이고,
 *    전체 목록은 도구 화면의 '기준과 출처'가 맡는다(카드에 잘린 문장을 두지 않는다).
 */
const sourceOf = (slug: string) => {
  const line = (appBySlug(slug)?.sourceLine ?? "")
    .replace(/\s*·?\s*(?:확인\s*)?기준일\s*\d{4}\.\s*\d{1,2}\.\s*\d{1,2}\.\s*$/u, "")
    .trim();
  const parts = line.split(" · ").map((p) => p.trim()).filter(Boolean);
  if (parts.length === 0) return "각 도구의 기준·출처 문서";
  return parts.length > 1 ? `${parts[0]} 외 ${parts.length - 1}건` : parts[0];
};

/**
 * 갈래·상황을 화면이 쓸 수 있는 모양으로 편다.
 * 없는 대상을 가리키면 여기서 빌드를 세운다 — 화면에 빈 카드가 남지 않는다.
 */
const branches = BRANCHES.map((branch) => {
  const due = resolveDue(branch.due, branch.dueNote, site.today);
  return {
    ...branch,
    due,
    choices: branch.choices.map((choice) => {
      if (choice.kind === "hub") {
        const app = appBySlug(choice.hub.calc);
        if (!app) throw new Error(`첫 화면 컨시어지(${branch.id}/${choice.id})가 없는 대표 계산기 "${choice.hub.calc}"를 가리킵니다.`);
        return { choice, app, posts: [] as typeof all, postsCount: categoryCount(choice.hub.postsHref.replace("/posts/", "")) };
      }
      const app = appBySlug(choice.calc);
      if (!app) throw new Error(`첫 화면 컨시어지(${branch.id}/${choice.id})가 없는 계산기 "${choice.calc}"를 가리킵니다.`);
      const post = postById.get(choice.postId);
      if (!post) throw new Error(`첫 화면 컨시어지(${branch.id}/${choice.id})가 발행되지 않은 글 "${choice.postId}"을 가리킵니다.`);
      return { choice, app, post, postsCount: 0 };
    }),
  };
});

/* 일간 머리글 — 날짜와 확인 시각은 손으로 적지 않는다(기존 홈과 같은 규칙) */
const WEEKDAYS = ["일", "월", "화", "수", "목", "금", "토"] as const;
const [baseYear, baseMonth, baseDay] = site.baseDate.split("-").map(Number);
const weekdayLabel = `${WEEKDAYS[new Date(Date.UTC(baseYear, baseMonth - 1, baseDay)).getUTCDay()]}요일`;
const checkClock = new Intl.DateTimeFormat("ko-KR", {
  timeZone: "Asia/Seoul",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date(hub.asOf));

const ddayClass: Record<string, string> = {
  later: "cq-dday is-later",
  soon: "cq-dday is-soon",
  near: "cq-dday is-near",
  today: "cq-dday is-near",
  past: "cq-dday is-later",
};
---

<section class="cq" id="start-here" aria-labelledby="start-title">
  <div class="wrap cq-wrap">
    <!-- ① 기준일·검증 배지 1줄 + 필름 입구 + 건너뛰기 출구 -->
    <div class="cq-top">
      <p class="cq-badge">
        <span class="cq-badge-dot" aria-hidden="true"></span>
        <span>기준일 <time datetime={site.baseDate}>{site.baseDateLabel}</time> {weekdayLabel}</span>
        <span class="cq-sep" aria-hidden="true">·</span>
        <span>1차 출처 확인</span>
        <span class="cq-sep" aria-hidden="true">·</span>
        <span class="mono cq-check">확인 {checkClock}</span>
      </p>
      <div class="cq-top-actions">
        <a class="cq-film" href="#film">
          <span class="cq-film-play" aria-hidden="true">▶</span>
          12초로 보는 버핏킴즈
        </a>
        <a class="cq-skip" href="#today">질문 건너뛰고 오늘 시황 보기 ↓</a>
      </div>
    </div>

    <h1 class="cq-title" id="start-title">
      받을 때 알게 되는 연금,<br />5월에 알게 되는 세금 — <span class="cq-title-em">미리 계산해 두는 곳</span>
    </h1>
    <p class="cq-lede">
      지금 걸린 돈 고민 하나를 고르면, 그 상황에 맞는 계산기와 글이 1:1로 열립니다. 고른 값은 이 브라우저에
      남기지 않습니다.
    </p>

    <!-- ② 1단계 — 생활 고민 네 갈래 -->
    <p class="cq-q" id="cq-q1"><span class="cq-step" aria-hidden="true">1</span>어떤 돈 고민을 먼저 살펴볼까요?</p>
    <fieldset class="cq-branches" aria-labelledby="cq-q1">
      <legend class="sr-only">돈 고민 갈래 — 넷 중 하나</legend>
      {
        branches.map((branch) => (
          <>
            <input
              class="cq-radio"
              type="radio"
              name="cq-branch"
              id={`cq-b-${branch.id}`}
              value={branch.id}
              checked={branch.id === DEFAULT_BRANCH}
            />
            <label class="cq-option" for={`cq-b-${branch.id}`}>
              <span class="cq-option-label">{branch.label}</span>
              <span class="cq-option-hint">{branch.hint}</span>
            </label>
          </>
        ))
      }

      <div class="cq-panels">
        {
          branches.map((branch) => (
            <div class="cq-panel" data-branch={branch.id}>
              {/* ③ 2단계 — 이 갈래에서 지금 내 상황에 가까운 것 */}
              <p class="cq-q cq-q2" id={`cq-q2-${branch.id}`}>
                <span class="cq-step" aria-hidden="true">2</span>
                지금 내 상황에 가까운 것은?
              </p>
              <fieldset class="cq-choices" aria-labelledby={`cq-q2-${branch.id}`}>
                <legend class="sr-only">{branch.label} — 상황 넷 중 하나</legend>
                {branch.choices.map((c) => (
                  <>
                    <input
                      class="cq-radio cq-radio--s"
                      type="radio"
                      name={`cq-s-${branch.id}`}
                      id={`cq-s-${c.choice.id}`}
                      value={c.choice.id}
                      checked={c.choice.id === DEFAULT_CHOICE}
                    />
                    <label class="cq-soption" for={`cq-s-${c.choice.id}`}>
                      {c.choice.label}
                    </label>
                  </>
                ))}

                {/* ④ 결과 카드 — 계산기 1 + 글 1 + 다가오는 일정 1 */}
                <div class="cq-results">
                  {branch.choices.map((c) => (
                    <article class="cq-card" data-res={c.choice.id} aria-labelledby={`cq-h-${c.choice.id}`}>
                      <h3 class="cq-card-title" id={`cq-h-${c.choice.id}`}>지금 확인할 것</h3>
                      <p class="cq-card-q">{c.choice.question}</p>

                      <ul class="cq-rows">
                        <li class="cq-row">
                          <span class="cq-row-kicker">계산기</span>
                          <a class="cq-row-link" href={withBase((c.app.runHref ?? `/apps/${c.app.slug}/run`))}>
                            <span class="cq-row-name">{c.app.name}</span>
                            <span class="cq-row-note cq-note-calc">
                              {c.choice.kind === "hub" ? c.choice.hub.calcLine : c.choice.calcLine}
                            </span>
                          </a>
                        </li>

                        <li class="cq-row">
                          <span class="cq-row-kicker">읽을 글</span>
                          {c.choice.kind === "hub" ? (
                            <a class="cq-row-link" href={withBase(c.choice.hub.postsHref)}>
                              <span class="cq-row-name">{c.choice.hub.postsNote}</span>
                              <span class="cq-row-note cq-note-post">{c.postsCount}편 · 분야별 전체 목록</span>
                            </a>
                          ) : (
                            <a class="cq-row-link" href={withBase(postPath(c.post))}>
                              <span class="cq-row-name">{c.post.data.title}</span>
                              <span class="cq-row-note cq-note-post">{c.post.data.readingMinutes}분 · 기준일 붙은 기록</span>
                            </a>
                          )}
                        </li>

                        <li class="cq-row">
                          <span class="cq-row-kicker">다가오는 일정</span>
                          <a class="cq-row-link" href={withBase(branch.due.href)}>
                            <span class="cq-row-name">
                              {branch.due.kind === "dated" && (
                                <span class={ddayClass[branch.due.dday.tone]} aria-label={branch.due.dday.aria}>
                                  {branch.due.dday.label}
                                </span>
                              )}
                              {branch.due.title}
                            </span>
                            <span class="cq-row-note cq-note-due">
                              {branch.due.kind === "dated"
                                ? `${branch.due.dday.dateLabel} · ${branch.due.note}`
                                : branch.due.kind === "month"
                                  ? `${branch.due.when} · ${branch.due.note}`
                                  : branch.due.note}
                            </span>
                          </a>
                        </li>
                      </ul>

                      <p class="cq-source">
                        <span class="cq-source-text">
                          <span class="mono">기준일 {site.baseDateLabel}</span>
                          <span aria-hidden="true"> · </span>
                          출처 {c.choice.kind === "hub" ? "각 도구의 기준·출처 문서" : sourceOf(c.choice.calc)}
                        </span>
                      </p>
                    </article>
                  ))}
                </div>
              </fieldset>
            </div>
          ))
        }
      </div>
    </fieldset>

    <!-- ⑤ 갈래별 분야 페이지 — 초기 HTML에 그대로 있는 <a> 다섯 -->
    <nav class="cq-links" aria-label="갈래별 분야 페이지">
      {
        branches.map((branch) => (
          <a class="cq-link" href={withBase(branch.href)}>
            {branch.label}
            <span class="cq-link-cat">글 {categoryCount(branch.href.replace("/posts/", ""))}편</span>
          </a>
        ))
      }
      <a class="cq-link" href={withBase("/year-end-tax")}>
        13월의 월급 지도
        <span class="cq-link-cat">12월 절세</span>
      </a>
    </nav>
  </div>
</section>

<style>
  .cq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 12px 0 14px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background-color: #07121e;
    background-image:
      radial-gradient(72% 58% at 12% -6%, rgb(26 79 253 / 0.34) 0%, rgb(7 18 30 / 0) 62%),
      radial-gradient(58% 52% at 96% 4%, rgb(31 122 98 / 0.22) 0%, rgb(7 18 30 / 0) 66%),
      linear-gradient(166deg, #0a1a2b 0%, #0b1b29 44%, #06101b 100%);
    color: var(--color-on-night);
  }

  /* 위에서 내려오는 한 줄 빛 — 히어로의 윗면을 살짝 띄운다 */
  .cq::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(147 169 255 / 0.55), transparent);
  }

  .cq-wrap {
    position: relative;
    max-width: 1200px;
  }

  /* ---------- ① 머리 줄 ---------- */
  .cq-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .cq-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-on-night-muted);
  }

  .cq-badge time {
    font-weight: 600;
    color: var(--color-on-night);
  }

  .cq-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: #4ade80;
    box-shadow: 0 0 0 3px rgb(74 222 128 / 0.18);
  }

  .cq-sep {
    color: rgb(170 182 204 / 0.5);
  }

  .cq-check {
    font-size: 11.5px;
  }

  .cq-top-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
  }

  .cq-film {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid rgb(147 169 255 / 0.42);
    border-radius: 999px;
    background-color: rgb(26 79 253 / 0.14);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: #dbe4ff;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft);
  }

  .cq-film:hover {
    background-color: rgb(26 79 253 / 0.28);
    border-color: rgb(147 169 255 / 0.8);
    color: #fff;
  }

  .cq-film-play {
    font-size: 9px;
    line-height: 1;
    color: var(--color-brand-glow);
  }

  .cq-skip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 12px;
    color: var(--color-on-night-muted);
    text-decoration: underline;
    text-decoration-color: rgb(170 182 204 / 0.45);
    text-underline-offset: 3px;
  }

  .cq-skip:hover {
    color: #fff;
  }

  /* ---------- h1 ---------- */
  .cq-title {
    margin: 10px 0 0;
    font-size: clamp(25px, 3.4vw, 40px);
    line-height: 1.26;
    letter-spacing: -0.035em;
    font-weight: 750;
    color: #ffffff;
    overflow-wrap: anywhere;
    text-wrap: initial;
  }

  .cq-title-em {
    color: var(--color-brand-glow);
    white-space: nowrap;
  }

  .cq-lede {
    display: none;
    margin: 8px 0 0;
    max-width: 50ch;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-on-night-muted);
    word-break: keep-all;
    text-wrap: pretty;
  }

  /* ---------- 질문 줄 ---------- */
  .cq-q {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #e7edff;
  }

  .cq-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: none;
    border-radius: 999px;
    background-color: var(--color-brand);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
  }

  /* ---------- 1·2단계 선택 칩 ---------- */
  .cq-branches,
  .cq-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-inline-size: 0;
    margin: 8px 0 0;
    padding: 0;
    border: 0;
  }

  /* 모바일 2단계는 2열 — 선택지 넷이 두 줄에 서고 카드가 화면 안에 들어온다 */
  .cq-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cq-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .cq-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    background-color: rgb(255 255 255 / 0.06);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #dce4f7;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft),
      color 160ms var(--ease-out-soft);
  }

  .cq-option:hover {
    border-color: rgb(255 255 255 / 0.42);
    color: #fff;
  }

  .cq-option-hint {
    display: none;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-on-night-muted);
  }

  .cq-radio:checked + .cq-option {
    background-color: #f2f5ff;
    border-color: #f2f5ff;
    color: #0b1b29;
  }

  .cq-radio:checked + .cq-option .cq-option-hint {
    color: #4a5872;
  }

  .cq-radio:focus-visible + .cq-option {
    outline: 2px solid var(--color-brand-glow);
    outline-offset: 3px;
  }

  .cq-soption {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 10px;
    background-color: rgb(255 255 255 / 0.04);
    font-size: 12.5px;
    font-weight: 600;
