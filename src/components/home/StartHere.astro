---
/**
 * 홈 첫 화면 — '3초 재무 진단 + 13월의 월급 지도 + 이달의 기한 + 계산기 4개' (v9.8.0, 2026-11-28).
 *
 * 왜 순서를 바꿨나
 *  · 이전 홈은 12초 브랜드 필름이 첫 화면이었다. 필름은 브랜드를 말하지만, 처음 온 사람이
 *    '지금 무엇을 할 수 있는지'는 알려 주지 않는다. 그래서 필름은 하단으로 내리고,
 *    첫 화면에 (1)진단 (2)연말정산 지도 (3)이달의 기한 (4)계산기를 놓았다.
 *
 * 지키는 것
 *  · h1은 이 구역에 하나. 문구는 기존 확정 문장을 그대로 쓴다(브랜드 카피를 새로 쓰지 않는다).
 *  · 진단 4칸은 라디오 + CSS `:checked` — 자바스크립트 없이도 선택이 된다(JS는 아무것도 저장하지 않는다).
 *  · 기한·D-데이는 `calendar.ts`·`year-end-tax.ts`와 같은 D-Day 함수(lib/dday)로 센다.
 */
import { withBase, site } from "@/config/site";
import { today as hub } from "@/data/today";
import { calendar } from "@/data/calendar";
import { MILESTONES } from "@/data/year-end-tax";
import { allPosts, postPath } from "@/lib/posts";
import { ddayOf, isUpcoming } from "@/lib/dday";

const all = await allPosts();
const byId = new Map(all.map((p) => [p.id, p]));

/* 3초 진단 — 네 갈래. 각 갈래는 계산기 하나와 글 하나로 이어진다. */
const DIAG = [
  {
    id: "pension",
    label: "연금",
    question: "올해 연금계좌에 얼마를 넣었고, 얼마가 남았나",
    calc: { href: "/apps/pension-tax/run", name: "연금저축·IRP 세액공제 계산기", line: "900만원 한도와 남은 금액, 예상 공제액" },
    postId: "finance-pension-900-credit-check",
  },
  {
    id: "invest",
    label: "투자",
    question: "지금 넣는 돈이 10년 뒤 얼마가 되나",
    calc: { href: "/apps/compound-return/run", name: "복리 수익률 계산기", line: "납입액·수익률·기간으로 미래 금액" },
    postId: "invest-dca-rule",
  },
  {
    id: "tax",
    label: "절세",
    question: "12월에 체크카드로 바꾸면 공제가 늘어나나",
    calc: { href: "/apps/credit-card-deduction/run", name: "신용카드 공제 계산기", line: "25% 문턱·한도·결제수단 전환 효과" },
    postId: "year-end-credit-card-deduction-2026",
  },
  {
    id: "insurance",
    label: "보험",
    question: "내 실손과 새 실손, 어느 쪽이 유리한가",
    calc: { href: "/apps/silson-compare/run", name: "실손 세대 비교 계산기", line: "1~5세대 보장과 보험료를 같은 표로" },
    postId: "silson-switch-2026",
  },
].map((d) => {
  const post = byId.get(d.postId);
  if (!post) throw new Error(`홈 3초 진단이 없는 글 "${d.postId}"을 가리킵니다.`);
  return { ...d, post };
});

/* 이달의 기한 — 달력의 확정 기한과 연말정산 지도의 기한을 한 목록으로 합쳐 가까운 3건 */
type Due = { date: string; title: string; href: string; note: string };
const dues: Due[] = [
  ...calendar
    .filter((c) => c.dueDate && isUpcoming(c.dueDate, site.today))
    .map((c) => ({
      date: c.dueDate as string,
      title: c.title,
      href: c.toolHref ?? `/calendar#m${c.month}`,
      note: `${c.month}월 · ${c.tag}`,
    })),
  ...MILESTONES.filter((m) => m.dueDate && isUpcoming(m.dueDate, site.today)).map((m) => ({
    date: m.dueDate as string,
    title: m.title,
    href: "/year-end-tax",
    note: "13월의 월급 지도",
  })),
]
  .sort((a, b) => a.date.localeCompare(b.date))
  .filter((d, i, arr) => arr.findIndex((x) => x.date === d.date && x.title === d.title) === i)
  .slice(0, 3)
  .map((d) => ({ ...d, dday: ddayOf(d.date, site.today) }));

/** D-데이 색 — 골든타임·허브와 같은 규칙(2단계: 3~6일 주황, 2일 이하 진한 회색) */
const ddayClass: Record<string, string> = {
  later: "dday dday--later",
  soon: "dday dday--soon",
  near: "dday dday--near",
  today: "dday dday--near",
  past: "dday dday--later",
};

/* 많이 쓰는 계산기 4개 — 첫 화면에서 바로 열린다. */
const QUICK_CALC = [
  { href: "/apps/credit-card-deduction/run", name: "신용카드 공제", line: "12월 결제수단" },
  { href: "/apps/pension-tax/run", name: "연금저축·IRP", line: "900만원 한도" },
  { href: "/apps/salary-net/run", name: "연봉 실수령", line: "4대보험·세금" },
  { href: "/apps/silson-compare/run", name: "실손 비교", line: "세대별 보장" },
];

/* 연말정산 지도 미리보기 기한 — 12. 18.(미리보기)과 12. 31.(납입) */
const previewClose = ddayOf("2026-12-18", site.today);
const spendClose = ddayOf("2026-12-31", site.today);

/* 일간 머리글 — 날짜와 확인 시각은 손으로 적지 않는다(기존 홈과 같은 규칙) */
const WEEKDAYS = ["일", "월", "화", "수", "목", "금", "토"] as const;
const [baseYear, baseMonth, baseDay] = site.baseDate.split("-").map(Number);
const weekdayLabel = `${WEEKDAYS[new Date(Date.UTC(baseYear, baseMonth - 1, baseDay)).getUTCDay()]}요일`;
const checkClock = new Intl.DateTimeFormat("ko-KR", {
  timeZone: "Asia/Seoul",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date(hub.asOf));
---

<section class="start-sky border-b border-line" id="start-here" aria-labelledby="start-here-title">
  <div class="wrap py-7 md:py-10">
    <div class="daily-head">
      <p class="daily-date">
        <span class="daily-date-label">기준일</span>
        <time datetime={site.baseDate}>{site.baseDateLabel}</time>
        <span class="daily-weekday">{weekdayLabel}</span>
      </p>
      <p class="daily-line">금융과 투자, 연금과 재무를 원문과 계산으로 확인하는 기록</p>
      <p class="daily-check mono">확인 {checkClock}</p>
    </div>

    <h1 id="start-here-title" class="hero-line mt-4">
      받을 때 알게 되는 연금,<br />5월에 알게 되는 세금 — <span class="hero-tail">미리 계산해 두는 곳</span>
    </h1>

    <p class="mt-2 max-w-[54ch] text-[13.5px] leading-[1.72] text-ink-muted">
      지금 궁금한 곳을 하나 고르면 계산기와 글이 그 자리에서 바뀝니다. 고른 값은 이 브라우저에 남기지 않습니다.
    </p>

    {/* ① 3초 재무 진단 */}
    <fieldset class="diag mt-4">
      <legend class="sr-only">3초 재무 진단 — 지금 궁금한 하나</legend>
      {
        DIAG.map((d, i) => (
          <input
            class="diag-radio"
            type="radio"
            name="start-diag"
            id={`diag-${d.id}`}
            value={d.id}
            checked={i === 0}
          />
        ))
      }
      <div class="diag-bar">
        {DIAG.map((d) => (
          <label class="diag-option" for={`diag-${d.id}`}>{d.label}</label>
        ))}
      </div>
      <div class="diag-panels">
        {
          DIAG.map((d) => (
            <div class="diag-panel" data-diag={d.id}>
              <p class="diag-q">{d.question}</p>
              <div class="diag-links">
                <a class="diag-link" href={withBase(d.calc.href)}>
                  <span class="diag-kicker">계산기</span>
                  <span class="diag-name">{d.calc.name}</span>
                  <span class="diag-note">{d.calc.line}</span>
                </a>
                <a class="diag-link" href={withBase(postPath(d.post))}>
                  <span class="diag-kicker">글</span>
                  <span class="diag-name">{d.post.data.title}</span>
                  <span class="diag-note">{d.post.data.readingMinutes}분 · 기준일 붙은 기록</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </fieldset>

    {/* ② 13월의 월급 지도 */}
    <a class="map-band mt-4" href={withBase("/year-end-tax")} data-start-map>
      <span class="map-band-body">
        <span class="map-band-kicker">13월의 월급 지도</span>
        <span class="map-band-title">2026년 귀속 연말정산 — 12월에 채우고, 1월에 모으고, 2월에 받습니다</span>
        <span class="map-band-days">
          <span>미리보기 마감 <b>{previewClose.label}</b> · 12. 18.(금)</span>
          <span>올해 납입·지출 마감 <b>{spendClose.label}</b> · 12. 31.(목)</span>
        </span>
      </span>
      <span class="map-band-go">지도 열기</span>
    </a>

    {/* ③ 이달의 기한 3개 */}
    <div class="dues mt-4">
      <div class="dues-head">
        <p class="dues-title">이달의 기한</p>
        <a class="dues-all" href={withBase("/calendar")}>골든타임 전체</a>
      </div>
      <ul class="dues-list">
        {
          dues.map((d) => (
            <li>
              <a class="due-row" href={withBase(d.href)}>
                <span class={ddayClass[d.dday.tone]} aria-label={d.dday.aria}>
                  {d.dday.label}
                </span>
                <span class="mono due-date">{d.dday.dateLabel}</span>
                <span class="due-name">{d.title}</span>
                <span class="due-note">{d.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* ④ 많이 쓰는 계산기 4개 */}
    <ul class="quick-calc mt-4">
      {
        QUICK_CALC.map((q) => (
          <li>
            <a class="quick-calc-link" href={withBase(q.href)}>
              <span class="quick-calc-name">{q.name}</span>
              <span class="quick-calc-line">{q.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .start-sky {
    background:
      linear-gradient(180deg, var(--color-sky-soft) 0%, var(--color-paper) 78%);
  }

  /* 일간 머리글 — 필름에서 옮겨 왔다(신문 1면의 날짜 줄) */
  .daily-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-line);
  }
  .daily-date {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    color: var(--color-ink);
  }
  .daily-date-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink-faint);
  }
  .daily-date time {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  .daily-weekday {
    font-size: 12.5px;
    color: var(--color-ink-muted);
  }
  .daily-line {
    flex: 1 1 auto;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--color-ink-faint);
    word-break: keep-all;
  }
  .daily-check {
    font-size: 12px;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .daily-line {
      display: none;
    }
  }

  .hero-line {
    margin: 0;
    font-size: clamp(27px, 3.6vw, 40px);
    line-height: 1.3;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }
  .hero-tail {
    color: var(--color-brand-deep);
    white-space: nowrap;
  }

  /* 3초 진단 — 라디오는 감추되 포커스는 받는다 */
  .diag {
    position: relative;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .diag-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .diag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .diag-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft),
      color 160ms var(--ease-out-soft);
  }
  .diag-option:hover {
    border-color: var(--color-ink-faint);
    color: var(--color-ink);
  }
  #diag-pension:checked ~ .diag-bar [for="diag-pension"],
  #diag-invest:checked ~ .diag-bar [for="diag-invest"],
  #diag-tax:checked ~ .diag-bar [for="diag-tax"],
  #diag-insurance:checked ~ .diag-bar [for="diag-insurance"] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface);
  }
  #diag-pension:focus-visible ~ .diag-bar [for="diag-pension"],
  #diag-invest:focus-visible ~ .diag-bar [for="diag-invest"],
  #diag-tax:focus-visible ~ .diag-bar [for="diag-tax"],
  #diag-insurance:focus-visible ~ .diag-bar [for="diag-insurance"] {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }
  .diag-panels {
    margin-top: 10px;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  .diag-panel {
    display: none;
  }
  #diag-pension:checked ~ .diag-panels [data-diag="pension"],
  #diag-invest:checked ~ .diag-panels [data-diag="invest"],
  #diag-tax:checked ~ .diag-panels [data-diag="tax"],
  #diag-insurance:checked ~ .diag-panels [data-diag="insurance"] {
    display: block;
  }
  .diag-q {
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.55;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    word-break: keep-all;
  }
  .diag-links {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }
  @media (min-width: 768px) {
    .diag-links {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 16px;
    }
  }
  .diag-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--color-line-soft);
    border-radius: 10px;
    transition: border-color 160ms var(--ease-out-soft);
  }
  .diag-link:hover {
    border-color: var(--color-ink-faint);
  }
  .diag-kicker {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
  }
  .diag-name {
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    word-break: keep-all;
  }
  .diag-note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink-faint);
  }

  /* 13월의 월급 지도 밴드 */
  .map-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-brand);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    padding: 14px 16px;
    transition: border-color 160ms var(--ease-out-soft);
  }
  .map-band:hover {
    border-color: var(--color-ink-faint);
  }
  .map-band-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .map-band-kicker {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand-deep);
  }
  .map-band-title {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    word-break: keep-all;
  }
  .map-band-days {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 12px;
    color: var(--color-ink-muted);
  }
  .map-band-days b {
    font-weight: 700;
    color: var(--color-ink);
  }
  .map-band-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 650;
    color: var(--color-ink);
  }

  /* 이달의 기한 */
  .dues {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    padding: 12px 14px;
  }
  .dues-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .dues-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .dues-all {
    font-size: 12px;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dues-list > li + li {
    border-top: 1px solid var(--color-line-soft);
  }
  .due-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    min-height: 44px;
    padding: 4px 0;
  }
  .due-date {
    font-size: 11.5px;
    color: var(--color-ink-faint);
  }
  .due-name {
    min-width: 0;
    flex: 1 1 auto;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    word-break: keep-all;
  }
  .due-note {
    font-size: 11.5px;
    color: var(--color-ink-faint);
  }

  /* 계산기 4개 */
  .quick-calc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (min-width: 768px) {
    .quick-calc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .quick-calc-link {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background-color: var(--color-surface);
    transition: border-color 160ms var(--ease-out-soft);
  }
  .quick-calc-link:hover {
    border-color: var(--color-ink-faint);
  }
  .quick-calc-name {
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .quick-calc-line {
    font-size: 11.5px;
    color: var(--color-ink-faint);
  }
</style>
