---
/**
 * 홈 — 「버핏킴즈 금융생활학교」 진입 밴드 (v8.2.0 — 6트랙 52주 + 학교 3강).
 *
 * 포털 픽(읽고 열어 보기) 아래에 놓아, 글·도구를 본 사람이 '배우는 순서'로 넘어가게 한다.
 * 대표 카드는 지금 열린 첫 강의(STEP 1 · 1-1강)를 보여 준다 — 개수와 순서는 data/academy.ts가 정한다.
 * 페이지당 하나인 단색 강조 카드(accent-card)는 신뢰 구역이 쓰므로 여기서는 쓰지 않는다.
 */
import { withBase } from "@/config/site";
import { ACADEMY, OPEN_LESSONS } from "@/data/academy";

const featured = OPEN_LESSONS[0];
const featuredHref = `/academy/${featured.slug}/`;
const nums = featured.keyNumbers.slice(0, 2);
---

<section class="scene-sky-soft border-b border-line" id="academy">
  <div class="wrap py-10 md:py-12">
    <div class="academy-band">
      <div class="min-w-0">
        <p class="eyebrow">금융생활학교</p>
        <h2 class="academy-band-title">
          용돈부터 은퇴까지,<br />배우는 순서를 놓았습니다
        </h2>
        <p class="academy-band-desc">
          {ACADEMY.promise}
        </p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          <li class="chip">6트랙 · 52주</li>
          <li class="chip">성인 실전 {ACADEMY.counts.steps} STEP · {ACADEMY.counts.lessons}강</li>
          <li class="chip">지금 열린 {OPEN_LESSONS.length}강</li>
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={withBase("/academy")} class="btn btn-secondary btn-sm min-h-[44px]">
            금융생활학교 전체 보기
          </a>
          <a href={withBase(featuredHref)} class="btn btn-tertiary btn-sm min-h-[44px]">
            {featured.label} — {featured.shortTitle}
          </a>
        </div>
      </div>

      <a href={withBase(featuredHref)} class="academy-band-card">
        <span class="academy-band-card-head">
          <span class="mono text-[10.5px] tracking-[0.04em] text-brand-deep">
            STEP {featured.step} · {featured.label}
          </span>
          <span class="academy-band-open">{`공개 ${OPEN_LESSONS.length}강`}</span>
        </span>
        <span class="academy-band-card-title">{featured.title}</span>
        <span class="academy-band-card-hook">{featured.hook}</span>
        <span class="academy-band-nums">
          {
            nums.map((k, i) => (
              <span>
                <span class="academy-band-num-label">{k.label}</span>
                <span class={i === 1 ? "academy-band-num is-brand" : "academy-band-num"}>{k.value}</span>
              </span>
            ))
          }
        </span>
        <span class="academy-band-go">
          카드뉴스 6장부터 보기 <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .academy-band {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 900px) {
    .academy-band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
      align-items: center;
      gap: 32px;
    }
  }

  .academy-band-title {
    margin-top: 8px;
    font-size: clamp(22px, 2.4vw, 29px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.038em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .academy-band-desc {
    margin-top: 8px;
    max-width: 52ch;
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .academy-band-card {
    display: block;
    padding: 16px 18px;
    border: 1px solid rgb(26 79 253 / 0.24);
    border-radius: 18px;
    background-color: #ffffff;
    box-shadow: 0 20px 44px -36px rgb(18 51 184 / 0.55);
    transition:
      border-color 160ms var(--ease-out-soft),
      transform 160ms var(--ease-out-soft);
  }

  .academy-band-card:hover {
    border-color: rgb(26 79 253 / 0.5);
  }

  .academy-band-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .academy-band-open {
    padding: 1px 8px;
    border-radius: 999px;
    background-color: var(--color-brand-soft);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
  }

  .academy-band-card-title {
    display: block;
    margin-top: 6px;
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.028em;
    color: var(--color-ink);
  }

  .academy-band-card-hook {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .academy-band-nums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .academy-band-nums > span {
    display: grid;
    gap: 1px;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: var(--color-paper);
  }

  .academy-band-num-label {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--color-ink-faint);
  }

  .academy-band-num {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .academy-band-num.is-brand {
    color: var(--color-brand-deep);
  }

  .academy-band-go {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
  }
</style>
