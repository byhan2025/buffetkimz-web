---
/**
 * 분야별 30초 브리핑 — v7.0 홈 금융포털 4번째 모듈.
 *
 * 세 탭(투자·연금 / 절세·세법 / 보험·리스크). 탭을 누르면 패널이 바뀐다.
 * 자바스크립트가 없으면 세 패널이 모두 세로로 보인다(내용이 사라지지 않는다).
 * 문구는 `data/pulse.ts` 한 파일에서 오고, 각 줄은 글 또는 도구 하나로만 연결된다.
 */
import { withBase } from "@/config/site";
import { pulseGroups } from "@/data/pulse";
---

<div class="pfeed" data-pulse-feed id="mod-brief">
  <div class="pfeed-head">
    <p class="pfeed-label">분야별 30초 브리핑</p>
    <p class="pfeed-note mono">3개 분야 · 각 3줄</p>
  </div>
  <p class="mod-chip mono">기준 11. 21. · 1차 출처 · 자산리포트</p>

  <div class="pfeed-tabs" role="tablist" aria-label="브리핑 분야">
    {
      pulseGroups.map((g, i) => (
        <button
          type="button"
          role="tab"
          id={`pulse-tab-${g.id}`}
          class="pfeed-tab"
          data-pulse-tab={g.id}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`pulse-panel-${g.id}`}
          data-on={i === 0 ? "1" : "0"}
        >
          {g.label}
        </button>
      ))
    }
  </div>

  {
    pulseGroups.map((g, i) => (
      <div
        class="pfeed-panel"
        id={`pulse-panel-${g.id}`}
        role="tabpanel"
        aria-labelledby={`pulse-tab-${g.id}`}
        data-pulse-panel={g.id}
        data-on={i === 0 ? "1" : "0"}
        hidden={i !== 0}
      >
        <p class="pfeed-line">{g.line}</p>
        <ul class="pfeed-list">
          {g.items.map((item, k) => (
            <li class="pfeed-item">
              <span class="pfeed-no mono" aria-hidden="true">
                {String(k + 1).padStart(2, "0")}
              </span>
              <div class="pfeed-item-body">
                <p class="pfeed-title">{item.title}</p>
                <p class="pfeed-text">{item.line}</p>
                <p class="pfeed-meta">
                  <span class="mono">{item.meta}</span>
                  <a href={withBase(item.href)} class="pfeed-link">
                    {item.cta}
                  </a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="pfeed-foot">
    모든 줄은 이미 발행한 글과 도구의 출처를 그대로 인용합니다. 브리핑은 판단의 재료이고, 결정은
    숫자를 직접 넣어 확인한 뒤에 합니다.
  </p>
</div>

<script>
  const feed = document.querySelector<HTMLElement>("[data-pulse-feed]");
  if (feed) {
    const tabs = [...feed.querySelectorAll<HTMLElement>("[data-pulse-tab]")];
    const panels = [...feed.querySelectorAll<HTMLElement>("[data-pulse-panel]")];
    const apply = (id: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.pulseTab === id;
        t.dataset.on = on ? "1" : "0";
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      panels.forEach((p) => {
        const on = p.dataset.pulsePanel === id;
        p.hidden = !on;
        p.dataset.on = on ? "1" : "0";
      });
    };
    tabs.forEach((t) => {
      t.addEventListener("click", () => apply(t.dataset.pulseTab ?? "invest"));
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const i = tabs.indexOf(t);
        const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        apply(next.dataset.pulseTab ?? "invest");
      });
    });
  }
</script>
