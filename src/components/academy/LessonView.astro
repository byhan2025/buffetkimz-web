---
/**
 * 강의 1개의 화면 — 「한스푼 아카데미」 (v8.1.0).
 *
 * 강의 5개(STEP 1 2강 + STEP 2 3강)가 같은 뼈대를 쓴다. 내용은 `data/academy-lessons.ts`에서만 온다.
 *   ① 히어로 + 조건별 손익 반전 훅 (조건이 바뀌면 결론이 뒤집힌다)
 *   ② 카드뉴스 인라인 뷰어 — 읽기 전에 손에 쥐는 요약부터 (카드뉴스 선호 반영)
 *   ③ 5분 한스푼 읽기 — 1,200~1,500자(공백 제외). 규격을 벗어나면 빌드가 멈춘다
 *   ④ 내 숫자 계산기 실습 — 시나리오 3개. 계산기 주소에 값을 붙이지 않는다
 *   ⑤ 1차 출처 + 자료앨범 세트 + 면책
 *   ⑥ 내 돈 운영표 1칸 (강의마다 계산기 모양이 다르다)
 *
 * 원칙: 특정 상품 비권유 · 모든 숫자는 tax-rules 상수에서 · 외부 채널·영상 이름 0.
 */
import Base from "@/layouts/Base.astro";
import HomePill from "@/components/HomePill.astro";
import SheetSlot from "@/components/academy/SheetSlot.astro";
import LiveMetricBadge from "@/components/metrics/LiveMetricBadge.astro";
import TrackDock from "@/components/learn/TrackDock.astro";
import CardNewsViewer from "@/components/academy/CardNewsViewer.astro";
import { withBase, site } from "@/config/site";
import { ACADEMY, stepByNo, openLessonsOfStep } from "@/data/academy";
import { LESSON_CHARS, LESSON_SPEC, type AcademyLesson } from "@/data/academy-lessons";
import { availableCount, availableSlides } from "@/lib/card-assets";
import { stageOfLesson } from "@/lib/tracks";
import { breadcrumbList, graph } from "@/lib/schema";

interface Props {
  lesson: AcademyLesson;
}
const { lesson } = Astro.props;

const step = stepByNo(lesson.step)!;
/** v9.1.0 P2 — 이 강의가 3단계 트랙의 한 단계면 하단 순환 독을 붙인다 */
const trackRef = stageOfLesson(lesson.slug);
const liveTrackRef = trackRef && trackRef.track.status === "live" ? trackRef : undefined;
const path = `/academy/${lesson.slug}`;
const chars = LESSON_CHARS[lesson.slug];
const cardCount = availableCount(lesson.cardSet);
/** og:image — 강의마다 연결된 카드뉴스 01번 표지(없으면 공용 og.png로 떨어진다) */
const ogSlide = availableSlides(lesson.cardSet)[0];

/** 원고 분량이 규격(1,200~1,500자)을 벗어나면 빌드에서 바로 알린다. */
if (chars < LESSON_SPEC.minChars || chars > LESSON_SPEC.maxChars) {
  throw new Error(
    `${lesson.label} 원고가 ${chars}자입니다. 규격은 1,200~1,500자(공백 제외)입니다 — academy-lessons.ts의 reading을 고치세요.`,
  );
}

/** 같은 STEP의 다른 강의 — 이전/다음 이동에 쓴다 */
const siblings = openLessonsOfStep(lesson.step);
const here = siblings.findIndex((l) => l.slug === lesson.slug);
const prevLesson = here > 0 ? siblings[here - 1] : undefined;

const sections = [
  { id: "cardnews", no: "②", label: "카드뉴스 6장", note: "3분" },
  /* v9.5.0 — 원고 자수는 제작 지표다. 독자에게는 '약 5분'만 남긴다(검사는 빌드에서 그대로 한다). */
  { id: "read", no: "③", label: "5분 한스푼 읽기", note: "약 5분" },
  { id: "calc", no: "④", label: "계산기 실습", note: "10분" },
  { id: "sources", no: "⑤", label: "1차 출처", note: "2분" },
  { id: "sheet", no: "⑥", label: "내 돈 운영표 1칸", note: "STEP 완료" },
];

const caveats = [
  `금액은 ${lesson.label}의 예시 값입니다. 내 숫자에 넣으면 결과가 달라집니다.`,
  "세금은 그해 결정세액과 공제 적용 방식에 따라 달라질 수 있습니다. 한도는 목표가 아니라 상한입니다.",
  "이 강의는 특정 상품·금융회사를 권하지 않습니다. 숫자의 기준일과 조문은 아래 1차 출처에서 확인하세요.",
];

const jsonLd = graph([
  breadcrumbList([
    { name: "홈", path: "/" },
    { name: "아카데미", path: "/academy" },
    { name: `STEP ${step.no} ${step.name}`, path: "/academy#roadmap" },
    { name: `${lesson.label} ${lesson.shortTitle}`, path },
  ]),
  {
    "@type": "LearningResource",
    "@id": `${site.url}${path}/#lesson`,
    name: lesson.title,
    description: lesson.hook,
    inLanguage: "ko",
    learningResourceType: "강의",
    educationalLevel: "입문",
    timeRequired: `PT${LESSON_SPEC.minutes}M`,
    isPartOf: { "@id": `${site.url}/academy/#course` },
    provider: { "@id": `${site.url}/#organization` },
    dateModified: site.baseDate,
    teaches: lesson.keyNumbers.map((k) => `${k.label} ${k.value}`),
  },
]);
---

<Base
  title={`${lesson.label} ${lesson.shortTitle} | ${ACADEMY.name}`}
  description={`${lesson.question} — ${lesson.hook} 5분 읽기, 내 숫자 계산기, 카드뉴스 6장, 1차 출처. 기준일 ${site.baseDateLabel}`}
  path={path}
  type="article"
  publishedTime={site.baseDate}
  image={ogSlide?.src}
  imageAlt={ogSlide ? `${lesson.shortTitle} — ${ogSlide.caption}` : undefined}
  imageWidth={ogSlide ? 1080 : undefined}
  imageHeight={ogSlide ? 1350 : undefined}
  jsonLd={jsonLd}
>
  <!-- 히어로 + ① 조건별 손익 반전 훅 -->
  <section class="scene-sky border-b border-line/70">
    <div class="wrap py-6 md:py-9">
      <HomePill />
      <nav class="flex flex-wrap items-center gap-2 text-[12px] text-ink-faint" aria-label="위치">
        <a href={withBase("/")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">홈</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/academy")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">
          아카데미
        </a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/academy/#roadmap")} class="inline-flex min-h-[44px] items-center hover:text-ink md:min-h-[24px]">
          STEP {step.no} {step.name}
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">{lesson.label}</span>
      </nav>

      <div class="mt-4 max-w-[68ch]">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="chip !border-brand/30 !bg-brand-soft !text-brand-deep">STEP {step.no} · {lesson.label}</span>
          <span class="chip">5분 읽기</span>
          <span class="chip">카드뉴스 {cardCount > 0 ? `${cardCount}장` : "준비 중"}</span>
          <span class="chip">계산기 실습</span>
          <span class="chip mono">기준일 {site.baseDateLabel}</span>
        </div>
        <h1 class="mt-3 text-[26px] font-bold leading-[1.3] tracking-[-0.042em] text-ink md:text-[36px]">
          {lesson.title}
        </h1>
        <p class="mt-2 text-[14.5px] leading-[1.75] text-ink-soft">
          STEP {step.no} 「{step.name}」의 {lesson.no}번째 강의입니다. 읽고, 계산하고, 카드 6장으로 남기고, 출처에서
          확인합니다.
        </p>
      </div>

      {/*
        v9.0.0 P1 — 이 강의의 숫자 배지. 히어로 칩 줄 아래, 훅 앞에 둬서
        강의가 쓰는 숫자(한도·세율·기준선)의 기준 시각과 조문을 먼저 보여 준다.
        `metrics`가 없거나 id가 해석되지 않으면 컴포넌트가 아무것도 그리지 않는다.
      */}
      {lesson.metrics && (
        <LiveMetricBadge market={lesson.metrics.market} rules={lesson.metrics.rules} place="lesson" />
      )}

      <!-- ① 훅 — 조건이 바뀌면 결론이 뒤집힌다 -->
      <div class="hook mt-5" data-hook>
        <p class="hook-lead">{lesson.hook}</p>
        <div class="hook-grid">
          <div class="hook-side is-short">
            <p class="hook-tag">{lesson.fork.short.tag}</p>
            <h2 class="hook-head">{lesson.fork.short.head}</h2>
            <p class="hook-body">{lesson.fork.short.body}</p>
            <p class="hook-verdict">{lesson.fork.short.verdict}</p>
          </div>
          <div class="hook-side is-long">
            <p class="hook-tag">{lesson.fork.long.tag}</p>
            <h2 class="hook-head">{lesson.fork.long.head}</h2>
            <p class="hook-body">{lesson.fork.long.body}</p>
            <p class="hook-verdict">{lesson.fork.long.verdict}</p>
          </div>
        </div>
        <div class="hook-foot">
          {lesson.keyNumbers.map((k) => (
            <span>
              <span class="hook-num-label">{k.label}</span>
              <span class="hook-num">{k.value}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 본문 -->
  <section class="scene-white">
    <div class="wrap py-9 md:py-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_286px] lg:gap-14">
        <div class="min-w-0">
          <!-- ② 카드뉴스 인라인 뷰어 — 읽기 전에 6장부터 -->
          <div id="cardnews" class="scroll-mt-[calc(var(--header-h)+16px)]">
            <CardNewsViewer set={lesson.cardSet} no="②" eyebrow="카드뉴스 먼저 보기" />
            <p class="mt-2 text-[12px] leading-[1.65] text-ink-faint">
              카드는 저장·공유·출력용입니다(1080×1350). 강의를 읽기 전에 6장을 훑으면 지금 내 숫자가 어디에
              걸리는지 먼저 보입니다.
            </p>
          </div>

          <!-- ③ 5분 읽기 -->
          <div id="read" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="flex flex-wrap items-end justify-between gap-2 border-b border-line pb-3">
              <div>
                <p class="eyebrow">③ 5분 한스푼 읽기</p>
                <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                  {lesson.shortTitle}
                </h2>
              </div>
              <p class="mono text-[11.5px] text-ink-faint">약 {lesson.readingMinutes}분</p>
            </div>

            <p class="read-question mt-4">{lesson.question}?</p>

            <div class="conclusion mt-4">
              <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">결론</p>
              <p class="mt-1.5 text-[15.5px] font-semibold leading-[1.7] tracking-[-0.012em] text-ink">
                {lesson.thesis}
              </p>
              <p class="mt-2 border-t border-line/70 pt-2 text-[13px] leading-[1.7] text-ink-muted">
                <span class="font-semibold text-ink-soft">내 계약·재무와 대조</span> 아래 계산기에서 내 숫자로 한 번
                바꿔 보면 결론이 내 자리로 옮겨집니다.
              </p>
            </div>

            <div class="prose-article mt-6">
              {
                lesson.reading.map((sec) => (
                  <>
                    <h2>{sec.h}</h2>
                    {sec.ps.map((p) => (
                      <p>{p}</p>
                    ))}
                  </>
                ))
              }
            </div>

            <p class="mt-6 rounded-xl border border-line bg-paper px-4 py-3 text-[12.5px] leading-[1.7] text-ink-muted">
              읽는 데 걸리는 시간은 5분입니다. 여기까지 읽었으면 아래 계산기에서 같은 숫자를 내 조건으로 한 번만
              바꿔 보세요. 숫자는 읽는 것보다 직접 넣어 볼 때 남습니다.
            </p>
          </div>

          <!-- ④ 계산기 실습 -->
          <div id="calc" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="border-b border-line pb-3">
              <p class="eyebrow">④ 내 숫자 계산기 실습</p>
              <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                세 번 넣어 보기
              </h2>
              <p class="mt-2 text-[13px] leading-[1.7] text-ink-muted">{lesson.calculator.note}</p>
            </div>

            <ul class="mt-4 grid gap-3">
              {
                lesson.scenarios.map((sc, i) => (
                  <li class="card card-lift p-4 md:p-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <p class="text-[11px] font-bold tracking-[0.14em] text-brand-deep">
                        시나리오 {String.fromCharCode(65 + i)} · {sc.label}
                      </p>
                      <p class="mono text-[12px] font-semibold text-ink-soft">{sc.result}</p>
                    </div>
                    <h3 class="mt-1.5 text-[15px] font-bold leading-snug tracking-[-0.025em] text-ink">
                      {sc.title}
                    </h3>
                    <ul class="scenario-settings mt-2">
                      {sc.settings.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                    <p class="mt-2 text-[12px] leading-[1.65] text-ink-faint">{sc.expect}</p>
                    <a
                      href={withBase(sc.href ?? lesson.calculator.href)}
                      class="btn btn-secondary btn-sm mt-3 inline-flex min-h-[44px] items-center"
                    >
                      {sc.cta ?? `${lesson.calculator.name} 열기`}
                      <span aria-hidden="true" class="ml-1.5">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-3 grid gap-2 md:grid-cols-2">
              <div class="note-box">
                <p class="text-[12px] font-semibold text-ink">버튼이 값을 넘기지 않는 이유</p>
                <p class="mt-1">
                  이 페이지의 버튼은 계산기만 엽니다. 소득·납입액 같은 내 숫자는 주소(URL)에 붙이지 않습니다.
                  주소에 남은 숫자는 기록·공유·방문 로그에 그대로 따라다니기 때문입니다.
                </p>
              </div>
              <div class="note-box">
                <p class="text-[12px] font-semibold text-ink">함께 보면 좋은 도구</p>
                <p class="mt-1">
                  같은 돈을 어느 그릇에 두느냐로 세후 결과가 어떻게 달라지는지 나란히 비교하는 계산기입니다.
                </p>
                <p class="mt-2">
                  <a href={withBase("/apps/account-tax-compare/run")} class="link font-semibold text-ink-soft">
                    4대 계좌 세후 비교 열기
                  </a>
                </p>
              </div>
            </div>
          </div>

          <!-- ⑤ 1차 출처 -->
          <div id="sources" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <div class="border-b border-line pb-3">
              <p class="eyebrow">⑤ 1차 출처</p>
              <h2 class="mt-1 text-[22px] font-bold tracking-[-0.035em] text-ink md:text-[26px]">
                직접 열어볼 원문
              </h2>
              <p class="mt-2 text-[13px] leading-[1.7] text-ink-muted">
                이 강의의 숫자가 나온 조문과 기관 안내입니다. 확인한 것만 적었고, 요건이 바뀌면 글과 카드를 함께
                다시 만듭니다.
              </p>
            </div>

            <a href={withBase(lesson.cardSet.href)} class="card card-lift card-set mt-4">
              <span class="card-set-thumb" aria-hidden="true">
                <span class="mono">3D 카드</span>
                <strong>{cardCount}</strong>
              </span>
              <span class="min-w-0">
                <span class="block text-[11px] font-bold tracking-[0.14em] text-brand-deep">자료앨범 세트</span>
                <span class="mt-0.5 block text-[15.5px] font-bold tracking-[-0.025em] text-ink">
                  {lesson.cardSet.title}
                </span>
                <span class="mt-0.5 block text-[12.5px] text-ink-muted">{lesson.cardSet.meta}</span>
                <span class="mt-1 block text-[11.5px] text-ink-faint">
                  장마다·세트 전체를 내려받을 수 있습니다. 위 ②에서 미리 보기로 넘겨볼 수 있습니다.
                </span>
              </span>
              <span class="btn btn-secondary btn-sm card-set-btn">자료앨범에서 보기 →</span>
            </a>

            <div class="mt-5">
              <p class="text-[11px] font-bold tracking-[0.16em] text-ink-faint">1차 출처 — 내가 직접 확인하는 원문</p>
              <ul class="source-list mt-2">
                {
                  lesson.sources.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-row">
                        <span class="min-w-0">
                          <span class="block text-[13.5px] font-semibold leading-snug text-ink">{s.label}</span>
                          <span class="mt-0.5 block text-[12px] leading-[1.6] text-ink-muted">{s.what}</span>
                        </span>
                        <span class="source-host mono">{s.host} ↗</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-2 text-[11.5px] leading-[1.6] text-ink-faint">
                확인한 조문과 안내만 적었습니다. 링크는 기관 사이트에서 직접 열립니다. 기준일 {site.baseDateLabel}
              </p>
            </div>

            <p class="disclaimer mt-4">
              <strong class="font-semibold text-ink">이 글은 특정 상품을 권하지 않습니다.</strong> 이 글과 카드는 제도와
              계산 구조를 설명하는 학습 자료입니다. 가입·전환을 권하지 않으며, 보험은 재무설계의 도구로만 다룹니다.{" "}
              <a href={withBase("/principles")} class="link font-semibold text-ink-soft">편집 원칙 보기</a>
            </p>
          </div>

          <!-- ⑥ STEP 완료 체크 -->
          <div id="sheet" class="mt-12 scroll-mt-[calc(var(--header-h)+16px)]">
            <SheetSlot
              variant={lesson.sheet.variant}
              slotNo={lesson.sheet.slotNo}
              slotTitle={lesson.sheet.slotTitle}
              line={lesson.sheet.line}
            />
          </div>

          <!-- 다음 강 -->
          <div class="mt-10 rounded-2xl border border-line bg-paper-deep/55 p-5 md:p-6">
            <p class="text-[11px] font-bold tracking-[0.16em] text-brand-deep">{lesson.next.label}</p>
            <div class="mt-1 flex flex-wrap items-baseline gap-2">
              <p class="text-[17px] font-bold tracking-[-0.03em] text-ink">{lesson.next.title}</p>
              {lesson.next.status && <span class="chip !min-h-[24px] !text-[11px]">{lesson.next.status}</span>}
            </div>
            <p class="mt-1.5 text-[13px] leading-[1.7] text-ink-muted">{lesson.next.body}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {lesson.next.href ? (
                <a href={withBase(lesson.next.href)} class="btn btn-primary btn-sm min-h-[44px]">
                  다음 강으로
                  <span aria-hidden="true" class="ml-1.5">→</span>
                </a>
              ) : (
                <a href={withBase("/academy/#roadmap")} class="btn btn-primary btn-sm min-h-[44px]">
                  아카데미 로드맵으로
                </a>
              )}
              {prevLesson && (
                <a href={withBase(`/academy/${prevLesson.slug}/`)} class="btn btn-secondary btn-sm min-h-[44px]">
                  이전 강 · {prevLesson.label}
                </a>
              )}
              <a href={withBase(lesson.calculator.href)} class="btn btn-tertiary btn-sm min-h-[44px]">
