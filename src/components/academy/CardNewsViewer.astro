---
/**
 * 인라인 카드뉴스 뷰어 — 강의 페이지 안에서 3D 카드 6장을 바로 넘겨 본다 (v8.1.0).
 *
 * 왜 만들었나
 *  · v8.0은 카드 세트를 '자료앨범 링크 한 줄'로만 두었다. 카드뉴스를 더 선호한다는 요청에 따라,
 *    강의를 읽기 전에 6장을 눈으로 먼저 훑고, 마음에 드는 장은 크게 보고 내려받을 수 있게 했다.
 *
 * 무엇을 지키나
 *  · 카드 파일은 `public/gallery/`의 실제 PNG만 건다. 아직 없는 세트는 빈 이미지 대신 '준비 안내'를 그린다
 *    (파일이 들어오면 다음 빌드에서 자동으로 6장이 나타난다 — 코드를 고칠 필요가 없다).
 *  · 입력값·조회 기록을 저장하지 않는다. 이미지 경로만 읽는다.
 *  · 자바스크립트가 없어도 첫 장과 '자료앨범 전체 보기' 링크는 그대로 보인다.
 */
import { withBase } from "@/config/site";
import { availableSlides } from "@/lib/card-assets";
import type { LessonCardSet } from "@/data/academy-lessons";

interface Props {
  /** 카드 세트 — academy-lessons.ts의 객체를 그대로 받는다 */
  set: LessonCardSet;
  /** 구획 번호 (`④`) */
  no?: string;
  /** 제목 위 작은 라벨 */
  eyebrow?: string;
  /** 자료앨범 링크 문구 */
  linkLabel?: string;
  /** 이 강의에서 특히 먼저 볼 장 (1부터). 없으면 세트의 startIndex */
  focus?: number;
}

const { set, no = "④", eyebrow = "자료앨범 3D 카드뉴스", linkLabel = "자료앨범에서 6장 전체 보기", focus } = Astro.props;

/** 빌드 시점에 실제로 있는 PNG만 남긴다 — 없는 파일로 깨진 이미지를 그리지 않는다. */
const slides = availableSlides(set);

const start = Math.min(
  Math.max((focus ?? set.startIndex + 1) - 1, 0),
  Math.max(slides.length - 1, 0),
);

const payload = slides.map((s, i) => ({
  src: withBase(s.src),
  alt: s.alt,
  caption: s.caption,
  name: `${set.id}-${String(i + 1).padStart(2, "0")}.png`,
}));

const heading = `${set.title} — 카드뉴스 ${slides.length}장`;
---

<section
  class="cn"
  data-cardnews
  data-start={start}
  aria-labelledby={`cn-title-${set.id}`}
>
  <div class="cn-top">
    <div class="min-w-0">
      <p class="eyebrow">{no} {eyebrow}</p>
      <h2 id={`cn-title-${set.id}`} class="cn-title">{set.title}</h2>
      <p class="cn-meta">{set.meta}</p>
    </div>
    <a href={withBase(set.href)} class="cn-gallery-link">
      {linkLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {
    slides.length > 0 ? (
      <>
        <div class="cn-view">
          <div class="cn-stage" data-cn-stage>
            <img
              src={payload[start].src}
              alt={payload[start].alt}
              width="1080"
              height="1350"
              loading="eager"
              decoding="async"
              class="cn-img"
              data-cn-img
            />
            <button type="button" class="cn-nav is-prev" data-cn-prev aria-label="이전 카드">
              ‹
            </button>
            <button type="button" class="cn-nav is-next" data-cn-next aria-label="다음 카드">
              ›
            </button>
            <span class="cn-counter mono" data-cn-counter>
              {start + 1} / {slides.length}
            </span>
          </div>

          <div class="cn-side">
            <p class="cn-caption" data-cn-caption aria-live="polite">
              {payload[start].caption}
            </p>

            <ul class="cn-thumbs" data-cn-thumbs aria-label={`${set.title} 카드 목록`}>
              {payload.map((s, i) => (
                <li>
                  <button
                    type="button"
                    class:list={["cn-thumb", i === start && "is-active"]}
                    data-cn-thumb={i}
                    aria-label={`${i + 1}장 — ${s.caption}`}
                    aria-pressed={i === start ? "true" : "false"}
                  >
                    <img src={s.src} alt="" width="1080" height="1350" loading="lazy" decoding="async" />
                    <span class="cn-thumb-no mono" aria-hidden="true">{i + 1}</span>
                  </button>
                </li>
              ))}
            </ul>

            <div class="cn-actions">
              <button type="button" class="btn btn-secondary btn-sm min-h-[44px]" data-cn-open>
                지금 장 크게 보기
              </button>
              <a
                href={payload[start].src}
                download={payload[start].name}
                class="btn btn-tertiary btn-sm min-h-[44px]"
                data-cn-download
              >
                이 장 내려받기
              </a>
            </div>
            <p class="cn-note">
              카드마다 하단에 그 숫자의 조문과 기준일이 적혀 있습니다. 6장을 모두 내려받으려면 위의
              '자료앨범'에서 세트를 여세요.
            </p>
          </div>
        </div>

        <script type="application/json" data-cn-data set:html={JSON.stringify(payload)} />

        <dialog class="cn-dialog" data-cn-dialog aria-label={`${set.title} 크게 보기`}>
          <div class="cn-dialog-head">
            <p class="cn-dialog-title">{set.title}</p>
            <div class="flex items-center gap-2">
              <span class="mono cn-dialog-count" data-cn-dialog-count />
              <button type="button" class="cn-dialog-close" data-cn-close aria-label="닫기">
                ×
              </button>
            </div>
          </div>
          <div class="cn-dialog-body">
            <button type="button" class="cn-dialog-nav is-prev" data-cn-dialog-prev aria-label="이전 카드">
              ‹
            </button>
            <img src={payload[start].src} alt={payload[start].alt} data-cn-dialog-img />
            <button type="button" class="cn-dialog-nav is-next" data-cn-dialog-next aria-label="다음 카드">
              ›
            </button>
          </div>
          <div class="cn-dialog-foot">
            <p class="cn-dialog-caption" data-cn-dialog-caption />
            <a href={payload[start].src} download={payload[start].name} class="btn btn-primary btn-xs" data-cn-dialog-download>
              현재 장 내려받기
            </a>
          </div>
        </dialog>
      </>
    ) : (
      <div class="cn-empty">
        <p class="cn-empty-title">이 세트의 카드 6장은 지금 제작 중입니다</p>
        <p class="cn-empty-body">
          장면과 숫자를 육안으로 검수한 뒤 자료앨범에 올립니다. 올라오면 이 자리에 6장이 그대로 나타나고, 그
          전까지는 아래 5분 읽기와 계산기로 같은 내용을 확인할 수 있습니다.
        </p>
        <ul class="cn-empty-list">
          {set.slides.map((s, i) => (
            <li>
              <span class="mono">{i + 1}</span>
              <span>{s.caption}</span>
            </li>
          ))}
        </ul>
        <a href={withBase(set.href)} class="btn btn-secondary btn-sm min-h-[44px]">
          자료앨범 카드뉴스 전체 보기
        </a>
      </div>
    )
  }
</section>

<script>
  type Slide = { src: string; alt: string; caption: string; name: string };

  document.querySelectorAll<HTMLElement>("[data-cardnews]").forEach((root) => {
    const data = root.querySelector<HTMLScriptElement>("[data-cn-data]");
    if (!data) return;
    let slides: Slide[] = [];
    try {
      slides = JSON.parse(data.textContent || "[]");
    } catch {
      return;
    }
    if (!slides.length) return;

    const img = root.querySelector<HTMLImageElement>("[data-cn-img]");
    const counter = root.querySelector<HTMLElement>("[data-cn-counter]");
    const caption = root.querySelector<HTMLElement>("[data-cn-caption]");
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cn-thumb]"));
    const download = root.querySelector<HTMLAnchorElement>("[data-cn-download]");
    const dialog = root.querySelector<HTMLDialogElement>("[data-cn-dialog]");
    const dImg = root.querySelector<HTMLImageElement>("[data-cn-dialog-img]");
    const dCount = root.querySelector<HTMLElement>("[data-cn-dialog-count]");
    const dCaption = root.querySelector<HTMLElement>("[data-cn-dialog-caption]");
    const dDownload = root.querySelector<HTMLAnchorElement>("[data-cn-dialog-download]");

    let i = Number(root.dataset.start ?? 0);
    if (!Number.isFinite(i) || i < 0 || i >= slides.length) i = 0;

    const paint = () => {
      const s = slides[i];
      if (img) {
        img.src = s.src;
        img.alt = s.alt;
      }
      if (counter) counter.textContent = `${i + 1} / ${slides.length}`;
      if (caption) caption.textContent = s.caption;
      if (download) {
        download.href = s.src;
        download.setAttribute("download", s.name);
      }
      thumbs.forEach((t, n) => {
        const on = n === i;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-pressed", on ? "true" : "false");
      });
      if (dImg) {
        dImg.src = s.src;
        dImg.alt = s.alt;
      }
      if (dCount) dCount.textContent = `${i + 1} / ${slides.length}`;
      if (dCaption) dCaption.textContent = s.caption;
      if (dDownload) {
        dDownload.href = s.src;
        dDownload.setAttribute("download", s.name);
      }
    };

    const go = (next: number) => {
      i = (next + slides.length) % slides.length;
      paint();
    };

    root.querySelector("[data-cn-prev]")?.addEventListener("click", () => go(i - 1));
    root.querySelector("[data-cn-next]")?.addEventListener("click", () => go(i + 1));
    thumbs.forEach((t, n) => t.addEventListener("click", () => go(n)));
    root.querySelector("[data-cn-open]")?.addEventListener("click", () => dialog?.showModal());
    root.querySelector("[data-cn-close]")?.addEventListener("click", () => dialog?.close());
    root.querySelector("[data-cn-dialog-prev]")?.addEventListener("click", () => go(i - 1));
    root.querySelector("[data-cn-dialog-next]")?.addEventListener("click", () => go(i + 1));

    /* 카드 사이 여백을 눌러도 닫힌다 — 모달 밖 클릭과 같은 동작 */
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    /* 키보드 — 좌우로 넘기고 Esc로 닫는다 */
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(i - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        go(i + 1);
      }
    });

    paint();
  });
</script>

<style>
  .cn {
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background-color: #ffffff;
    box-shadow:
      0 1px 2px rgb(11 27 41 / 0.04),
      0 22px 48px -38px rgb(11 27 41 / 0.6);
  }

  @media (min-width: 768px) {
    .cn {
      padding: 22px;
    }
  }

  .cn-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }

  .cn-title {
    margin-top: 2px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .cn-title {
      font-size: 22px;
    }
  }

  .cn-meta {
    margin-top: 2px;
    font-size: 12px;
    color: var(--color-ink-muted);
  }

  .cn-gallery-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
  }

  .cn-gallery-link:hover {
    color: var(--color-brand);
  }

  .cn-view {
    display: grid;
    gap: 14px;
    margin-top: 14px;
  }

  @media (min-width: 860px) {
    .cn-view {
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }
  }

  .cn-stage {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-paper);
    border: 1px solid var(--color-line-soft);
  }

  .cn-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background-color: var(--color-paper-deep);
  }

  .cn-nav {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.6);
    background-color: rgb(11 27 41 / 0.62);
    color: #ffffff;
    font-size: 22px;
    line-height: 1;
    backdrop-filter: blur(2px);
  }

  .cn-nav:hover {
    background-color: rgb(11 27 41 / 0.82);
  }

  .cn-nav.is-prev {
    left: 8px;
  }

  .cn-nav.is-next {
    right: 8px;
  }

  .cn-counter {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 8px;
    border-radius: 999px;
    background-color: rgb(11 27 41 / 0.72);
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .cn-side {
    min-width: 0;
  }

  .cn-caption {
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 12px;
    background-color: var(--color-brand-soft);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.55;
    color: var(--color-brand-deep);
    text-wrap: pretty;
  }

  .cn-thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 10px;
  }

  .cn-thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--color-paper);
  }

  .cn-thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    opacity: 0.78;
  }

  .cn-thumb.is-active {
    border-color: var(--color-brand);
  }

  .cn-thumb.is-active img,
  .cn-thumb:hover img {
    opacity: 1;
  }

  .cn-thumb:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .cn-thumb-no {
    position: absolute;
    right: 4px;
    bottom: 4px;
    min-width: 16px;
    padding: 1px 4px;
    border-radius: 999px;
    background-color: rgb(11 27 41 / 0.68);
    color: #ffffff;
    font-size: 9.5px;
    text-align: center;
  }

  .cn-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .cn-note {
    margin-top: 8px;
    font-size: 11.5px;
    line-height: 1.65;
    color: var(--color-ink-faint);
  }

  /* ---- 준비 안내(카드 파일이 아직 없을 때) ---- */
  .cn-empty {
    margin-top: 14px;
    padding: 16px;
    border: 1px dashed var(--color-line);
    border-radius: 16px;
    background-color: var(--color-cream);
  }

  .cn-empty-title {
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .cn-empty-body {
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .cn-empty-list {
    display: grid;
    gap: 3px;
    margin: 10px 0 12px;
  }

  .cn-empty-list li {
    display: flex;
    gap: 8px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .cn-empty-list .mono {
    flex: none;
    color: var(--color-ink-faint);
  }

  /* ---- 크게 보기 ---- */
  .cn-dialog {
    width: min(94vw, 720px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background-color: #0b1b29;
    color: #ffffff;
    overflow: hidden;
  }

  .cn-dialog::backdrop {
    background-color: rgb(11 27 41 / 0.78);
  }

  .cn-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
  }

  .cn-dialog-title {
    font-size: 13px;
    font-weight: 700;
  }

  .cn-dialog-count {
    font-size: 12px;
    color: #c9cedd;
  }

  .cn-dialog-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background-color: rgb(255 255 255 / 0.12);
    color: #ffffff;
    font-size: 20px;
    line-height: 1;
  }

  .cn-dialog-body {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
  }

  .cn-dialog-body img {
    flex: 1 1 auto;
    min-width: 0;
    max-height: 72vh;
    object-fit: contain;
    border-radius: 10px;
  }

  .cn-dialog-nav {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background-color: rgb(255 255 255 / 0.14);
    color: #ffffff;
    font-size: 22px;
    line-height: 1;
  }

  .cn-dialog-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px 14px;
  }

  .cn-dialog-caption {
    font-size: 12.5px;
    line-height: 1.6;
    color: #d7dbe7;
  }
</style>
