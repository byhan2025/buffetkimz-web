---
/**
 * 「내 돈 운영표」 1칸 미리보기 — 강의 하단의 STEP 완료 체크.
 *
 * · 연금저축·IRP 납입액을 정해 두면 세액공제액을 그 화면에서 계산한다(한도·공제율은 tax-rules 상수).
 * · '이 칸 채우기'를 누르면 운영표 2번 칸(계좌 배치표)이 채워진 모습을 보여 준다.
 * · 입력값은 주소·서버·저장소 어디에도 남기지 않는다. 화면을 닫으면 사라진다(사이트 계산 원칙과 같다).
 */
import { PENSION_ACCOUNT, wonLabel, manLabel, pct } from "@/data/tax-rules";
import { withBase, site } from "@/config/site";

const presets = {
  pension: [0, 300, PENSION_ACCOUNT.savingsLimit],
  irp: [0, 100, 200, PENSION_ACCOUNT.combinedLimit - PENSION_ACCOUNT.savingsLimit],
};
const defaults = { pension: PENSION_ACCOUNT.savingsLimit, irp: 300 };
---

<section
  class="sheet"
  data-sheet
  data-limit-savings={PENSION_ACCOUNT.savingsLimit}
  data-limit-combined={PENSION_ACCOUNT.combinedLimit}
  data-rate-low={PENSION_ACCOUNT.creditRateLow}
  data-rate-high={PENSION_ACCOUNT.creditRateHigh}
  aria-labelledby="sheet-heading"
>
  <div class="sheet-head">
    <div>
      <p class="eyebrow">STEP 완료 체크</p>
      <h2 id="sheet-heading" class="sec-title">내 돈 운영표 · 2번 칸</h2>
      <p class="mt-2 max-w-[54ch] text-[13px] leading-[1.7] text-ink-muted">
        이 강의에서 채우는 칸은 하나입니다. 계좌 배치표의 첫 줄 — 연금저축과 IRP에 얼마를 넣고, 올해 얼마를
        돌려받는지 적습니다. 숫자를 골라 칸을 채워 보세요.
      </p>
    </div>
    <p class="sheet-progress mono" data-sheet-progress>STEP 2 · 0 / 7칸</p>
  </div>

  <div class="sheet-body">
    <div class="sheet-form">
      <fieldset class="sheet-field">
        <legend class="sheet-legend">소득 구간</legend>
        <div class="sheet-chips">
          <label class="sheet-chip">
            <input type="radio" name="sheet-bracket" value="low" checked data-sheet-input />
            <span>총급여 5,500만원 이하 · {pct(PENSION_ACCOUNT.creditRateLow)}</span>
          </label>
          <label class="sheet-chip">
            <input type="radio" name="sheet-bracket" value="high" data-sheet-input />
            <span>5,500만원 초과 · {pct(PENSION_ACCOUNT.creditRateHigh)}</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="sheet-field">
        <legend class="sheet-legend">
          연금저축 납입액 <span class="mono">한도 {manLabel(PENSION_ACCOUNT.savingsLimit)}</span>
        </legend>
        <div class="sheet-chips">
          {
            presets.pension.map((v) => (
              <label class="sheet-chip sheet-chip--num">
                <input
                  type="radio"
                  name="sheet-pension"
                  value={v}
                  checked={v === defaults.pension}
                  data-sheet-input
                />
                <span>{v === 0 ? "0" : `${v}만`}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="sheet-field">
        <legend class="sheet-legend">
          IRP 납입액 <span class="mono">합산 한도 {manLabel(PENSION_ACCOUNT.combinedLimit)}</span>
        </legend>
        <div class="sheet-chips">
          {
            presets.irp.map((v) => (
              <label class="sheet-chip sheet-chip--num">
                <input type="radio" name="sheet-irp" value={v} checked={v === defaults.irp} data-sheet-input />
                <span>{v === 0 ? "0" : `${v}만`}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="sheet-result">
        <p class="text-[11.5px] font-semibold text-ink-faint">올해 줄어드는 세금 (한도 기준)</p>
        <p class="mt-1 text-[24px] font-bold leading-none tracking-[-0.035em] text-brand-deep" data-sheet-credit>
          {wonLabel(
            Math.round(
              (defaults.pension + defaults.irp) * 10000 * PENSION_ACCOUNT.creditRateLow,
            ),
          )}
        </p>
        <p class="mono mt-1.5 text-[11.5px] text-ink-faint" data-sheet-breakdown>
          공제 대상 {manLabel(defaults.pension + defaults.irp)} × {pct(PENSION_ACCOUNT.creditRateLow)}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-sheet-commit>이 칸 채우기</button>
        <a href={withBase("/academy/#roadmap")} class="text-[12px] text-ink-faint underline underline-offset-2">
          아카데미 로드맵
        </a>
      </div>

      <p class="text-[11.5px] leading-[1.6] text-ink-faint">
        고른 값은 이 화면 안에서만 계산하고, 주소·서버·저장소 어디에도 남기지 않습니다. 화면을 닫으면 사라집니다.
        중도해지 시에는 공제받은 납입액에 기타소득세 {pct(PENSION_ACCOUNT.earlyWithdrawRateWithLocal)}가 붙습니다.
      </p>
    </div>

    <div class="sheet-preview" data-sheet-preview>
      <p class="mono text-[11px] tracking-[0.04em] text-ink-faint">내 돈 운영표 · 6칸 중 2번</p>

      <div class="sheet-empty" data-sheet-empty>
        <p class="text-[13.5px] font-semibold text-ink">아직 빈칸입니다</p>
        <p class="mt-1 text-[12px] leading-[1.65] text-ink-muted">
          왼쪽에서 소득 구간과 납입액을 고른 뒤 <span class="font-semibold text-ink-soft">이 칸 채우기</span>를
          누르면, 계좌 배치표의 첫 줄이 완성됩니다.
        </p>
      </div>

      <div class="sheet-filled" data-sheet-filled hidden>
        <p class="text-[11px] font-bold tracking-[0.14em] text-brand-deep">칸 완성</p>
        <p class="mt-1.5 text-[15px] font-bold tracking-[-0.025em] text-ink">계좌 배치표 · 첫 줄</p>
        <dl class="sheet-filled-list mt-2">
          <div>
            <dt>소득 구간</dt>
            <dd data-sheet-out-bracket>총급여 5,500만원 이하</dd>
          </div>
          <div>
            <dt>연금저축</dt>
            <dd data-sheet-out-pension>600만원</dd>
          </div>
          <div>
            <dt>IRP</dt>
            <dd data-sheet-out-irp>300만원</dd>
          </div>
          <div>
            <dt>세액공제</dt>
            <dd data-sheet-out-credit>148만 5,000원</dd>
          </div>
        </dl>
        <p class="mt-2 border-t border-dashed border-line pt-2 text-[11.5px] leading-[1.6] text-ink-faint">
          기준일 {site.baseDateLabel} · 소득세법 제59조의3 — 나머지 6칸은 다음 강의에서 채웁니다.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  /** 1485000 → "148만 5,000원" (tax-rules의 wonLabel과 같은 표기) */
  const label = (won: number) => {
    const man = Math.floor(won / 10000);
    const rest = won % 10000;
    if (rest === 0) return `${man.toLocaleString("ko-KR")}만원`;
    return `${man.toLocaleString("ko-KR")}만 ${rest.toLocaleString("ko-KR")}원`;
  };
  const man = (value: number) => (value === 0 ? "0원" : `${value.toLocaleString("ko-KR")}만원`);
  const pctLabel = (rate: number) => `${(rate * 100).toFixed(1).replace(/\.0$/, "")}%`;

  document.querySelectorAll<HTMLElement>("[data-sheet]").forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>("[data-sheet-input]")];
    const creditEl = root.querySelector<HTMLElement>("[data-sheet-credit]");
    const breakdownEl = root.querySelector<HTMLElement>("[data-sheet-breakdown]");
    const progressEl = root.querySelector<HTMLElement>("[data-sheet-progress]");
    const empty = root.querySelector<HTMLElement>("[data-sheet-empty]");
    const filled = root.querySelector<HTMLElement>("[data-sheet-filled]");
    const out = {
      bracket: root.querySelector<HTMLElement>("[data-sheet-out-bracket]"),
      pension: root.querySelector<HTMLElement>("[data-sheet-out-pension]"),
      irp: root.querySelector<HTMLElement>("[data-sheet-out-irp]"),
      credit: root.querySelector<HTMLElement>("[data-sheet-out-credit]"),
    };
    const commitBtn = root.querySelector<HTMLButtonElement>("[data-sheet-commit]");

    /* 한도·공제율은 화면이 data 속성으로 넘긴 tax-rules 상수를 그대로 쓴다(숫자를 여기서 다시 적지 않는다) */
    const LIMIT_SAVINGS = Number(root.dataset.limitSavings);
    const LIMIT_COMBINED = Number(root.dataset.limitCombined);
    const RATE: Record<string, number> = {
      low: Number(root.dataset.rateLow),
      high: Number(root.dataset.rateHigh),
    };

    const picked = (name: string) =>
      inputs.find((i) => i.name === name && i.checked)?.value ?? "0";

    const state = () => {
      const bracket = picked("sheet-bracket") || "low";
      const pension = Number(picked("sheet-pension") || 0);
      const irp = Number(picked("sheet-irp") || 0);
      const savingsEligible = Math.min(pension, LIMIT_SAVINGS);
      const eligible = savingsEligible + Math.min(irp, Math.max(LIMIT_COMBINED - savingsEligible, 0));
      const rate = RATE[bracket] ?? RATE.low;
      return { bracket, pension, irp, eligible, rate, credit: Math.round(eligible * 10000 * rate) };
    };

    let committed = false;

    const render = () => {
      const s = state();
      if (creditEl) creditEl.textContent = label(s.credit);
      if (breakdownEl)
        breakdownEl.textContent = `공제 대상 ${man(s.eligible)} × ${pctLabel(s.rate)}`;
      if (committed) paint();
    };

    /** 채워진 칸 — 방금 고른 값으로 다시 그린다 */
    const paint = () => {
      const s = state();
      if (out.bracket)
        out.bracket.textContent = s.bracket === "high" ? "총급여 5,500만원 초과" : "총급여 5,500만원 이하";
      if (out.pension) out.pension.textContent = man(s.pension);
      if (out.irp) out.irp.textContent = man(s.irp);
      if (out.credit) out.credit.textContent = label(s.credit);
    };

    inputs.forEach((i) => i.addEventListener("change", render));

    commitBtn?.addEventListener("click", () => {
      committed = true;
      paint();
      if (empty) empty.hidden = true;
      if (filled) filled.hidden = false;
      if (progressEl) progressEl.textContent = "STEP 2 · 1 / 7칸";
      commitBtn.textContent = "값 바꿔서 다시 채우기";
      filled?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    render();
  });
</script>

<style>
  .sheet {
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background-color: #ffffff;
    box-shadow:
      0 1px 2px rgb(11 27 41 / 0.04),
      0 20px 44px -34px rgb(11 27 41 / 0.5);
  }

  @media (min-width: 768px) {
    .sheet {
      padding: 28px;
    }
  }

  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .sheet-progress {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background-color: var(--color-brand-soft);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-brand-deep);
  }

  .sheet-body {
    display: grid;
    gap: 18px;
    margin-top: 18px;
  }

  @media (min-width: 900px) {
    .sheet-body {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }
  }

  .sheet-form {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .sheet-field {
    min-width: 0;
  }

  .sheet-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .sheet-legend .mono {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-ink-faint);
  }

  .sheet-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sheet-chip {
    display: inline-flex;
    cursor: pointer;
  }

  .sheet-chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .sheet-chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background-color: #ffffff;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-ink-muted);
    transition:
      border-color 140ms var(--ease-out-soft),
      background-color 140ms var(--ease-out-soft);
  }

  .sheet-chip--num span {
    min-width: 62px;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }

  .sheet-chip input:checked + span {
    border-color: var(--color-brand);
    background-color: var(--color-brand-soft);
    color: var(--color-brand-deep);
  }

  .sheet-chip input:focus-visible + span {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .sheet-result {
    padding: 14px 16px;
    border-radius: 14px;
    background-color: var(--color-paper);
    border: 1px solid var(--color-line-soft);
  }

  .sheet-preview {
    padding: 16px;
    border: 1px dashed var(--color-line);
    border-radius: 16px;
    background-color: var(--color-cream);
  }

  .sheet-filled {
    margin-top: 10px;
  }

  .sheet-filled-list {
    display: grid;
    gap: 2px;
  }

  .sheet-filled-list > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 0;
    border-bottom: 1px solid var(--color-line-soft);
  }

  .sheet-filled-list dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink-faint);
  }

  .sheet-filled-list dd {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
