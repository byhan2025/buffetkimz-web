---
/**
 * 「내 돈 운영표」 1칸 미리보기 — 변형 선택기 (v8.1.0).
 *
 * 강의마다 채우는 칸이 다르므로 계산기 모양을 나눈다.
 *   pension   연금저축·IRP 납입액 → 세액공제 (2-3강, v8.0 파일럿)
 *   cashflow  소득·고정비·변동비 → 남는 돈·비상금 목표 (1-1강)
 *   emergency 생활비·적립액 → 비상금 목표액·도달 개월 (1-2강)
 *   order     월 여유자금 → 1·2·3순위 배분·예상 공제 (2-1강)
 *   isa       연 수익 → ISA 절세액·전환 추가 공제 (2-2강)
 *   allowance 용돈 → 쓸 돈·모을 돈·남길 돈 (초등 1강, v8.2.0)
 *   teenplan  월 반복 결제·BNPL → 1년 비용·갚을 총액 (청소년 1강)
 *   firstpay  세전·공제 → 실수령·세 칸 (첫 월급 1강)
 *   household 실수령·고정비·원리금·변동비 → 남는 돈·고정비 비율 (가계 1강, v8.3.0)
 *   coverage  진단비·지급률·감액 → 예상 수령액 (가계 2강)
 *   policy    투자금·비중·손실 한도 → 손실 금액·회복 필요 상승 (3-1강)
 *   etfcheck  보유 금액·비용률·기간 → 기간 비용 (3-2강)
 *   draworder 시작 자산·연 인출액·순서 → 5년 뒤 잔액과 두 기준선 (4-1강, v8.4.0)
 *   silson    세대·보험료·선택 → 3년 비용·3년 뒤 보험료 (5-1강)
 *   rebalance 총자산·목표 비중 → 덜기/채우기 금액·밴드 (6-1강)
 *   assetplan 총액·비중·하락률 → 전체 손실률 (학교 자산형성 1강)
 *   pensionmap 세 층 월 수령액 → 연 사적연금·소득 합계와 두 기준선 (학교 은퇴 1강)
 *
 * 공통 원칙: 입력값은 화면 안에서만 계산하고 주소·서버·저장소에 남기지 않는다.
 */
import SheetSlotPension from "./SheetSlotPension.astro";
import SheetCashflow from "./SheetCashflow.astro";
import SheetEmergency from "./SheetEmergency.astro";
import SheetOrder from "./SheetOrder.astro";
import SheetIsa from "./SheetIsa.astro";
import SheetSchool from "./SheetSchool.astro";
import SheetPolicy from "./SheetPolicy.astro";
import SheetV84 from "./SheetV84.astro";
import type { SheetVariant } from "@/data/academy-lessons";

interface Props {
  variant?: SheetVariant;
  slotNo?: number;
  slotTitle?: string;
  line?: string;
}

const { variant = "pension", slotNo, slotTitle, line } = Astro.props;
---

{
  variant === "cashflow" ? (
    <SheetCashflow slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "emergency" ? (
    <SheetEmergency slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "order" ? (
    <SheetOrder slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "isa" ? (
    <SheetIsa slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "allowance" || variant === "teenplan" || variant === "firstpay" || variant === "household" || variant === "coverage" ? (
    <SheetSchool variant={variant} slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "policy" || variant === "etfcheck" ? (
    <SheetPolicy variant={variant} slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : variant === "draworder" || variant === "silson" || variant === "rebalance" || variant === "assetplan" || variant === "pensionmap" ? (
    <SheetV84 variant={variant} slotNo={slotNo} slotTitle={slotTitle} line={line} />
  ) : (
    <SheetSlotPension />
  )
}
