---
/**
 * 앱스토어 아이콘 — 앱마다 다른 글리프 하나.
 * 선(stroke)만 쓰는 24px 격자라 카드 안 작은 타일에서도 형태가 남는다.
 * v7.3 유용한앱 2·3탄 16종은 각 데이터 파일의 아이콘 표(UTILS_B_ICONS·UTILS_C_ICONS)를 그대로 쓴다.
 */
import { UTILS_B_ICONS } from "@/data/utils-b.ts";
